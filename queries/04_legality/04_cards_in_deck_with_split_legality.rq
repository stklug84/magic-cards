# Cards across all decks in the dataset that are legal in some formats but
# not in others (i.e. the card has both at least one :Legal and at least one
# non-:Legal legality status), comparing the tracked formats played on the
# given platform: by default the seven paper formats, with mc:MTGArena the
# MTG Arena formats. Useful for identifying format-restricted cards. The
# commented VALUES line restricts results to specific deck(s).
#
# PARAMETERS:
#   ?deck     - optional deck filter (uncomment the VALUES line to restrict)
#   ?platform - the game platform whose formats are compared (mc:PaperMagic,
#               mc:MTGArena or mc:MagicOnline)

PREFIX mc:   <urn:stklug84:MagicCardsOntology:2026-02-27#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?deckName ?cardName WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SomeDeck }
  VALUES ?platform { mc:PaperMagic }

  ?deck mc:hasCard ?c .
  OPTIONAL { ?deck rdfs:label ?deckName }
  ?c mc:cardName ?cardName .

  # At least one Legal
  ?c mc:hasLegality ?lmLegal .
  ?lmLegal mc:inFormat ?fmtLegal ;
           mc:hasLegalityStatus mc:Legal .
  ?fmtLegal mc:isPlayedOn ?platform .

  # At least one non-Legal
  ?c mc:hasLegality ?lmOther .
  ?lmOther mc:inFormat ?fmtOther ;
           mc:hasLegalityStatus ?otherStatus .
  ?fmtOther mc:isPlayedOn ?platform .
  FILTER(?otherStatus != mc:Legal)
}
ORDER BY ?deckName ?cardName
