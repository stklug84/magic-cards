# Cards across all decks in the dataset whose legality status is :Legal
# across ALL seven tracked formats (Commander, Standard, Modern, Legacy,
# Vintage, Pioneer, Pauper). The commented VALUES line restricts results
# to specific deck(s).
#
# PARAMETERS:
#   ?deck - optional deck filter (uncomment the VALUES line to restrict)

PREFIX mc:   <urn:stklug84:MagicCardsOntology:2026-02-27#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?deckName ?cardName WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SaheeliRadiantCreatorDeck }

  ?deck mc:hasCard ?c .
  OPTIONAL { ?deck rdfs:label ?deckName }
  ?c mc:cardName ?cardName .

  FILTER NOT EXISTS {
    ?c mc:hasLegality ?lm .
    ?lm mc:hasLegalityStatus ?status .
    FILTER(?status != mc:Legal)
  }
}
ORDER BY ?deckName ?cardName
