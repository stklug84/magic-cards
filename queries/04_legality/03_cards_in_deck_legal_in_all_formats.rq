# Cards across all decks in the dataset whose legality status is :Legal in
# ALL tracked formats played on the given platform. The default, paper,
# covers the seven paper formats (Commander, Standard, Modern, Legacy,
# Vintage, Pioneer, Pauper); mc:MTGArena covers the MTG Arena formats
# (Standard, Pioneer, Historic, Timeless, Alchemy, Brawl, Standard Brawl).
# The commented VALUES line restricts results to specific deck(s).
#
# PARAMETERS:
#   ?deck     - optional deck filter (uncomment the VALUES line to restrict)
#   ?platform - the game platform whose formats are checked (mc:PaperMagic,
#               mc:MTGArena or mc:MagicOnline)

PREFIX mc:   <urn:stklug84:MagicCardsOntology:2026-02-27#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?deckName ?cardName WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SomeDeck }
  VALUES ?platform { mc:PaperMagic }

  ?deck mc:hasCard ?c .
  OPTIONAL { ?deck rdfs:label ?deckName }
  ?c mc:cardName ?cardName .

  FILTER NOT EXISTS {
    ?c mc:hasLegality ?lm .
    ?lm mc:inFormat ?fmt ;
        mc:hasLegalityStatus ?status .
    ?fmt mc:isPlayedOn ?platform .
    FILTER(?status != mc:Legal)
  }
}
ORDER BY ?deckName ?cardName
