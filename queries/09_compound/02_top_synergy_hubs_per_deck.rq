# Top "synergy hubs" across all decks: cards with the highest number of
# distinct in-deck synergy partners, ordered DESC. Limit configurable.
#
# PARAMETERS:
#   ?deck    - optional: uncomment the VALUES clause in WHERE to restrict
#              to specific deck(s); by default all decks are covered
#   ?topN    - how many rows to return (LIMIT)

PREFIX mc: <urn:stklug84:MagicCardsOntology:2026-02-27#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?deckName ?cardName (COUNT(DISTINCT ?other) AS ?partners) WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SaheeliRadiantCreatorDeck }

  OPTIONAL { ?deck rdfs:label ?deckName }

  ?deck mc:hasCard ?c , ?other .
  FILTER(?c != ?other)
  ?c mc:cardName ?cardName .
  ?c ( mc:hasSynergyWith
     | ^mc:hasSynergyWith
     | mc:amplifies
     | ^mc:amplifies
     | mc:isAmplifiedBy
     | ^mc:isAmplifiedBy
     | mc:enables
     | ^mc:enables
     | mc:isEnabledBy
     | ^mc:isEnabledBy ) ?other .
}
GROUP BY ?deck ?deckName ?cardName
ORDER BY ?deckName DESC(?partners) ?cardName
LIMIT 10
