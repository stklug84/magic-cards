# Compare two decks: report cards in deck A, cards in deck B, and cards in both,
# tagged by membership. Useful for diffing two builds or finding shared staples.
#
# PARAMETERS (uncomment and edit the two VALUES clauses below):
#   ?deckA - first deck to compare
#   ?deckB - second deck to compare
# Without the VALUES lines the query diffs every pair of decks in the
# dataset (including each deck against itself); set each to the deck IRIs
# you want to diff.

PREFIX mc: <urn:stklug84:MagicCardsOntology:2026-02-27#>

SELECT ?cardName ?membership WHERE {
  # VALUES ?deckA { mc:SomeDeckA }
  # VALUES ?deckB { mc:SomeDeckB }

  {
    ?deckA mc:hasCard ?c .
    ?c mc:cardName ?cardName .
    OPTIONAL { ?deckB mc:hasCard ?c BIND("BOTH" AS ?bothTag) }
    FILTER NOT EXISTS { ?deckB mc:hasCard ?c }
    BIND("A_ONLY" AS ?membership)
  } UNION {
    ?deckB mc:hasCard ?c .
    ?c mc:cardName ?cardName .
    FILTER NOT EXISTS { ?deckA mc:hasCard ?c }
    BIND("B_ONLY" AS ?membership)
  } UNION {
    ?deckA mc:hasCard ?c .
    ?deckB mc:hasCard ?c .
    ?c mc:cardName ?cardName .
    BIND("BOTH" AS ?membership)
  }
}
ORDER BY ?membership ?cardName
