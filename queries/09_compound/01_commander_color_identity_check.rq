# Commander color identity check (rule 903.5c): for every Commander deck in
# the dataset, list each card whose color identity has a color that is not in
# the deck's color identity. In a legal Commander deck this result set is
# empty.
#
# The check reads mc:hasColorIdentity (rule 903.4), never mc:hasColor: color
# identity also counts the mana symbols in a card's rules text and its color
# indicator, so a colorless card can have a colored identity (Azorius Signet:
# white-blue) and a colored card a wider one (Lingering Souls: white, identity
# white-black). A card with a colorless identity asserts no
# mc:hasColorIdentity and is never listed, as rule 903.5c allows. With two
# commanders (partner, rule 702.124c) the deck's color identity is the union
# of both commanders' identities.
#
# PARAMETERS:
#   ?deck - optional: uncomment the VALUES clause in WHERE to restrict
#           validation to specific deck(s); by default all decks are checked

PREFIX mc: <urn:stklug84:MagicCardsOntology:2026-02-27#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?deckName ?cardName ?offendingColor WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SomeDeck }

  ?deck mc:hasCard ?c .
  ?c mc:cardName ?cardName ;
     mc:hasColorIdentity ?offendingColor .

  # Commander decks only; a color is allowed when any commander has it.
  FILTER EXISTS { ?commander mc:isCommanderOf ?deck }
  FILTER NOT EXISTS {
    ?commander mc:isCommanderOf ?deck ;
               mc:hasColorIdentity ?offendingColor .
  }

  # Last, not first: an OPTIONAL that opens the pattern drops every deck
  # without a label.
  OPTIONAL { ?deck rdfs:label ?deckName }
}
ORDER BY ?deckName ?cardName ?offendingColor
