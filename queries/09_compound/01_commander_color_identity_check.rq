# Sanity check: for every Commander deck in the dataset, list every card whose
# colors include a color NOT present in any commander of that deck. In a legal
# Commander deck this result set should be empty.
#
# NOTE: This checks card :hasColor only, not full color identity (which would
# also include colors of mana symbols in oracle text and color indicators).
# For a strict check, extend the ontology with :hasColorIdentity.
#
# PARAMETERS:
#   ?deck - optional: uncomment the VALUES clause in WHERE to restrict
#           validation to specific deck(s); by default all decks are checked

PREFIX mc: <urn:stklug84:MagicCardsOntology:2026-02-27#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?deckName ?cardName ?offendingColor WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SaheeliRadiantCreatorDeck }

  OPTIONAL { ?deck rdfs:label ?deckName }

  ?commander mc:isCommanderOf ?deck .

  ?deck mc:hasCard ?c .
  ?c mc:cardName ?cardName ;
     mc:hasColor ?offendingColor .

  FILTER NOT EXISTS { ?commander mc:hasColor ?offendingColor }
}
ORDER BY ?deckName ?cardName ?offendingColor
