# Cards that have a given keyword ability, across all decks in the dataset.
# Uncomment the VALUES ?deck line to restrict to specific deck(s).
#
# PARAMETERS:
#   ?deck    - (optional) specific deck(s), via the commented VALUES line
#   ?keyword - the KeywordAbility individual (e.g. mc:Flying, mc:Haste, mc:Trample)

PREFIX mc:   <urn:stklug84:MagicCardsOntology:2026-02-27#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?deckName ?cardName WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SomeDeck }
  VALUES ?keyword { mc:Flying }

  ?deck mc:hasCard ?c .
  OPTIONAL { ?deck rdfs:label ?deckName }
  ?c mc:hasKeywordAbility ?keyword ;
     mc:cardName ?cardName .
}
ORDER BY ?deckName ?cardName
