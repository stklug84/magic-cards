# All non-land cards with mana value at most a given threshold, across all
# decks in the dataset. Uncomment the VALUES ?deck line to restrict to
# specific deck(s).
#
# PARAMETERS:
#   ?deck  - (optional) specific deck(s), via the commented VALUES line
#   ?maxMV - inclusive upper bound on mana value

PREFIX mc:   <urn:stklug84:MagicCardsOntology:2026-02-27#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT ?deckName ?cardName ?manaValue ?manaCost WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SomeDeck }
  VALUES ?maxMV { 4 }

  ?deck mc:hasCard ?c .
  OPTIONAL { ?deck rdfs:label ?deckName }
  ?c mc:cardName  ?cardName ;
     mc:manaValue ?manaValue .
  OPTIONAL { ?c mc:manaCost ?manaCost }
  FILTER NOT EXISTS { ?c mc:hasCardType mc:Land }
  FILTER (?manaValue <= ?maxMV)
}
ORDER BY ?deckName ?manaValue ?cardName
