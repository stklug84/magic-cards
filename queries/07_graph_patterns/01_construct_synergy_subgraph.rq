# CONSTRUCT a clean synergy subgraph: a triple (a :hasSynergyWith b) for every
# pair of cards that share any synergy relation within the same deck, across
# all decks in the dataset. The commented VALUES line restricts to specific
# deck(s). Result can be loaded into Graphviz/Gephi via TriG/N-Triples export.
#
# PARAMETERS:
#   ?deck - optional deck filter; uncomment the VALUES line below to restrict
#           to specific deck(s)

PREFIX mc: <urn:stklug84:MagicCardsOntology:2026-02-27#>

CONSTRUCT { ?a mc:hasSynergyWith ?b }
WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SaheeliRadiantCreatorDeck }

  ?deck mc:hasCard ?a , ?b .
  FILTER(STR(?a) < STR(?b))
  ?a ( mc:hasSynergyWith
     | ^mc:hasSynergyWith
     | mc:amplifies
     | ^mc:amplifies
     | mc:isAmplifiedBy
     | ^mc:isAmplifiedBy
     | mc:enables
     | ^mc:enables
     | mc:isEnabledBy
     | ^mc:isEnabledBy ) ?b .
}
