# CONSTRUCT a minimal "deck skeleton" graph covering all decks in the dataset:
# for each card in each deck, emit (card :isInDeck deck), (card :cardName name),
# (card :manaValue mv), and (card :hasCardType type). Useful for exporting a
# slim view for visualization.
#
# PARAMETERS:
#   ?deck - optional deck filter; uncomment the VALUES line below to restrict
#           to specific deck(s)

PREFIX mc: <urn:stklug84:MagicCardsOntology:2026-02-27#>

CONSTRUCT {
  ?c mc:isInDeck     ?deck ;
     mc:cardName     ?name ;
     mc:manaValue    ?mv ;
     mc:hasCardType  ?t .
}
WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SaheeliRadiantCreatorDeck }

  ?deck mc:hasCard ?c .
  ?c mc:cardName    ?name ;
     mc:hasCardType ?t .
  OPTIONAL { ?c mc:manaValue ?mv }
}
