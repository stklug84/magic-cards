# Cards that do NOT participate in any synergy triple (no incoming or
# outgoing synergy edge), across all decks in the dataset. Uncomment the
# VALUES ?deck line to restrict to specific deck(s).
#
# PARAMETERS:
#   ?deck - (optional) specific deck(s), via the commented VALUES line

PREFIX mc:   <urn:stklug84:MagicCardsOntology:2026-02-27#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?deckName ?cardName WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SomeDeck }

  ?deck mc:hasCard ?c .
  OPTIONAL { ?deck rdfs:label ?deckName }
  ?c mc:cardName ?cardName .

  FILTER NOT EXISTS {
    ?c ( mc:hasSynergyWith
       | ^mc:hasSynergyWith
       | mc:amplifies
       | ^mc:amplifies
       | mc:isAmplifiedBy
       | ^mc:isAmplifiedBy
       | mc:enables
       | ^mc:enables
       | mc:isEnabledBy
       | ^mc:isEnabledBy ) ?other .
  }
}
ORDER BY ?deckName ?cardName
