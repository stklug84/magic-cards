# For each card in the deck, count the number of distinct other cards in the
# same deck it has any synergy relation with. Useful for spotting key combo pieces.
#
# PARAMETERS:
#   ?deck - the deck to query

PREFIX mc: <urn:stklug84:MagicCardsOntology:2026-02-27#>

SELECT ?cardName (COUNT(DISTINCT ?other) AS ?synergyCount) WHERE {
  VALUES ?deck { mc:SaheeliRadiantCreatorDeck }

  ?deck mc:hasCard ?c , ?other .
  FILTER(?c != ?other)
  ?c mc:cardName ?cardName .
  ?c ( mc:hasSynergyWith
     | ^mc:hasSynergyWith
     | mc:amplifies
     | ^mc:amplifies
     | mc:isAmplifiedBy
     | ^mc:isAmplifiedBy
     | mc:enables
     | ^mc:enables
     | mc:isEnabledBy
     | ^mc:isEnabledBy ) ?other .
}
GROUP BY ?cardName
ORDER BY DESC(?synergyCount) ?cardName
