# All synergy pairs where BOTH cards are present in the same deck, across all
# decks in the dataset. Uncomment the VALUES ?deck line to restrict to
# specific deck(s).
# Each pair is reported once per deck (filter A < B on IRI to avoid duplicates).
#
# PARAMETERS:
#   ?deck - (optional) specific deck(s), via the commented VALUES line

PREFIX mc:   <urn:stklug84:MagicCardsOntology:2026-02-27#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?deckName ?aName ?bName WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SaheeliRadiantCreatorDeck }

  ?deck mc:hasCard ?a , ?b .
  OPTIONAL { ?deck rdfs:label ?deckName }
  ?a ( mc:hasSynergyWith
     | ^mc:hasSynergyWith
     | mc:amplifies
     | ^mc:amplifies
     | mc:isAmplifiedBy
     | ^mc:isAmplifiedBy
     | mc:enables
     | ^mc:enables
     | mc:isEnabledBy
     | ^mc:isEnabledBy ) ?b .
  ?a mc:cardName ?aName .
  ?b mc:cardName ?bName .
  FILTER(STR(?a) < STR(?b))
}
ORDER BY ?deckName ?aName ?bName
