# Distinct sets represented in each deck in the dataset, with card count per
# set. Covers all decks; the commented VALUES line restricts results to
# specific deck(s).
#
# PARAMETERS:
#   ?deck - optional deck filter (uncomment the VALUES line to restrict)

PREFIX mc:   <urn:stklug84:MagicCardsOntology:2026-02-27#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?deckName ?setCode ?setName (COUNT(DISTINCT ?c) AS ?cards) WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SomeDeck }

  ?deck mc:hasCard ?c .
  OPTIONAL { ?deck rdfs:label ?deckName }
  ?c mc:isInSet ?s .
  OPTIONAL { ?s mc:setCode ?setCode }
  OPTIONAL { ?s mc:setName ?setName }
}
GROUP BY ?deck ?deckName ?setCode ?setName
ORDER BY ?deckName DESC(?cards) ?setName
