# Card-type breakdown: count of unique cards per primary card type, per deck,
# for all decks in the dataset. Multi-typed cards (e.g. Artifact Creature)
# are counted once per card type.
#
# PARAMETERS:
#   ?deck - optional deck filter; uncomment the VALUES line below to restrict
#           to specific deck(s)

PREFIX mc:   <urn:stklug84:MagicCardsOntology:2026-02-27#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?deckName ?typeLabel (COUNT(DISTINCT ?c) AS ?cardCount) WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SomeDeck }

  ?deck mc:hasCard ?c .
  ?c mc:hasCardType ?t .
  OPTIONAL { ?t rdfs:label ?typeLabel }
  OPTIONAL { ?deck rdfs:label ?deckName }
}
GROUP BY ?deck ?deckName ?typeLabel
ORDER BY ?deckName DESC(?cardCount)
