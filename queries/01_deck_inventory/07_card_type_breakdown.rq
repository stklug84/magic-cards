# Card-type breakdown: count of unique cards per primary card type in a deck.
# Multi-typed cards (e.g. Artifact Creature) are counted once per card type.
#
# PARAMETERS:
#   ?deck - the deck to query

PREFIX mc:   <urn:stklug84:MagicCardsOntology:2026-02-27#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?typeLabel (COUNT(DISTINCT ?c) AS ?cardCount) WHERE {
  VALUES ?deck { mc:SaheeliRadiantCreatorDeck }

  ?deck mc:hasCard ?c .
  ?c mc:hasCardType ?t .
  OPTIONAL { ?t rdfs:label ?typeLabel }
}
GROUP BY ?typeLabel
ORDER BY DESC(?cardCount)
