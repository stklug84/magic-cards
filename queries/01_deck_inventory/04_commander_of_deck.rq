# Returns the commander(s) of every deck in the dataset.
#
# PARAMETERS:
#   ?deck - optional deck filter; uncomment the VALUES line below to restrict
#           to specific deck(s)

PREFIX mc:   <urn:stklug84:MagicCardsOntology:2026-02-27#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?deckName ?commander ?commanderName WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SaheeliRadiantCreatorDeck }

  ?commander mc:isCommanderOf ?deck ;
             mc:cardName ?commanderName .
  OPTIONAL { ?deck rdfs:label ?deckName }
}
ORDER BY ?deckName ?commanderName
