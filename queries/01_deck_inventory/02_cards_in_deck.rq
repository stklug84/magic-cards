# Lists every card in every deck with its quantity, sorted by deck then
# quantity descending. Covers all decks in the dataset.
#
# PARAMETERS:
#   ?deck - optional deck filter; uncomment the VALUES line below to restrict
#           to specific deck(s)

PREFIX mc:   <urn:stklug84:MagicCardsOntology:2026-02-27#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?deckName ?cardName ?quantity WHERE {
  # To restrict to specific deck(s), uncomment and edit:
  # VALUES ?deck { mc:SomeDeck }

  ?deck mc:hasDeckEntry ?entry .
  ?entry mc:entryCard ?card ;
         mc:quantity ?quantity .
  ?card mc:cardName ?cardName .
  OPTIONAL { ?deck rdfs:label ?deckName }
}
ORDER BY ?deckName DESC(?quantity) ?cardName
