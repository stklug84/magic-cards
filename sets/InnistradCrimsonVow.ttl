:VoiceOfTheBlessed rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Voice of the Blessed" ;
    :manaCost "{W}{W}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Spirit ,
                :Cleric ;
    :hasRarity :Rare ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :InnistradCrimsonVow ;
    :cardNumber "44"^^xsd:integer ;
    :artist "Anastasia Ovchinnikova" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "2" ;
    :toughnessValue "2"^^xsd:integer ;
    :printedText """Whenever you gain life, put a +1/+1 counter on this creature.
As long as this creature has four or more +1/+1 counters on it, it has flying and vigilance.
As long as this creature has ten or more +1/+1 counters on it, it has indestructible."""@en ;
    :oracleText """Whenever you gain life, put a +1/+1 counter on this creature.
As long as this creature has four or more +1/+1 counters on it, it has flying and vigilance.
As long as this creature has ten or more +1/+1 counters on it, it has indestructible."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=540879"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/vow/44/voice-of-the-blessed"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "78827"^^xsd:positiveInteger ;
    :arenaName "Voice of the Blessed" ;
    :arenaSetCode "VOW" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-11-19"^^xsd:date ;
        :rulingText """In a Two-Headed Giant game, life gained by your teammate won't cause the first ability to trigger, even though it caused your team's life total to increase."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-11-19"^^xsd:date ;
        :rulingText """Each creature with lifelink dealing combat damage causes a separate life-gaining event. For example, if two creatures you control with lifelink deal combat damage at the same time, Voice of the Blessed's first ability will trigger twice. However, if a single creature you control with lifelink deals combat damage to multiple creatures, players, and/or planeswalkers at the same time (perhaps because it has trample or was blocked by more than one creature), the ability will trigger only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-11-19"^^xsd:date ;
        :rulingText """The first ability of Voice of the Blessed triggers just once for each life-gaining event, no matter how much life was gained."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-11-19"^^xsd:date ;
        :rulingText """If you gain an amount of life “for each” of something, that life is gained as one event and the ability of Voice of the Blessed triggers only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-11-19"^^xsd:date ;
        :rulingText """If Voice of the Blessed is dealt lethal damage at the same time that you gain life, it won't receive a counter from its ability in time to save it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-11-19"^^xsd:date ;
        :rulingText """Gaining flying after it has become blocked won't cause Voice of the Blessed to become unblocked."""@en ] .

