@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@prefix :     <urn:stklug84:MagicCardsOntology:2026-02-27#> .
@base         <urn:stklug84:MagicCardIndividuals:M10:2026-07-19#> .

################################################################################
#
# Ontology Definition
#
################################################################################

<urn:stklug84:MagicCardIndividuals:M10:2026-07-19#>
    rdf:type owl:Ontology ;
    owl:imports <urn:stklug84:MagicCardsOntology:2026-02-27#> ;
    rdfs:label "Magic Card Collection Individuals – Magic 2010"@en ;
    rdfs:comment """An instance graph describing the card individuals of a
personal Magic: The Gathering card collection that were printed in the set
Magic 2010 (M10). One Card individual is defined per collected
printing, carrying its characteristics, the platforms it is available on
(paper, MTG Arena, Magic Online) with its MTG Arena identity, its legality
in the paper and MTG Arena formats, and official rulings. Card data was
sourced from Gatherer and Scryfall. This file imports MagicCardsOntology to
reuse all existing class, property, set, keyword, subtype, format and
legality definitions."""@en .


################################################################################
#
# Card Individuals
#
################################################################################

:SoulWarden rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Soul Warden" ;
    :manaCost "{W}" ;
    :manaValue "1"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Human ,
                :Cleric ;
    :hasRarity :Common ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :Magic2010 ;
    :cardNumber "34"^^xsd:integer ;
    :artist "Randy Gallegos" ;
    :hasLanguage :English ;
    :power "1" ;
    :powerValue "1"^^xsd:integer ;
    :toughness "1" ;
    :toughnessValue "1"^^xsd:integer ;
    :printedText """Whenever another creature enters, you gain 1 life."""@en ;
    :oracleText """Whenever another creature enters, you gain 1 life."""@en ;
    :flavorText """"One does not question the size or shape of the grains of sand in an hourglass. Nor do I question the temperament of the souls under my guidance.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=190571"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/m10/34/soul-warden"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """If this creature enters at the same time as one or more other creatures, its ability will trigger for each of those other creatures. """@en ] .
