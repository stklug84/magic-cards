    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """The Ring gains its abilities in order from top to bottom. Once it gains an ability, it has that ability for the rest of the game."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Each time the Ring tempts you, you must choose a creature if you control one."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """If the creature you choose as your Ring-bearer was already your Ring-bearer, that still counts as choosing that creature as your Ring-bearer for the purpose of abilities that trigger "whenever you choose a creature as your Ring-bearer" or abilities that care about which creature was chosen as your Ring-bearer."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """As the Ring tempts you, you get an emblem named The Ring if you don't have one. Then your emblem gains its next ability and you choose a creature you control to become (or remain) your Ring-bearer."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """The Ring can tempt you even if you don't control a creature. In this case, abilities that trigger "whenever the Ring tempts you" will still trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Each player can have only one emblem named The Ring and only one Ring-bearer at a time."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Some spells and abilities that cause the Ring to tempt you may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. The Ring won't tempt you."""@en ] .

:WarbeastOfGorgoroth rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Warbeast of Gorgoroth" ;
    :manaCost "{4}{R}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Beast ;
    :hasRarity :Common ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :TheLordOfTheRingsTalesOfMiddleEarth ;
    :cardNumber "152"^^xsd:integer ;
    :artist "Oleg Shekhovtsov" ;
    :hasLanguage :English ;
    :power "5" ;
    :powerValue "5"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :hasKeywordAction :Amass ;
    :printedText """Whenever this creature or another creature you control with power 4 or greater dies, amass Orcs 2. (Put two +1/+1 counters on an Army you control. It's also an Orc. If you don't control an Army, create a 0/0 black Orc Army creature token first.)"""@en ;
    :oracleText """Whenever this creature or another creature you control with power 4 or greater dies, amass Orcs 2. (Put two +1/+1 counters on an Army you control. It's also an Orc. If you don't control an Army, create a 0/0 black Orc Army creature token first.)"""@en ;
    :flavorText """Drums rolled, fires leaped, and great engines drawn by beasts crawled across the field."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=616982"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/ltr/152/warbeast-of-gorgoroth"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "84844"^^xsd:positiveInteger ;
    :arenaName "Warbeast of Gorgoroth" ;
    :arenaSetCode "LTR" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """If Warbeast of Gorgoroth and one or more other creatures you control with power 4 or greater die at the same time, its ability will trigger once for each of them."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Amass abilities are now written as "amass [subtype] N." Previous cards with amass have received errata to say "amass Zombies N.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """To amass Orcs N, if you don't control an Army creature, create a 0/0 black Orc Army creature token. Then you choose an Army creature you control and put N +1/+1 counters on it. If that Army isn't already an Orc, it becomes an Orc in addition to its other types."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Some spells and abilities that amass Orcs may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. You won't amass Orcs."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Amass Zombies works the same way, except you create a 0/0 black Zombie Army creature token if you don't control an Army. If the Army creature you chose isn't already a Zombie, it becomes a Zombie in addition to its other types. By combining cards with amass Orcs and amass Zombies, you can end up with an Orc Zombie Army."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Some cards refer to the "amassed Army." That means the Army creature you chose to receive counters, even if no counters were placed on it for some reason."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """If you don't control an Army, the Orc Army token you create enters the battlefield as a 0/0 creature before receiving counters. Any abilities that trigger when a creature with a certain power enters the battlefield, such as that of Mentor of the Meek, will see the token enter as a 0/0 creature before it gets +1/+1 counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """In the rare case that you control multiple Army creatures (perhaps because you played a creature with changeling) while you amass Orcs, you choose which of your Army creatures to put the +1/+1 counters on. If that creature isn't an Orc, it becomes an Orc in addition to its other types."""@en ] .

