:SarumansTrickery rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Saruman's Trickery" ;
    :manaCost "{1}{U}{U}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Uncommon ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :TheLordOfTheRingsTalesOfMiddleEarth ;
    :cardNumber "68"^^xsd:integer ;
    :artist "Yongjae Choi" ;
    :hasLanguage :English ;
    :hasKeywordAction :Amass ;
    :printedText """Counter target spell.
Amass Orcs 1. (Put a +1/+1 counter on an Army you control. It's also an Orc. If you don't control an Army, create a 0/0 black Orc Army creature token first.)"""@en ;
    :oracleText """Counter target spell.
Amass Orcs 1. (Put a +1/+1 counter on an Army you control. It's also an Orc. If you don't control an Army, create a 0/0 black Orc Army creature token first.)"""@en ;
    :flavorText """"I gave you the chance of aiding me willingly."
—Saruman"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=616898"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/ltr/68/sarumans-trickery"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "84760"^^xsd:positiveInteger ;
    :arenaName "Saruman's Trickery" ;
    :arenaSetCode "LTR" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """If you don't control an Army, the Orc Army token you create enters the battlefield as a 0/0 creature before receiving counters. Any abilities that trigger when a creature with a certain power enters the battlefield, such as that of Mentor of the Meek, will see the token enter as a 0/0 creature before it gets +1/+1 counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """To amass Orcs N, if you don't control an Army creature, create a 0/0 black Orc Army creature token. Then you choose an Army creature you control and put N +1/+1 counters on it. If that Army isn't already an Orc, it becomes an Orc in addition to its other types."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Amass abilities are now written as "amass [subtype] N." Previous cards with amass have received errata to say "amass Zombies N.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Some cards refer to the "amassed Army." That means the Army creature you chose to receive counters, even if no counters were placed on it for some reason."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Some spells and abilities that amass Orcs may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. You won't amass Orcs."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """In the rare case that you control multiple Army creatures (perhaps because you played a creature with changeling) while you amass Orcs, you choose which of your Army creatures to put the +1/+1 counters on. If that creature isn't an Orc, it becomes an Orc in addition to its other types."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Amass Zombies works the same way, except you create a 0/0 black Zombie Army creature token if you don't control an Army. If the Army creature you chose isn't already a Zombie, it becomes a Zombie in addition to its other types. By combining cards with amass Orcs and amass Zombies, you can end up with an Orc Zombie Army."""@en ] .

