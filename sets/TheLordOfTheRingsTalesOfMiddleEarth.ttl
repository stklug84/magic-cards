      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Each player can have only one emblem named The Ring and only one Ring-bearer at a time."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """As the Ring tempts you, you get an emblem named The Ring if you don't have one. Then your emblem gains its next ability and you choose a creature you control to become (or remain) your Ring-bearer."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """The Ring can tempt you even if you don't control a creature. In this case, abilities that trigger "whenever the Ring tempts you" will still trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Each time the Ring tempts you, you must choose a creature if you control one."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """The Ring gains its abilities in order from top to bottom. Once it gains an ability, it has that ability for the rest of the game."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """If the creature you choose as your Ring-bearer was already your Ring-bearer, that still counts as choosing that creature as your Ring-bearer for the purpose of abilities that trigger "whenever you choose a creature as your Ring-bearer" or abilities that care about which creature was chosen as your Ring-bearer."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Some spells and abilities that cause the Ring to tempt you may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. The Ring won't tempt you."""@en ] .

