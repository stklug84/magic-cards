    :hasSuperType :Legendary ;
    :hasCardType :Instant ;
    :hasRarity :Rare ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :TheLordOfTheRingsTalesOfMiddleEarth ;
    :cardNumber "91"^^xsd:integer ;
    :artist "John Di Giovanni" ;
    :hasLanguage :English ;
    :printedText """(You may cast a legendary instant only if you control a legendary creature or planeswalker.)
Destroy target creature. If its controller has more than four cards in hand, they exile cards from their hand equal to the difference."""@en ;
    :oracleText """(You may cast a legendary instant only if you control a legendary creature or planeswalker.)
Destroy target creature. If its controller has more than four cards in hand, they exile cards from their hand equal to the difference."""@en ;
    :flavorText """Isildur cut the Ring from Sauron's hand with the hilt-shard of his father's sword, and Sauron himself was overthrown."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=616921"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/ltr/91/isildurs-fateful-strike"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "84783"^^xsd:positiveInteger ;
    :arenaName "Isildur's Fateful Strike" ;
    :arenaSetCode "LTR" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Isildur's Fateful Strike is the first legendary instant. It is subject to the same casting restrictions as existing legendary sorceries, as listed in the following rulings."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """You can't cast a legendary instant unless you control a legendary creature or a legendary planeswalker. Once you begin to cast a legendary instant, losing control of your legendary creatures and planeswalkers won't affect that spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Other than the casting restriction, the legendary supertype on an instant carries no additional rules. You may cast any number of legendary instants in a turn, and your deck may contain any number of legendary cards (but no more than four of any with the same name)."""@en ] .

:ShadowOfTheEnemy rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Shadow of the Enemy" ;
    :manaCost "{3}{B}{B}{B}" ;
    :manaValue "6"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :MythicRare ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :TheLordOfTheRingsTalesOfMiddleEarth ;
    :cardNumber "107"^^xsd:integer ;
    :artist "Shahab Alizadeh" ;
    :hasLanguage :English ;
    :printedText """Exile all creature cards from target player's graveyard. You may cast spells from among those cards for as long as they remain exiled, and mana of any type can be spent to cast them."""@en ;
    :oracleText """Exile all creature cards from target player's graveyard. You may cast spells from among those cards for as long as they remain exiled, and mana of any type can be spent to cast them."""@en ;
    :flavorText """As Frodo put on the Ring, Sauron was suddenly aware of the magnitude of his own folly. His wrath blazed in consuming flame, but his fear rose like black smoke."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=616937"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/ltr/107/shadow-of-the-enemy"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "84799"^^xsd:positiveInteger ;
    :arenaName "Shadow of the Enemy" ;
    :arenaSetCode "LTR" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Shadow of the Enemy uses a new template indicating that you may spend mana as though it were mana of any type to cast the exiled cards. The six types of mana are white, blue, black, red, green, and colorless."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """You pay all costs and follow all normal timing rules for spells cast this way."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Snow mana is not a type of mana. Shadow of the Enemy won't let you pay a snow cost using mana produced by a nonsnow source."""@en ] .

