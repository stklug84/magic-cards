    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2013-04-15"^^xsd:date ;
        :rulingText """The ability can target a tapped creature. If the targeted creature is already tapped when it resolves, that creature just remains tapped and doesn’t untap during its controller’s next untap step."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-07-12"^^xsd:date ;
        :rulingText """Dungeon Geists’s triggered ability can target a tapped creature. If the targeted creature is already tapped when it resolves, that creature just remains tapped and won’t untap during its controller’s untap step."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-07-12"^^xsd:date ;
        :rulingText """If another player gains control of Dungeon Geists, its effect expires. It won’t keep the creature from untapping anymore, even if you later regain control of Dungeon Geists."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-07-12"^^xsd:date ;
        :rulingText """If Dungeon Geists leaves the battlefield before its triggered ability has resolved, the target creature will be tapped, but it will be able to untap as normal."""@en ] .

