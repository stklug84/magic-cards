    :hasKeywordAction :Proliferate ;
    :printedText """Whenever an opponent attacks you, choose target creature attacking you. Put a stun counter on that creature.
{3}{U}: Proliferate. (Choose any number of permanents and/or players, then give each another counter of each kind already there.)"""@en ;
    :oracleText """Whenever an opponent attacks you, choose target creature attacking you. Put a stun counter on that creature.
{3}{U}: Proliferate. (Choose any number of permanents and/or players, then give each another counter of each kind already there.)"""@en ;
    :flavorText """"If you want everything, you'll end up with nothing.\""""@en ;
    :scryfallUrl "https://scryfall.com/card/fic/38/lulu-stern-guardian"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "98086"^^xsd:positiveInteger ;
    :arenaName "Lulu, Stern Guardian" ;
    :arenaSetCode "FIC" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-06-06"^^xsd:date ;
        :rulingText """If a player or permanent has more than one kind of counter on it, and you choose for it to get additional counters, it must get one of each kind of counter it already has. You can't have it get just one kind of counter it already has and not the others."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-06-06"^^xsd:date ;
        :rulingText """Players can respond to a spell or ability whose effect includes proliferating. Once that spell or ability starts to resolve, however, and its controller chooses which permanents and players will get new counters, it's too late for anyone to respond."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-06-06"^^xsd:date ;
        :rulingText """Lulu's first ability only cares about creatures attacking you, not planeswalkers you control or battles you protect."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-06-06"^^xsd:date ;
        :rulingText """When you proliferate, you can choose any permanent that has a counter, including ones controlled by opponents. You can choose any player who has a counter, including opponents. You can't choose cards in any zone other than the battlefield, even if they have counters on them."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-06-06"^^xsd:date ;
        :rulingText """You don't have to choose every permanent or player that has a counter—only the ones you want to add counters to. Since "any number" includes zero, you don't have to choose any permanents at all, and you don't have to choose any players at all."""@en ] .

