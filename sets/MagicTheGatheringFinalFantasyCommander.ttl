    :printedText """{T}: Add {C}.
{1}, {T}: Move a counter from target permanent you control onto a second target permanent. Activate only as a sorcery."""@en ;
    :oracleText """{T}: Add {C}.
{1}, {T}: Move a counter from target permanent you control onto a second target permanent. Activate only as a sorcery."""@en ;
    :flavorText """A butterfly will lead the way to secret things."""@en ;
    :scryfallUrl "https://scryfall.com/card/fic/408/nesting-grounds"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """You choose the two target permanents as Nesting Grounds's second ability is put onto the stack. You choose which kind of counter to move as that ability resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """If either permanent becomes an illegal target, no counter is removed or put."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """The two target permanents don't have to share a type, which can result in some counters on permanents that would not occur normally, such as loyalty counters on creatures or +1/+1 counters on lands. Keyword counters will grant the permanent that keyword even if it's meaningless (such as trample on an enchantment); +1/+1 counters won't affect the permanent unless it's a creature; and many named counters (such as soul counters) won't have an effect unless the recipient permanent refers to them in some way."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """To move a counter from one creature to another, the counter is removed from the first permanent and put on the second. Any abilities that care about a counter being removed from or put onto a permanent will apply."""@en ] .

