                  :Card ;
    :cardName "Conqueror's Flail" ;
    :manaCost "{2}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasSubType :Equipment ;
    :hasRarity :Rare ;
    :isInSet :MagicTheGatheringFinalFantasyCommander ;
    :cardNumber "340"^^xsd:integer ;
    :artist "Russell Dongjun Lu" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Equip ;
    :printedText """Equipped creature gets +1/+1 for each color among permanents you control.
As long as this Equipment is attached to a creature, your opponents can't cast spells during your turn.
Equip {2}"""@en ;
    :oracleText """Equipped creature gets +1/+1 for each color among permanents you control.
As long as this Equipment is attached to a creature, your opponents can't cast spells during your turn.
Equip {2}"""@en ;
    :scryfallUrl "https://scryfall.com/card/fic/340/conquerors-flail"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2016-11-08"^^xsd:date ;
        :rulingText """The five colors are white, blue, black, red, and green. Conqueror's Flail can't give a creature more than +5/+5. (Gold, artifact, and colorless aren't colors.)"""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-11-08"^^xsd:date ;
        :rulingText """If Conquerer's Flail is attached to a creature you control and you activate its equip ability targeting another creature you control, there's no time in between activating that ability and the resolution of that ability during which it's not attached to a creature. Assuming it's your turn, your opponents won't be able to cast spells."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-11-08"^^xsd:date ;
        :rulingText """The first ability of Conqueror's Flail constantly updates as the number of colors among permanents you control changes. If the number of colors decreases and the damage that was marked on the equipped creature earlier in the turn is now lethal damage, that creature is destroyed. Similarly, if its toughness becomes 0, that creature is put into its owner's graveyard."""@en ] .

