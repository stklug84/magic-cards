    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """Key to the City's last ability triggers during your untap step, but it's put onto the stack at the same time as abilities that trigger at the beginning of your upkeep step. Even though Key to the City's ability triggered first, you may order it before or after other abilities you control that are put onto the stack at this time."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """Activating Key to the City's ability targeting a creature that has already been blocked won't cause it to become unblocked."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """You can pay {2} only once each time Key to the City's triggered ability resolves. You can't pay more to draw additional cards."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """You can activate Key to the City's first ability without targeting any creature."""@en ] .

