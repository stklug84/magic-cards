    :hasLanguage :English ;
    :producesMana :Colorless ;
    :hasKeywordAbility :Kicker ;
    :printedText """Multikicker {2} (You may pay an additional {2} any number of times as you cast this spell.)
This artifact enters with a charge counter on it for each time it was kicked.
{T}: Add {C} for each charge counter on this artifact."""@en ;
    :oracleText """Multikicker {2} (You may pay an additional {2} any number of times as you cast this spell.)
This artifact enters with a charge counter on it for each time it was kicked.
{T}: Add {C} for each charge counter on this artifact."""@en ;
    :scryfallUrl "https://scryfall.com/card/fic/343/everflowing-chalice"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """You can cast Everflowing Chalice without kicking it at all if you wish. However, if Everflowing Chalice has no charge counters on it, activating its last ability won't produce any mana."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """To determine a spell's total cost, start with the mana cost (or an alternative cost if another card's effect allows you to pay one instead), add any cost increases (such as kicker), then apply any cost reductions. The spell's mana value remains unchanged, no matter what the total cost to cast it was."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If you copy a kicked spell on the stack, the copy is also kicked. If the copied spell is a permanent spell, the token the copy of that spell becomes when it enters is also kicked."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If a card or token enters as a copy of a permanent, the new permanent isn't kicked, even if the original was."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If you put a permanent with a kicker ability onto the battlefield without casting it, you can't kick it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If a spell's kicker cost was paid, the spell is "kicked.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """The kicker ability doesn't let you pay a kicker cost more than once."""@en ] .

