@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@prefix :     <urn:stklug84:MagicCardsOntology:2026-02-27#> .
@base         <urn:stklug84:MagicCardIndividuals:EA1:2026-07-19#> .

################################################################################
#
# Ontology Definition
#
################################################################################

<urn:stklug84:MagicCardIndividuals:EA1:2026-07-19#>
    rdf:type owl:Ontology ;
    owl:imports <urn:stklug84:MagicCardsOntology:2026-02-27#> ;
    rdfs:label "Magic Card Collection Individuals – Explorer Anthology 1"@en ;
    rdfs:comment """An instance graph describing the card individuals of a
personal Magic: The Gathering card collection that were printed in the set
Explorer Anthology 1 (EA1). One Card individual is defined per printing
collected in paper or on MTG Arena, carrying its characteristics, the
platforms it is available on
(paper, MTG Arena, Magic Online) with its MTG Arena identity, its legality
in the paper and MTG Arena formats, and official rulings. Card data was
sourced from Gatherer and Scryfall. This file imports MagicCardsOntology to
reuse all existing class, property, set, keyword, subtype, format and
legality definitions."""@en .


################################################################################
#
# Card Individuals
#
################################################################################

:ElvishMystic rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Elvish Mystic" ;
    :manaCost "{G}" ;
    :manaValue "1"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Elf ,
                :Druid ;
    :hasRarity :Common ;
    :hasColor :Green ;
    :hasColorIdentity :Green ;
    :isInSet :ExplorerAnthology1 ;
    :cardNumber "13"^^xsd:integer ;
    :artist "Wesley Burt" ;
    :hasLanguage :English ;
    :producesMana :Green ;
    :power "1" ;
    :powerValue "1"^^xsd:integer ;
    :toughness "1" ;
    :toughnessValue "1"^^xsd:integer ;
    :printedText """{T}: Add {G}."""@en ;
    :oracleText """{T}: Add {G}."""@en ;
    :flavorText """"Life grows everywhere. My kin merely find those places where it grows strongest."
—Nissa Revane"""@en ;
    :scryfallUrl "https://scryfall.com/card/ea1/13/elvish-mystic"^^xsd:anyURI ;
    :isAvailableOn :MTGArena ;
    :arenaId "54163"^^xsd:positiveInteger ;
    :arenaName "Elvish Mystic" ;
    :arenaSetCode "M14" ;
    :arenaCollectorNumber "169" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] .
