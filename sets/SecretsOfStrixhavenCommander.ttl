:BrudicladTelchorEngineer rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Brudiclad, Telchor Engineer" ;
    :manaCost "{4}{U}{R}" ;
    :manaValue "6"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Artifact ;
    :hasCardType :Creature ;
    :hasSubType :Phyrexian ;
    :hasSubType :Artificer ;
    :hasRarity :MythicRare ;
    :hasColor :Red ;
    :hasColor :Blue ;
    :hasColorIdentity :Red ;
    :hasColorIdentity :Blue ;
    :isInSet :SecretsOfStrixhavenCommander ;
    :cardNumber "299"^^xsd:integer ;
    :artist "Daarken" ;
    :hasLanguage :English ;
    :power "4" ;
    :powerValue "4"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :printedText """Creature tokens you control have haste.
At the beginning of combat on your turn, create a 2/1 blue Phyrexian Myr artifact creature token. Then you may choose a token you control. If you do, each other token you control becomes a copy of that token."""@en ;
    :oracleText """Creature tokens you control have haste.
At the beginning of combat on your turn, create a 2/1 blue Phyrexian Myr artifact creature token. Then you may choose a token you control. If you do, each other token you control becomes a copy of that token."""@en ;
    :scryfallUrl "https://scryfall.com/card/soc/299/brudiclad-telchor-engineer"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """Once a creature token that came under your control this turn has legally attacked, causing it to lose haste by removing Brudiclad from the battlefield won't cause that token to stop attacking."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """All other tokens you control become a copy of the chosen token, even those that aren't of the same type. For example, if you control a Treasure artifact token and choose the Myr token Brudiclad just created, your Treasure will become a copy of the Myr."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """The effect of Brudiclad's triggered ability lasts indefinitely. It continues to apply after Brudiclad leaves the game."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Brudiclad copies only the values defined as the original token was created (unless that token is copying something else; see below). It doesn't copy whether that token is tapped or untapped, whether it has any counters on it or any Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, or so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """The last effect of Brudiclad's triggered ability affects all tokens you control other than the chosen token, including the token that was just created if that isn't the chosen token."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """If the chosen token is copying something else (for example, if the chosen token was previously affected by Brudiclad's triggered ability), then your tokens become copies of whatever the chosen token copied."""@en ] .

:DinaSoulSteeper rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Dina, Soul Steeper" ;
    :manaCost "{B}{G}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Dryad ;
