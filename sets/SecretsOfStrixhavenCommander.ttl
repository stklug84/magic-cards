:NexusMentality rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Nexus Mentality" ;
    :manaCost "{3}{U}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :SecretsOfStrixhavenCommander ;
    :cardNumber "21"^^xsd:integer ;
    :artist "Lie Setiawan" ;
    :hasLanguage :English ;
    :printedText """Choose one. If you control a commander as you cast this spell, you may choose both instead.
• Move all counters from target nonland permanent you control onto another target nonland permanent you control.
• Remove all counters from target nonland permanent you control. Draw a card for each counter removed this way."""@en ;
    :oracleText """Choose one. If you control a commander as you cast this spell, you may choose both instead.
• Move all counters from target nonland permanent you control onto another target nonland permanent you control.
• Remove all counters from target nonland permanent you control. Draw a card for each counter removed this way."""@en ;
    :scryfallUrl "https://scryfall.com/card/soc/21/nexus-mentality"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-03-20"^^xsd:date ;
        :rulingText """There's no extra bonus if you control more than one commander."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-03-20"^^xsd:date ;
        :rulingText """Once you've announced that you're casting a spell, players can't take any actions until you've finished doing so. Notably, opponents can't try to remove your commander to change how many modes you may choose."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-03-20"^^xsd:date ;
        :rulingText """The commander you control doesn't have to be your commander."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-03-20"^^xsd:date ;
        :rulingText """To move a counter from one permanent to another, the counter is removed from the first permanent and put onto the second. Any abilities that care about a counter being removed from or placed on a permanent will apply."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-03-20"^^xsd:date ;
        :rulingText """Once you've chosen both modes for the spell, it doesn't matter whether you continue to control a commander. This is true even if you somehow no longer control a commander as you finish casting the spell."""@en ] .

:EldraziConscriptionSecretsOfStrixhavenCommander131 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Eldrazi Conscription" ;
    :manaCost "{8}" ;
    :manaValue "8"^^xsd:nonNegativeInteger ;
    :hasCardType :Kindred ,
                 :Enchantment ;
    :hasSubType :Eldrazi ,
                :Aura ;
    :hasRarity :Rare ;
    :isInSet :SecretsOfStrixhavenCommander ;
    :cardNumber "131"^^xsd:integer ;
    :artist "Jaime Jones" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Enchant ;
    :printedText """Enchant creature
Enchanted creature gets +10/+10 and has trample and annihilator 2. (Whenever it attacks, defending player sacrifices two permanents of their choice.)"""@en ;
    :oracleText """Enchant creature
Enchanted creature gets +10/+10 and has trample and annihilator 2. (Whenever it attacks, defending player sacrifices two permanents of their choice.)"""@en ;
    :flavorText """The barest taste of Eldrazi power shatters both realms and identities."""@en ;
    :scryfallUrl "https://scryfall.com/card/soc/131/eldrazi-conscription"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2010-06-15"^^xsd:date ;
        :rulingText """Annihilator abilities trigger and resolve during the declare attackers step. The defending player chooses and sacrifices the required number of permanents before they declare blockers. Any creatures sacrificed this way won't be able to block."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2010-06-15"^^xsd:date ;
        :rulingText """Eldrazi Conscription is an Eldrazi. However, it doesn't turn the enchanted creature into an Eldrazi."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2010-06-15"^^xsd:date ;
        :rulingText """If a creature with annihilator is attacking a planeswalker, and the defending player chooses to sacrifice that planeswalker, the attacking creature continues to attack. It may be blocked. If it isn't blocked, it simply won't deal combat damage to anything."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-12-07"^^xsd:date ;
        :rulingText """If a creature has multiple instances of annihilator, each triggers separately when that creature attacks."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Kindred is a card type that allows noncreature cards to have creature types. For example, Echoes of Eternity is an Eldrazi (although not a creature) while on the battlefield and an Eldrazi card (although not a creature card) in zones other than the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """While it appears only on cards that already have other card types, kindred is a card type and will be counted by effects that refer to the number of card types among cards in a zone."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """This card was originally printed with the "tribal" card type. That card type has been replaced with "kindred". This change does not affect the gameplay function of this card."""@en ] .

