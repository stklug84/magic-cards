    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Human ;
    :hasSubType :Rogue ;
    :hasSubType :Ally ;
    :hasRarity :Uncommon ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :SecretsOfStrixhavenCommander ;
    :cardNumber "233"^^xsd:integer ;
    :artist "Jason Rainville" ;
    :hasLanguage :English ;
    :power "1" ;
    :powerValue "1"^^xsd:integer ;
    :toughness "1" ;
    :toughnessValue "1"^^xsd:integer ;
    :printedText """Whenever this creature or another creature you control dies, each opponent loses 1 life and you gain 1 life."""@en ;
    :oracleText """Whenever this creature or another creature you control dies, each opponent loses 1 life and you gain 1 life."""@en ;
    :flavorText """"Eldrazi? Ha! Try walking through Zulaport at night with your pockets full. Now *that's* dangerous.\""""@en ;
    :scryfallUrl "https://scryfall.com/card/soc/233/zulaport-cutthroat"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
