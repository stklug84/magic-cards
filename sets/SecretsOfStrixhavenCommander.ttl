    :hasColorIdentity :Green ;
    :isInSet :SecretsOfStrixhavenCommander ;
    :cardNumber "305"^^xsd:integer ;
    :artist "Chris Rahn" ;
    :hasLanguage :English ;
    :power "1" ;
    :powerValue "1"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    :printedText """Whenever you gain life, each opponent loses 1 life.
{1}, Sacrifice another creature: Dina gets +X/+0 until end of turn, where X is the sacrificed creature's power."""@en ;
    :oracleText """Whenever you gain life, each opponent loses 1 life.
{1}, Sacrifice another creature: Dina gets +X/+0 until end of turn, where X is the sacrificed creature's power."""@en ;
    :scryfallUrl "https://scryfall.com/card/soc/305/dina-soul-steeper"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-04-16"^^xsd:date ;
        :rulingText """Each creature with lifelink dealing combat damage causes a separate life gain event. For example, if two creatures you control with lifelink deal combat damage at the same time, a "whenever you gain life" ability will trigger twice. However, if a single creature you control with lifelink deals combat damage to multiple creatures, players, and/or planeswalkers at the same time (perhaps because it has trample or was blocked by more than one creature), the ability will trigger only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-04-16"^^xsd:date ;
        :rulingText """Dina's first ability triggers only once for each life gain event, no matter how much life was gained."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-04-16"^^xsd:date ;
        :rulingText """When Dina's first ability resolves, each opponent loses only 1 life, no matter how much life was gained."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-04-16"^^xsd:date ;
        :rulingText """X is the power the creature had when it was on the battlefield, not the power it has in the graveyard."""@en ] .

:TempleOfMystery rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Temple of Mystery" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Land ;
    :hasRarity :Rare ;
    :hasColorIdentity :Green ;
    :hasColorIdentity :Blue ;
    :isInSet :SecretsOfStrixhavenCommander ;
    :cardNumber "414"^^xsd:integer ;
    :artist "Piotr Dura" ;
    :hasLanguage :English ;
    :printedText """This land enters tapped.
When this land enters, scry 1. (Look at the top card of your library. You may put that card on the bottom.)
{T}: Add {G} or {U}."""@en ;
    :oracleText """This land enters tapped.
When this land enters, scry 1. (Look at the top card of your library. You may put that card on the bottom.)
{T}: Add {G} or {U}."""@en ;
    # Note: keyword "Scry" not defined in MagicCardsOntology
    :scryfallUrl "https://scryfall.com/card/soc/414/temple-of-mystery"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2013-09-15"^^xsd:date ;
        :rulingText """When you scry, you may put all the cards you look at back on top of your library, you may put all of those cards on the bottom of your library, or you may put some of those cards on top and the rest of them on the bottom."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-09-15"^^xsd:date ;
        :rulingText """You choose how to order cards returned to your library after scrying no matter where you put them."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-09-15"^^xsd:date ;
        :rulingText """You perform the actions stated on a card in sequence. For some spells and abilities, that means you'll scry last. For others, that means you'll scry and then perform other actions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-09-15"^^xsd:date ;
        :rulingText """Scry appears on some spells and abilities with one or more targets. If all of the spell or ability's targets are illegal when it tries to resolve, it won't resolve and none of its effects will happen. You won't scry."""@en ] .
