################################################################################
#
# Ontology Definition
#
################################################################################

<urn:stklug84:MagicCardIndividuals:DBL:2026-07-19#>
    rdf:type owl:Ontology ;
    owl:imports <urn:stklug84:MagicCardsOntology:2026-02-27#> ;
    rdfs:label "Magic Card Collection Individuals – Innistrad: Double Feature"@en ;
    rdfs:comment """An instance graph describing the card individuals of a
personal Magic: The Gathering card collection that were printed in the set
Innistrad: Double Feature (DBL). One Card individual is defined per collected
printing, carrying its characteristics, the platforms it is available on
(paper, MTG Arena, Magic Online) with its MTG Arena identity, its legality
in the paper and MTG Arena formats, and official rulings. Card data was
sourced from Gatherer and Scryfall. This file imports MagicCardsOntology to
reuse all existing class, property, set, keyword, subtype, format and
legality definitions."""@en .


################################################################################
#
# Card Individuals
#
################################################################################

:InvestigatorsJournalInnistradDoubleFeature525 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Investigator's Journal" ;
    :manaCost "{2}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasSubType :Book ,
                :Clue ;
    :hasRarity :Rare ;
    :isInSet :InnistradDoubleFeature ;
    :cardNumber "525"^^xsd:integer ;
    :artist "Yeong-Hao Han" ;
    :hasLanguage :English ;
    :printedText """This artifact enters with a number of suspect counters on it equal to the greatest number of creatures a player controls.
{2}, {T}, Remove a suspect counter from this artifact: Draw a card.
{2}, Sacrifice this artifact: Draw a card."""@en ;
    :oracleText """This artifact enters with a number of suspect counters on it equal to the greatest number of creatures a player controls.
{2}, {T}, Remove a suspect counter from this artifact: Draw a card.
{2}, Sacrifice this artifact: Draw a card."""@en ;
    :scryfallUrl "https://scryfall.com/card/dbl/525/investigators-journal"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-11-19"^^xsd:date ;
        :rulingText """You don't choose an opponent to determine how many suspect counters are placed on Investigator's Journal as it enters the battlefield. You always use the greatest number possible."""@en ] .
