    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """If an Aura is exiled this way, its owner chooses what it will enchant as it returns to the battlefield. An Aura put onto the battlefield this way doesn’t target anything (so it could be attached to an opponent’s permanent with hexproof, for example) , but the Aura’s enchant ability restricts what it can be attached to. If the Aura can’t legally be attached to anything, it remains in exile for the rest of the game."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """Auras attached to the exiled permanent will be put into their owners’ graveyards. Any Equipment will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist. When the card returns to the battlefield, it will be a new object with no connection to the card that was exiled."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """If Seam Rip leaves the battlefield before its triggered ability resolves, the target permanent won’t be exiled."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """If a permanent has {X} in its mana cost, X is 0 for the purpose of determining its mana value."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """If a token is exiled this way, it will cease to exist and won’t return to the battlefield."""@en ] .

