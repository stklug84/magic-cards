    :printedText """This creature enters with a +1/+1 counter on it.
When this creature dies, put its counters on target creature you control."""@en ;
    :oracleText """This creature enters with a +1/+1 counter on it.
When this creature dies, put its counters on target creature you control."""@en ;
    :flavorText """Eternity columns are the trade hubs of every solar system."""@en ;
    :scryfallUrl "https://scryfall.com/card/eoe/11/dockworker-drone"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """Dockworker Drone’s second ability puts all counters that were on Dockworker Drone onto the target creature, not just its +1/+1 counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """If enough -1/-1 counters are put on Dockworker Drone at the same time to make its toughness 0 or less, its second ability will see all of the +1/+1 counters it had when it died as well as the -1/-1 counters it had, and an equal number of each of those types of counters (plus any other applicable counters) will be put onto the target creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """In some unusual cases, you may end up putting the appropriate counters on more than one permanent. For example, if you control The Ozolith (a card from the Ikoria: Lair of Behemoths set) when Dockworker Drone dies, you’ll put the appropriate number of each kind of counter onto both The Ozolith and the target creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """If Dockworker Drone has -1/-1 counters on it when it dies, that ability will include those as well. This may result in the recipient of the counters dying."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """Dockworker Drone’s second ability doesn’t cause you to move counters from Dockworker Drone onto the target creature. Rather, you put the same number of each kind of counter Dockworker Drone had when it died onto the target creature."""@en ] .

