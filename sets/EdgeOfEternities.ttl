    :oracleText """When this enchantment enters, exile target nonland permanent an opponent controls until this enchantment leaves the battlefield."""@en ;
    :flavorText """"Stygian demon! You are sentenced to ten cycles of illumination. May the light scour the shadow from your soul.\""""@en ;
    :scryfallUrl "https://scryfall.com/card/eoe/6/banishing-light"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
