:OinTheBrave rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Óin the Brave" ;
    :manaCost "{1}{R}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Dwarf ,
                :Warrior ;
    :hasRarity :Common ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :TheHobbit ;
    :cardNumber "106"^^xsd:integer ;
    :artist "Colin Boyer" ;
    :hasLanguage :English ;
    :power "1" ;
    :powerValue "1"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    :hasKeywordAbility :Storied ;
    :printedText """Storied (If you control three or more artifacts, legendaries, and/or Sagas, you have an enduring story for the rest of the game.)
As long as you have an enduring story, Óin gets +1/+0 and has haste.
{1}, {T}, Discard a card: Draw a card."""@en ;
    :oracleText """Storied (If you control three or more artifacts, legendaries, and/or Sagas, you have an enduring story for the rest of the game.)
As long as you have an enduring story, Óin gets +1/+0 and has haste.
{1}, {T}, Discard a card: Draw a card."""@en ;
    :flavorText """When the heart of a Dwarf is wakened by gold, he grows suddenly bold and fierce."""@en ;
    :scryfallUrl "https://scryfall.com/card/hob/106/%C3%B3in-the-brave"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "103484"^^xsd:positiveInteger ;
    :arenaName "Óin the Brave" ;
    :arenaSetCode "HOB" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-06-29"^^xsd:date ;
        :rulingText """If you control three legendary, Saga, and/or artifact permanents but don't control a permanent with storied, you don't get an enduring story. For example, if you controlled three artifacts, lost control of two, then cast Thorin Oakenshield, you won't have an enduring story."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-06-29"^^xsd:date ;
        :rulingText """A single permanent can only count once toward the three legendary, Saga, and/or artifact permanents needed to get an enduring story, even if it has more than one of those qualities. If you control one permanent that is a legendary artifact and a second permanent that is a Saga, you will only have two of the three permanents required to get an enduring story."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-06-29"^^xsd:date ;
        :rulingText """Once you have an enduring story, you have it for the rest of the game, even if you lose control of some or all of your storied permanents. The enduring story designation is on the player and can't be removed by any effect."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-06-29"^^xsd:date ;
        :rulingText """If your third legendary, Saga, or artifact permanent enters the battlefield and then one of those permanents leaves the battlefield immediately afterwards (most likely due to the "legend rule" or due to being a creature with 0 toughness), you get an enduring story before it leaves the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-06-29"^^xsd:date ;
        :rulingText """A permanent is any object on the battlefield, including tokens and lands. Spells and emblems aren't permanents."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-06-29"^^xsd:date ;
        :rulingText """Storied isn't a triggered ability and doesn't use the stack. Players can respond to a spell that will give you your third legendary, Saga, and/or artifact permanent, but they can't respond to you getting an enduring story once you control that third permanent."""@en ] .

