    :hasCardType :Creature ;
    :hasSubType :Insect ,
                :Adventure ;
    :hasRarity :Common ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :TheHobbit ;
    :cardNumber "30"^^xsd:integer ;
    :artist "Xabi Gaztelua" ;
    :hasLanguage :English ;
    :power "2" ;
