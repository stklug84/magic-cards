:BardKingOfDale rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Bard, King of Dale" ;
    :manaCost "{4}{W}{U}" ;
    :manaValue "6"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Human ,
                :Noble ,
                :Archer ;
    :hasRarity :MythicRare ;
    :hasColor :White ,
              :Blue ;
    :hasColorIdentity :White ,
                      :Blue ;
    :isInSet :TheHobbit ;
    :cardNumber "144"^^xsd:integer ;
    :artist "Xabi Gaztelua" ;
    :hasLanguage :English ;
    :power "3" ;
    :powerValue "3"^^xsd:integer ;
    :toughness "5" ;
    :toughnessValue "5"^^xsd:integer ;
    :hasKeywordAbility :Reach ,
                       :Vigilance ;
    :printedText """Reach, vigilance
If you would draw a card except the first one you draw in each of your draw steps, draw two cards instead.
If one or more tokens would be created under your control, twice that many of those tokens are created instead."""@en ;
    :oracleText """Reach, vigilance
If you would draw a card except the first one you draw in each of your draw steps, draw two cards instead.
If one or more tokens would be created under your control, twice that many of those tokens are created instead."""@en ;
    :scryfallUrl "https://scryfall.com/card/hob/144/bard-king-of-dale"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "103524"^^xsd:positiveInteger ;
    :arenaName "Bard, King of Dale" ;
    :arenaSetCode "HOB" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-06-29"^^xsd:date ;
        :rulingText """If an effect creates more than one kind of token, it'll create twice as many of each kind. For example, if you control Bilbo, Fellow Conspirator and Bard, King of Dale and you create a Food token, you'll create two Food tokens and two Treasure tokens (regardless of the order you chose to apply the replacement effects)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-06-29"^^xsd:date ;
        :rulingText """Because Bard, King of Dale is legendary, it's unlikely that one player will control two. However, if that happens, cards drawn by that player will be multiplied by four. Three Bards will multiply by eight, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-06-29"^^xsd:date ;
        :rulingText """Bard's last ability only applies to tokens that are created. Copies of permanent spells that resolve become tokens on the battlefield, but those tokens are not created and will not be doubled by Bard's ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-06-29"^^xsd:date ;
        :rulingText """If two or more replacement effects would apply to a card-drawing event, the player drawing the card chooses the order in which to apply them."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-06-29"^^xsd:date ;
        :rulingText """Similarly, the effect of the last ability on multiple Bard, King of Dale is cumulative. If you control two, you'll create four times the number of tokens."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-06-29"^^xsd:date ;
        :rulingText """If the effect creating the tokens instructs you to do something with those tokens at a later time, like exiling them at the end of combat, you'll do that for all the tokens."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-06-29"^^xsd:date ;
        :rulingText """If you control Bard, King of Dale and create an Army token because you amass and didn't already control an Army, you will create two Army tokens. However, since you can only put the counters on one of the tokens, the other remains a 0/0 creature and will be put into its owner's graveyard the next time state-based actions are checked."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-06-29"^^xsd:date ;
        :rulingText """For Bard's last ability, all of the tokens enter the battlefield simultaneously. They'll be created with the same name, color, type and subtype, abilities, power, toughness, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-06-29"^^xsd:date ;
        :rulingText """If the token you create has any "as [this permanent] enters" or "[this permanent] enters with" abilities, first determine how many tokens are being created, then apply those abilities individually for each one. For example, if a token with "You may have [this permanent] enter as a copy of any creature on the battlefield" would be created (such as an embalmed Vizier of Many Faces), the resulting two tokens can each copy a different creature."""@en ] .

