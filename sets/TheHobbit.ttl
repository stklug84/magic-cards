:ConfusticateAndBebother rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Confusticate and Bebother" ;
    :manaCost "{2}{U}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Common ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :TheHobbit ;
    :cardNumber "35"^^xsd:integer ;
    :artist "Colin Boyer" ;
