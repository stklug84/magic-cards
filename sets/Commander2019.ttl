:GhiredConclaveExile rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Ghired, Conclave Exile" ;
    :manaCost "{2}{R}{G}{W}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Human ,
                :Shaman ;
    :hasRarity :MythicRare ;
    :hasColor :White ,
              :Red ,
              :Green ;
    :hasColorIdentity :White ,
                      :Red ,
                      :Green ;
    :isInSet :Commander2019 ;
    :cardNumber "42"^^xsd:integer ;
    :artist "Yongjae Choi" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "5" ;
    :toughnessValue "5"^^xsd:integer ;
    :hasKeywordAction :Populate ;
    :printedText """When Ghired enters, create a 4/4 green Rhino creature token with trample.
Whenever Ghired attacks, populate. The token enters tapped and attacking. (To populate, create a token that's a copy of a creature token you control.)"""@en ;
    :oracleText """When Ghired enters, create a 4/4 green Rhino creature token with trample.
Whenever Ghired attacks, populate. The token enters tapped and attacking. (To populate, create a token that's a copy of a creature token you control.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=470588"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/c19/42/ghired-conclave-exile"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2019-08-23"^^xsd:date ;
        :rulingText """In some rare cases, you might copy a creature token that isn't normally a creature. This token enters the battlefield as a noncreature permanent. It will be tapped but it won't be attacking."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-08-23"^^xsd:date ;
        :rulingText """Any effects that say that the token can't attack (such as that of Doomed Artisan, or if you copy a token with defender) affect only the declaration of attackers. They won't stop the token you populate from entering the battlefield attacking."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-08-23"^^xsd:date ;
        :rulingText """You choose which player or planeswalker the created token is attacking. It doesn't have to be attacking the same player or planeswalker that Ghired is attacking."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-08-23"^^xsd:date ;
        :rulingText """Although the token is an attacking creature, it was never declared as an attacking creature. This means that abilities that trigger whenever a creature attacks won't trigger when it enters the battlefield attacking."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """If you control no creature tokens when you populate, nothing will happen."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """The new creature token copies the characteristics of the original token as stated by the effect that created the original token."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """The new token doesn't copy whether the original token is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, or any noncopy effects that have changed its power, toughness, color, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Populate doesn't target the creature token you're copying. You choose that creature token as you're taking the populate action. You can choose any creature token you control. If a spell or ability causes you to create a creature token and then instructs you to populate, you may choose to copy the token you just created, or you may choose to copy another creature token you control."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Any enters-the-battlefield abilities of the copied token will trigger when the new token enters the battlefield. Any "as [this creature] enters the battlefield" or "[this creature] enters the battlefield with" abilities of the copied token will also work."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """If you choose to copy a creature token that's a copy of another creature, the new creature token will copy the characteristics of whatever the original token is copying."""@en ] .

