        :rulingText """If you create a copy of a spell on the stack and target a creature you control with a valiant ability, that ability will trigger as long as the creature hasn't yet been the target of a spell or ability you control this turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
