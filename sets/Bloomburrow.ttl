    :oracleText """Valiant — Whenever this creature becomes the target of a spell or ability you control for the first time each turn, you may discard a card. If you do, draw a card."""@en ;
    :flavorText """"Unneeded words are like dandelion seeds—cast adrift at the slightest whiff of scrutiny, only to find purchase and thrive where you least expect."
—Myrtle, Valley scribe"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=669075"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/blb/161/whiskerquill-scribe"^^xsd:anyURI ;
