:NocturnalHunger rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Nocturnal Hunger" ;
    :manaCost "{2}{B}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Common ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :Bloomburrow ;
    :cardNumber "102"^^xsd:integer ;
    :artist "Sam Guay" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Gift ;
    # Note: keyword "Food" not defined in MagicCardsOntology
    :printedText """Gift a Food (You may promise an opponent a gift as you cast this spell. If you do, they create a Food token before its other effects. It's an artifact with "{2}, {T}, Sacrifice this token: You gain 3 life.")
Destroy target creature. If the gift wasn't promised, you lose 2 life."""@en ;
    :oracleText """Gift a Food (You may promise an opponent a gift as you cast this spell. If you do, they create a Food token before its other effects. It's an artifact with "{2}, {T}, Sacrifice this token: You gain 3 life.")
Destroy target creature. If the gift wasn't promised, you lose 2 life."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=669016"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/blb/102/nocturnal-hunger"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "91638"^^xsd:positiveInteger ;
    :arenaName "Nocturnal Hunger" ;
    :arenaSetCode "BLB" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """For instants and sorceries with gift, the gift is given to the appropriate opponent as part of the resolution of the spell. This happens before any of the spell's other effects would take place."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """If a spell for which the gift was promised is countered, doesn't resolve (perhaps because all of its targets are illegal), or is otherwise removed from the stack, the gift won't be given. None of its other effects will happen either."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """As an additional cost to cast a spell with gift, you can promise the listed gift to an opponent. That opponent is chosen as part of that additional cost. The gift isn't given at this time; rather, it's given at a later time based on whether or not the spell is a permanent spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """Some instant or sorcery spells require alternative or additional targets if the gift was promised. You ignore these targeting requirements if the gifts aren't promised for those spells. On the other hand, you can promise a gift for a permanent spell even if you won't be able to choose targets for an enters ability of that permanent once the spell resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """For permanent spells with gift, an ability triggers when that permanent enters if the gift was promised. When that ability resolves, the gift is given to the appropriate opponent."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """In the main set, there are four different kinds of gifts. "Gift a Food" causes the chosen opponent to create a Food token, while "Gift a Treasure" causes the chosen opponent to create a Treasure token. "Gift a card" causes them to draw a card, and "Gift a tapped Fish" causes them to create a tapped 1/1 blue Fish creature token. The Commander decks contain two more kinds of gifts: "Gift an Octopus," which causes the chosen opponent to create an 8/8 blue Octopus creature token, and "Gift an extra turn," which causes them to take an extra turn after the current turn ends."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """If you copy a spell for which the gift was promised, the gift was also promised to the same opponent for the copy. If a card or token enters as a copy of a permanent that's already on the battlefield, the gift isn't promised for that new permanent, even if it was promised for the original."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """You can't pay a gift cost more than once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """You can't sacrifice a Food to pay multiple costs. For example, you can't sacrifice a Food token to activate its own ability and also to activate Maraleaf Rider's ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Food is an artifact type. Even though it appears on some creatures, it's never a creature type."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Whatever you do, don't eat the delicious cards."""@en ] .

:OsteomancerAdept rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Osteomancer Adept" ;
    :manaCost "{1}{B}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Squirrel ,
                :Warlock ;
    :hasRarity :Rare ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :Bloomburrow ;
    :cardNumber "103"^^xsd:integer ;
    :artist "Daniel Zrom" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "2" ;
    :toughnessValue "2"^^xsd:integer ;
    :hasKeywordAbility :Deathtouch ;
    :printedText """Deathtouch
{T}: Until end of turn, you may cast creature spells from your graveyard by foraging in addition to paying their other costs. If you cast a spell this way, that creature enters with a finality counter on it. (To forage, exile three cards from your graveyard or sacrifice a Food. If a creature with a finality counter on it would die, exile it instead.)"""@en ;
    :oracleText """Deathtouch
{T}: Until end of turn, you may cast creature spells from your graveyard by foraging in addition to paying their other costs. If you cast a spell this way, that creature enters with a finality counter on it. (To forage, exile three cards from your graveyard or sacrifice a Food. If a creature with a finality counter on it would die, exile it instead.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=669017"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/blb/103/osteomancer-adept"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "91639"^^xsd:positiveInteger ;
    :arenaName "Osteomancer Adept" ;
    :arenaSetCode "BLB" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """You must still follow timing restrictions and permissions for creature spells you cast with the permission granted by Osteomancer Adept's last ability. Normally, you'll be able to cast them only during your main phase while the stack is empty."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """If you don't have enough cards in your graveyard or a Food on the battlefield, you can't choose to forage."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """Multiple finality counters on a single permanent are redundant."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """Finality counters aren't keyword counters, and a finality counter doesn't give any abilities to the permanent it's on. If that permanent loses its abilities and then would go to a graveyard, it will still be exiled instead."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """If Dryad Arbor (the only card that's both a creature and a land) is in your graveyard, you can't play it this way. Dryad Arbor can't be cast as a spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """Finality counters work on any permanent, not only creatures. If a permanent with a finality counter on it would be put into a graveyard from the battlefield, exile it instead."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """Once you announce that you're casting a spell or activating an ability, players can't take actions until you've finished doing so. Notably, opponents can't try to remove cards from your graveyard or Foods you control to stop you from foraging."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """Finality counters don't stop permanents from going to zones other than the graveyard from the battlefield. For example, if a permanent with a finality counter on it would be put into its owner's hand from the battlefield, it does so normally."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Food is an artifact type. Even though it appears on some creatures, it's never a creature type."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """You can't sacrifice a Food to pay multiple costs. For example, you can't sacrifice a Food token to activate its own ability and also to activate Maraleaf Rider's ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Whatever you do, don't eat the delicious cards."""@en ] .

