:TraverseTheUlvenwald rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Traverse the Ulvenwald" ;
    :manaCost "{G}" ;
    :manaValue "1"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Rare ;
    :hasColor :Green ;
    :hasColorIdentity :Green ;
    :isInSet :InnistradRemastered ;
    :cardNumber "221"^^xsd:integer ;
    :artist "Vincent Proce" ;
    :hasLanguage :English ;
    # Note: keyword "Delirium" not defined in MagicCardsOntology
    :printedText """Search your library for a basic land card, reveal it, put it into your hand, then shuffle.
Delirium — If there are four or more card types among cards in your graveyard, instead search your library for a creature or land card, reveal it, put it into your hand, then shuffle."""@en ;
    :oracleText """Search your library for a basic land card, reveal it, put it into your hand, then shuffle.
Delirium — If there are four or more card types among cards in your graveyard, instead search your library for a creature or land card, reveal it, put it into your hand, then shuffle."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=686068"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/inr/221/traverse-the-ulvenwald"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2016-04-08"^^xsd:date ;
        :rulingText """Some delirium abilities that appear on instants and sorceries use the word "instead." These spells have an upgraded effect when they resolve if there are four or more card types among cards in your graveyard. They check that number only while they're resolving and don't count themselves, since they aren't in your graveyard yet. You only get the upgraded effect, not both effects."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """Some delirium abilities that appear on instants and sorceries use the word “instead.” These spells have an upgraded effect when they resolve if there are four or more card types among cards in your graveyard. They check that number only while they’re resolving and don’t count themselves, since they aren’t in your graveyard yet. You only get the upgraded effect, not both effects."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """The number of card types matters, not the number of cards. For example, Epitaph Golem (an artifact creature) along with Memory Deluge (an instant) and Travel Preparations (a sorcery) will enable delirium."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """The card types that could appear in your graveyard are artifact, battle, creature, enchantment, instant, kindred, land, planeswalker, and sorcery. Supertypes (such as legendary and basic) and subtypes (such as Human and Equipment) are not counted."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """Because you consider only the characteristics of a double-faced card’s front face while it’s not on the battlefield, the types of its back face won’t be counted for delirium."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """The delirium ability of Traverse the Ulvenwald allows you to find a nonbasic land card."""@en ] .

