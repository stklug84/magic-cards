    :isInSet :InnistradRemastered ;
    :cardNumber "79"^^xsd:integer ;
    :artist "Billy Christian" ;
    :hasLanguage :English ;
    :printedText """Whenever a nontoken Zombie you control enters, create a token that's a copy of that creature."""@en ;
    :oracleText """Whenever a nontoken Zombie you control enters, create a token that's a copy of that creature."""@en ;
    :flavorText """"Geralf's prowess continues to grow. He can now replicate my own creations with near-perfect accuracy."
—Ludevic's laboratory notes"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=685906"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/inr/79/necroduality"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """The token copies exactly what was printed on the original permanent and nothing else (unless that permanent is copying something else; see below). It doesn’t copy whether that permanent is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, or so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """If the copied permanent is copying something else, then the token enters as whatever that permanent copied."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """Any “enters” abilities of the copied permanent will trigger when the token enters. Any “as [this permanent] enters” or “[this permanent] enters with” abilities of the copied permanent will also work."""@en ] .

