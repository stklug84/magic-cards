    :hasCardType :Sorcery ;
    :hasRarity :Rare ;
    :hasColor :Black ;
    :hasColor :Green ;
    :hasColorIdentity :Black ;
    :hasColorIdentity :Green ;
    :isInSet :InnistradRemastered ;
    :cardNumber "244"^^xsd:integer ;
    :artist "Chris Rallis" ;
    :hasLanguage :English ;
    :printedText """Destroy target nonland permanent and all other permanents with the same name as that permanent."""@en ;
    :oracleText """Destroy target nonland permanent and all other permanents with the same name as that permanent."""@en ;
    :flavorText """"I can't abide shoddy work. Whose are these?"
—Ghoulcaller Gisa"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=686094"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/inr/244/maelstrom-pulse"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """Maelstrom Pulse has only one target. Other permanents with the same name will be destroyed even if they have hexproof or protection."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """If the target permanent is an illegal target by the time Maelstrom Pulse tries to resolve, the spell won't resolve. You won't destroy any permanents at all. If the target is legal but not destroyed (most likely because it has indestructible), you do destroy other permanents with the same name."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-06-10"^^xsd:date ;
        :rulingText """Unless a token is a copy of another permanent or was explicitly given a name by the effect that created it, its name is the subtypes it was given when it was created plus the word "Token." For example, if an effect creates a 1/1 Soldier creature token, that token is named "Soldier Token.\""""@en ] .

:SigardaHostOfHerons rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Sigarda, Host of Herons" ;
    :manaCost "{2}{G}{W}{W}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Angel ;
    :hasRarity :MythicRare ;
    :hasColor :White ;
    :hasColor :Green ;
    :hasColorIdentity :White ;
    :hasColorIdentity :Green ;
    :isInSet :InnistradRemastered ;
    :cardNumber "247"^^xsd:integer ;
    :artist "Chris Rahn" ;
    :hasLanguage :English ;
    :power "5" ;
    :powerValue "5"^^xsd:integer ;
    :toughness "5" ;
    :toughnessValue "5"^^xsd:integer ;
    :hasKeywordAbility :Flying ;
    :hasKeywordAbility :Hexproof ;
    :printedText """Flying, hexproof
Spells and abilities your opponents control can't cause you to sacrifice permanents."""@en ;
    :oracleText """Flying, hexproof
Spells and abilities your opponents control can't cause you to sacrifice permanents."""@en ;
    :flavorText """Great devotion yields great reward."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=686097"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/inr/247/sigarda-host-of-herons"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2018-12-07"^^xsd:date ;
        :rulingText """As a spell or ability an opponent controls resolves, if it would force you to sacrifice a permanent, you just don't. That part of the effect does nothing. If that spell or ability gives you the option to sacrifice a permanent (as Desecration Demon does), you can't take that option."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-12-07"^^xsd:date ;
        :rulingText """Sigarda's ability affects only sacrifices. It won't stop a creature from dying due to lethal damage or having 0 toughness, and it won't stop a permanent from being put into its owner's graveyard due to the "legend rule." None of these are sacrifices; they're the result of game rules."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-12-07"^^xsd:date ;
        :rulingText """If a spell or ability an opponent controls states that something happens unless you sacrifice a permanent (as Mogis, God of Slaughter does), you can't choose to sacrifice a permanent. On the other hand, if a spell or ability an opponent controls instructs you to sacrifice a permanent unless you perform an action (as Killing Wave does), you can choose whether or not to perform the action. If you don't perform the action, nothing happens, since you can't sacrifice any permanents."""@en ] .

