                  :Card ;
    :cardName "Imprisoned in the Moon" ;
    :manaCost "{2}{U}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasSubType :Aura ;
    :hasRarity :Common ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :InnistradRemastered ;
    :cardNumber "69"^^xsd:integer ;
    :artist "Ryan Alexander Lee" ;
    :hasLanguage :English ;
    :producesMana :Colorless ;
    :hasKeywordAbility :Enchant ;
    :printedText """Enchant creature, land, or planeswalker
Enchanted permanent is a colorless land with "{T}: Add {C}" and loses all other card types and abilities."""@en ;
    :oracleText """Enchant creature, land, or planeswalker
Enchanted permanent is a colorless land with "{T}: Add {C}" and loses all other card types and abilities."""@en ;
    :flavorText """Only one vault was great enough to hold Emrakul."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=685895"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/inr/69/imprisoned-in-the-moon"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2016-07-13"^^xsd:date ;
        :rulingText """The permanent will keep any supertypes it previously had. Notably, if Imprisoned in the Moon is enchanting a legendary permanent, that permanent will continue to be legendary."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-07-13"^^xsd:date ;
        :rulingText """Becoming a land may cause other Auras to become illegally attached. These are put into their owner's graveyard, and any Equipment attached to the land become unattached and remain on the battlefield. Counters on the land remain on it even if they don't do anything."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-07-13"^^xsd:date ;
        :rulingText """If the enchanted permanent is a land and has land types, it retains those types even though it loses any intrinsic mana abilities associated with them. For example, a Plains enchanted by Imprisoned in the Moon is still a Plains, but it can't tap for {W}, only for {C}."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-07-13"^^xsd:date ;
        :rulingText """If you remove Imprisoned in the Moon from a planeswalker after tapping it for mana, you can still activate a loyalty ability of that planeswalker even though it's tapped."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-07-13"^^xsd:date ;
        :rulingText """At the time the permanent becomes enchanted, Imprisoned in the Moon causes it to lose all abilities except the noted mana ability. Any abilities the permanent gains after that point will work normally."""@en ] .

