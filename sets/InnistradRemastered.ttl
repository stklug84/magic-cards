    :oracleText """Escalate {3} (Pay this cost for each mode chosen beyond the first.)
Choose one or both —
• Target creature gets +3/+0 until end of turn.
• Target creature gains first strike until end of turn."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=685981"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/inr/146/borrowed-hostility"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2016-07-13"^^xsd:date ;
        :rulingText """If two of the chosen modes of an escalate spell target a creature, you may choose the same creature for each mode’s target, or choose different creatures. The same is true if the chosen modes target a player (or opponent)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-07-13"^^xsd:date ;
        :rulingText """If one target of an escalate spell becomes illegal, the other targets will still be affected. If all of the targets become illegal, the spell won’t resolve."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-07-13"^^xsd:date ;
        :rulingText """Additional costs don’t affect a spell’s mana value."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-07-13"^^xsd:date ;
        :rulingText """You choose all of your modes at once. You can’t wait to perform one mode’s actions and then decide to choose more modes."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-07-13"^^xsd:date ;
        :rulingText """You can’t choose any one mode multiple times."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-07-13"^^xsd:date ;
        :rulingText """Effects that reduce the cost of spells reduce the total cost, including any escalate costs added."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-07-13"^^xsd:date ;
        :rulingText """If an effect allows you to cast a spell that has escalate without paying its mana cost, you pay escalate costs for that spell if you choose more than one mode."""@en ] .

