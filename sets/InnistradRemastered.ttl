    :manaValue "1"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasSubType :Equipment ;
    :hasRarity :Common ;
    :isInSet :InnistradRemastered ;
    :cardNumber "254"^^xsd:integer ;
    :artist "Scott Chou" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Equip ;
    :printedText """Equipped creature can't be blocked by Vampires or Zombies.
Equipped creature has "{T}, Sacrifice Blazing Torch: Blazing Torch deals 2 damage to any target."
Equip {1} ({1}: Attach to target creature you control. Equip only as a sorcery.)"""@en ;
    :oracleText """Equipped creature can't be blocked by Vampires or Zombies.
Equipped creature has "{T}, Sacrifice Blazing Torch: Blazing Torch deals 2 damage to any target."
Equip {1} ({1}: Attach to target creature you control. Equip only as a sorcery.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=686104"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/inr/254/blazing-torch"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2009-10-01"^^xsd:date ;
        :rulingText """If a Blazing Torch controlled by one player somehow winds up equipping a creature a different player controls, the damage ability can’t be activated by either player. Only the creature’s controller may activate the ability — but since that player can’t sacrifice Blazing Torch (a permanent they don’t control), the ability’s cost can’t be paid."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2009-10-01"^^xsd:date ;
        :rulingText """The source of the damage is Blazing Torch, not the equipped creature. However, the equipped creature’s ability is what targets the permanent or player. If Blazing Torch is equipped to a red creature, for example, the ability couldn’t target a creature with protection from red. It could target a creature with protection from artifacts, but all the damage would be prevented."""@en ] .

