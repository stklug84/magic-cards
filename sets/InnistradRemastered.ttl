:LunarchVeteran rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Lunarch Veteran // Luminous Phantom" ;
    :manaCost "{W}" ;
    :manaValue "1"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Human ;
    :hasSubType :Cleric ;
    :hasSubType :Spirit ;
    :hasRarity :Common ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :InnistradRemastered ;
    :cardNumber "32"^^xsd:integer ;
    :artist "Igor Kieryluk" ;
    :hasLanguage :English ;
    :power "1" ;
    :powerValue "1"^^xsd:integer ;
    :toughness "1" ;
    :toughnessValue "1"^^xsd:integer ;
    :hasKeywordAbility :Flying ;
    :hasKeywordAction :Transform ;
    :hasKeywordAbility :Disturb ;
    :printedText """Whenever another creature you control enters, you gain 1 life.
Disturb {1}{W} (You may cast this card from your graveyard transformed for its disturb cost.)
//
Flying
Whenever another creature you control leaves the battlefield, you gain 1 life.
If Luminous Phantom would be put into a graveyard from anywhere, exile it instead."""@en ;
    :oracleText """Whenever another creature you control enters, you gain 1 life.
Disturb {1}{W} (You may cast this card from your graveyard transformed for its disturb cost.)
//
Flying
Whenever another creature you control leaves the battlefield, you gain 1 life.
If Luminous Phantom would be put into a graveyard from anywhere, exile it instead."""@en ;
    :flavorText """"Even in our darkest times, Avacyn's light still guides us.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=685848"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/inr/32/lunarch-veteran-luminous-phantom"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """When you cast a spell using a card's disturb ability, the card is put onto the stack with its back face up. The resulting spell has all the characteristics of that face."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """If you copy a permanent spell cast this way (perhaps with a card like Double Major), the copy becomes a token that's a copy of the card's back face, even though it isn't itself a double-faced card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """A spell cast this way enters the battlefield with its back face up."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """To determine the total cost of a spell, start with the mana cost or alternative cost (such as a disturb cost) you're paying, add any cost increases, then apply any cost reductions. The mana value of a spell cast using disturb is determined by the mana cost on the front face of the card, no matter what the total cost to cast the spell was. (This is a special rule that applies only to transforming double faced-cards, including ones with disturb.)"""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """Disturb is found only on the front faces of some double-faced cards."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """"Disturb [cost]" means "You may cast this card transformed from your graveyard by paying [cost] rather than its mana cost.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """The back face of each card with disturb has an ability that instructs its controller to exile if it would be put into a graveyard from anywhere. This includes going to the graveyard from the stack, so if the spell is countered after you cast it using the disturb ability, it will be put into exile."""@en ] .

:MentorOfTheMeek rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Mentor of the Meek" ;
    :manaCost "{2}{W}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Human ;
    :hasSubType :Soldier ;
    :hasRarity :Uncommon ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :InnistradRemastered ;
    :cardNumber "34"^^xsd:integer ;
    :artist "Jana Schirmer & Johannes Voss" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "2" ;
    :toughnessValue "2"^^xsd:integer ;
    :printedText """Whenever another creature you control with power 2 or less enters, you may pay {1}. If you do, draw a card."""@en ;
    :oracleText """Whenever another creature you control with power 2 or less enters, you may pay {1}. If you do, draw a card."""@en ;
    :flavorText """"In these halls there is no pass or fail. Your true test comes with the first full moon.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=685851"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/inr/34/mentor-of-the-meek"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """Mentor of the Meek’s ability checks the power of the other creature only as it enters. If that creature’s power is 2 or less, the ability will trigger. Once the ability triggers, raising that creature’s power above 2 won’t affect that ability. Similarly, reducing the creature’s power to 2 or less after it enters won’t cause the ability to trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """While resolving the triggered ability of Mentor of the Meek, you can’t pay {1} multiple times to draw more than one card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """If a creature enters with +1/+1 counters or a continuous effect such as that of Wedding Festivity will apply to the creature on the battlefield, those effects apply when checking to see if Mentor of the Meek’s ability will trigger."""@en ] .

:OdricLunarchMarshal rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Odric, Lunarch Marshal" ;
    :manaCost "{3}{W}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Human ;
    :hasSubType :Soldier ;
    :hasRarity :Rare ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :InnistradRemastered ;
    :cardNumber "36"^^xsd:integer ;
    :artist "Chase Stone" ;
    :hasLanguage :English ;
    :power "3" ;
    :powerValue "3"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    :printedText """At the beginning of each combat, creatures you control gain first strike until end of turn if a creature you control has first strike. The same is true for flying, deathtouch, double strike, haste, hexproof, indestructible, lifelink, menace, reach, skulk, trample, and vigilance."""@en ;
    :oracleText """At the beginning of each combat, creatures you control gain first strike until end of turn if a creature you control has first strike. The same is true for flying, deathtouch, double strike, haste, hexproof, indestructible, lifelink, menace, reach, skulk, trample, and vigilance."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=685853"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/inr/36/odric-lunarch-marshal"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2016-04-08"^^xsd:date ;
        :rulingText """Multiple instances of any of the abilities Odric can grant your creatures are redundant."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-04-08"^^xsd:date ;
        :rulingText """Odric's ability triggers at the beginning of each combat, not just combat on your turn, whether or not any creatures you control have any of the listed abilities. If a creature gains one of the listed abilities before Odric's triggered ability resolves, perhaps due to another ability that triggered at the beginning of combat, then creatures you control will gain that ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-04-08"^^xsd:date ;
        :rulingText """The set of creatures affected by Odric's ability and how they are affected is determined as the ability resolves. Creatures you begin to control later in the turn won't gain any abilities or cause creatures to gain new abilities, and the abilities gained won't change even if every creature that normally had the abilities leaves the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """If one of those creatures has one or more variants of the listed keywords (for example, hexproof from white), creatures you control gain those specific variants."""@en ] .

