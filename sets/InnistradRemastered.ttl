:GisaAndGeralf rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Gisa and Geralf" ;
    :manaCost "{2}{U}{B}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Human ;
    :hasSubType :Wizard ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColor :Black ;
    :hasColorIdentity :Blue ;
    :hasColorIdentity :Black ;
    :isInSet :InnistradRemastered ;
    :cardNumber "237"^^xsd:integer ;
    :artist "Karla Ortiz" ;
    :hasLanguage :English ;
    :power "4" ;
    :powerValue "4"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :hasKeywordAction :Mill ;
    :printedText """When Gisa and Geralf enters, mill four cards.
Once during each of your turns, you may cast a Zombie creature spell from your graveyard."""@en ;
    :oracleText """When Gisa and Geralf enters, mill four cards.
Once during each of your turns, you may cast a Zombie creature spell from your graveyard."""@en ;
    :flavorText """"These fiends are slightly less tolerable than you."
"A sentiment that warms my heart, sister.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=686086"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/inr/237/gisa-and-geralf"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """Once you begin to cast the Zombie spell, losing control of Gisa and Geralf won’t affect the spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """If you cast one Zombie creature spell from your graveyard and then have a new Gisa and Geralf come under your control in the same turn, you may cast another Zombie creature spell from your graveyard that turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """You must follow the normal timing permissions and restrictions of the Zombie spell you cast from your graveyard."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """If a Zombie card is put into your graveyard during your main phase and the stack is empty, you have a chance to cast it before any player may attempt to remove that card from your graveyard."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """If multiple effects allow you to cast a Zombie creature spell from your graveyard, such as those of Gisa and Geralf and Karador, Ghost Chieftain, you must announce which permission you’re using as you begin to cast the spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-01-24"^^xsd:date ;
        :rulingText """You must pay the costs to cast that Zombie spell. If it has an alternative cost, you may cast it for that cost instead."""@en ] .

