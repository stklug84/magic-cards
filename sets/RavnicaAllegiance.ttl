@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@prefix :     <urn:stklug84:MagicCardsOntology:2026-02-27#> .
@base         <urn:stklug84:MagicCardIndividuals:RNA:2026-07-19#> .

################################################################################
#
# Ontology Definition
#
################################################################################

<urn:stklug84:MagicCardIndividuals:RNA:2026-07-19#>
    rdf:type owl:Ontology ;
    owl:imports <urn:stklug84:MagicCardsOntology:2026-02-27#> ;
    rdfs:label "Magic Card Collection Individuals – Ravnica Allegiance"@en ;
    rdfs:comment """An instance graph describing the card individuals of a
personal Magic: The Gathering card collection that were printed in the set
Ravnica Allegiance (RNA). One Card individual is defined per collected
printing, carrying its characteristics, format legalities and official
rulings. Card data was sourced from Gatherer and Scryfall. This file imports
MagicCardsOntology to reuse all existing class, property, set, keyword,
subtype, format and legality definitions."""@en .


################################################################################
#
# Card Individuals
#
################################################################################

:KayasWrath rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Kaya's Wrath" ;
    :manaCost "{W}{W}{B}{B}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Rare ;
    :hasColor :White ,
              :Black ;
    :hasColorIdentity :White ,
                      :Black ;
    :isInSet :RavnicaAllegiance ;
    :cardNumber "187"^^xsd:integer ;
    :artist "Victor Adame Minguez" ;
    :hasLanguage :English ;
    :printedText """Destroy all creatures. You gain life equal to the number of creatures you controlled that were destroyed this way."""@en ;
    :oracleText """Destroy all creatures. You gain life equal to the number of creatures you controlled that were destroyed this way."""@en ;
    :flavorText """Teysa convened the meeting of the Obzedat. Kaya ended it."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=457331"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/rna/187/kayas-wrath"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2019-01-25"^^xsd:date ;
        :rulingText """If a creature you control has indestructible, it isn't destroyed this way and you won't gain life for it. If a creature you control is destroyed but put into a zone other than a graveyard, you will gain life for it."""@en ] .
