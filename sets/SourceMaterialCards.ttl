:ArchangelOfThune rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Archangel of Thune" ;
    :manaCost "{3}{W}{W}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Angel ;
    :hasRarity :MythicRare ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :SourceMaterialCards ;
    :cardNumber "41"^^xsd:integer ;
    :artist "Jamie McKelvie & Jordie Bellaire" ;
    :hasLanguage :English ;
    :power "3" ;
    :powerValue "3"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :hasKeywordAbility :Flying ,
                       :Lifelink ;
    :printedText """Flying
Lifelink (Damage dealt by this creature also causes you to gain that much life.)
Whenever you gain life, put a +1/+1 counter on each creature you control."""@en ;
    :oracleText """Flying
Lifelink (Damage dealt by this creature also causes you to gain that much life.)
Whenever you gain life, put a +1/+1 counter on each creature you control."""@en ;
    :scryfallUrl "https://scryfall.com/card/mar/41/archangel-of-thune"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "105205"^^xsd:positiveInteger ;
    :arenaName "Archangel of Thune" ;
    :arenaSetCode "MAR" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """If a creature you control is dealt lethal damage at the same time that you gain life, it won't receive a counter from Archangel of Thune's ability in time to save it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """In a Two-Headed Giant game, life gained by your teammate won't cause the ability to trigger, even though it caused your team's life total to increase."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """If you gain an amount of life “for each” of something, that life is gained as one event and the ability triggers only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """Each creature with lifelink dealing combat damage causes a separate life-gaining event. For example, if two creatures you control with lifelink deal combat damage at the same time, the ability will trigger twice. However, if a single creature you control with lifelink deals combat damage to multiple creatures, players, and/or planeswalkers at the same time (perhaps because it has trample or was blocked by more than one creature), the ability will trigger only once."""@en ] .
