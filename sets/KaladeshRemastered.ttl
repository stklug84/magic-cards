:ThopterArrest rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Thopter Arrest" ;
    :manaCost "{2}{W}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :Uncommon ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :KaladeshRemastered ;
    :cardNumber "34"^^xsd:integer ;
    :artist "Kieran Yanner" ;
    :hasLanguage :English ;
    :printedText """When this enchantment enters, exile target artifact or creature an opponent controls until this enchantment leaves the battlefield."""@en ;
    :oracleText """When this enchantment enters, exile target artifact or creature an opponent controls until this enchantment leaves the battlefield."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=547840"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/klr/34/thopter-arrest"^^xsd:anyURI ;
    :isAvailableOn :MTGArena ;
    :arenaId "75612"^^xsd:positiveInteger ;
    :arenaName "Thopter Arrest" ;
    :arenaSetCode "KLR" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """If a token is exiled this way, it will cease to exist and won’t return to the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """Auras attached to the exiled permanent will be put into their owners’ graveyards. Any Equipment will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """The exiled card returns to the battlefield immediately after Thopter Arrest leaves the battlefield. Nothing happens between the two events, including state-based actions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """If Thopter Arrest leaves the battlefield before its triggered ability resolves, the target permanent won’t be exiled."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """In a multiplayer game, if Thopter Arrest’s owner leaves the game, the exiled card will return to the battlefield. Because the one-shot effect that returns the card isn’t an ability that goes on the stack, it won’t cease to exist along with the leaving player’s spells and abilities on the stack."""@en ] .

