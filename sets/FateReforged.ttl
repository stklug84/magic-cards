:UginTheSpiritDragon rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Ugin, the Spirit Dragon" ;
    :manaCost "{8}" ;
    :manaValue "8"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Planeswalker ;
    :hasSubType :Ugin ;
    :hasRarity :MythicRare ;
    :isInSet :FateReforged ;
    :cardNumber "1"^^xsd:integer ;
    :artist "Raymond Swanland" ;
    :hasLanguage :English ;
    :loyalty "7"^^xsd:integer ;
    :printedText """+2: Ugin deals 3 damage to any target.
−X: Exile each permanent with mana value X or less that's one or more colors.
−10: You gain 7 life, draw seven cards, then put up to seven permanent cards from your hand onto the battlefield."""@en ;
    :oracleText """+2: Ugin deals 3 damage to any target.
−X: Exile each permanent with mana value X or less that's one or more colors.
−10: You gain 7 life, draw seven cards, then put up to seven permanent cards from your hand onto the battlefield."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=391948"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/frf/1/ugin-the-spirit-dragon"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Banned ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """Ugin, the Spirit Dragon is not a Dragon card; that is, he doesn't have the creature type Dragon. Spells and abilities that refer to Dragon cards or Dragons don't apply to Ugin."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """If you choose to put permanent cards with morph onto the battlefield with the third ability, you must put them onto the battlefield face up."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-06-23"^^xsd:date ;
        :rulingText """The mana value of a token that isn't a copy of another object is 0. A token that is a copy of another object has the same mana cost as that object."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-06-23"^^xsd:date ;
        :rulingText """A permanent card is an artifact, creature, enchantment, land, or planeswalker card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-06-23"^^xsd:date ;
        :rulingText """If a permanent has {X} in its mana cost, X is considered to be 0."""@en ] .
