:DanceWithCalamity rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Dance with Calamity" ;
    :manaCost "{7}{R}" ;
    :manaValue "8"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Rare ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "29"^^xsd:integer ;
    :artist "Fajareka Setiawan" ;
    :hasLanguage :English ;
    :printedText """Shuffle your library. As many times as you choose, you may exile the top card of your library. If the total mana value of the cards exiled this way is 13 or less, you may cast any number of spells from among those cards without paying their mana costs."""@en ;
    :oracleText """Shuffle your library. As many times as you choose, you may exile the top card of your library. If the total mana value of the cards exiled this way is 13 or less, you may cast any number of spells from among those cards without paying their mana costs."""@en ;
    :flavorText """It was just another day on Innistrad."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612142"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/29/dance-with-calamity"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """You can look at each card you exile before deciding whether to push your luck or stop."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """If you cast a card "without paying its mana cost," you can't pay any alternative costs. You can, however, pay additional costs. If the card has any mandatory additional costs, those must be paid to cast the card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """If an exiled card has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """If you cast any of the exiled cards, you do so as part of the resolution of the spell. You can't wait to cast them later in the turn. Timing restrictions based on a card's type are ignored."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """Any cards not cast, including land cards, remain in exile. They can't be cast on later turns."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """If you cast more than one of the exiled cards, you choose the order in which to cast them. A spell you cast this way can be the target of a later spell you cast this way. However, permanent spells cast this way won't resolve until you're done casting spells, so the permanents they become can't be the target of spells cast this way. For example, if you exile Twincast and Lightning Strike, you can cast Lightning Strike and then cast Twincast targeting it; but if you exile a creature card and an Aura card, you can't cast that Aura targeting that creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """If you danced with calamity a little too closely, and the total mana value of the exiled cards is greater than 13, the cards you exiled will remain there and you won't get to cast any of them."""@en ] .

