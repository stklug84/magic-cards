:ChaosWarpMarchOfTheMachineCommander273 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Chaos Warp" ;
    :manaCost "{2}{R}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Rare ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "273"^^xsd:integer ;
    :artist "Trevor Claxton" ;
    :hasLanguage :English ;
    :printedText """The owner of target permanent shuffles it into their library, then reveals the top card of their library. If it's a permanent card, they put it onto the battlefield."""@en ;
    :oracleText """The owner of target permanent shuffles it into their library, then reveals the top card of their library. If it's a permanent card, they put it onto the battlefield."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612521"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/273/chaos-warp"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2011-09-22"^^xsd:date ;
        :rulingText """The owner of a token is the player under whose control the token was put onto the battlefield. If a token is shuffled into a player's library this way, that player shuffles before revealing the top card of that library."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2011-09-22"^^xsd:date ;
        :rulingText """A permanent card is a card with one or more of the following card types: artifact, creature, enchantment, land, or planeswalker."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2011-09-22"^^xsd:date ;
        :rulingText """If the revealed card is not a permanent card, it remains on top of that library."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2011-09-22"^^xsd:date ;
        :rulingText """If the revealed card is a permanent card but can't enter (perhaps because it's an Aura with nothing to enchant), it remains on top of that library."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2011-09-22"^^xsd:date ;
        :rulingText """If the permanent is an illegal target by the time Chaos Warp tries to resolve, it won't resolve and none of its effects will occur. No library will be shuffled and no card will be revealed."""@en ] .

:CurseOfOpulence rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Curse of Opulence" ;
    :manaCost "{R}" ;
    :manaValue "1"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasSubType :Aura ;
    :hasSubType :Curse ;
    :hasRarity :Uncommon ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "274"^^xsd:integer ;
    :artist "Kieran Yanner" ;
    :hasLanguage :English ;
    :producesMana :White ;
    :producesMana :Blue ;
    :producesMana :Black ;
    :producesMana :Red ;
    :producesMana :Green ;
    :hasKeywordAbility :Enchant ;
    :printedText """Enchant player
Whenever enchanted player is attacked, create a Gold token. Each opponent attacking that player does the same. (A Gold token is an artifact with "Sacrifice this token: Add one mana of any color.")"""@en ;
    :oracleText """Enchant player
Whenever enchanted player is attacked, create a Gold token. Each opponent attacking that player does the same. (A Gold token is an artifact with "Sacrifice this token: Add one mana of any color.")"""@en ;
    :flavorText """Jingling coins beckon many an eager hand."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612522"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/274/curse-of-opulence"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2017-08-25"^^xsd:date ;
        :rulingText """Curse of Opulence's triggered ability resolves after attackers have been declared. Any costs to attack must have already been paid before the attacking player creates the Gold."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-08-25"^^xsd:date ;
        :rulingText """A player is attacking another player if they control a creature that's attacking that player. If no creatures are attacking the enchanted player as a Curse's ability resolves (most likely because they've left the battlefield), only the Curse's controller performs its actions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-08-25"^^xsd:date ;
        :rulingText """Each Curse's ability triggers only once, no matter how many creatures are attacking the enchanted player."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-08-25"^^xsd:date ;
        :rulingText """The triggered ability of these Curses won't trigger if only a planeswalker controlled by the enchanted player is attacked."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-08-25"^^xsd:date ;
        :rulingText """If you enchant yourself with one of these Curses, you'll get its effects whenever another player attacks you."""@en ] .

