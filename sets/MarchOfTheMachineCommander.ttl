:RashmiAndRagavan rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Rashmi and Ragavan" ;
    :manaCost "{1}{G}{U}{R}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Elf ;
    :hasSubType :Monkey ;
    :hasRarity :MythicRare ;
    :hasColor :Blue ;
    :hasColor :Red ;
    :hasColor :Green ;
    :hasColorIdentity :Blue ;
    :hasColorIdentity :Red ;
    :hasColorIdentity :Green ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "8"^^xsd:integer ;
    :artist "Joshua Cairos" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    # Note: keyword "Treasure" not defined in MagicCardsOntology
    :printedText """Whenever you cast your first spell during each of your turns, exile the top card of target opponent's library and create a Treasure token. Then you may cast the exiled card without paying its mana cost if it's a spell with mana value less than the number of artifacts you control. If you don't cast it this way, you may cast it this turn."""@en ;
    :oracleText """Whenever you cast your first spell during each of your turns, exile the top card of target opponent's library and create a Treasure token. Then you may cast the exiled card without paying its mana cost if it's a spell with mana value less than the number of artifacts you control. If you don't cast it this way, you may cast it this turn."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612086"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/8/rashmi-and-ragavan"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """Rashmi and Ragavan’s ability resolves before the spell that caused it to trigger, but not before you have to pay for the original spell. You won’t be able to use the Treasure token you create to pay for it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """If you cast a spell without paying its mana cost, you can’t choose to cast it for any alternative costs. You can, however, pay any additional costs. If the spell has any mandatory additional costs, you must pay those."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """Check the number of artifacts you control as the ability resolves, including the Treasure token you just created, to see if you can cast the exiled card without paying its mana cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """Rashmi and Ragavan has to be on the battlefield at the moment you cast your first spell. Notably, on the turn you cast Rashmi and Ragavan, the ability won’t trigger for you that turn. If a spell causes Rashmi and Ragavan to leave the battlefield as an additional cost to cast it, the ability won’t trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """If you cast the spell without paying its mana cost, you do so during the resolution of the triggered ability. Timing restrictions of that spell based on card type are ignored. It will resolve before the spell that caused the ability to trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """If the spell has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """If you don’t cast the card at all, it remains exiled."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """If you don’t cast it without paying its mana cost but rather cast it later in the turn, you must pay its costs, and you must follow all applicable timing rules. For example, if the card is a creature card, you can cast that card by paying its mana cost only during your main phase while the stack is empty."""@en ] .

