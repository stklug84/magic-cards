:FeldonOfTheThirdPath rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Feldon of the Third Path" ;
    :manaCost "{1}{R}{R}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Human ;
    :hasSubType :Artificer ;
    :hasRarity :MythicRare ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "277"^^xsd:integer ;
    :artist "Chase Stone" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    :printedText """{2}{R}, {T}: Create a token that's a copy of target creature card in your graveyard, except it's an artifact in addition to its other types. It gains haste. Sacrifice it at the beginning of the next end step."""@en ;
    :oracleText """{2}{R}, {T}: Create a token that's a copy of target creature card in your graveyard, except it's an artifact in addition to its other types. It gains haste. Sacrifice it at the beginning of the next end step."""@en ;
    :flavorText """"She will come back to me.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612525"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/277/feldon-of-the-third-path"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """If Feldon's ability creates multiple tokens due to a replacement effect (such as the one Doubling Season creates), each of those tokens will gain haste and you'll sacrifice each of them."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """The token copies exactly what was printed on the original creature card (except that the copy is also an artifact) and nothing else."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """If the copied creature card has {X} in its mana cost, X is 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """If another creature becomes a copy of, or enters the battlefield as a copy of the token, that creature will copy the creature card the token is copying, except it will also be an artifact. This is true even if the creature card that was copied by Feldon of the Third Path is no longer in the graveyard at that time. However, the new copy won't gain haste and you won't sacrifice it at the beginning of the next end step."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """Any enters-the-battlefield abilities of the copied creature card will trigger when the token enters the battlefield. Any "as [this permanent] enters the battlefield" or "[this permanent] enters the battlefield with" abilities of the copied creature card will also work."""@en ] .

:FieryConfluence rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Fiery Confluence" ;
    :manaCost "{2}{R}{R}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Rare ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "278"^^xsd:integer ;
    :artist "Kieran Yanner" ;
    :hasLanguage :English ;
    :printedText """Choose three. You may choose the same mode more than once.
• Fiery Confluence deals 1 damage to each creature.
• Fiery Confluence deals 2 damage to each opponent.
• Destroy target artifact."""@en ;
    :oracleText """Choose three. You may choose the same mode more than once.
• Fiery Confluence deals 1 damage to each creature.
• Fiery Confluence deals 2 damage to each opponent.
• Destroy target artifact."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612526"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/278/fiery-confluence"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """If a Confluence is copied, the effect that creates the copy will usually allow you to choose new targets, but you can't choose new modes."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """If the first or second modes are chosen multiple times, each of those modes represents a separate damage-dealing event. For example, if your opponent casts Fiery Confluence choosing the second mode three times, and you control Guardian Seraph (a creature with the ability "If a source an opponent controls would deal damage to you, prevent 1 of that damage"), you'll be dealt a total of 3 damage."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """If a mode requires a target, you can select that mode only if there's a legal target available. Ignore the targeting requirements for modes you don't choose. Each time you select that mode, you can choose a different target, or you can choose the same target."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """You choose the modes as you cast the spell. Once modes are chosen, they can't be changed."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """If all targets for the chosen modes become illegal before the Confluence resolves, the spell won't resolve and none of its effects will happen. If at least one target is still legal, the spell will resolve but will have no effect on any illegal targets."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """No player can cast spells or activate abilities in between the modes of a resolving spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """No matter which combination of modes you choose, you always follow the instructions of a Confluence in the order they are written. If the same mode is chosen more than once, you choose their relative order as you cast the spell."""@en ] .

