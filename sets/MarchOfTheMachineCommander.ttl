:VedalkenHumiliator rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Vedalken Humiliator" ;
    :manaCost "{3}{U}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Vedalken ;
    :hasSubType :Wizard ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "243"^^xsd:integer ;
    :artist "Jehan Choo" ;
    :hasLanguage :English ;
    :power "3" ;
    :powerValue "3"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    # Note: keyword "Metalcraft" not defined in MagicCardsOntology
    :printedText """Metalcraft — Whenever this creature attacks, if you control three or more artifacts, creatures your opponents control lose all abilities and have base power and toughness 1/1 until end of turn."""@en ;
    :oracleText """Metalcraft — Whenever this creature attacks, if you control three or more artifacts, creatures your opponents control lose all abilities and have base power and toughness 1/1 until end of turn."""@en ;
    :flavorText """"And who will stop me? You?\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612491"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/243/vedalken-humiliator"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Any power- or toughness-modifying effects (those that give +N/+N, for example) and counters will apply to the creature's new base power and toughness, even if they started to apply before Vedalken Humiliator's ability resolved."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """If you don't control three artifacts as Vedalken Humiliator's ability resolves, it has no effect. If you do, the effect continues to apply even if you lose control of Vedalken Humiliator or your artifacts later in the turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Vedalken Humiliator's ability overwrites all previous effects that set an affected creature's base power and toughness to specific values. Any power- or toughness-setting effects that start to apply to a creature after the ability resolves will overwrite this effect."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Vedalken Humiliator's ability affects only creatures your opponents control at the time it resolves. Creatures they begin to control later in the turn won't lose power, toughness, or abilities."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """All creatures your opponents control are affected by Vedalken Humiliator's ability, not just those controlled by the player it's attacking."""@en ] .

