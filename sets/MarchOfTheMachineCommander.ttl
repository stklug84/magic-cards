:SelesnyaLoftGardens rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Selesnya Loft Gardens" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Plane ;
    :hasSubType :Ravnica ;
    :hasRarity :Common ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "156"^^xsd:integer ;
    :artist "Martina Pilcerova" ;
    :hasLanguage :English ;
    :producesMana :White ;
    :producesMana :Blue ;
    :producesMana :Black ;
    :producesMana :Red ;
    :producesMana :Green ;
    :printedText """If an effect would create one or more tokens, it creates twice that many of those tokens instead.
If an effect would put one or more counters on a permanent, it puts twice that many of those counters on that permanent instead.
Whenever chaos ensues, until end of turn, whenever you tap a land for mana, add one mana of any type that land produced."""@en ;
    :oracleText """If an effect would create one or more tokens, it creates twice that many of those tokens instead.
If an effect would put one or more counters on a permanent, it puts twice that many of those counters on that permanent instead.
Whenever chaos ensues, until end of turn, whenever you tap a land for mana, add one mana of any type that land produced."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=615147"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/156/selesnya-loft-gardens"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2012-06-01"^^xsd:date ;
        :rulingText """Effects that place a counter on a permanent include that permanent entering. For example, a creature that normally enters with one or more +1/+1 counters will enter that many +1/+1 counters on it. A planeswalker will enter with twice its starting loyalty counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2012-06-01"^^xsd:date ;
        :rulingText """Adding loyalty counters to a planeswalker in order to activate a loyalty ability isn't an effect, so those counters are not doubled."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2012-06-01"^^xsd:date ;
        :rulingText """Any -1/-1 counters that are placed on a creature because of wither or infect are also not doubled."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2012-06-01"^^xsd:date ;
        :rulingText """The chaos ability is cumulative. For example, if you roll {CHAOS} twice in a turn, tapping a land for mana will cause two mana abilities to trigger."""@en ] .

:StrongholdFurnace rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Stronghold Furnace" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Plane ;
    :hasSubType :Rath ;
    :hasRarity :Common ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "160"^^xsd:integer ;
    :artist "Jim Pavelec" ;
    :hasLanguage :English ;
    :hasKeywordAction :Double ;
    :printedText """If a source would deal damage to a permanent or player, it deals double that damage instead.
Whenever chaos ensues, Stronghold Furnace deals 1 damage to any target."""@en ;
    :oracleText """If a source would deal damage to a permanent or player, it deals double that damage instead.
Whenever chaos ensues, Stronghold Furnace deals 1 damage to any target."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=615151"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/160/stronghold-furnace"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2009-10-01"^^xsd:date ;
        :rulingText """If multiple effects modify how damage will be dealt, the player who would be dealt damage or the controller of the creature that would be dealt damage chooses the order to apply the effects. For example, Mending Hands says, "Prevent the next 4 damage that would be dealt to any target this turn." Suppose a spell would deal 5 damage to a player who has cast Mending Hands targeting themselves. The player who would be dealt damage can either (a) prevent 4 damage first and then let Stronghold Furnace's effect double the remaining 1 damage, taking 2 damage, or (b) double the damage to 10 and then prevent 4 damage, taking 6 damage."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2009-10-01"^^xsd:date ;
        :rulingText """A face-up plane card that's turned face down becomes a new object with no relation to its previous existence. In particular, it loses all counters it may have had."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2009-10-01"^^xsd:date ;
        :rulingText """A plane card is treated as if its text box included "When you roll {PW}, put this card on the bottom of its owner's planar deck face down, then move the top card of your planar deck off that planar deck and turn it face up." This is called the "planeswalking ability.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2009-10-01"^^xsd:date ;
        :rulingText """The controller of a face-up plane card is the player designated as the "planar controller." Normally, the planar controller is whoever the active player is. However, if the current planar controller would leave the game, instead the next player in turn order that wouldn't leave the game becomes the planar controller, then the old planar controller leaves the game. The new planar controller retains that designation until they leave the game or a different player becomes the active player, whichever comes first."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2009-10-01"^^xsd:date ;
        :rulingText """Stronghold Furnace's first ability interacts with all damage, not just combat damage. Notably, it doubles the damage from its own chaos ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2009-10-01"^^xsd:date ;
        :rulingText """If an ability of a plane refers to "you," it's referring to whoever the plane's controller is at the time, not to the player that started the game with that plane card in their deck. Many abilities of plane cards affect all players, while many others affect only the planar controller, so read each ability carefully."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2009-10-01"^^xsd:date ;
        :rulingText """If a spell or ability divides damage among multiple recipients (such as Pyrotechnics does), the damage is divided before Stronghold Furnace's effect doubles it. The same is true for combat damage."""@en ] .

:EchoStorm rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Echo Storm" ;
    :manaCost "{3}{U}{U}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "221"^^xsd:integer ;
    :artist "Mark Poole" ;
    :hasLanguage :English ;
    :printedText """When you cast this spell, copy it for each time you've cast your commander from the command zone this game. You may choose new targets for the copies.
Create a token that's a copy of target artifact."""@en ;
    :oracleText """When you cast this spell, copy it for each time you've cast your commander from the command zone this game. You may choose new targets for the copies.
Create a token that's a copy of target artifact."""@en ;
    :flavorText """An organized and methodical reproduction."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612469"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/221/echo-storm"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """If the copied artifact is copying something else (for example, if the copied artifact is a Sculpting Steel), then the token enters the battlefield as whatever that artifact copied."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """The token copies exactly what was printed on the original artifact and nothing else (unless that artifact is copying something else or is a token; see below). It doesn't copy whether that artifact is tapped or untapped, whether it has any counters on it or Auras attached to it, or any non-copy effects that have changed its types, color, or so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Each Storm's triggered ability can copy the Storm spell even if that spell is countered before that ability resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """The copies are created on the stack, so they're not “cast.” Abilities that trigger when a player casts a spell (such as the Storm's ability itself) won't trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """If the copied artifact is a token, the token that's created copies the original characteristics of that token as stated by the effect that created the token."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Each copy resolves one at a time. Any abilities that trigger on the artifact token entering the battlefield resolve before the next copy resolves. The original spell is the last to resolve."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """If the copied artifact has {X} in its mana cost, X is considered to be 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Each Storm's triggered ability counts only how many times you've cast your commander from the command zone before that triggered ability resolves. If you cast your commander again later, you won't get another copy."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Any enters-the-battlefield abilities of the copied artifact will trigger when the token enters the battlefield. Any “as [this artifact] enters the battlefield” or “[this artifact] enters the battlefield with” abilities of the chosen artifact will also work."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """If your commander was countered, that time you cast it still counts."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-10-05"^^xsd:date ;
        :rulingText """If you have multiple commanders, you'll copy this spell for each time you've cast either of them. For example, if you've cast one commander once and one twice, you'll copy this spell three times."""@en ] .

:ImprisonedInTheMoonMarchOfTheMachineCommander224 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Imprisoned in the Moon" ;
    :manaCost "{2}{U}" ;
