—*Beyond the Great Henge*"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612493"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/245/workshop-elders"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2019-10-04"^^xsd:date ;
        :rulingText """If another effect later causes the artifact to become a creature and sets its power and toughness as it does so, that creature will have that base power and toughness; it won't be 0/0. Notably, crewing a Vehicle does not set its power and toughness, so a Vehicle's base power and toughness remain 0/0 if you crew it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-10-04"^^xsd:date ;
        :rulingText """The effect of Workshop Elders's triggered ability lasts indefinitely. It doesn't wear off during the cleanup step."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-10-04"^^xsd:date ;
        :rulingText """An artifact that becomes a creature due to Workshop Elders can't attack unless you've controlled it continuously since your turn began."""@en ] .

