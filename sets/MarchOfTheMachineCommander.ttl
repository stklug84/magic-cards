:RealityShiftMarchOfTheMachineCommander231 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Reality Shift" ;
    :manaCost "{1}{U}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Uncommon ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "231"^^xsd:integer ;
    :artist "Howard Lyon" ;
    :hasLanguage :English ;
    :hasKeywordAction :Manifest ;
    :printedText """Exile target creature. Its controller manifests the top card of their library. (That player puts the top card of their library onto the battlefield face down as a 2/2 creature. If it's a creature card, it can be turned face up any time for its mana cost.)"""@en ;
    :oracleText """Exile target creature. Its controller manifests the top card of their library. (That player puts the top card of their library onto the battlefield face down as a 2/2 creature. If it's a creature card, it can be turned face up any time for its mana cost.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612479"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/231/reality-shift"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """The face-down permanent is a 2/2 creature with no name, mana cost, creature types, or abilities. It's colorless and has a mana value of 0. Other effects that apply to the permanent can still grant or change any of these characteristics."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """If a double-faced card is manifested, it will be put onto the battlefield face down. While face down, it can't transform. If the front face of the card is a creature card, you can turn it face up by paying its mana cost. If you do, its front face will be up."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """Unlike a face-down creature that was cast using the morph ability, a manifested creature may still be turned face up after it loses its abilities if it's a creature card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """You must ensure that your face-down spells and permanents can easily be differentiated from each other. You're not allowed to mix up the cards that represent them on the battlefield in order to confuse other players. The order they entered the battlefield should remain clear. Common methods for indicating this include using markers or dice, or simply placing them in order on the battlefield. You must also track how each became face down (manifested, cast face down using the morph ability, and so on)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """Turning a permanent face up or face down doesn't change whether that permanent is tapped or untapped."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """Any time you have priority, you may turn a manifested creature face up by revealing that it's a creature card (ignoring any copy effects or type-changing effects that might be applying to it) and paying its mana cost. This is a special action. It doesn't use the stack and can't be responded to."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """A permanent that turns face up or face down changes characteristics but is otherwise the same permanent. Spells and abilities that were targeting that permanent, as well as Auras and Equipment that were attached to the permanent, aren't affected."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """Because face-down creatures don't have names, they can't have the same name as any other creature, even another face-down creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """If a manifested creature would have morph if it were face up, you may also turn it face up by paying its morph cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """There are no cards in the Fate Reforged set that would turn a face-down instant or sorcery card on the battlefield face up, but some older cards can try to do this. If something tries to turn a face-down instant or sorcery card on the battlefield face up, reveal that card to show all players it's an instant or sorcery card. The permanent remains on the battlefield face down. Abilities that trigger when a permanent turns face up won't trigger, because even though you revealed the card, it never turned face up."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """If a face-down permanent you control leaves the battlefield, you must reveal it. You must also reveal all face-down spells and permanents you control if you leave the game or if the game ends."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """At any time, you can look at a face-down permanent you control. You can't look at face-down permanents you don't control unless an effect allows you to or instructs you to."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """Because the permanent is on the battlefield both before and after it's turned face up, turning a permanent face up doesn't cause any enters-the-battlefield abilities to trigger."""@en ] .

:ReverseEngineer rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Reverse Engineer" ;
    :manaCost "{3}{U}{U}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Uncommon ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "232"^^xsd:integer ;
    :artist "Chase Stone" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Improvise ;
    :printedText """Improvise (Your artifacts can help cast this spell. Each artifact you tap after you're done activating mana abilities pays for {1}.)
Draw three cards."""@en ;
    :oracleText """Improvise (Your artifacts can help cast this spell. Each artifact you tap after you're done activating mana abilities pays for {1}.)
Draw three cards."""@en ;
    :flavorText """The Hold, an illegal research facility in a derelict merchant ship, became a wellspring of renegade intelligence."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612480"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/232/reverse-engineer"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Improvise doesn't change a spell's mana cost or mana value."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """When calculating a spell's total cost, include any alternative costs, additional costs, or anything else that increases or reduces the cost to cast the spell. Improvise applies after the total cost is calculated."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Improvise can't pay for {W}, {U}, {B}, {R}, {G}, or {C} mana symbols in a spell's total cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Tapping an artifact won't cause its abilities to stop applying unless those abilities say so."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Equipment attached to a creature doesn't become tapped when that creature becomes tapped, and tapping that Equipment doesn't cause the creature to become tapped."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """If an artifact you control has a mana ability with {T} in the cost, activating that ability while casting a spell with improvise will result in the artifact being tapped when you pay the spell's costs. You won't be able to tap it again for improvise. Similarly, if you sacrifice an artifact to activate a mana ability while casting a spell with improvise, that artifact won't be on the battlefield when you pay the spell's costs, so you won't be able to tap it for improvise."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """When using improvise to cast a spell with {X} in its mana cost, first choose the value for X. That choice, plus any cost increases or decreases, will determine the spell's total cost. Then you can tap artifacts you control to help pay that cost. For example, if you cast Saheeli's Directive and choose X to be 3, the total cost is {3}{R}{R}{R}. If you tap two artifacts, you'll have to pay {1}{R}{R}{R}."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Improvise can't be used to pay for anything other than the cost of casting the spell. For example, it can't be used during the resolution of an ability that says “Counter target spell unless its controller pays {3}.”"""@en ] .

