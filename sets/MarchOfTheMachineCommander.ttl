    :hasColorIdentity :Blue ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "235"^^xsd:integer ;
    :artist "Michael Bruinsma" ;
    :hasLanguage :English ;
    :power "4" ;
    :powerValue "4"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :hasKeywordAbility :Flying ;
    :printedText """Flying
Whenever an artifact creature you control deals combat damage to a player, you may create a 1/1 blue Thopter artifact creature token with flying."""@en ;
    :oracleText """Flying
Whenever an artifact creature you control deals combat damage to a player, you may create a 1/1 blue Thopter artifact creature token with flying."""@en ;
    :flavorText """Whether mechanical or biological, life finds a way to propagate itself."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612483"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/235/sharding-sphinx"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2008-10-01"^^xsd:date ;
        :rulingText """The only difference between a colored artifact and a colorless artifact is, obviously, its color. Unlike most artifacts, a colored artifact requires colored mana to cast. Also unlike most artifacts, a colored artifact has a color in all zones. It will interact with cards that care about color. Other than that, a colored artifact behaves just like any other artifact. It will interact as normal with any card that cares about artifacts, such as Shatter or Arcbound Ravager."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2008-10-01"^^xsd:date ;
        :rulingText """If combat damage is dealt to players by multiple artifact creatures you control (including, perhaps, Sharding Sphinx itself), Sharding Sphinx's ability will trigger that many times. You'll get that many Thopter tokens. You'll get just one token per creature, no matter how much combat damage that creature dealt."""@en ] .

