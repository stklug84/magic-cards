:ReplicatingRing rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Replicating Ring" ;
    :manaCost "{3}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasSuperType :Snow ;
    :hasCardType :Artifact ;
    :hasRarity :Uncommon ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "372"^^xsd:integer ;
    :artist "Olena Richards" ;
    :hasLanguage :English ;
    :producesMana :White ;
    :producesMana :Blue ;
    :producesMana :Black ;
    :producesMana :Red ;
    :producesMana :Green ;
    :printedText """{T}: Add one mana of any color.
At the beginning of your upkeep, put a night counter on this artifact. Then if it has eight or more night counters on it, remove all of them and create eight colorless snow artifact tokens named Replicated Ring with "{T}: Add one mana of any color.\""""@en ;
    :oracleText """{T}: Add one mana of any color.
At the beginning of your upkeep, put a night counter on this artifact. Then if it has eight or more night counters on it, remove all of them and create eight colorless snow artifact tokens named Replicated Ring with "{T}: Add one mana of any color.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612620"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/372/replicating-ring"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """Some cards have additional effects for each {S} spent to cast them. You can cast these spells even if you don't spend any snow mana to cast them; their additional effects simply won't do anything."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """The Kaldheim set doesn't have any cards with mana costs that include {S}, but some previous sets do. If an effect says such a spell costs {1} less to cast, that reduction doesn't apply to any {S} costs. This is also true for activated abilities that include {S} in their activation costs and effects that reduce those costs."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """The check of whether Replicating Ring has eight or more night counters on it happens only as part of the resolution of the triggered ability. If Replicating Ring picks up its eighth night counter at another time, you won't immediately create Replicated Rings. You'll have to wait until the next time the triggered ability resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """Snow isn't a type of mana. If an effect says you may spend mana as though it were any type, you can't pay for {S} using mana that wasn't produced by a snow source."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """The {S} symbol is a generic mana symbol. It represents a cost that can be paid by one mana that was produced by a snow source. That mana can be any color or colorless."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """Snow is a supertype, not a card type. It has no rules meaning or function by itself, but spells and abilities may refer to it."""@en ] .

