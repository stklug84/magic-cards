:SaheeliSublimeArtificerMarchOfTheMachineCommander338 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Saheeli, Sublime Artificer" ;
    :manaCost "{1}{U/R}{U/R}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Planeswalker ;
    :hasSubType :Saheeli ;
    :hasRarity :Uncommon ;
    :hasColor :Blue ;
    :hasColor :Red ;
    :hasColorIdentity :Blue ;
    :hasColorIdentity :Red ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "338"^^xsd:integer ;
    :artist "Wesley Burt" ;
    :hasLanguage :English ;
    :loyalty "5"^^xsd:integer ;
    :printedText """Whenever you cast a noncreature spell, create a 1/1 colorless Servo artifact creature token.
−2: Target artifact you control becomes a copy of another target artifact or creature you control until end of turn, except it's an artifact in addition to its other types."""@en ;
    :oracleText """Whenever you cast a noncreature spell, create a 1/1 colorless Servo artifact creature token.
−2: Target artifact you control becomes a copy of another target artifact or creature you control until end of turn, except it's an artifact in addition to its other types."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612586"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/338/saheeli-sublime-artificer"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """If an effect begins to apply to the target artifact before it becomes a copy of another permanent, that effect will continue to apply."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """Saheeli's first ability resolves before the spell that caused it to trigger. It resolves even if that spell is countered."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """If the target artifact is an Equipment attached to a creature and it becomes a copy of a non-Equipment permanent, it becomes unattached. If it becomes a copy of an Equipment, it remains attached."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """The target artifact is an artifact in addition to whatever types the second target has, and this exception is copiable. If something else copies the artifact later in the turn, that copy also will be an artifact."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """Saheeli's loyalty ability causes the target artifact to copy the printed values of the target permanent, plus any copy effects that have been applied to it. It won't copy counters on that permanent or effects that have changed its power, toughness, types, color, or so on. Notably, it won't copy effects that made the target permanent become a creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """If the target artifact copies a permanent that's copying something else, it will become whatever the target is copying."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """If the target artifact isn't an Equipment and becomes a copy of an Equipment, it'll become unattached when it becomes a non-Equipment artifact again."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """If the target artifact becomes a creature the same turn it enters the battlefield, you can't attack with it or use any of its {T} abilities unless it has haste."""@en ] .

:Struggle rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Struggle // Survive" ;
    :manaCost "{2}{R}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasCardType :Sorcery ;
    :hasRarity :Uncommon ;
    :hasColor :Red ;
    :hasColor :Green ;
    :hasColorIdentity :Red ;
    :hasColorIdentity :Green ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "339"^^xsd:integer ;
    :artist "Eric Deschamps" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Aftermath ;
    :printedText """Struggle deals damage to target creature equal to the number of lands you control.
//
Aftermath (Cast this spell only from your graveyard. Then exile it.)
Each player shuffles their graveyard into their library."""@en ;
    :oracleText """Struggle deals damage to target creature equal to the number of lands you control.
//
Aftermath (Cast this spell only from your graveyard. Then exile it.)
Each player shuffles their graveyard into their library."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612587"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/339/struggle-survive"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """A spell with aftermath cast from a graveyard will always be exiled afterward, whether it resolves, it's countered, or it leaves the stack in some other way."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """All split cards have two card faces on a single card, and you put a split card onto the stack with only the half you're casting. The characteristics of the half of the card you didn't cast are ignored while the spell is on the stack. For example, if an effect prevents you from casting green spells, you can cast Destined of Destined // Lead, but not Lead."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """While not on the stack, the characteristics of a split card are the combination of its two halves. For example, Destined // Lead is a green and black card, it is both an instant card and a sorcery card, and its mana value is 6. This means that if an effect allows you to cast a card with mana value 2 from your hand, you can't cast Destined. This is a change from the previous rules for split cards."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """If another effect allows you to cast a split card with aftermath from a graveyard, you may cast either half. If you cast the half that has aftermath, you'll exile the card if it would leave the stack."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """Each split card is a single card. For example, if you discard one, you've discarded one card, not two. If an effect counts the number of instant and sorcery cards in your graveyard, Destined // Lead counts once, not twice."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """If you cast the first half of a split card with aftermath during your turn, you'll have priority immediately after it resolves. You can cast the half with aftermath from your graveyard before any player can take any other action if it's legal for you to do so."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """Split cards with aftermath have a new frame treatment—the half you can cast from your hand is oriented the same as other cards you'd cast from your hand, while the half you can cast from your graveyard is a traditional split card half. This frame treatment is for your convenience and has no rules significance."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """If another effect allows you to cast a split card with aftermath from any zone other than a graveyard, you can't cast the half with aftermath."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """Each split card has two names. If an effect instructs you to choose a card name, you may choose one, but not both."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-07-14"^^xsd:date ;
        :rulingText """If a player has no cards in their graveyard when Survive resolves, that player just shuffles their library."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-07-14"^^xsd:date ;
        :rulingText """Once you've started to cast a spell with aftermath from your graveyard, the card is immediately moved to the stack. Opponents can't try to stop the ability by exiling the card with an effect such as that of Crook of Condemnation."""@en ] .

:AcademyManufactor rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Academy Manufactor" ;
    :manaCost "{3}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasCardType :Creature ;
    :hasSubType :AssemblyWorker ;
    :hasRarity :Rare ;
    :isInSet :MarchOfTheMachineCommander ;
    :cardNumber "346"^^xsd:integer ;
    :artist "Campbell White" ;
    :hasLanguage :English ;
    :power "1" ;
    :powerValue "1"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    # Note: keyword "Treasure" not defined in MagicCardsOntology
    # Note: keyword "Food" not defined in MagicCardsOntology
    :printedText """If you would create a Clue, Food, or Treasure token, instead create one of each."""@en ;
    :oracleText """If you would create a Clue, Food, or Treasure token, instead create one of each."""@en ;
    :flavorText """Automated systems at the Tolarian Academy sort new acquisitions for optimal use, determining which should be studied, eaten, or sold."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=612594"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/moc/346/academy-manufactor"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-06-18"^^xsd:date ;
        :rulingText """Creating a Clue token this way isn't the same thing as investigating. Notably, an ability that triggers whenever you investigate won't trigger because you created a Clue token due to this replacement effect. If the original token creation was because you investigated once, those abilities will still each trigger once, no matter how many Clue tokens you end up creating."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-06-18"^^xsd:date ;
        :rulingText """If you control two Academy Manufactors and would create some number of Clue, Food, or Treasure tokens, you will instead create three times that many Clue tokens, three times that many Food tokens, and three times that many Treasure tokens."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-06-18"^^xsd:date ;
        :rulingText """If you control one Academy Manufactor and would create some number of Clue, Food, or Treasure tokens, you will instead create that many Clue tokens, that many Food tokens, and that many Treasure tokens."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-06-18"^^xsd:date ;
        :rulingText """If you control eighteen Academy Manufactors (I don't know, you figure it out) and would create some number of Clue, Food, or Treasure tokens, you will instead create 129,140,163 times that many Clue tokens, 129,140,163 times that many Food tokens, and 129,140,163 times that many Treasure tokens."""@en ] .

