:ArcboundWandererModernMasters200 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Arcbound Wanderer" ;
    :manaCost "{6}" ;
    :manaValue "6"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ,
                 :Creature ;
    :hasSubType :Golem ;
    :hasRarity :Common ;
    :isInSet :ModernMasters ;
    :cardNumber "200"^^xsd:integer ;
    :artist "Christopher Moeller" ;
    :hasLanguage :English ;
    :power "0" ;
    :powerValue "0"^^xsd:integer ;
    :toughness "0" ;
    :toughnessValue "0"^^xsd:integer ;
    :hasKeywordAbility :Modular ,
                       :Sunburst ;
    :printedText """Modular—Sunburst (This creature enters with a +1/+1 counter on it for each color of mana spent to cast it. When it dies, you may put its +1/+1 counters on target artifact creature.)"""@en ;
    :oracleText """Modular—Sunburst (This creature enters with a +1/+1 counter on it for each color of mana spent to cast it. When it dies, you may put its +1/+1 counters on target artifact creature.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=370523"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/mma/200/arcbound-wanderer"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2004-12-01"^^xsd:date ;
        :rulingText """For the leaves-the-battlefield ability, the number of counters on Arcbound Wanderer at the time it left the battlefield is what's relevant; the number of colors of mana used to pay its cost doesn't matter anymore."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2004-12-01"^^xsd:date ;
        :rulingText """When the Wanderer leaves the battlefield, you may put the counters onto a single target artifact creature. You can't split them among two or more artifact creatures."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2004-12-01"^^xsd:date ;
        :rulingText """This card has modular—sunburst, a combination of two keyword abilities. The sunburst ability sets the number for the modular ability. Basically, the number of +1/+1 counters the Wanderer gets as it enters is equal to the number of colors of mana used to pay its cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2006-09-25"^^xsd:date ;
        :rulingText """If this creature gets enough -1/-1 counters put on it to cause its toughness to be 0 or less (or the damage marked on it to be lethal), modular will put a number of +1/+1 counters on the target artifact creature equal to the number of +1/+1 counters on this creature before it left the battlefield."""@en ] .
