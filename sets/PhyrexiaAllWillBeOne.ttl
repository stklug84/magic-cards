:SkrelvsHivePhyrexiaAllWillBeOne34 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Skrelv's Hive" ;
    :manaCost "{1}{W}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :Rare ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :PhyrexiaAllWillBeOne ;
    :cardNumber "34"^^xsd:integer ;
    :artist "Heonhwa" ;
    :hasLanguage :English ;
    # Note: keyword "Corrupted" not defined in MagicCardsOntology
    :printedText """At the beginning of your upkeep, you lose 1 life and create a 1/1 colorless Phyrexian Mite artifact creature token with toxic 1 and "This token can't block."
Corrupted — As long as an opponent has three or more poison counters, creatures you control with toxic have lifelink."""@en ;
    :oracleText """At the beginning of your upkeep, you lose 1 life and create a 1/1 colorless Phyrexian Mite artifact creature token with toxic 1 and "This token can't block."
Corrupted — As long as an opponent has three or more poison counters, creatures you control with toxic have lifelink."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=602564"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/one/34/skrelvs-hive"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "83734"^^xsd:positiveInteger ;
    :arenaName "Skrelv's Hive" ;
    :arenaSetCode "ONE" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """A player with ten or more poison counters loses the game. This is a state-based action and doesn't use the stack. In other words, it happens immediately and players can't respond to it, just like a player losing the game due to having 0 or less life."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """Toxic doesn't change the amount of combat damage a creature deals. For example, if a 2/2 creature with toxic 1 deals combat damage to a player, that creature will deal 2 damage. The results of that damage are the player loses 2 life and gets a poison counter."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """If a creature with toxic deals combat damage to a creature or planeswalker, or if it deals noncombat damage, toxic has no effect and no player gets poison counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """Multiple instances of toxic are cumulative. For example, if a creature has toxic 2 and gains toxic 1 due to another effect, combat damage that creature deals to a player will cause that player to get 3 poison counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """Any other effects of that damage, such as life gain from lifelink, still apply."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """Damage dealt by a creature with toxic grants the same number of counters regardless of how much damage is dealt. Notably, if a replacement effect modifies the damage in some way (such as that of Gratuitous Violence), the number of counters given remains unchanged."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """Conversely, replacement effects that apply to the number of counters put on a player can modify the counters placed this way. For example, Vorinclex, Monstrous Raider's last two abilities can apply to counters placed this way."""@en ] .

:BladeOfSharedSouls rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Blade of Shared Souls" ;
    :manaCost "{2}{U}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasSubType :Equipment ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :PhyrexiaAllWillBeOne ;
    :cardNumber "42"^^xsd:integer ;
    :artist "Volkan Baǵa" ;
    :hasLanguage :English ;
    :hasKeywordAbility :ForMirrodin ,
                       :Equip ;
    :printedText """For Mirrodin! (When this Equipment enters, create a 2/2 red Rebel creature token, then attach this to it.)
Whenever this Equipment becomes attached to a creature, for as long as this Equipment remains attached to it, you may have that creature become a copy of another target creature you control.
Equip {2}"""@en ;
    :oracleText """For Mirrodin! (When this Equipment enters, create a 2/2 red Rebel creature token, then attach this to it.)
Whenever this Equipment becomes attached to a creature, for as long as this Equipment remains attached to it, you may have that creature become a copy of another target creature you control.
Equip {2}"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=602572"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/one/42/blade-of-shared-souls"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "83742"^^xsd:positiveInteger ;
    :arenaName "Blade of Shared Souls" ;
    :arenaSetCode "ONE" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """If the Rebel is destroyed, the Equipment stays on the battlefield. Similarly, you may pay its equip cost to move it from the Rebel token to another creature you control."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """If the ability causes two Rebel tokens to be created (due to an effect such as that of Mondrak, Glory Dominus), the Equipment becomes attached to only one of them."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """The copiable values granted by Blade of Shared Souls are locked in as its effect begins to apply. After that point, it doesn't matter if the creature that's being copied leaves the battlefield or if any of its copiable values change."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """The creature copies exactly what is printed on the chosen creature (unless that creature has additional copy effects affecting it, is copying something else, or is a token; see below). It doesn't copy whether that creature is tapped or untapped, whether it has any counters on it or any Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, or so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """The Rebel enters the battlefield as a 2/2 creature, then the Equipment becomes attached to it. Abilities that trigger when a creature enters the battlefield see that a 2/2 creature entered the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """Non-copy effects that have already applied to the equipped creature will continue to apply to it. For example, +1/+1 counters on it will still affect it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """If the target creature is a token, the equipped creature copies the original characteristics of that token as stated by the effect that created it. If the equipped creature isn't a token, copying a token won't cause it to become a token. Similarly, if the equipped creature is a token, copying a nontoken won't cause it to become a nontoken."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """If the target creature is a double-faced or melded permanent, the equipped creature copies the face shown. If the equipped creature copies a melded permanent or the back face of a double-faced card, its mana value is 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """If the target creature is copying something else (for example, if that creature is equipped by another Blade of Shared Souls), then the equipped creature becomes a copy of whatever the target creature copied."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """If the target creature isn't normally a creature (for example, an animated Monument to Perfection), the equipped creature will become a copy of the noncreature permanent. Blade of Shared Souls will become unattached and the copy effect will end. The previously equipped creature will revert to whatever it was before the copy effect applied."""@en ] .

