    :hasLanguage :English ;
    :printedText """Destroy target creature or enchantment an opponent controls. You lose life equal to that permanent's mana value."""@en ;
    :oracleText """Destroy target creature or enchantment an opponent controls. You lose life equal to that permanent's mana value."""@en ;
    :flavorText """"All it took was a little Time. And all for this, to get beyond any one universe, to find Division, to get revenge on those who imprisoned us so long ago. To take them all.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=635547"^^xsd:anyURI ;
