:MidnightCrusaderShuttle rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Midnight Crusader Shuttle" ;
    :manaCost "{4}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasSubType :Vehicle ;
    :hasRarity :Uncommon ;
    :isInSet :DoctorWhoCommander ;
    :cardNumber "179"^^xsd:integer ;
    :artist "Evan Shipard" ;
    :hasLanguage :English ;
    :power "3" ;
    :powerValue "3"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :hasKeywordAbility :Crew ;
    # Note: keyword "Midnight Entity" not defined in MagicCardsOntology
    :printedText """Midnight Entity — Whenever this Vehicle attacks, defending player faces a villainous choice — That player sacrifices a creature of their choice, or you gain control of a creature of your choice that player controls until end of turn. If you gain control of a creature this way, tap it, and it's attacking that player.
Crew 2"""@en ;
    :oracleText """Midnight Entity — Whenever this Vehicle attacks, defending player faces a villainous choice — That player sacrifices a creature of their choice, or you gain control of a creature of your choice that player controls until end of turn. If you gain control of a creature this way, tap it, and it's attacking that player.
Crew 2"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=634874"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/who/179/midnight-crusader-shuttle"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If a spell or ability requires multiple players to face a villainous choice, the result is a little different from other effects in Magic. In that case, the first player in turn order makes their choice and the action for that choice is performed before the next player makes their choice. Then each of the remaining players repeat this process in turn order."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """A player facing a villainous choice can always choose either option, even if one or both of the options are impossible. For example, if one of the options is to sacrifice a creature, a player who controls no creatures can still choose that option."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """When a player faces a villainous choice, they first choose one of the two options, then all actions in the chosen option are performed."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """When a creature becomes attacking this way, it wasn't declared as an attacker, so triggered abilities that trigger when a creature attacks won't trigger. Similar, all restrictions or costs to attack are ignored. For example, if the chosen creature has defender, it could still end up being an attacking creature this way."""@en ] .

