    :hasColorIdentity :Black ;
    :isInSet :DoctorWhoCommander ;
    :cardNumber "261"^^xsd:integer ;
    :artist "Shahab Alizadeh" ;
    :hasLanguage :English ;
    :producesMana :Blue ;
    :producesMana :Black ;
    :entersTapped "true"^^xsd:boolean ;
    :printedText """As this land enters, you may reveal an Island or Swamp card from your hand. If you don't, this land enters tapped.
{T}: Add {U} or {B}."""@en ;
    :oracleText """As this land enters, you may reveal an Island or Swamp card from your hand. If you don't, this land enters tapped.
{T}: Add {U} or {B}."""@en ;
    :flavorText """"You traveled five miles in twelve years?!"
—The Tenth Doctor"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=635587"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/who/261/choked-estuary"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2016-04-08"^^xsd:date ;
        :rulingText """You may reveal any land card with either or both of the appropriate subtypes. It doesn't have to be a basic land. For example, you could reveal Prairie Stream from the Battle for Zendikar set to satisfy the ability of Choked Estuary."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-04-08"^^xsd:date ;
        :rulingText """Lands don't have a subtype just because they can produce mana of the corresponding color. Choked Estuary itself is neither an Island nor a Swamp, even though it produces blue and black mana, so you can't reveal one to satisfy the ability of another."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-04-08"^^xsd:date ;
        :rulingText """If an effect instructs you to put Choked Estuary onto the battlefield tapped, it will still enter the battlefield tapped even if you reveal a land card from your hand."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-04-08"^^xsd:date ;
        :rulingText """If an Island or Swamp is entering the battlefield from your hand at the same time as Choked Estuary, you may reveal the other land to have Choked Estuary enter untapped."""@en ] .

