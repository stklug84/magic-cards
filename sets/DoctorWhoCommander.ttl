    :hasRarity :Uncommon ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :DoctorWhoCommander ;
    :cardNumber "210"^^xsd:integer ;
    :artist "Colin Boyer" ;
    :hasLanguage :English ;
    :printedText """Exile target creature. Its controller may search their library for a basic land card, put that card onto the battlefield tapped, then shuffle."""@en ;
    :oracleText """Exile target creature. Its controller may search their library for a basic land card, put that card onto the battlefield tapped, then shuffle."""@en ;
    :flavorText """"The time has come for you to change your appearance, Doctor, and begin your exile."
—High Council of the Time Lords"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=635536"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/who/210/path-to-exile"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """The controller of the exiled creature isn't required to search their library for a basic land. If that player doesn't, the player won't shuffle their library."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """If the target creature is an illegal target by the time Path to Exile tries to resolve, it won't resolve and none of its effects will happen. The creature's controller won't search for a basic land card."""@en ] .

