:Blink rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Blink" ;
    :manaCost "{2}{U}{B}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasSubType :Saga ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColor :Black ;
    :hasColorIdentity :Blue ;
    :hasColorIdentity :Black ;
    :isInSet :DoctorWhoCommander ;
    :cardNumber "116"^^xsd:integer ;
    :artist "Colin Boyer" ;
    :hasLanguage :English ;
    :hasKeywordAction :Investigate ;
    :hasKeywordAbility :Vigilance ;
    :printedText """(As this Saga enters and after your draw step, add a lore counter. Sacrifice after IV.)
I, III — Choose target creature. Its owner shuffles it into their library, then investigates. (They create a Clue token.)
II, IV — Create a 2/2 black Alien Angel artifact creature token with first strike, vigilance, and "Whenever an opponent casts a creature spell, this token isn't a creature until end of turn.\""""@en ;
    :oracleText """(As this Saga enters and after your draw step, add a lore counter. Sacrifice after IV.)
I, III — Choose target creature. Its owner shuffles it into their library, then investigates. (They create a Clue token.)
II, IV — Create a 2/2 black Alien Angel artifact creature token with first strike, vigilance, and "Whenever an opponent casts a creature spell, this token isn't a creature until end of turn.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=634811"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/who/116/blink"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """People often assume that Sagas are a strict progression from top to bottom, but actually, from a non-linear, non-subjective viewpoint, it's more like a big ball of wibbly wobbly, timey-wimey . . . stuff. That is, the rules support chapter abilities that appear to be out of order, like those on Blink. The first ability triggers when the first and third lore counters are added. The last ability triggers when the second and fourth lore counters are placed on it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If an opponent casts a creature spell with flash while the token is attacking or blocking, the token is removed from combat because it stops being a creature. However, any creatures that it was blocking are still considered blocked."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """As the triggered ability of the Alien Angel token resolves, it continues to be an artifact but will stop being both an Alien and an Angel until it becomes a creature again."""@en ] .

