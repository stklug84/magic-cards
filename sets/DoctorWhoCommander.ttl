      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """Unlike other creature types in Magic that are each only one word, the two words "Time Lord" represent a single creature subtype. Time Lord is the only two-word creature type."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
