        :rulingText """You must pay all costs and follow all normal timing rules to play cards exiled with The Matrix of Time. For example, you may play a land this way only during your main phase while the stack is empty."""@en ] .

:MondassianColonyShip rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Mondassian Colony Ship" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Plane ;
    :hasSubType :SpacecraftPlanar ;
    :hasRarity :Common ;
    :isInSet :DoctorWhoCommander ;
    :cardNumber "590"^^xsd:integer ;
    :artist "Drew Tucker" ;
    :hasLanguage :English ;
    :printedText """Whenever a creature attacks, it gets +1/+1 until end of turn for each other creature its controller controls that shares a creature type with it.
Whenever chaos ensues, turn target creature face down. It becomes a 2/2 Cyberman artifact creature."""@en ;
    :oracleText """Whenever a creature attacks, it gets +1/+1 until end of turn for each other creature its controller controls that shares a creature type with it.
Whenever chaos ensues, turn target creature face down. It becomes a 2/2 Cyberman artifact creature."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=634268"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/who/590/mondassian-colony-ship"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """The player who controls a face-down permanent may look at it at any time. Notably, if the cards were put on the battlefield face down from another player's library, the player that owns them does not get to look at those cards."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If, for any reason, the face-down creature is turned face up, the effect making it a Cyberman ends. It will be whatever is printed on the card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If the face-down card has a morph ability, its controller may turn it face up by paying the associated morph cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """Double-faced permanents that are already on the battlefield can't be turned face down this way. However, a double-faced card can be put onto the battlefield face down from another zone this way."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """Each creature turned face down this way or put onto the battlefield this way is a 2/2 Cyberman artifact creature with no name and no color."""@en ] .

