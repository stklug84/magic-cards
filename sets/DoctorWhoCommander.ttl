    :cardNumber "260"^^xsd:integer ;
    :artist "Nadia Hurianova" ;
    :hasLanguage :English ;
    :producesMana :White ;
    :producesMana :Blue ;
    :entersTapped "true"^^xsd:boolean ;
    :printedText """This land enters tapped.
{T}: Add {W} or {U}.
{3}{W}{U}: Until end of turn, this land becomes a 4/4 white and blue Elemental creature with flying and vigilance. It's still a land."""@en ;
    :oracleText """This land enters tapped.
{T}: Add {W} or {U}.
{3}{W}{U}: Until end of turn, this land becomes a 4/4 white and blue Elemental creature with flying and vigilance. It's still a land."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=635586"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/who/260/celestial-colonnade"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2010-03-01"^^xsd:date ;
        :rulingText """When a land becomes a creature, that doesn't count as having a creature enter. The permanent was already on the battlefield; it only changed its types. Abilities that trigger whenever a creature enters won't trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2010-03-01"^^xsd:date ;
        :rulingText """A land that becomes a creature may be affected by "summoning sickness." You can't attack with it or use any of its {T} abilities (including its mana abilities) unless it began your most recent turn on the battlefield under your control. Note that summoning sickness cares about when that permanent came under your control, not when it became a creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-12-07"^^xsd:date ;
        :rulingText """Once Celestial Colonnade has attacked, tapping it for mana won't remove it from combat."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-12-07"^^xsd:date ;
        :rulingText """If Celestial Colonnade can't attack unless you pay a cost that includes a mana payment, you may attack with it and tap it to pay for that cost. It will still attack in this case."""@en ] .

