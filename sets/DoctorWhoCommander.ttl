:TheToymakersTrap rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "The Toymaker's Trap" ;
    :manaCost "{2}{B}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
