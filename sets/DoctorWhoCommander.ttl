    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If a spell or ability requires multiple players to face a villainous choice, the result is a little different from other effects in Magic. In that case, the first player in turn order makes their choice and the action for that choice is performed before the next player makes their choice. Then each of the remaining players repeat this process in turn order."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """A player facing a villainous choice can always choose either option, even if one or both of the options are impossible. For example, if one of the options is to sacrifice a creature, a player who controls no creatures can still choose that option."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """When a player faces a villainous choice, they first choose one of the two options, then all actions in the chosen option are performed."""@en ] .

:TheFourthDoctorDoctorWhoCommander2 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "The Fourth Doctor" ;
    :manaCost "{2}{G}{U}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :TimeLord ;
    :hasSubType :Doctor ;
    :hasRarity :MythicRare ;
    :hasColor :Blue ;
    :hasColor :Green ;
    :hasColorIdentity :Blue ;
    :hasColorIdentity :Green ;
    :isInSet :DoctorWhoCommander ;
    :cardNumber "2"^^xsd:integer ;
    :artist "David Auden Nash" ;
    :hasLanguage :English ;
    :power "4" ;
    :powerValue "4"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    # Note: keyword "Food" not defined in MagicCardsOntology
    :printedText """You may look at the top card of your library any time.
Would You Like A...? — Once each turn, you may play a historic land or cast a historic spell from the top of your library. When you do, create a Food token. (Artifacts, legendaries, and Sagas are historic.)"""@en ;
    :oracleText """You may look at the top card of your library any time.
Would You Like A...? — Once each turn, you may play a historic land or cast a historic spell from the top of your library. When you do, create a Food token. (Artifacts, legendaries, and Sagas are historic.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=634405"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/who/2/the-fourth-doctor"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If the top card of your library changes during the process of casting a spell or activating an ability, you can't look at the new top card until the process of casting the spell or activating the ability ends (all targets are chosen, all costs are paid, and so on)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """Essentially, The Fourth Doctor lets you play with the top card of your library revealed only to you. Knowing what that card is becomes part of the information you have access to, just like you can look at the cards in your hand. You may look at the top card of your library whenever you want, even if you don't have priority. This action doesn't use the stack."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """Unlike other creature types in Magic that are each only one word, the two words "Time Lord" represent a single creature subtype. Time Lord is the only two-word creature type."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """Neither "Time" nor "Lord" are creature types. Some older cards were printed with the subtype "Lord," but all of those cards have updated Oracle card text that removed that type."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If an effect instructs you to choose a creature type, you may choose Time Lord."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """You can't sacrifice a Food to pay multiple costs. For example, you can't sacrifice a Food token to activate its own ability and also to activate Maraleaf Rider's ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Whatever you do, don't eat the delicious cards."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Food is an artifact type. Even though it appears on some creatures, it's never a creature type."""@en ] .

:SarahJaneSmith rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Sarah Jane Smith" ;
    :manaCost "{1}{W}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Human ;
    :hasSubType :Detective ;
    :hasRarity :Rare ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :DoctorWhoCommander ;
    :cardNumber "6"^^xsd:integer ;
    :artist "Fajareka Setiawan" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "1" ;
    :toughnessValue "1"^^xsd:integer ;
    :hasKeywordAction :Investigate ;
    # Note: keyword "Doctor's companion" not defined in MagicCardsOntology
    :printedText """Whenever you cast a historic spell, investigate. This ability triggers only once each turn. (Artifacts, legendaries, and Sagas are historic. To investigate, create a Clue token. It's an artifact with "{2}, Sacrifice this token: Draw a card.")
Doctor's companion (You can have two commanders if the other is the Doctor.)"""@en ;
    :oracleText """Whenever you cast a historic spell, investigate. This ability triggers only once each turn. (Artifacts, legendaries, and Sagas are historic. To investigate, create a Clue token. It's an artifact with "{2}, Sacrifice this token: Draw a card.")
Doctor's companion (You can have two commanders if the other is the Doctor.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=634421"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/who/6/sarah-jane-smith"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """Once the game begins, your two commanders are tracked separately. If you cast one, you won't have to pay an additional {2} the first time you cast the other. A player loses the game after having been dealt 21 combat damage from any one of them, not from both of them combined."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If something refers to your commander while you have two commanders, it refers to one of them of your choice. If you are instructed to perform an action on your commander (e.g. put it from the command zone into your hand due to Command Beacon), you choose one of your commanders at the time the effect happens."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If your Commander deck has two commanders, you can include only cards whose own color identities are also found in your commanders' combined color identities."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """Although Doctor's companion is a new variant of the partner ability, the rules for partner have not otherwise changed. Notably, Time Lord Doctors and cards with Doctor's companion do not interact with cards which have another partner ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """The Doctor's companion ability allows you to have two commanders if one has the ability and the other is a legendary creature that is a Time Lord Doctor and has no other creature types. Creatures with the changeling ability, for example, can't be a second commander this way."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """Both commanders start in the command zone, and the remaining 98 cards (or 58 cards in a Commander Draft game) of your deck are shuffled to become your library."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """An effect that checks whether you control your commander is satisfied if you control one or both of your two commanders."""@en ] .

:Missy rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Missy" ;
    :manaCost "{3}{U}{B}{R}" ;
    :manaValue "6"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :TimeLord ;
    :hasSubType :Rogue ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColor :Black ;
    :hasColor :Red ;
    :hasColorIdentity :Blue ;
    :hasColorIdentity :Black ;
    :hasColorIdentity :Red ;
    :isInSet :DoctorWhoCommander ;
    :cardNumber "8"^^xsd:integer ;
    :artist "Ekaterina Burmak" ;
    :hasLanguage :English ;
    :power "4" ;
    :powerValue "4"^^xsd:integer ;
    :toughness "5" ;
    :toughnessValue "5"^^xsd:integer ;
    :printedText """Whenever another nonartifact creature dies, return it to the battlefield under your control face down and tapped. It's a 2/2 Cyberman artifact creature.
At the beginning of your end step, each opponent faces a villainous choice — Each artifact creature you control deals 1 damage to that opponent, or you draw a card and chaos ensues."""@en ;
    :oracleText """Whenever another nonartifact creature dies, return it to the battlefield under your control face down and tapped. It's a 2/2 Cyberman artifact creature.
At the beginning of your end step, each opponent faces a villainous choice — Each artifact creature you control deals 1 damage to that opponent, or you draw a card and chaos ensues."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=634423"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/who/8/missy"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """The player who controls a face-down permanent may look at it at any time. Notably, if the cards were put on the battlefield face down from another player's library, the player that owns them does not get to look at those cards."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """A player facing a villainous choice can always choose either option, even if one or both of the options are impossible. For example, if one of the options is to sacrifice a creature, a player who controls no creatures can still choose that option."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """Unlike other creature types in Magic that are each only one word, the two words "Time Lord" represent a single creature subtype. Time Lord is the only two-word creature type."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If, for any reason, the face-down creature is turned face up, the effect making it a Cyberman ends. It will be whatever is printed on the card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If a spell or ability requires multiple players to face a villainous choice, the result is a little different from other effects in Magic. In that case, the first player in turn order makes their choice and the action for that choice is performed before the next player makes their choice. Then each of the remaining players repeat this process in turn order."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """Neither "Time" nor "Lord" are creature types. Some older cards were printed with the subtype "Lord," but all of those cards have updated Oracle card text that removed that type."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """Each creature turned face down this way or put onto the battlefield this way is a 2/2 Cyberman artifact creature with no name and no color."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If an effect instructs you to choose a creature type, you may choose Time Lord."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """Double-faced permanents that are already on the battlefield can't be turned face down this way. However, a double-faced card can be put onto the battlefield face down from another zone this way."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """When a player faces a villainous choice, they first choose one of the two options, then all actions in the chosen option are performed."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If the face-down card has a morph ability, its controller may turn it face up by paying the associated morph cost."""@en ] .

