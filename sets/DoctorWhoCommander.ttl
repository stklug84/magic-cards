    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2004-10-04"^^xsd:date ;
        :rulingText """If there is more than one Propaganda on the battlefield, the cost is cumulative."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2004-10-04"^^xsd:date ;
        :rulingText """If there are multiple attacks in a turn, then you have to pay for each attack."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2004-10-04"^^xsd:date ;
        :rulingText """The payment is made during the declare attackers step at the same time you are declaring the attacker."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2004-10-04"^^xsd:date ;
        :rulingText """Paying this cost is not an instant or any other kind of ability, it is an additional cost on the declaration of the attacker."""@en ] .

:FeedTheSwarm rdf:type owl:NamedIndividual ,
