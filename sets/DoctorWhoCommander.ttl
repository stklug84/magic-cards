:TheDoctorsTomb rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "The Doctor's Tomb" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Plane ;
    :hasSubType :Trenzalore ;
    :hasRarity :Common ;
    :isInSet :DoctorWhoCommander ;
    :cardNumber "580"^^xsd:integer ;
    :artist "Anato Finnstark" ;
    :hasLanguage :English ;
    :printedText """If a creature would die, instead exile it and that creature's controller loses 2 life.
Whenever chaos ensues, redistribute any number of players' life totals. (Each of those players gets one life total back.)"""@en ;
    :oracleText """If a creature would die, instead exile it and that creature's controller loses 2 life.
Whenever chaos ensues, redistribute any number of players' life totals. (Each of those players gets one life total back.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=634258"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/who/580/the-doctors-tomb"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """You can't split up a life total when you redistribute it. For example, suppose that in a two-player game your life total is 5 and your opponent's life total is 15 when the chaos ability starts to resolve. You can choose to (a) leave the life totals as they are or (b) make your life total 15 and your opponent's 5. You can't choose to make your life total 20 and your opponent's 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """You choose which player gets which life total when the chaos ability resolves."""@en ] .

