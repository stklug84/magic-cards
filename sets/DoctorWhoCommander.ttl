        :rulingText """You choose the modes as you cast the spell. Once modes are chosen, they can't be changed."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """No matter which combination of modes you choose, you always follow the instructions in the order they are written."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """No player can cast spells or activate abilities in between the modes of a resolving spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If an effect copies Doomsday Confluence, the copy will have the same modes chosen the same number of times."""@en ] .

