    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """Double-faced permanents that are already on the battlefield can't be turned face down this way. However, a double-faced card can be put onto the battlefield face down from another zone this way."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If, for any reason, the face-down creature is turned face up, the effect making it a Cyberman ends. It will be whatever is printed on the card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """The player who controls a face-down permanent may look at it at any time. Notably, if the cards were put on the battlefield face down from another player's library, the player that owns them does not get to look at those cards."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """If the face-down card has a morph ability, its controller may turn it face up by paying the associated morph cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-10-13"^^xsd:date ;
        :rulingText """Each creature turned face down this way or put onto the battlefield this way is a 2/2 Cyberman artifact creature with no name and no color."""@en ] .

