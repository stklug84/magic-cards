:TamiyosCompleation rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Tamiyo's Compleation" ;
    :manaCost "{3}{U}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasSubType :Aura ;
    :hasRarity :Common ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :KamigawaNeonDynasty ;
    :cardNumber "83"^^xsd:integer ;
    :artist "Dominik Mayer" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Enchant ,
                       :Flash ;
    :printedText """Flash
Enchant artifact, creature, or planeswalker
When this Aura enters, tap enchanted permanent. If it's an Equipment, unattach it.
Enchanted permanent loses all abilities and doesn't untap during its controller's untap step."""@en ;
    :oracleText """Flash
Enchant artifact, creature, or planeswalker
When this Aura enters, tap enchanted permanent. If it's an Equipment, unattach it.
Enchanted permanent loses all abilities and doesn't untap during its controller's untap step."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=548381"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/neo/83/tamiyos-compleation"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "79508"^^xsd:positiveInteger ;
    :arenaName "Tamiyo's Compleation" ;
    :arenaSetCode "NEO" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2022-02-18"^^xsd:date ;
        :rulingText """An Equipment creature that loses its reconfigure ability cannot be attached to a creature by any effect."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-02-18"^^xsd:date ;
        :rulingText """An attached Equipment with reconfigure that loses its reconfigure ability doesn't become a creature again until it becomes unattached, and it won't become unattached until the triggered ability of Tamiyo's Compleation resolves. If that ability is countered, the Equipment will stay attached to the equipped creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-02-18"^^xsd:date ;
        :rulingText """A planeswalker with Tamiyo's Compleation attached to it may still be attacked and it will continue to lose loyalty counters if damage is dealt to it."""@en ] .

