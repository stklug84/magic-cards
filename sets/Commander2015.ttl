@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@prefix :     <urn:stklug84:MagicCardsOntology:2026-02-27#> .
@base         <urn:stklug84:MagicCardIndividuals:C15:2026-07-19#> .

################################################################################
#
# Ontology Definition
#
################################################################################

<urn:stklug84:MagicCardIndividuals:C15:2026-07-19#>
    rdf:type owl:Ontology ;
    owl:imports <urn:stklug84:MagicCardsOntology:2026-02-27#> ;
    rdfs:label "Magic Card Collection Individuals – Commander 2015"@en ;
    rdfs:comment """An instance graph describing the card individuals of a
personal Magic: The Gathering card collection that were printed in the set
Commander 2015 (C15). One Card individual is defined per collected
printing, carrying its characteristics, the platforms it is available on
(paper, MTG Arena, Magic Online) with its MTG Arena identity, its legality
in the paper and MTG Arena formats, and official rulings. Card data was
sourced from Gatherer and Scryfall. This file imports MagicCardsOntology to
reuse all existing class, property, set, keyword, subtype, format and
legality definitions."""@en .


################################################################################
#
# Card Individuals
#
################################################################################

:VividCrag rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Vivid Crag" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Land ;
    :hasRarity :Uncommon ;
    :hasColorIdentity :Red ;
    :isInSet :Commander2015 ;
    :cardNumber "316"^^xsd:integer ;
    :artist "Martina Pilcerova" ;
    :hasLanguage :English ;
    :producesMana :White ,
                  :Blue ,
                  :Black ,
                  :Red ,
                  :Green ;
    :entersTapped "true"^^xsd:boolean ;
    :printedText """This land enters tapped with two charge counters on it.
{T}: Add {R}.
{T}, Remove a charge counter from this land: Add one mana of any color."""@en ;
    :oracleText """This land enters tapped with two charge counters on it.
{T}: Add {R}.
{T}, Remove a charge counter from this land: Add one mana of any color."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=405439"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/c15/316/vivid-crag"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
