:ColossusOfAkros rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Colossus of Akros" ;
    :manaCost "{8}" ;
    :manaValue "8"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ,
                 :Creature ;
    :hasSubType :Golem ;
    :hasRarity :Rare ;
    :isInSet :Theros ;
    :cardNumber "214"^^xsd:integer ;
    :artist "Zack Stella" ;
    :hasLanguage :English ;
    :power "10" ;
    :powerValue "10"^^xsd:integer ;
    :toughness "10" ;
    :toughnessValue "10"^^xsd:integer ;
    :hasKeywordAbility :Indestructible ,
                       :Defender ;
    :hasKeywordAction :Monstrosity ;
    :printedText """Defender, indestructible
{10}: Monstrosity 10. (If this creature isn't monstrous, put ten +1/+1 counters on it and it becomes monstrous.)
As long as this creature is monstrous, it has trample and can attack as though it didn't have defender."""@en ;
    :oracleText """Defender, indestructible
{10}: Monstrosity 10. (If this creature isn't monstrous, put ten +1/+1 counters on it and it becomes monstrous.)
As long as this creature is monstrous, it has trample and can attack as though it didn't have defender."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=373555"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/ths/214/colossus-of-akros"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2013-09-15"^^xsd:date ;
        :rulingText """Monstrous isn't an ability that a creature has. It's just something true about that creature. If the creature stops being a creature or loses its abilities, it will continue to be monstrous."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-09-15"^^xsd:date ;
        :rulingText """Once a creature becomes monstrous, it can't become monstrous again. If the creature is already monstrous when the monstrosity ability resolves, nothing happens."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-09-15"^^xsd:date ;
        :rulingText """Colossus of Akros doesn't lose defender when it's monstrous. It's just able to attack."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-09-15"^^xsd:date ;
        :rulingText """An ability that triggers when a creature becomes monstrous won't trigger if that creature isn't on the battlefield when its monstrosity ability resolves."""@en ] .
