    :hasLanguage :English ;
    :producesMana :White ,
                  :Blue ;
    :entersTapped "true"^^xsd:boolean ;
    :printedText """({T}: Add {W} or {U}.)
This land enters tapped."""@en ;
    :oracleText """({T}: Add {W} or {U}.)
This land enters tapped."""@en ;
    :flavorText """"A cliff once rose from the surf here—until Bjora Dawn-Greeter declared that it was blocking her view and pulled it down bare-handed."
—Iskene, Kannah storyteller"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=503876"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/khm/257/glacial-floodplain"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "75307"^^xsd:positiveInteger ;
    :arenaName "Glacial Floodplain" ;
    :arenaSetCode "KHM" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """Snow is a supertype, not a card type. It has no rules meaning or function by itself, but spells and abilities may refer to it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """The {S} symbol is a generic mana symbol. It represents a cost that can be paid by one mana that was produced by a snow source. That mana can be any color or colorless."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """Some cards have additional effects for each {S} spent to cast them. You can cast these spells even if you don't spend any snow mana to cast them; their additional effects simply won't do anything."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """The Kaldheim set doesn't have any cards with mana costs that include {S}, but some previous sets do. If an effect says such a spell costs {1} less to cast, that reduction doesn't apply to any {S} costs. This is also true for activated abilities that include {S} in their activation costs and effects that reduce those costs."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """Snow isn't a type of mana. If an effect says you may spend mana as though it were any type, you can't pay for {S} using mana that wasn't produced by a snow source."""@en ] .

:KayaTheInexorable rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Kaya the Inexorable" ;
    :manaCost "{3}{W}{B}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Planeswalker ;
    :hasSubType :Kaya ;
    :hasRarity :MythicRare ;
    :hasColor :White ,
              :Black ;
    :hasColorIdentity :White ,
                      :Black ;
    :isInSet :Kaldheim ;
    :cardNumber "288"^^xsd:integer ;
    :artist "Livia Prima" ;
    :hasLanguage :English ;
    :loyalty "5"^^xsd:integer ;
    :printedText """+1: Put a ghostform counter on up to one target nontoken creature. It gains "When this creature dies or is put into exile, return it to its owner's hand and create a 1/1 white Spirit creature token with flying."
−3: Exile target nonland permanent.
−7: You get an emblem with "At the beginning of your upkeep, you may cast a legendary spell from your hand, from your graveyard, or from among cards you own in exile without paying its mana cost.\""""@en ;
    :oracleText """+1: Put a ghostform counter on up to one target nontoken creature. It gains "When this creature dies or is put into exile, return it to its owner's hand and create a 1/1 white Spirit creature token with flying."
−3: Exile target nonland permanent.
−7: You get an emblem with "At the beginning of your upkeep, you may cast a legendary spell from your hand, from your graveyard, or from among cards you own in exile without paying its mana cost.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=507139"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/khm/288/kaya-the-inexorable"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "76888"^^xsd:positiveInteger ;
    :arenaName "Kaya the Inexorable" ;
    :arenaSetCode "KHM" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """If the spell has {X} in its mana cost, you must choose 0 as the value of X."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """If you cast a spell “without paying its mana cost,” you can’t choose to cast it for any alternative costs. You can, however, pay additional costs, such as kicker costs. If the card has any mandatory additional costs, those must be paid to cast the spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """If you own a face-down card in exile, Kaya’s emblem will let you cast it only if you can look at the card (and only if it’s legendary). If you aren’t allowed to look at the card, you can’t cast it, even if you know it’s legendary."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """The ghostform counter added by the first ability doesn’t have any functional importance. It’s there to remind you of the ability the creature gains. Even if that counter is removed from the creature, the triggered ability it gains will still work."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-02-05"^^xsd:date ;
        :rulingText """If a nontoken creature gains more than one instance of that triggered ability, each of them will trigger separately. You can return the card to its owner’s hand only once, but you’ll create a Spirit creature token for each of those abilities."""@en ] .
