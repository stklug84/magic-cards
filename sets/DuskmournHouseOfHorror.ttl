:LivingPhone rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Living Phone" ;
    :manaCost "{2}{W}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ,
                 :Creature ;
    :hasSubType :Toy ;
    :hasRarity :Common ;
    :hasColor :White ;
