    :artist "Chris Rallis" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "2" ;
    :toughnessValue "2"^^xsd:integer ;
    :hasKeywordAbility :Lifelink ;
    :hasAbilityWord :Survival ;
    :printedText """Survival — At the beginning of your second main phase, if this creature is tapped, put a flying, lifelink, or +1/+1 counter on it.
Whenever this creature or another creature you control dies, if it had counters on it, put those counters on up to one target creature."""@en ;
    :oracleText """Survival — At the beginning of your second main phase, if this creature is tapped, put a flying, lifelink, or +1/+1 counter on it.
Whenever this creature or another creature you control dies, if it had counters on it, put those counters on up to one target creature."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=673431"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/dsk/26/reluctant-role-model"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "92086"^^xsd:positiveInteger ;
    :arenaName "Reluctant Role Model" ;
    :arenaSetCode "DSK" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If Reluctant Role Model dies at the same time as one or more other creatures with counters on them, its last ability will trigger for each of those creatures."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Reluctant Role Model's last ability doesn't cause you to move counters from the creature that died onto the target creature. Rather, you put the same number of each kind of counter the creature that died had when it died onto the target creature. Other effects that interact with putting counters onto that creature will interact with this effect accordingly."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If the creature that died had -1/-1 counters on it when it died, Reluctant Role Model's last ability will include those as well. This may result in the target creature also dying."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Survival abilities (and other abilities that trigger at the beginning of your second main phase) will trigger at the beginning of the second main phase you take in a turn. They won't trigger during your third, fourth, or other additional main phases in a single turn, if effects somehow cause you to have more than two main phases."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If a creature's survival ability triggers but the creature leaves the battlefield before the ability resolves, use its tapped or untapped status as it last existed on the battlefield to determine whether or not the ability will do anything."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If a creature with a survival ability isn't tapped when your second main phase begins, the ability won't trigger at all. You won't be able to tap it during your second main phase in time to have that ability trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If a creature's survival ability triggers but that creature is untapped when the ability begins to resolve, that ability won't do anything."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """In some unusual cases, you may end up putting the appropriate counters on more than one permanent. For example, if you control The Ozolith when Reluctant Role Model dies, you'll put the appropriate number of each kind of counter onto both The Ozolith and the target creature."""@en ] .

:TobyBeastieBefriender rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Toby, Beastie Befriender" ;
    :manaCost "{2}{W}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Human ,
                :Wizard ;
    :hasRarity :Rare ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :DuskmournHouseOfHorror ;
    :cardNumber "35"^^xsd:integer ;
    :artist "Jehan Choo" ;
    :hasLanguage :English ;
    :power "1" ;
    :powerValue "1"^^xsd:integer ;
    :toughness "1" ;
    :toughnessValue "1"^^xsd:integer ;
    :printedText """When Toby enters, create a 4/4 white Beast creature token with "This token can't attack or block alone."
As long as you control four or more creature tokens, creature tokens you control have flying."""@en ;
    :oracleText """When Toby enters, create a 4/4 white Beast creature token with "This token can't attack or block alone."
As long as you control four or more creature tokens, creature tokens you control have flying."""@en ;
    :flavorText """"Sure, I'm pretty small, but Gribble isn't, so I don't get scared.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=673440"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/dsk/35/toby-beastie-befriender"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "92097"^^xsd:positiveInteger ;
    :arenaName "Toby, Beastie Befriender" ;
    :arenaSetCode "DSK" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Once the Beast token has attacked or blocked, removing all of your other attacking or blocking creatures won't cause it to stop attacking or blocking."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If you control more than one creature with "This creature can't attack or block alone" they can attack or block together, even if no other creatures attack or block."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If an effect says the Beast token attacks or blocks "if able" and you control one or more other creatures that are able to attack or block, you must attack or block with the Beast token and at least one other creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Although the Beast token can't attack alone, other attacking creatures don't have to attack the same player, planeswalker, or battle. For example, the Beast token could attack an opponent and another creature could attack a planeswalker. Similarly, other blocking creatures don't have to block the same creature that the Beast token blocks."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """In a Two-Headed Giant game, the Beast token can attack or block with a creature controlled by your teammate, even if no other creatures you control are attacking or blocking."""@en ] .

:UnwantedRemake rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Unwanted Remake" ;
    :manaCost "{W}" ;
    :manaValue "1"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Uncommon ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :DuskmournHouseOfHorror ;
    :cardNumber "39"^^xsd:integer ;
    :artist "Eli Minaya" ;
    :hasLanguage :English ;
    :printedText """Destroy target creature. Its controller manifests dread. (That player looks at the top two cards of their library, then puts one onto the battlefield face down as a 2/2 creature and the other into their graveyard. If it's a creature card, it can be turned face up any time for its mana cost.)"""@en ;
    :oracleText """Destroy target creature. Its controller manifests dread. (That player looks at the top two cards of their library, then puts one onto the battlefield face down as a 2/2 creature and the other into their graveyard. If it's a creature card, it can be turned face up any time for its mana cost.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=673444"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/dsk/39/unwanted-remake"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "92101"^^xsd:positiveInteger ;
    :arenaName "Unwanted Remake" ;
    :arenaSetCode "DSK" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If your library contains only one card when you manifest dread, you'll look at that card and put it onto the battlefield face down. You won't have the option to put it into your graveyard instead. If your library contains no cards when you manifest dread, you won't do anything."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Any time you have priority, you can turn a manifested permanent you control face up by revealing that it's a creature card (ignoring any copy effects or type-changing effects that might be applying to it) and paying its mana cost. This is a special action. It doesn't use the stack and can't be responded to."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If a double-faced card is manifested, it will be put onto the battlefield face down. While face down, it can't transform. If the front face of the card is a creature card, you can turn it face up by paying its mana cost. If you do, its front face will be up."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Because the permanent is on the battlefield both before and after it's turned face up, turning a permanent face up doesn't cause any enters-the-battlefield abilities to trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If a face-down spell leaves the stack and goes to any zone other than the battlefield (if it was countered, for example), you must reveal it. Similarly, if a face-down permanent leaves the battlefield, you must reveal it. You must also reveal all face-down spells and permanents you control if you leave the game or the game ends."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Some cards in the Duskmourn release have abilities that trigger "whenever you manifest dread." In circumstances where you are instructed to manifest dread but can't perform some or all of the steps of manifesting dread (probably because your library has one or fewer cards in it), these abilities will still trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If a manifested creature would have disguise or morph if it were face up, you may also turn it face up by paying its disguise or morph cost, as appropriate."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """A permanent that turns face up or face down changes characteristics but is otherwise the same permanent. Spells and abilities that were targeting that permanent and Auras and Equipment that were attached to that permanent aren't affected unless the new characteristics of the object change the legality of those targets or attachments."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If the target creature is an illegal target as Unwanted Remake tries to resolve, it won't resolve and none of its effects will happen. The creature's controller won't manifest dread."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If a face-down creature loses its abilities, it can't be turned face up with a disguise or morph ability because it will no longer have that ability (or the associated cost) once face up."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """At any time, you can look at a face-down spell or permanent you control. You can't look at face-down permanents or spells you don't control unless an effect instructs or allows you to do so."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Because face-down creatures don't have a name, they can't have the same name as any other creature, even another face-down creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Turning a permanent face up or face down doesn't change whether that permanent is tapped or untapped."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If something tries to turn a face-down instant or sorcery card on the battlefield face up, reveal that card to show all players it's an instant or sorcery card. The permanent remains on the battlefield face down. Abilities that trigger when a permanent turns face up won't trigger, because even though you revealed the card, it never turned face up."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """To manifest dread, look at the top two cards of your library. Manifest one (by putting it onto the battlefield face down) and put the other into your graveyard. The card you put onto the battlefield becomes a 2/2 face-down creature with no name, mana cost, creature types, or abilities. It's colorless and has a mana value of 0. Other effects that apply to the permanent can still grant it any characteristics it doesn't have or change the characteristics it does have."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Unlike a face-down creature that was cast using a disguise or morph ability, a manifested creature may still be turned face up after it loses its abilities if it's a creature card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """You must ensure that your face-down spells and permanents can be easily differentiated from each other. You're not allowed to mix up the cards that represent them on the battlefield to confuse other players. The order in which they entered should remain clear, as well as what ability caused them to be face down. (This includes manifest, disguise, cloak, morph, and a few older effects that turn cards face down.) Common methods for doing this include using markers or dice, or simply placing them in order on the battlefield."""@en ] .

