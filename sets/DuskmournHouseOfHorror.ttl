    :toughnessValue "1"^^xsd:integer ;
    :printedText """This creature can't be blocked.
Whenever this creature deals combat damage to a player, choose one that hasn't been chosen —
• Put two +1/+1 counters on this creature.
• Draw a card.
• This creature becomes a copy of another target creature you control."""@en ;
    :oracleText """This creature can't be blocked.
Whenever this creature deals combat damage to a player, choose one that hasn't been chosen —
• Put two +1/+1 counters on this creature.
• Draw a card.
• This creature becomes a copy of another target creature you control."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=673477"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/dsk/72/silent-hallcreeper"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "92142"^^xsd:positiveInteger ;
    :arenaName "Silent Hallcreeper" ;
    :arenaSetCode "DSK" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Silent Hallcreeper copies exactly what was printed on the target creature and nothing else (unless that creature is copying something else or is a token; see below). It doesn't copy whether that creature is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """The phrase "that hasn't been chosen" refers only to that specific Silent Hallcreeper. If Silent Hallcreeper leaves the battlefield and then returns to the battlefield later, it will be a new object with no memory of the modes that were chosen when it was last on the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If the copied creature is a token, Silent Hallcreeper copies the original characteristics of that token as stated by the effect that created that token."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """When Silent Hallcreeper becomes a copy of the target creature, it's neither entering nor leaving the battlefield. Any enters-the-battlefield or leaves-the-battlefield abilities won't trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If the third mode is chosen for Silent Hallcreeper's last ability but the target creature is an illegal target as the ability tries to resolve, it won't resolve and none of its effects will happen."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """While Silent Hallcreeper is a copy of another creature, it won't have any of its previous abilities."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If the copied creature is copying something else, then Silent Hallcreeper becomes a copy of whatever that creature copied."""@en ] .

