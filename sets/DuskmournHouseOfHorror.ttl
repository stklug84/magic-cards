    :cardNumber "111"^^xsd:integer ;
    :artist "Jodie Muir" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Flash ;
    :printedText """Flash
When this enchantment enters, target creature an opponent controls gets -3/-3 until end of turn.
Creatures your opponents control can be the targets of spells and abilities as though they didn't have hexproof. Ward abilities of those creatures don't trigger."""@en ;
    :oracleText """Flash
When this enchantment enters, target creature an opponent controls gets -3/-3 until end of turn.
Creatures your opponents control can be the targets of spells and abilities as though they didn't have hexproof. Ward abilities of those creatures don't trigger."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=673516"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/dsk/111/nowhere-to-run"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "92189"^^xsd:positiveInteger ;
    :arenaName "Nowhere to Run" ;
    :arenaSetCode "DSK" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If a spell or ability targeting a creature an opponent controls with a ward ability is on the stack, causing Nowhere to Run to leave the battlefield won't cause that ward ability to trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If a spell or ability you control targets a creature an opponent controls with hexproof and Nowhere to Run leaves the battlefield while that spell or ability is on the stack, that creature becomes an illegal target for that spell or ability. This includes Nowhere to Run's own triggered ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Ward abilities of creatures your opponents control won't trigger as long as Nowhere to Run is on the battlefield. It doesn't matter whether or not they have hexproof."""@en ] .

:ResurrectedCultist rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Resurrected Cultist" ;
    :manaCost "{2}{B}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Human ,
                :Cleric ;
    :hasRarity :Common ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :DuskmournHouseOfHorror ;
    :cardNumber "115"^^xsd:integer ;
    :artist "Tyler Walpole" ;
    :hasLanguage :English ;
    :power "4" ;
    :powerValue "4"^^xsd:integer ;
    :toughness "1" ;
    :toughnessValue "1"^^xsd:integer ;
    :hasAbilityWord :Delirium ;
    :printedText """Delirium — {2}{B}{B}: Return this card from your graveyard to the battlefield with a finality counter on it. Activate only if there are four or more card types among cards in your graveyard and only as a sorcery. (If a creature with a finality counter on it would die, exile it instead.)"""@en ;
    :oracleText """Delirium — {2}{B}{B}: Return this card from your graveyard to the battlefield with a finality counter on it. Activate only if there are four or more card types among cards in your graveyard and only as a sorcery. (If a creature with a finality counter on it would die, exile it instead.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=673520"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/dsk/115/resurrected-cultist"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "92193"^^xsd:positiveInteger ;
    :arenaName "Resurrected Cultist" ;
    :arenaSetCode "DSK" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Finality counters don't stop permanents from going to zones other than the graveyard from the battlefield. For example, if a permanent with a finality counter on it would be put into its owner's hand from the battlefield, it does so normally."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Multiple finality counters on a single permanent are redundant."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Finality counters aren't keyword counters, and a finality counter doesn't give any abilities to the permanent it's on. If that permanent loses its abilities and then would go to a graveyard, it will still be exiled instead."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Finality counters work on any permanent, not only creatures. If a permanent with a finality counter on it would be put into a graveyard from the battlefield, exile it instead."""@en ] .

