:GrowthSpiral rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Growth Spiral" ;
    :manaCost "{G}{U}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Common ;
    :hasColor :Blue ;
    :hasColor :Green ;
    :hasColorIdentity :Blue ;
    :hasColorIdentity :Green ;
    :isInSet :DuskmournHouseOfHorrorCommander ;
    :cardNumber "88"^^xsd:integer ;
    :artist "Nicholas Gregory" ;
    :hasLanguage :English ;
    :printedText """Draw a card. You may put a land card from your hand onto the battlefield."""@en ;
    :oracleText """Draw a card. You may put a land card from your hand onto the battlefield."""@en ;
    :flavorText """Hidden within the infinite, protean rooms of the House are strange pockets of power that only the bravest dare access."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=675816"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/dsc/88/growth-spiral"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2019-01-25"^^xsd:date ;
        :rulingText """Growth Spiral's effect doesn't count as playing a land. It can put a land card onto the battlefield even if it's not your turn or if you've already played your land for the turn."""@en ] .

