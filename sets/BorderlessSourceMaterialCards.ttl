:PathToExileBorderlessSourceMaterialCards1 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Path to Exile" ;
    :manaCost "{W}" ;
    :manaValue "1"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :MythicRare ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :BorderlessSourceMaterialCards ;
    :cardNumber "1"^^xsd:integer ;
    :artist "Kevin Eastman" ;
    :hasLanguage :English ;
    :printedText """Exile target creature. Its controller may search their library for a basic land card, put that card onto the battlefield tapped, then shuffle."""@en ;
    :oracleText """Exile target creature. Its controller may search their library for a basic land card, put that card onto the battlefield tapped, then shuffle."""@en ;
    :scryfallUrl "https://scryfall.com/card/pza/1/path-to-exile"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "100663"^^xsd:positiveInteger ;
    :arenaName "Path to Exile" ;
    :arenaSetCode "PZA" ;
    :arenaCollectorNumber "0" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """The controller of the exiled creature isn't required to search their library for a basic land. If that player doesn't, the player won't shuffle their library."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """If the target creature is an illegal target by the time Path to Exile tries to resolve, it won't resolve and none of its effects will happen. The creature's controller won't search for a basic land card."""@en ] .

:DoublingSeasonBorderlessSourceMaterialCards11 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Doubling Season" ;
    :manaCost "{4}{G}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :MythicRare ;
    :hasColor :Green ;
    :hasColorIdentity :Green ;
    :isInSet :BorderlessSourceMaterialCards ;
    :cardNumber "11"^^xsd:integer ;
    :artist "Kevin Eastman" ;
    :hasLanguage :English ;
    :printedText """If an effect would create one or more tokens under your control, it creates twice that many of those tokens instead.
If an effect would put one or more counters on a permanent you control, it puts twice that many of those counters on that permanent instead."""@en ;
    :oracleText """If an effect would create one or more tokens under your control, it creates twice that many of those tokens instead.
If an effect would put one or more counters on a permanent you control, it puts twice that many of those counters on that permanent instead."""@en ;
    :scryfallUrl "https://scryfall.com/card/pza/11/doubling-season"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "100673"^^xsd:positiveInteger ;
    :arenaName "Doubling Season" ;
    :arenaSetCode "PZA" ;
    :arenaCollectorNumber "0" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If there are two Doubling Seasons on the battlefield, then the number of tokens or counters is four times the original number. If there are three on the battlefield, then the number of tokens or counters is eight times the original number, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Battles will enter with double the normal number of defense counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Everything that is specified by the effect creating the original token or tokens will also be true about the additional token or tokens created by Doubling Season's replacement effect. For example, if an effect tells you to create a token "tapped and attacking," the additional tokens will also be tapped and attacking."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Doubling Season affects permanents that enter with counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Planeswalkers will enter with double the normal number of loyalty counters. However, if you activate an ability whose cost has you put loyalty counters on a planeswalker, the number you put on isn't doubled. This is because those counters are put on as a cost, not as an effect."""@en ] .
