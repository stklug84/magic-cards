:MidnightClockModernHorizons3Commander189 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Midnight Clock" ;
    :manaCost "{2}{U}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :ModernHorizons3Commander ;
    :cardNumber "189"^^xsd:integer ;
    :artist "Alexander Forssberg" ;
    :hasLanguage :English ;
    :printedText """{T}: Add {U}.
{2}{U}: Put an hour counter on this artifact.
At the beginning of each upkeep, put an hour counter on this artifact.
When the twelfth hour counter is put on this artifact, shuffle your hand and graveyard into your library, then draw seven cards. Exile this artifact."""@en ;
    :oracleText """{T}: Add {U}.
{2}{U}: Put an hour counter on this artifact.
At the beginning of each upkeep, put an hour counter on this artifact.
When the twelfth hour counter is put on this artifact, shuffle your hand and graveyard into your library, then draw seven cards. Exile this artifact."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=665603"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/m3c/189/midnight-clock"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2019-10-04"^^xsd:date ;
        :rulingText """Midnight Clock's first triggered ability triggers at the beginning of each upkeep, not just your upkeep. In a Two-Headed Giant game, an ability that triggers at the beginning of each upkeep rather than each player's upkeep triggers only once during each team's upkeep."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-10-04"^^xsd:date ;
        :rulingText """You can activate Midnight Clock's mana ability to pay the cost of its second ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-10-04"^^xsd:date ;
        :rulingText """Midnight Clock's last ability triggers after one or more counters are put onto it if it had fewer than twelve counters on it before those counters were put on it and it has twelve or more counters on it after."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-10-04"^^xsd:date ;
        :rulingText """If Midnight Clock leaves the battlefield while its last ability is on the stack, it won't be exiled."""@en ] .

:TezzeretsGambitModernHorizons3Commander194 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Tezzeret's Gambit" ;
    :manaCost "{3}{U/P}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Uncommon ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :ModernHorizons3Commander ;
    :cardNumber "194"^^xsd:integer ;
    :artist "Karl Kopinski" ;
    :hasLanguage :English ;
    :hasKeywordAction :Proliferate ;
    :printedText """({U/P} can be paid with either {U} or 2 life.)
Draw two cards, then proliferate. (Choose any number of permanents and/or players, then give each another counter of each kind already there.)"""@en ;
    :oracleText """({U/P} can be paid with either {U} or 2 life.)
Draw two cards, then proliferate. (Choose any number of permanents and/or players, then give each another counter of each kind already there.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=665608"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/m3c/194/tezzerets-gambit"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2011-06-01"^^xsd:date ;
        :rulingText """Phyrexian mana is not a new color. Players can't produce Phyrexian mana."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2011-06-01"^^xsd:date ;
        :rulingText """To calculate the mana value of a card with Phyrexian mana symbols in its cost, count each Phyrexian mana symbol as 1."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2011-06-01"^^xsd:date ;
        :rulingText """As you cast a spell or activate an activated ability with one or more Phyrexian mana symbols in its cost, you choose how to pay for each Phyrexian mana symbol at the same time you would choose modes or choose a value for X."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2011-06-01"^^xsd:date ;
        :rulingText """A card with Phyrexian mana symbols in its mana cost is each color that appears in that mana cost, regardless of how that cost may have been paid."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2011-06-01"^^xsd:date ;
        :rulingText """If you're at 1 life or less, you can't pay 2 life."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """If a permanent ever has both +1/+1 counters and -1/-1 counters on it at the same time, they're removed in pairs as a state-based action so that the permanent has only one of those kinds of counters on it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """An ability that triggers "Whenever you proliferate" triggers even if you chose no permanents or players while doing so."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """If a player or permanent has more than one kind of counter on it, and you choose for it to get additional counters, it must get one of each kind of counter it already has. You can't have it get just one kind of counter it already has and not the others."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """Players can respond to a spell or ability whose effect includes proliferating. Once that spell or ability starts to resolve, however, and its controller chooses which permanents and players will get new counters, it's too late for anyone to respond."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """To proliferate, you can choose any permanent that has a counter, including ones controlled by opponents. You can choose any player who has a counter, including opponents. You can't choose cards in any zone other than the battlefield, even if they have counters on them."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """You don't have to choose every permanent or player that has a counter, only the ones you want to add another counter to. Since "any number" includes zero, you don't have to choose any permanents at all, and you don't have to choose any players at all."""@en ] .

:CombustibleGearhulkModernHorizons3Commander210 rdf:type owl:NamedIndividual ,
