:PortTownModernHorizons3Commander364 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Port Town" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Land ;
    :hasRarity :Rare ;
    :hasColorIdentity :White ;
    :hasColorIdentity :Blue ;
    :isInSet :ModernHorizons3Commander ;
    :cardNumber "364"^^xsd:integer ;
    :artist "Kamila Szutenberg" ;
    :hasLanguage :English ;
    :printedText """As this land enters, you may reveal a Plains or Island card from your hand. If you don't, this land enters tapped.
{T}: Add {W} or {U}."""@en ;
    :oracleText """As this land enters, you may reveal a Plains or Island card from your hand. If you don't, this land enters tapped.
{T}: Add {W} or {U}."""@en ;
    :flavorText """A haunted fog known as the Nebelgast shrouds the cities along Nephalia's coast."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=665778"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/m3c/364/port-town"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2016-04-08"^^xsd:date ;
        :rulingText """If an effect instructs you to put Port Town onto the battlefield tapped, it will still enter the battlefield tapped even if you reveal a land card from your hand."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-04-08"^^xsd:date ;
        :rulingText """You may reveal any land card with either or both of the appropriate subtypes. It doesn't have to be a basic land. For example, you could reveal Canopy Vista from the Battle for Zendikar set to satisfy the ability of Port Town."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-04-08"^^xsd:date ;
        :rulingText """If a Plains or Island is entering the battlefield from your hand at the same time as Port Town, you may reveal the other land to have Port Town enter untapped."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-04-08"^^xsd:date ;
        :rulingText """Lands don't have a subtype just because they can produce mana of the corresponding color. Port Town itself is neither a Plains nor an Island, even though it produces white and blue mana, so you can't reveal one to satisfy the ability of another."""@en ] .

:PrairieStreamModernHorizons3Commander365 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Prairie Stream" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Land ;
    :hasSubType :Plains ;
    :hasSubType :Island ;
    :hasRarity :Rare ;
    :hasColorIdentity :White ;
    :hasColorIdentity :Blue ;
    :isInSet :ModernHorizons3Commander ;
    :cardNumber "365"^^xsd:integer ;
    :artist "Adam Paquette" ;
    :hasLanguage :English ;
    :printedText """({T}: Add {W} or {U}.)
This land enters tapped unless you control two or more basic lands."""@en ;
    :oracleText """({T}: Add {W} or {U}.)
This land enters tapped unless you control two or more basic lands."""@en ;
    :flavorText """The continent of Ondu is a vast plateau crisscrossed by deep trenches and meandering rivers."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=665779"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/m3c/365/prairie-stream"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2015-08-25"^^xsd:date ;
        :rulingText """Even though these lands have basic land types, they are not basic lands because "basic" doesn't appear on their type line. Notably, controlling two or more of them won't allow others to enter the battlefield untapped."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-08-25"^^xsd:date ;
        :rulingText """If one of these lands enters the battlefield at the same time as any number of basic lands, those other lands are not counted when determining if this land enters the battlefield tapped or untapped."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-08-25"^^xsd:date ;
        :rulingText """However, because these cards have basic land types, effects that specify a basic land type without also specifying that the land be basic can affect them. For example, a spell or ability that reads "Destroy target Forest" can target Canopy Vista, while one that reads "Destroy target basic Forest" cannot."""@en ] .

