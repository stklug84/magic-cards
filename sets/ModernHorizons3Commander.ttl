:SpawningBed rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Spawning Bed" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Land ;
    :hasRarity :Uncommon ;
    :isInSet :ModernHorizons3Commander ;
    :cardNumber "380"^^xsd:integer ;
    :artist "Jason Felix" ;
    :hasLanguage :English ;
    :printedText """{T}: Add {C}.
{6}, {T}, Sacrifice this land: Create three 1/1 colorless Eldrazi Scion creature tokens. They have "Sacrifice this token: Add {C}.\""""@en ;
    :oracleText """{T}: Add {C}.
{6}, {T}, Sacrifice this land: Create three 1/1 colorless Eldrazi Scion creature tokens. They have "Sacrifice this token: Add {C}.\""""@en ;
    :flavorText """Young Eldrazi crawl forth from the dust, compelled by a greater will."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=665794"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/m3c/380/spawning-bed"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2015-08-25"^^xsd:date ;
        :rulingText """Some instants and sorceries that create Eldrazi Scions require targets. If all targets for such a spell have become illegal by the time that spell tries to resolve, the spell won't resolve and none of its effects will happen. You won't get any Eldrazi Scions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-08-25"^^xsd:date ;
        :rulingText """Eldrazi and Scion are each separate creature types. Anything that affects Eldrazi will affect these tokens, for example."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-08-25"^^xsd:date ;
        :rulingText """Eldrazi Scions are similar to Eldrazi Spawn, seen in the Zendikar block. Note that Eldrazi Scions are 1/1, not 0/1."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-08-25"^^xsd:date ;
        :rulingText """Sacrificing an Eldrazi Scion creature token to add {C} is a mana ability. It doesn't use the stack and can't be responded to."""@en ] .

:TempleOfEnlightenmentModernHorizons3Commander386 rdf:type owl:NamedIndividual ,
