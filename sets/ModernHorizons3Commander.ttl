    :printedText """When this creature enters, create four 1/1 colorless Myr artifact creature tokens.
Whenever this creature attacks, you may tap X untapped Myr you control. If you do, this creature gets +X/+0 until end of turn and deals X damage to the player or planeswalker it's attacking."""@en ;
    :oracleText """When this creature enters, create four 1/1 colorless Myr artifact creature tokens.
Whenever this creature attacks, you may tap X untapped Myr you control. If you do, this creature gets +X/+0 until end of turn and deals X damage to the player or planeswalker it's attacking."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=665715"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/m3c/301/myr-battlesphere"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
