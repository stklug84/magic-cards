:SatyaAetherfluxGenius rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Satya, Aetherflux Genius" ;
    :manaCost "{1}{U}{R}{W}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Human ;
    :hasSubType :Artificer ;
    :hasRarity :MythicRare ;
    :hasColor :White ;
    :hasColor :Blue ;
