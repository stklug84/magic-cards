        :rulingText """A creature entering the battlefield at the same time as Aetherstorm Roc causes its first triggered ability to trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """Aetherstorm Roc's second triggered ability resolves before blockers are chosen. A creature tapped this way won't be able to block."""@en ] ,
