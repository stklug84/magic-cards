        :rulingText """Because Aurora Shifter isn't entering the battlefield when it becomes a copy of another creature, any "When [this creature] enters the battlefield" or "[This creature] enters the battlefield with" abilities of the copied creature won't apply."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
