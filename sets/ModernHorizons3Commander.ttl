    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-04-16"^^xsd:date ;
        :rulingText """The "Snarl" itself doesn't have any land subtypes. You can't reveal one to satisfy the ability of another."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-04-16"^^xsd:date ;
        :rulingText """If a land card with an appropriate subtype is entering the battlefield from your hand at the same time as one of these lands, you may reveal the other land to have the "Snarl" enter untapped."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-04-16"^^xsd:date ;
        :rulingText """If an effect instructs you to put one of these lands onto the battlefield tapped, it will still enter the battlefield tapped even if you reveal a land card from your hand."""@en ] ,
      [ rdf:type :Ruling ;
