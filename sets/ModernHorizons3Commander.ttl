:FiligreeRacer rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Filigree Racer" ;
    :manaCost "{3}{R}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasSubType :Vehicle ;
    :hasRarity :Rare ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :ModernHorizons3Commander ;
    :cardNumber "108"^^xsd:integer ;
    :artist "Gaboleps" ;
    :hasLanguage :English ;
    :power "5" ;
    :powerValue "5"^^xsd:integer ;
    :toughness "5" ;
    :toughnessValue "5"^^xsd:integer ;
    :hasKeywordAbility :Crew ;
    :printedText """When this Vehicle enters, you get {E}{E}{E}{E} (four energy counters).
Whenever this Vehicle attacks, you may pay {E}{E}. When you do, target instant or sorcery card in your graveyard gains jump-start until end of turn. (You may cast that card from your graveyard by discarding a card in addition to paying its other costs. Then exile it.)
Crew 1"""@en ;
    :oracleText """When this Vehicle enters, you get {E}{E}{E}{E} (four energy counters).
Whenever this Vehicle attacks, you may pay {E}{E}. When you do, target instant or sorcery card in your graveyard gains jump-start until end of turn. (You may cast that card from your graveyard by discarding a card in addition to paying its other costs. Then exile it.)
Crew 1"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=665382"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/m3c/108/filigree-racer"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """If an effect allows you to pay an alternative cost rather than a spell's mana cost, you may pay that alternative cost when you jump-start a spell. You'll still discard a card as an additional cost to cast it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """When casting a spell with jump-start, you must still follow any timing restrictions and permissions, including those based on the card's type. For instance, you can cast a sorcery using jump-start only when you could normally cast a sorcery."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """A spell cast using jump-start will always be exiled afterward, whether it resolves, it's countered, or it leaves the stack in some other way."""@en ] .

