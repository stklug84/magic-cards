    :cardNumber "386"^^xsd:integer ;
    :artist "Svetlin Velinov" ;
    :hasLanguage :English ;
    :hasKeywordAction :Scry ;
    :printedText """This land enters tapped.
When this land enters, scry 1. (Look at the top card of your library. You may put that card on the bottom.)
{T}: Add {W} or {U}."""@en ;
    :oracleText """This land enters tapped.
When this land enters, scry 1. (Look at the top card of your library. You may put that card on the bottom.)
{T}: Add {W} or {U}."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=665800"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/m3c/386/temple-of-enlightenment"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2013-09-15"^^xsd:date ;
        :rulingText """You choose how to order cards returned to your library after scrying no matter where you put them."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-09-15"^^xsd:date ;
        :rulingText """You perform the actions stated on a card in sequence. For some spells and abilities, that means you'll scry last. For others, that means you'll scry and then perform other actions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-09-15"^^xsd:date ;
        :rulingText """When you scry, you may put all the cards you look at back on top of your library, you may put all of those cards on the bottom of your library, or you may put some of those cards on top and the rest of them on the bottom."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-09-15"^^xsd:date ;
        :rulingText """Scry appears on some spells and abilities with one or more targets. If all of the spell or ability's targets are illegal when it tries to resolve, it won't resolve and none of its effects will happen. You won't scry."""@en ] .

