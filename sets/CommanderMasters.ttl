:DoublingSeason rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Doubling Season" ;
    :manaCost "{4}{G}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :MythicRare ;
    :hasColor :Green ;
    :hasColorIdentity :Green ;
    :isInSet :CommanderMasters ;
    :cardNumber "283"^^xsd:integer ;
    :artist "Chuck Lukacs" ;
    :hasLanguage :English ;
    :printedText """If an effect would create one or more tokens under your control, it creates twice that many of those tokens instead.
If an effect would put one or more counters on a permanent you control, it puts twice that many of those counters on that permanent instead."""@en ;
    :oracleText """If an effect would create one or more tokens under your control, it creates twice that many of those tokens instead.
If an effect would put one or more counters on a permanent you control, it puts twice that many of those counters on that permanent instead."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=627747"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/cmm/283/doubling-season"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If there are two Doubling Seasons on the battlefield, then the number of tokens or counters is four times the original number. If there are three on the battlefield, then the number of tokens or counters is eight times the original number, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Battles will enter with double the normal number of defense counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Everything that is specified by the effect creating the original token or tokens will also be true about the additional token or tokens created by Doubling Season's replacement effect. For example, if an effect tells you to create a token "tapped and attacking," the additional tokens will also be tapped and attacking."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Doubling Season affects permanents that enter with counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Planeswalkers will enter with double the normal number of loyalty counters. However, if you activate an ability whose cost has you put loyalty counters on a planeswalker, the number you put on isn't doubled. This is because those counters are put on as a cost, not as an effect."""@en ] .

:TeysaKarlov rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Teysa Karlov" ;
    :manaCost "{2}{W}{B}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Human ;
    :hasSubType :Advisor ;
    :hasRarity :Rare ;
    :hasColor :White ;
    :hasColor :Black ;
    :hasColorIdentity :White ;
    :hasColorIdentity :Black ;
    :isInSet :CommanderMasters ;
    :cardNumber "593"^^xsd:integer ;
    :artist "Magali Villeneuve" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :printedText """If a creature dying causes a triggered ability of a permanent you control to trigger, that ability triggers an additional time.
Creature tokens you control have vigilance and lifelink."""@en ;
    :oracleText """If a creature dying causes a triggered ability of a permanent you control to trigger, that ability triggers an additional time.
Creature tokens you control have vigilance and lifelink."""@en ;
    :flavorText """While Kaya is guildmaster, Teysa waits patiently at the center of the Orzhov web of power."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=626448"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/cmm/593/teysa-karlov"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2019-01-25"^^xsd:date ;
        :rulingText """An ability that triggers on an event that causes a creature to die doesn't trigger twice. For example, an ability that triggers “whenever you sacrifice a creature” triggers only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-01-25"^^xsd:date ;
        :rulingText """Teysa affects a creature's own “when this creature dies” triggered abilities as well as other triggered abilities that trigger when that creature dies. Such triggered abilities start with “when” or “whenever.”"""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-01-25"^^xsd:date ;
        :rulingText """If you somehow control two Teysas, a creature dying causes abilities to trigger three times, not four. A third Teysa causes abilities to trigger four times, a fourth causes abilities to trigger five times, and so on. This also means that if you control Teysa and cast a second one, an ability that triggers when it dies due to the “legend rule” triggers three times."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-01-25"^^xsd:date ;
        :rulingText """If a creature dying at the same time as Teysa (including Teysa itself dying) causes a triggered ability of a permanent you control to trigger, that ability triggers an additional time."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-01-25"^^xsd:date ;
        :rulingText """Teysa's effect doesn't copy the triggered ability; it just causes the ability to trigger twice. Any choices made as you put the ability onto the stack, such as modes and targets, are made separately for each instance of the ability. Any choices made on resolution, such as whether to pay a cost for that triggered ability, are also made separately."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-01-25"^^xsd:date ;
        :rulingText """An ability that triggers when a creature “leaves the battlefield” will trigger twice if that creature leaves the battlefield by dying."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-01-25"^^xsd:date ;
        :rulingText """If a creature dying at the same time that another permanent you control leaves the battlefield causes a triggered ability of that permanent to trigger, that ability triggers an additional time."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-01-25"^^xsd:date ;
        :rulingText """Look at each creature as it exists on the battlefield, taking into account continuous effects, to determine whether any triggered abilities will trigger multiple times. For example, if a land that has become a creature dies, an ability that triggers when it dies triggers twice."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-01-25"^^xsd:date ;
        :rulingText """The trigger event doesn't have to specifically refer to “creatures.” In these cases, the trigger event may also refer to something being “put into a graveyard from the battlefield.” For example, an ability that triggers “whenever an artifact is put into a graveyard from the battlefield” would trigger twice if an artifact creature dies while Teysa Karlov is on the battlefield."""@en ] .

:FluxChanneler rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Flux Channeler" ;
    :manaCost "{2}{U}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Human ;
    :hasSubType :Wizard ;
    :hasRarity :Uncommon ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :CommanderMasters ;
    :cardNumber "847"^^xsd:integer ;
    :artist "Heonhwa" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "2" ;
    :toughnessValue "2"^^xsd:integer ;
    :hasKeywordAction :Proliferate ;
    :printedText """Whenever you cast a noncreature spell, proliferate. (Choose any number of permanents and/or players, then give each another counter of each kind already there.)"""@en ;
    :oracleText """Whenever you cast a noncreature spell, proliferate. (Choose any number of permanents and/or players, then give each another counter of each kind already there.)"""@en ;
    :flavorText """"Inform our allies in the Tenth and throw the circuit. It's about to get weird.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=625252"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/cmm/847/flux-channeler"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """Flux Channeler's ability resolves before the spell that caused it to trigger. It resolves even if that spell is countered."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """If a player or permanent has more than one kind of counter on it, and you choose for it to get additional counters, it must get one of each kind of counter it already has. You can't have it get just one kind of counter it already has and not the others."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """You don't have to choose every permanent or player that has a counter, only the ones you want to add another counter to. Since "any number" includes zero, you don't have to choose any permanents at all, and you don't have to choose any players at all."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """To proliferate, you can choose any permanent that has a counter, including ones controlled by opponents. You can choose any player who has a counter, including opponents. You can't choose cards in any zone other than the battlefield, even if they have counters on them."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """An ability that triggers "Whenever you proliferate" triggers even if you chose no permanents or players while doing so."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """If a permanent ever has both +1/+1 counters and -1/-1 counters on it at the same time, they're removed in pairs as a state-based action so that the permanent has only one of those kinds of counters on it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """Players can respond to a spell or ability whose effect includes proliferating. Once that spell or ability starts to resolve, however, and its controller chooses which permanents and players will get new counters, it's too late for anyone to respond."""@en ] .
