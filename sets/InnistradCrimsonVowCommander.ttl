@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@prefix :     <urn:stklug84:MagicCardsOntology:2026-02-27#> .
@base         <urn:stklug84:MagicCardIndividuals:VOC:2026-07-19#> .

################################################################################
#
# Ontology Definition
#
################################################################################

<urn:stklug84:MagicCardIndividuals:VOC:2026-07-19#>
    rdf:type owl:Ontology ;
    owl:imports <urn:stklug84:MagicCardsOntology:2026-02-27#> ;
    rdfs:label "Magic Card Collection Individuals – Crimson Vow Commander"@en ;
    rdfs:comment """An instance graph describing the card individuals of a
personal Magic: The Gathering card collection that were printed in the set
Crimson Vow Commander (VOC). One Card individual is defined per collected
printing, carrying its characteristics, format legalities and official
rulings. Card data was sourced from Gatherer and Scryfall. This file imports
MagicCardsOntology to reuse all existing class, property, set, keyword,
subtype, format and legality definitions."""@en .


################################################################################
#
# Card Individuals
#
################################################################################

:PriestOfTheBlessedGraf rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Priest of the Blessed Graf" ;
    :manaCost "{2}{W}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Human ;
    :hasSubType :Cleric ;
    :hasRarity :Rare ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :InnistradCrimsonVowCommander ;
    :cardNumber "45"^^xsd:integer ;
    :artist "Irina Nordsol" ;
    :hasLanguage :English ;
    :power "1" ;
    :powerValue "1"^^xsd:integer ;
    :toughness "2" ;
    :toughnessValue "2"^^xsd:integer ;
    :printedText """At the beginning of your end step, create X 1/1 white Spirit creature tokens with flying, where X is the number of opponents who control more lands than you."""@en ;
    :oracleText """At the beginning of your end step, create X 1/1 white Spirit creature tokens with flying, where X is the number of opponents who control more lands than you."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=546823"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/voc/45/priest-of-the-blessed-graf"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] .
