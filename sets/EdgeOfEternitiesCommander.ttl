:SolarArray rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Solar Array" ;
    :manaCost "{3}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasRarity :Rare ;
    :isInSet :EdgeOfEternitiesCommander ;
    :cardNumber "18"^^xsd:integer ;
    :artist "Sergey Glushakov" ;
    :hasLanguage :English ;
    :producesMana :White ,
                  :Blue ,
                  :Black ,
                  :Red ,
                  :Green ;
    :printedText """{T}: Add one mana of any color. When you next cast an artifact spell this turn, that spell gains sunburst. (If it's a creature, it enters with a +1/+1 counter on it for each color of mana spent to cast it. Otherwise, it enters with that many charge counters on it.)"""@en ;
    :oracleText """{T}: Add one mana of any color. When you next cast an artifact spell this turn, that spell gains sunburst. (If it's a creature, it enters with a +1/+1 counter on it for each color of mana spent to cast it. Otherwise, it enters with that many charge counters on it.)"""@en ;
    :flavorText """Sothera collapses, but its light is not yet gone."""@en ;
    :scryfallUrl "https://scryfall.com/card/eoc/18/solar-array"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """If a spell has multiple instances of sunburst, each one applies. For example, if you activate the abilities of two Solar Arrays and then cast Selfcraft Mechan (an artifact creature), it will have two instances of sunburst and will thus enter with two +1/+1 counters on it for each color of mana spent to cast it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """The five colors are white, blue, black, red, and green. Colorless is not a color."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """Sunburst checks what mana was actually spent to cast the spell. If an effect allows you to spend mana “as though it were” mana of any color or type, that allows you to spend mana you couldn’t otherwise spend, but it doesn’t change what mana you spent to cast the spell."""@en ] .

:SurgeConductor rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Surge Conductor" ;
    :manaCost "{3}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ,
                 :Creature ;
    :hasSubType :Robot ;
    :hasRarity :Rare ;
    :isInSet :EdgeOfEternitiesCommander ;
    :cardNumber "19"^^xsd:integer ;
    :artist "Alexandr Leskinen" ;
    :hasLanguage :English ;
    :power "3" ;
    :powerValue "3"^^xsd:integer ;
    :toughness "2" ;
    :toughnessValue "2"^^xsd:integer ;
    :hasKeywordAction :Proliferate ;
    :printedText """Whenever another nontoken artifact you control enters, proliferate. (Choose any number of permanents and/or players, then give each another counter of each kind already there.)"""@en ;
    :oracleText """Whenever another nontoken artifact you control enters, proliferate. (Choose any number of permanents and/or players, then give each another counter of each kind already there.)"""@en ;
    :flavorText """A conductor for an electric symphony."""@en ;
    :scryfallUrl "https://scryfall.com/card/eoc/19/surge-conductor"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """If Surge Conductor and one or more other nontoken artifacts you control enter the battlefield at the same time, Surge Conductor’s ability will trigger for each of those nontoken artifacts."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """You don’t have to choose every permanent or player that has a counter—only the ones you want to add counters to. Since “any number” includes zero, you don’t have to choose any permanents at all, and you don’t have to choose any players at all."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """If a permanent or player has more than one kind of counter on them, and you choose for that permanent or player to get additional counters, that permanent or player must get one of each kind of counter they already have. You can’t have them get just one kind of counter they already have and not the others."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """Players can respond to a spell or ability whose effect includes proliferating. Once that spell or ability starts to resolve, however, and its controller chooses which permanents and players will get new counters, it’s too late for anyone to respond."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """When you proliferate, you can choose any permanent that has a counter, including ones controlled by opponents. You can choose any player who has a counter, including opponents. You can’t choose cards in any zone other than the battlefield, even if they have counters on them."""@en ] .

