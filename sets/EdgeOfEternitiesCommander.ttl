:RipplesOfPotential rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Ripples of Potential" ;
    :manaCost "{1}{U}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :EdgeOfEternitiesCommander ;
    :cardNumber "77"^^xsd:integer ;
    :artist "Sam Hogg" ;
    :hasLanguage :English ;
    :hasKeywordAction :Proliferate ;
    :printedText """Proliferate, then choose any number of permanents you control that had a counter put on them this way. Those permanents phase out. (To proliferate, choose any number of permanents and/or players, then give each another counter of each kind already there. Treat phased-out permanents and anything attached to them as though they don't exist until their controller's next turn.)"""@en ;
    :oracleText """Proliferate, then choose any number of permanents you control that had a counter put on them this way. Those permanents phase out. (To proliferate, choose any number of permanents and/or players, then give each another counter of each kind already there. Treat phased-out permanents and anything attached to them as though they don't exist until their controller's next turn.)"""@en ;
    :scryfallUrl "https://scryfall.com/card/eoc/77/ripples-of-potential"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Any continuous effects with a "for as long as" duration ignore phased-out objects. If ignoring those objects causes the effect's conditions to no longer be met, the duration will expire."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Choices made for permanents as they entered the battlefield are remembered even after they phase in."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Permanents phase back in during their controller's untap step, immediately before that player untaps their permanents. Creatures that phase in this way are able to attack and pay a cost of {T} during that turn. If a permanent had counters on it when it phased out, it will have those counters when it phases back in."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """As a creature is phased out, Auras and Equipment attached to it also phase out at the same time. Those Auras and Equipment will phase in at the same time that creature does, and they'll phase in still attached to that creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """To proliferate, you can choose any permanent that has a counter, including ones controlled by opponents. You can choose any player who has a counter, including opponents. You can't choose cards in any zone other than the battlefield, even if they have counters on them."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """If a player or permanent has more than one kind of counter on it, and you choose for it to get additional counters, it must get one of each kind of counter it already has. You can't have it get just one kind of counter it already has and not the others."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Players can respond to a spell or ability whose effect includes proliferating. Once that spell or ability starts to resolve, however, and its controller chooses which permanents and players will get new counters, it's too late for anyone to respond."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Phased-out permanents are treated as though they don't exist. They can't be the target of spells or abilities, their static abilities have no effect on the game, their triggered abilities can't trigger, they can't attack or block, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """An attacking or blocking creature that phases out is removed from combat."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """An ability that triggers "Whenever you proliferate" triggers even if you chose no permanents or players while doing so."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """A phased-out token will phase in at the beginning of its controller's untap step just like a nontoken permanent would."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Phasing out doesn't cause any "leaves the battlefield" abilities to trigger. Similarly, phasing in won't cause any "enters the battlefield" abilities to trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """You don't have to choose every permanent or player that has a counter, only the ones you want to add another counter to. Since "any number" includes zero, you don't have to choose any permanents at all, and you don't have to choose any players at all."""@en ] .

