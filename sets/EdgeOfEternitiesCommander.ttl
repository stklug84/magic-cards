    # Note: keyword "Converge" not defined in MagicCardsOntology
    :printedText """Converge — This creature enters with a +1/+1 counter on it for each color of mana spent to cast it.
Remove a +1/+1 counter from this creature: Add one mana of any color.
{T}: Put a +1/+1 counter on this creature."""@en ;
    :oracleText """Converge — This creature enters with a +1/+1 counter on it for each color of mana spent to cast it.
Remove a +1/+1 counter from this creature: Add one mana of any color.
{T}: Put a +1/+1 counter on this creature."""@en ;
    :scryfallUrl "https://scryfall.com/card/eoc/133/crystalline-crawler"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2016-11-08"^^xsd:date ;
        :rulingText """If there are any alternative or additional costs to cast a spell with a converge ability, the mana spent to pay those costs will count. For example, if an effect makes Crystalline Crawler cost {1} more to cast, you could pay {W}{U}{B}{R}{G} to cast it and have it enter the battlefield with five +1/+1 counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-11-08"^^xsd:date ;
        :rulingText """The colors of mana are white, blue, black, red, and green. Colorless is not a color."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-11-08"^^xsd:date ;
        :rulingText """If you cast a spell with converge without spending any mana to cast it (perhaps because an effect allowed you to cast it without paying its mana cost), then the number of colors spent to cast it will be zero."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-11-08"^^xsd:date ;
        :rulingText """Unless a spell or ability allows you to, you can't choose to pay more mana for a spell with a converge ability just to spend more colors of mana. Likewise, if a spell or ability reduces the amount of mana it costs you to cast a spell with converge, you can't ignore that cost reduction in order to spend more colors of mana."""@en ] .

