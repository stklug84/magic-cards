        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """If Szarel leaves the battlefield at the same time as you sacrifice one or more other nontoken permanents during your turn (probably because you also sacrificed Szarel), its last ability triggers for each of those other nontoken permanents."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """If Szarel leaves the battlefield before its last ability resolves, use its power as it last existed on the battlefield to determine how many +1/+1 counters to put on the target creature."""@en ] ,
