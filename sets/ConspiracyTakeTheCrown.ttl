:KayaGhostAssassin rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Kaya, Ghost Assassin" ;
    :manaCost "{2}{W}{B}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Planeswalker ;
    :hasSubType :Kaya ;
    :hasRarity :MythicRare ;
    :hasColor :White ,
              :Black ;
    :hasColorIdentity :White ,
                      :Black ;
    :isInSet :ConspiracyTakeTheCrown ;
    :cardNumber "75"^^xsd:integer ;
    :artist "Chris Rallis" ;
    :hasLanguage :English ;
    :loyalty "5"^^xsd:integer ;
    :printedText """0: Exile Kaya or up to one target creature. Return that card to the battlefield under its owner's control at the beginning of your next upkeep. You lose 2 life.
−1: Each opponent loses 2 life and you gain 2 life.
−2: Each opponent discards a card and you draw a card."""@en ;
    :oracleText """0: Exile Kaya or up to one target creature. Return that card to the battlefield under its owner's control at the beginning of your next upkeep. You lose 2 life.
−1: Each opponent loses 2 life and you gain 2 life.
−2: Each opponent discards a card and you draw a card."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=416832"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/cn2/75/kaya-ghost-assassin"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2016-08-23"^^xsd:date ;
        :rulingText """As the last ability resolves, each opponent will choose a card to discard and set it aside. Then all those cards are revealed and discarded simultaneously."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-08-23"^^xsd:date ;
        :rulingText """You choose whether or not to target a creature as you activate the first ability. If you chose a target creature, you choose whether to exile Kaya or that creature as the ability resolves. If you chose a creature and that creature is no longer a legal target as the ability tries to resolve, the ability doesn't resolve and none of its effects happen. You won't exile Kaya or lose 2 life."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-08-23"^^xsd:date ;
        :rulingText """If you didn't choose a target creature for the first ability, and Kaya isn't on the battlefield as the ability resolves, you'll just lose 2 life. No card will be exiled or returned to the battlefield."""@en ] .
