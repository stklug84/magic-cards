:PhyrexianTriniformCommanderLegends331 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Phyrexian Triniform" ;
    :manaCost "{9}" ;
    :manaValue "9"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ,
                 :Creature ;
    :hasSubType :Phyrexian ,
                :Golem ;
    :hasRarity :MythicRare ;
    :isInSet :CommanderLegends ;
    :cardNumber "331"^^xsd:integer ;
    :artist "Adam Paquette" ;
    :hasLanguage :English ;
    :power "9" ;
    :powerValue "9"^^xsd:integer ;
    :toughness "9" ;
    :toughnessValue "9"^^xsd:integer ;
    :hasKeywordAbility :Encore ;
    :printedText """When this creature dies, create three 3/3 colorless Phyrexian Golem artifact creature tokens.
Encore {12} ({12}, Exile this card from your graveyard: For each opponent, create a token copy that attacks that opponent this turn if able. They gain haste. Sacrifice them at the beginning of the next end step. Activate only as a sorcery.)"""@en ;
    :oracleText """When this creature dies, create three 3/3 colorless Phyrexian Golem artifact creature tokens.
Encore {12} ({12}, Exile this card from your graveyard: For each opponent, create a token copy that attacks that opponent this turn if able. They gain haste. Sacrifice them at the beginning of the next end step. Activate only as a sorcery.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=497851"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/cmr/331/phyrexian-triniform"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """If one of the tokens somehow is under another player's control as the delayed triggered ability resolves, you can't sacrifice that token. It remains on the battlefield indefinitely, even if you regain control of it later."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """Exiling the card with encore is a cost to activate the ability. Once you announce that you're activating it, no player may take actions until you've finished. They can't try to remove the card from your graveyard to stop you from paying the cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """If one of the tokens can't attack for any reason (such as being tapped), then it doesn't attack. If there's a cost associated with having it attack, you aren't forced to pay that cost, so it doesn't have to attack in that case either."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """Opponents who have left the game aren't counted when determining how many tokens to create."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """The tokens copy only what's on the original card. Effects that modified that creature when it was previously on the battlefield won't be copied."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """Each token must attack the appropriate player if able."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-07-28"^^xsd:date ;
        :rulingText """If an effect stops a token from attacking a specific player, that token can attack any player, planeswalker, or battle, or not attack at all. If the effect stops the token from attacking a specific player unless a cost is paid, you don't have to pay that cost unless you want to attack that player."""@en ] .

