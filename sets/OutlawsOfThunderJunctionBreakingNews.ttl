:SkewerTheCritics rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Skewer the Critics" ;
    :manaCost "{2}{R}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Uncommon ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :OutlawsOfThunderJunctionBreakingNews ;
    :cardNumber "26"^^xsd:integer ;
    :artist "Florey" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Spectacle ;
    :printedText """Spectacle {R} (You may cast this spell for its spectacle cost rather than its mana cost if an opponent lost life this turn.)
Skewer the Critics deals 3 damage to any target."""@en ;
    :oracleText """Spectacle {R} (You may cast this spell for its spectacle cost rather than its mana cost if an opponent lost life this turn.)
Skewer the Critics deals 3 damage to any target."""@en ;
    :flavorText """Maligned Thespian Stares, Hurls Daggers at Disparaging Audience"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=657771"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/otp/26/skewer-the-critics"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "90724"^^xsd:positiveInteger ;
    :arenaName "Skewer the Critics" ;
    :arenaSetCode "OTP" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """In a multiplayer game, if an opponent loses life and later that turn leaves the game, you can cast a spell for its spectacle cost. (If a player leaves the game during their turn, that turn continues without an active player.)"""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """To determine the total cost of a spell, start with the mana cost or alternative cost you're paying (such as a spectacle cost), add any cost increases, then apply any cost reductions. The mana value of the spell remains unchanged, no matter what the total cost to cast it was."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Damage dealt to a player causes that player to lose that much life."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Spectacle doesn't change when you can cast the spell. For example, you can't cast a sorcery with spectacle during an opponent's turn unless another effect allows you to do so, even if that player has lost life this turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Spectacle cares only that an opponent lost life during the turn, not that the opponent's life total is currently lower than it was. For example, if an opponent loses 1 life and then gains 2 life in the same turn, you can cast a spell for its spectacle cost that turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """A card's spectacle cost is the same no matter how much life your opponents lost or how many opponents lost life."""@en ] .

:Skullcrack rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Skullcrack" ;
    :manaCost "{1}{R}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Rare ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :OutlawsOfThunderJunctionBreakingNews ;
    :cardNumber "27"^^xsd:integer ;
    :artist "Mark A. Nelson" ;
    :hasLanguage :English ;
    :printedText """Players can't gain life this turn. Damage can't be prevented this turn. Skullcrack deals 3 damage to target player or planeswalker."""@en ;
    :oracleText """Players can't gain life this turn. Damage can't be prevented this turn. Skullcrack deals 3 damage to target player or planeswalker."""@en ;
    :flavorText """Sterling Enforcer Can't Stand Heat, or at All"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=657772"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/otp/27/skullcrack"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "90725"^^xsd:positiveInteger ;
    :arenaName "Skullcrack" ;
    :arenaSetCode "OTP" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Effects that would replace gaining life with another effect won't apply because it's impossible for players to gain life."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Spells and abilities that would cause a player to gain life or that would prevent damage still resolve, but the life-gain and damage-prevention parts have no effect."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Skullcrack targets only the player or planeswalker. If that player or planeswalker is an illegal target when Skullcrack tries to resolve, it won't resolve and none of its effects will happen."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """If an effect says to set a player's life total to a certain number and that number is higher than the player's current life total, that part of the effect won't do anything. (If the number is lower than the player's current life total, the effect will work as normal.)"""@en ] .

