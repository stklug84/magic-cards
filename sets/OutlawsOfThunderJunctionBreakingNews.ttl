    :hasLanguage :English ;
    :printedText """The owner of target spell, nonland permanent, or card in a graveyard puts it on their choice of the top or bottom of their library."""@en ;
    :oracleText """The owner of target spell, nonland permanent, or card in a graveyard puts it on their choice of the top or bottom of their library."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=657789"^^xsd:anyURI ;
