:Octomancer rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Octomancer" ;
    :manaCost "{3}{G}{U}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Frog ;
    :hasSubType :Druid ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColor :Green ;
    :hasColorIdentity :Blue ;
    :hasColorIdentity :Green ;
    :isInSet :BloomburrowCommander ;
    :cardNumber "37"^^xsd:integer ;
    :artist "Justin Gerard" ;
    :hasLanguage :English ;
    :power "3" ;
    :powerValue "3"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    :hasKeywordAbility :Gift ;
    :printedText """Gift an Octopus (You may promise an opponent a gift as you cast this spell. If you do, when it enters, they create an 8/8 blue Octopus creature token.)
At the beginning of each end step, create a token that's a copy of target creature token that entered the battlefield this turn."""@en ;
    :oracleText """Gift an Octopus (You may promise an opponent a gift as you cast this spell. If you do, when it enters, they create an 8/8 blue Octopus creature token.)
At the beginning of each end step, create a token that's a copy of target creature token that entered the battlefield this turn."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=671154"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/blc/37/octomancer"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """Any "enters" abilities of the copied token will trigger when the token enters. Any "as [this permanent] enters" or "[this permanent] enters with" abilities of the copied token will also work."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """For instants and sorceries with gift, the gift is given to the appropriate opponent as part of the resolution of the spell. This happens before any of the spell's other effects would take place."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """If the copied token has {X} in its mana cost, X is 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """You can't pay a gift cost more than once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """If the copied token is copying something else (for example, if the copied token is one previously created by this ability), then the token enters as whatever that token copied."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """The token you create copies the original characteristics of the token as stated by the effect that created that token (unless that token is copying something else; see below). It doesn't copy whether that token is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, or so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """Some instant or sorcery spells require alternative or additional targets if the gift was promised. You ignore these targeting requirements if the gifts aren't promised for those spells. On the other hand, you can promise a gift for a permanent spell even if you won't be able to choose targets for an enters ability of that permanent once the spell resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """If a spell for which the gift was promised is countered, doesn't resolve (perhaps because all of its targets are illegal), or is otherwise removed from the stack, the gift won't be given. None of its other effects will happen either."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """As an additional cost to cast a spell with gift, you can promise the listed gift to an opponent. That opponent is chosen as part of that additional cost. The gift isn't given at this time; rather, it's given at a later time based on whether or not the spell is a permanent spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """For permanent spells with gift, an ability triggers when that permanent enters if the gift was promised. When that ability resolves, the gift is given to the appropriate opponent."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """In the main set, there are four different kinds of gifts. "Gift a Food" causes the chosen opponent to create a Food token, while "Gift a Treasure" causes the chosen opponent to create a Treasure token. "Gift a card" causes them to draw a card, and "Gift a tapped Fish" causes them to create a tapped 1/1 blue Fish creature token. The Commander decks contain two more kinds of gifts: "Gift an Octopus," which causes the chosen opponent to create an 8/8 blue Octopus creature token, and "Gift an extra turn," which causes them to take an extra turn after the current turn ends."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-07-26"^^xsd:date ;
        :rulingText """If you copy a spell for which the gift was promised, the gift was also promised to the same opponent for the copy. If a card or token enters as a copy of a permanent that's already on the battlefield, the gift isn't promised for that new permanent, even if it was promised for the original."""@en ] .

:ReliquaryTowerBloomburrowCommander132 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Reliquary Tower" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Land ;
    :hasRarity :Uncommon ;
    :isInSet :BloomburrowCommander ;
    :cardNumber "132"^^xsd:integer ;
    :artist "Jesper Ejsing" ;
    :hasLanguage :English ;
    :producesMana :Colorless ;
    :printedText """You have no maximum hand size.
{T}: Add {C}."""@en ;
    :oracleText """You have no maximum hand size.
{T}: Add {C}."""@en ;
    :flavorText """Once guarded by the Knights of the Reliquary, the tower stands now protected only by its own remoteness, its dusty treasures open to plunder by anyone."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=671345"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/blc/132/reliquary-tower"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2009-02-01"^^xsd:date ;
        :rulingText """If multiple effects modify your hand size, apply them in timestamp order. For example, if you put Null Profusion (an enchantment that says your maximum hand size is two) onto the battlefield and then put Reliquary Tower onto the battlefield, you'll have no maximum hand size. However, if those permanents enter in the opposite order, your maximum hand size would be two."""@en ] .

:RestorationAngel rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Restoration Angel" ;
    :manaCost "{3}{W}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Angel ;
    :hasRarity :Rare ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :BloomburrowCommander ;
    :cardNumber "150"^^xsd:integer ;
    :artist "Jake Murray" ;
    :hasLanguage :English ;
    :power "3" ;
    :powerValue "3"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :hasKeywordAbility :Flying ;
    :hasKeywordAbility :Flash ;
    :printedText """Flash
Flying
When this creature enters, you may exile target non-Angel creature you control, then return that card to the battlefield under your control."""@en ;
    :oracleText """Flash
Flying
When this creature enters, you may exile target non-Angel creature you control, then return that card to the battlefield under your control."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=671508"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/blc/150/restoration-angel"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """If a token is exiled this way, it will cease to exist and won't return to the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """Once the exiled creature returns, it's considered a new object with no relation to the object that it was. Auras attached to the exiled creature will be put into their owners' graveyards. Equipment attached to the exiled creature will become unattached and remain on the battlefield. Any counters on the exiled creature will cease to exist."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """When an effect returns the exiled card "under your control," you control it indefinitely after that. If you had temporarily gained control of a creature, it won't return to its previous controller. In a multiplayer game, if a player leaves the game, all cards that player owns leave as well. If you leave the game, a creature you took with Restoration Angel's effect is exiled."""@en ] .

:CombatCelebrant rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Combat Celebrant" ;
    :manaCost "{2}{R}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Human ;
    :hasSubType :Warrior ;
    :hasRarity :MythicRare ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :BloomburrowCommander ;
    :cardNumber "194"^^xsd:integer ;
    :artist "Chris Rallis" ;
    :hasLanguage :English ;
    :power "4" ;
    :powerValue "4"^^xsd:integer ;
    :toughness "1" ;
    :toughnessValue "1"^^xsd:integer ;
    :hasKeywordAction :Exert ;
    :printedText """If this creature hasn't been exerted this turn, you may exert it as it attacks. When you do, untap all other creatures you control and after this phase, there is an additional combat phase. (An exerted creature won't untap during your next untap step.)"""@en ;
    :oracleText """If this creature hasn't been exerted this turn, you may exert it as it attacks. When you do, untap all other creatures you control and after this phase, there is an additional combat phase. (An exerted creature won't untap during your next untap step.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=671552"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/blc/194/combat-celebrant"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """If you exert Combat Celebrant, you get an additional combat phase even if Combat Celebrant doesn't survive the first combat phase."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """You can't exert a creature unless an effect allows you to do so. Similar effects that "tap and freeze" a creature (such as that of Decision Paralysis) don't exert that creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """If an exerted creature is already untapped during your next untap step (most likely because it had vigilance or an effect untapped it), exert's effect preventing it from untapping expires without having done anything."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """All cards in the Amonkhet set that let you exert a creature let you do so as you declare it as an attacking creature, as do some of the cards in the Hour of Devastation set. You can't do so later in combat, and creatures put onto the battlefield attacking can't be exerted. Any abilities that trigger on exerting an attacking creature will resolve before blockers are declared."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """Combat Celebrant's ability untaps all of your creatures, not just the ones that are attacking."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """If you exert multiple Combat Celebrants in one combat phase, you'll have that many additional combat phases, but all of your creatures are untapped only during the current combat phase. You'll need to exert the Combat Celebrants one at a time, in multiple combat phases, to untap your attacking creatures and attack with them in each combat step."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """Untapping an attacking creature doesn't remove it from combat."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """If you gain control of another player's creature until end of turn and exert it, it will untap during that player's untap step."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """There's no main phase between your combat phases, so you'll have no opportunity to cast spells or activate abilities that could only be cast any time you could cast a sorcery. For example, you won't be able to cast another creature or equip Equipment between combats."""@en ] .
