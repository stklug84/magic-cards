                  :Card ;
    :cardName "Dragon's Eye Savants" ;
    :manaCost "{1}{U}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Human ,
                :Wizard ;
    :hasRarity :Uncommon ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :KhansOfTarkir ;
    :cardNumber "38"^^xsd:integer ;
    :artist "Jason Rainville" ;
    :hasLanguage :English ;
    :power "0" ;
    :powerValue "0"^^xsd:integer ;
    :toughness "6" ;
    :toughnessValue "6"^^xsd:integer ;
    :hasKeywordAbility :Morph ;
    :printedText """Morph—Reveal a blue card in your hand. (You may cast this card face down as a 2/2 creature for {3}. Turn it face up any time for its morph cost.)
When this creature is turned face up, look at target opponent's hand."""@en ;
    :oracleText """Morph—Reveal a blue card in your hand. (You may cast this card face down as a 2/2 creature for {3}. Turn it face up any time for its morph cost.)
When this creature is turned face up, look at target opponent's hand."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=386524"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/ktk/38/dragons-eye-savants"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "58013"^^xsd:positiveInteger ;
    :arenaName "Dragon's Eye Savants" ;
    :arenaSetCode "KTK" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2014-09-20"^^xsd:date ;
        :rulingText """Any time you have priority, you may turn the face-down creature face up by revealing what its morph cost is and paying that cost. This is a special action. It doesn't use the stack and can't be responded to. Only a face-down permanent can be turned face up this way; a face-down spell cannot."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-09-20"^^xsd:date ;
        :rulingText """When the spell resolves, it enters the battlefield as a 2/2 creature with no name, mana cost, creature types, or abilities. It's colorless and has a mana value of 0. Other effects that apply to the creature can still grant it any of these characteristics."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-09-20"^^xsd:date ;
        :rulingText """A permanent that turns face up or face down changes characteristics but is otherwise the same permanent. Spells and abilities that were targeting that permanent, as well as Auras and Equipment that were attached to the permanent, aren't affected."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-09-20"^^xsd:date ;
        :rulingText """Because the permanent is on the battlefield both before and after it's turned face up, turning a permanent face up doesn't cause any enters-the-battlefield abilities to trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-09-20"^^xsd:date ;
        :rulingText """The face-down spell has no mana cost and has a mana value of 0. When you cast a face-down spell, put it on the stack face down so no other player knows what it is, and pay {3}. This is an alternative cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-09-20"^^xsd:date ;
        :rulingText """You must ensure that your face-down spells and permanents can easily be differentiated from each other. You're not allowed to mix up the cards that represent them on the battlefield in order to confuse other players. The order they entered the battlefield should remain clear. Common methods for doing this include using markers or dice, or simply placing them in order on the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-09-20"^^xsd:date ;
        :rulingText """Morph lets you cast a card face down by paying {3}, and lets you turn the face-down permanent face up any time you have priority by paying its morph cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-09-20"^^xsd:date ;
        :rulingText """If a face-down permanent leaves the battlefield, you must reveal it. You must also reveal all face-down spells and permanents you control if you leave the game or if the game ends."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-09-20"^^xsd:date ;
        :rulingText """At any time, you can look at a face-down spell or permanent you control. You can't look at face-down spells or permanents you don't control unless an effect instructs you to do so."""@en ] .

