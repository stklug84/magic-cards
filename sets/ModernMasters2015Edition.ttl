:UlamogsCrusher rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Ulamog's Crusher" ;
    :manaCost "{8}" ;
    :manaValue "8"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Eldrazi ;
    :hasRarity :Common ;
    :isInSet :ModernMasters2015Edition ;
    :cardNumber "7"^^xsd:integer ;
    :artist "Todd Lockwood" ;
    :hasLanguage :English ;
    :power "8" ;
    :powerValue "8"^^xsd:integer ;
    :toughness "8" ;
    :toughnessValue "8"^^xsd:integer ;
    :hasKeywordAbility :Annihilator ;
    :printedText """Annihilator 2 (Whenever this creature attacks, defending player sacrifices two permanents of their choice.)
This creature attacks each combat if able."""@en ;
    :oracleText """Annihilator 2 (Whenever this creature attacks, defending player sacrifices two permanents of their choice.)
This creature attacks each combat if able."""@en ;
    :flavorText """"Whatever the Eldrazi's purpose is, it has nothing to do with something so insignificant as us."
—Nirthu, lone missionary"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=397678"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/mm2/7/ulamogs-crusher"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2010-06-15"^^xsd:date ;
        :rulingText """Annihilator abilities trigger and resolve during the declare attackers step. The defending player chooses and sacrifices the required number of permanents before they declare blockers. Any creatures sacrificed this way won't be able to block."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2010-06-15"^^xsd:date ;
        :rulingText """If a creature with annihilator is attacking a planeswalker, and the defending player chooses to sacrifice that planeswalker, the attacking creature continues to attack. It may be blocked. If it isn't blocked, it simply won't deal combat damage to anything."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-12-07"^^xsd:date ;
        :rulingText """If Ulamog's Crusher can't attack for any reason (such as becoming tapped or having just entered the battlefield), then it doesn't attack. If there's a cost associated with having it attack, its controller isn't forced to pay that cost, so it doesn't have to attack in that case either."""@en ] .
