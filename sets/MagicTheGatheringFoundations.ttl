    :cardNumber "678"^^xsd:integer ;
    :artist "Joseph Meehan" ;
    :hasLanguage :English ;
    :producesMana :White ,
                  :Blue ,
                  :Black ,
                  :Red ,
                  :Green ;
    :power "4" ;
    :powerValue "4"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :hasKeywordAbility :Flying ;
    :printedText """Flying
Whenever you cast a spell, put a +1/+1 counter on Ramos for each of that spell's colors.
Remove five +1/+1 counters from Ramos: Add {W}{W}{U}{U}{B}{B}{R}{R}{G}{G}. Activate only once each turn."""@en ;
    :oracleText """Flying
Whenever you cast a spell, put a +1/+1 counter on Ramos for each of that spell's colors.
Remove five +1/+1 counters from Ramos: Add {W}{W}{U}{U}{B}{B}{R}{R}{G}{G}. Activate only once each turn."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=680817"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/fdn/678/ramos-dragon-engine"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Ramos's triggered ability doesn't trigger until you've finished casting a spell, including paying all of its costs. If Ramos has fewer than five +1/+1 counters on it, there's no way to add counters with a spell and pay for that spell with the newly-added counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If you cast a colorless spell, Ramos's triggered ability triggers, but it won't get any +1/+1 counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Ramos's triggered ability resolves before the spell that caused it to trigger. The ability will resolve even if that spell is countered or otherwise leaves the stack without resolving. In that case, use its last known information to determine what colors it was."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Ramos's triggered ability counts the number of colors a spell has (from zero to five), not how many colored mana symbols are there in its mana cost or how many colors of mana you spent."""@en ] .

:SorcerousSpyglass rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Sorcerous Spyglass" ;
    :manaCost "{2}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasRarity :Uncommon ;
    :isInSet :MagicTheGatheringFoundations ;
    :cardNumber "679"^^xsd:integer ;
    :artist "Kieran Yanner" ;
    :hasLanguage :English ;
    :printedText """As this artifact enters, look at an opponent's hand, then choose any card name.
Activated abilities of sources with the chosen name can't be activated unless they're mana abilities."""@en ;
    :oracleText """As this artifact enters, look at an opponent's hand, then choose any card name.
Activated abilities of sources with the chosen name can't be activated unless they're mana abilities."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=680818"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/fdn/679/sorcerous-spyglass"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """Sorcerous Spyglass affects cards regardless of what zone they're in. This includes cards in hand, cards in the graveyard, and exiled cards."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """An activated mana ability is one that produces mana as it resolves, not one that costs mana to activate."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """You can't choose the name of a token unless that token has the same name as a card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """You can choose any card name, even if that card doesn't normally have an activated ability. You're not limited to the names of cards you saw in the opponent's hand."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """Activated abilities contain a colon. They're generally written "[Cost]: [Effect]." Some keyword abilities (such as equip) are activated abilities and will have colons in their reminder text. Triggered abilities (starting with "when," "whenever," or "at") are unaffected by the last ability of Sorcerous Spyglass."""@en ] .

