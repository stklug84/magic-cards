:ChandraFlameshaper rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Chandra, Flameshaper" ;
    :manaCost "{5}{R}{R}" ;
    :manaValue "7"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Planeswalker ;
    :hasSubType :Chandra ;
    :hasRarity :MythicRare ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :MagicTheGatheringFoundations ;
    :cardNumber "81"^^xsd:integer ;
    :artist "Mark Winters" ;
    :hasLanguage :English ;
    :producesMana :Red ;
    :loyalty "6"^^xsd:integer ;
    :printedText """+2: Add {R}{R}{R}. Exile the top three cards of your library. Choose one. You may play that card this turn.
+1: Create a token that's a copy of target creature you control, except it has haste and "At the beginning of the end step, sacrifice this token."
−4: Chandra deals 8 damage divided as you choose among any number of target creatures and/or planeswalkers."""@en ;
    :oracleText """+2: Add {R}{R}{R}. Exile the top three cards of your library. Choose one. You may play that card this turn.
+1: Create a token that's a copy of target creature you control, except it has haste and "At the beginning of the end step, sacrifice this token."
−4: Chandra deals 8 damage divided as you choose among any number of target creatures and/or planeswalkers."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=679158"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/fdn/81/chandra-flameshaper"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Chandra's first ability is not a mana ability. It uses the stack and players can respond to it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Any enters abilities of the copied creature will trigger when the token enters. Any "as [this permanent] enters" or "[this permanent] enters with" abilities of the copied creature will also work."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If the copied creature is copying something else, then the token enters as whatever that creature copied, with the listed exceptions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """You choose the targets and how damage will be divided as you activate Chandra's last ability. Each chosen target must receive at least 1 damage."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """The token created by Chandra's second ability copies exactly what was printed on the original creature and nothing else, with the listed exceptions (unless that creature is copying something else or is a token; see below). It doesn't copy whether that creature is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, or so on. If it is a Vehicle, it is not crewed."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If some of the targets of Chandra's last ability become illegal, the original division of damage still applies, but the damage that would have been dealt to illegal targets isn't dealt at all."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """You pay all costs and follow all timing rules for cards played with the permission granted by Chandra's first ability. For example, if the exiled card is a land card, you may play it only during your main phase while the stack is empty."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If the copied creature is a token, the token that's created copies the original characteristics of that token as stated by the effect that created the token, with the listed exceptions."""@en ] .

