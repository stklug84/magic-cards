:PyromancersGoggles rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Pyromancer's Goggles" ;
    :manaCost "{5}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Artifact ;
    :hasRarity :MythicRare ;
    :hasColorIdentity :Red ;
    :isInSet :MagicTheGatheringFoundations ;
    :cardNumber "677"^^xsd:integer ;
    :artist "Kevin Sidharta" ;
    :hasLanguage :English ;
    :producesMana :Red ;
    :printedText """{T}: Add {R}. When that mana is spent to cast a red instant or sorcery spell, copy that spell and you may choose new targets for the copy."""@en ;
    :oracleText """{T}: Add {R}. When that mana is spent to cast a red instant or sorcery spell, copy that spell and you may choose new targets for the copy."""@en ;
    :flavorText """Chandra treasures her mentor's goggles, not for their magical properties, but for the memory of the woman who taught her to truly harness the power of fire."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=680816"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/fdn/677/pyromancers-goggles"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Any red instant or sorcery spell you spend the mana on will be copied, not just one that requires targets."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If the copied spell is modal (that is, it says "Choose one –" or the like), the copy will have the same mode or modes. You can't choose a different one."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """The copy is created on the stack, so it's not "cast." Abilities that trigger when a player casts a spell won't trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """You can't choose to pay any additional costs for the copy. However, effects based on any additional costs that were paid for the original spell are copied as though those same costs were paid for the copy too."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """The copy will have the same targets as the spell it's copying unless you choose new ones. You may change any number of the targets, including all of them or none of them. The new targets must be legal."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """A copy is created even if the spell cast with the red mana produced by Pyromancer's Goggles has been countered or otherwise left the stack without resolving by the time that ability resolves. The copy resolves before the original spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """The delayed triggered ability will trigger whether Pyromancer's Goggles is still on the battlefield or not."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If more than one red mana produced by a Pyromancer's Goggles is spent to cast a single red instant or sorcery spell, the delayed triggered ability associated with each mana spent will trigger. That many copies will be created. It doesn't matter if this red mana was produced by one Pyromancer's Goggles or by multiple Pyromancer's Goggles."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """The mana produced by Pyromancer's Goggles can be spent on anything, not just a red instant or sorcery spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If the copied spell has an X whose value was determined as it was cast, the copy has the same value of X."""@en ] .

:RamosDragonEngine rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Ramos, Dragon Engine" ;
