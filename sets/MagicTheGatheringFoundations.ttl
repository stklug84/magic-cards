    :artist "Zoltan Boros" ;
    :hasLanguage :English ;
    # Note: keyword "Food" not defined in MagicCardsOntology
    :printedText """Destroy target creature. Create a Food token. (It's an artifact with "{2}, {T}, Sacrifice this token: You gain 3 life.")"""@en ;
    :oracleText """Destroy target creature. Create a Food token. (It's an artifact with "{2}, {T}, Sacrifice this token: You gain 3 life.")"""@en ;
    :flavorText """"My secret ingredient? Well, I can't tell you that. But here's a hint. It's not love.\""""@en ;
