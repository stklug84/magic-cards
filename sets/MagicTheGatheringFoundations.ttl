:AngelOfVitality rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Angel of Vitality" ;
    :manaCost "{2}{W}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Angel ;
    :hasRarity :Uncommon ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :MagicTheGatheringFoundations ;
    :cardNumber "706"^^xsd:integer ;
    :artist "Johannes Voss" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "2" ;
    :toughnessValue "2"^^xsd:integer ;
    :hasKeywordAbility :Flying ;
    :printedText """Flying
If you would gain life, you gain that much life plus 1 instead.
This creature gets +2/+2 as long as you have 25 or more life."""@en ;
    :oracleText """Flying
If you would gain life, you gain that much life plus 1 instead.
This creature gets +2/+2 as long as you have 25 or more life."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=680845"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/fdn/706/angel-of-vitality"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """In formats where your life total doesn't start at 20, Angel of Vitality's last ability still applies if your life total is 25 or more."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """In a Two-Headed Giant game, Angel of Vitality's last ability applies as long as your team's life total is 25 or more."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """In a Two-Headed Giant game, life gained by your teammate won't cause Angel of Vitality's second ability to apply, even though it will cause your team's life total to increase."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If you gain an amount of life "for each" of something or "equal to the number" of something, that life is gained as one event and the second ability of Angel of Vitality applies only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If you control two Angels of Vitality and you would gain life, you gain that much life plus 2. A third Angel of Vitality has you gain that much life plus 3, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If Angel of Vitality is dealt damage and your life total is increased above 25 before state-based actions are performed (most likely because Angel of Vitality is dealt combat damage at the same time that a creature you control with lifelink deals combat damage), Angel of Vitality's last ability applies before checking whether it's destroyed for having lethal damage marked on it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """The middle ability of Angel of Vitality applies just once to each life-gaining event, whether it's 1 life from Dazzling Angel or 4 life from Apothecary Stomper."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Each creature with lifelink dealing combat damage causes a separate life-gaining event. For example, if two creatures you control with lifelink deal combat damage at the same time, Angel of Vitality's second ability will apply twice. However, if a single creature you control with lifelink deals combat damage to multiple creatures, players, planeswalkers, and/or battles at the same time (perhaps because it has trample or was blocked by more than one creature), the ability will apply only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Because damage remains marked on a creature until it's removed as the turn ends, nonlethal damage dealt to Angel of Vitality may become lethal if your life total drops below 25 during that turn."""@en ] .

