:AjanisPridemateMagicTheGatheringFoundations293 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Ajani's Pridemate" ;
    :manaCost "{1}{W}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Cat ,
                :Soldier ;
    :hasRarity :Uncommon ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :MagicTheGatheringFoundations ;
    :cardNumber "293"^^xsd:integer ;
    :artist "Chris Rallis" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "2" ;
    :toughnessValue "2"^^xsd:integer ;
    :printedText """Whenever you gain life, put a +1/+1 counter on this creature."""@en ;
    :oracleText """Whenever you gain life, put a +1/+1 counter on this creature."""@en ;
    :flavorText """"We must never stoop to violence in the name of conquest or hatred, but when evil threatens, we must face it with courage and ferocity."
—Ajani Goldmane"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=678390"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/fdn/293/ajanis-pridemate"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If Ajani's Pridemate is dealt lethal damage at the same time that you gain life, it won't receive a counter from its ability in time to save it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """In a Two-Headed Giant game, life gained by your teammate won't cause Ajani's Pridemate's ability to trigger, even though it caused your team's life total to increase."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Each creature with lifelink dealing combat damage causes a separate life-gaining event. For example, if two creatures you control with lifelink deal combat damage at the same time, Ajani's Pridemate's ability will trigger twice. However, if a single creature you control with lifelink deals combat damage to multiple creatures, players, planeswalkers, and/or battles at the same time (perhaps because it has trample or was blocked by more than one creature), the ability will trigger only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """The ability of Ajani's Pridemate triggers just once for each life-gaining event, whether it's 1 life from Dazzling Angel or 4 life from Apothecary Stomper."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If you gain an amount of life "for each" of something or "equal to the number" of something, that life is gained as one event and Ajani's Pridemate's ability triggers only once."""@en ] .

