:FiendishPanda rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Fiendish Panda" ;
    :manaCost "{2}{W}{B}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Bear ,
                :Demon ;
    :hasRarity :Uncommon ;
    :hasColor :White ,
              :Black ;
    :hasColorIdentity :White ,
                      :Black ;
    :isInSet :MagicTheGatheringFoundations ;
    :cardNumber "120"^^xsd:integer ;
    :artist "Brian Valeza" ;
    :hasLanguage :English ;
    :power "3" ;
    :powerValue "3"^^xsd:integer ;
    :toughness "2" ;
    :toughnessValue "2"^^xsd:integer ;
    :printedText """Whenever you gain life, put a +1/+1 counter on this creature.
When this creature dies, return another target non-Bear creature card with mana value less than or equal to this creature's power from your graveyard to the battlefield."""@en ;
    :oracleText """Whenever you gain life, put a +1/+1 counter on this creature.
When this creature dies, return another target non-Bear creature card with mana value less than or equal to this creature's power from your graveyard to the battlefield."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=679197"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/fdn/120/fiendish-panda"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """In a Two-Headed Giant game, life gained by your teammate won't cause Fiendish Panda's first ability to trigger, even though it caused your team's life total to increase."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If Fiendish Panda is dealt lethal damage at the same time that you gain life, it won't receive a counter from its first ability in time to save it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Use Fiendish Panda's power as it last existed on the battlefield to determine which creature cards may be targeted with its last ability. (Feel free to think of this as a metric of just how fiendish the panda was.)"""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If you gain an amount of life "for each" of something or "equal to the number" of something, that life is gained as one event and Fiendish Panda's first ability triggers only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Each creature with lifelink dealing combat damage causes a separate life-gaining event. For example, if two creatures you control with lifelink deal combat damage at the same time, Fiendish Panda's first ability will trigger twice. However, if a single creature you control with lifelink deals combat damage to multiple creatures, players, planeswalkers, and/or battles at the same time (perhaps because it has trample or was blocked by more than one creature), the ability will trigger only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """Fiendish Panda's first ability triggers just once for each life-gaining event, whether it's 1 life from Dazzling Angel or 4 life from Apothecary Stomper."""@en ] .

