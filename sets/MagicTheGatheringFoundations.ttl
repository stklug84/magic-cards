    :cardNumber "661"^^xsd:integer ;
    :artist "John Avon" ;
    :hasLanguage :English ;
    :printedText """Destroy target nonland permanent and all other permanents with the same name as that permanent."""@en ;
    :oracleText """Destroy target nonland permanent and all other permanents with the same name as that permanent."""@en ;
    :flavorText """During the collision of the shards, entire ways of life disappeared without a trace."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=680800"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/fdn/661/maelstrom-pulse"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
