    :hasRarity :MythicRare ;
    :isInSet :MagicTheGatheringFoundations ;
    :cardNumber "727"^^xsd:integer ;
    :artist "Cliff Childs" ;
    :hasLanguage :English ;
    :producesMana :Colorless ;
    :entersTapped "true"^^xsd:boolean ;
    :printedText """This land enters tapped.
{T}: Add {C}.
{3}, {T}, Return this land to its owner's hand: Search your library for a Gate card, put it onto the battlefield, then shuffle. If you control ten or more Gates with different names, you win the game."""@en ;
    :oracleText """This land enters tapped.
{T}: Add {C}.
{3}, {T}, Return this land to its owner's hand: Search your library for a Gate card, put it onto the battlefield, then shuffle. If you control ten or more Gates with different names, you win the game."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=680866"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/fdn/727/mazes-end"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2013-04-15"^^xsd:date ;
        :rulingText """Returning Maze's End to its owner's hand is part of the cost to activate its last ability. Once that ability is announced, players can't respond to it until after you've paid its activation cost and returned Maze's End to hand."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-04-15"^^xsd:date ;
        :rulingText """Putting a Gate onto the battlefield with Maze's End doesn't count as the one land you can play during your turn. If it's your turn, you can play Maze's End or a different land card from your hand after its ability has resolved."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-04-15"^^xsd:date ;
        :rulingText """Controlling multiple Gates with the same name has no effect on your ability to win the game with Maze's End. The excess Gates are simply ignored."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-04-15"^^xsd:date ;
        :rulingText """When the last ability of Maze's End resolves, you'll search for a Gate and put it onto the battlefield before checking to see if you win the game. This check will happen even if you don't put a Gate onto the battlefield this way. This check will happen only as the ability resolves, not at other times."""@en ] .

