    :hasLanguage :English ;
    :producesMana :Colorless ;
    :printedText """{T}: Add {C}.
{1}, {T}, Sacrifice this land: Draw a card. Activate only if you control five or more lands."""@en ;
    :oracleText """{T}: Add {C}.
{1}, {T}, Sacrifice this land: Draw a card. Activate only if you control five or more lands."""@en ;
    :flavorText """Only when you've given up the search will the caves yield their secrets."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=680825"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/fdn/686/cryptic-caves"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2019-07-12"^^xsd:date ;
        :rulingText """Cryptic Caves can be one of the five lands you control. You don't need to control five other lands. It's okay that you'll only control four lands as you finish activating Cryptic Caves's last ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-07-12"^^xsd:date ;
        :rulingText """If you control two Cryptic Caves and exactly three other lands, you can activate the last ability of only one of the Cryptic Caves. As soon as the cost for that ability is paid, you will no longer control enough lands to activate the ability of the second Cryptic Caves. """@en ] .

