:BanishingLightMagicTheGatheringFoundations138 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Banishing Light" ;
    :manaCost "{2}{W}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :Common ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :MagicTheGatheringFoundations ;
    :cardNumber "138"^^xsd:integer ;
    :artist "Willian Murai" ;
    :hasLanguage :English ;
    :printedText """When this enchantment enters, exile target nonland permanent an opponent controls until this enchantment leaves the battlefield."""@en ;
    :oracleText """When this enchantment enters, exile target nonland permanent an opponent controls until this enchantment leaves the battlefield."""@en ;
    :flavorText """The Champion reached for a stone, and Heliod placed the sun into her hand.
—*The Theriad*"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=679880"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/fdn/138/banishing-light"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """If Banishing Light leaves the battlefield before its triggered ability resolves, the target permanent won’t be exiled."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """If an Aura is exiled this way, its owner chooses what it will enchant as it returns to the battlefield. An Aura put onto the battlefield this way doesn’t target anything (so it could be attached to a permanent an opponent controls with hexproof, for example), but the Aura’s enchant ability restricts what it can be attached to. If the Aura can’t legally be attached to anything, it remains in exile for the rest of the game."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """Auras attached to the exiled permanent will be put into their owners’ graveyards. Any Equipment will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist. When the card returns to the battlefield, it will be a new object with no connection to the card that was exiled."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """If a token is exiled this way, it will cease to exist and won’t return to the battlefield."""@en ] .

