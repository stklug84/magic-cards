:RiteOfReplication rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Rite of Replication" ;
    :manaCost "{2}{U}{U}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :MagicTheGatheringFoundations ;
    :cardNumber "711"^^xsd:integer ;
    :artist "Matt Cavotta" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Kicker ;
    :printedText """Kicker {5} (You may pay an additional {5} as you cast this spell.)
Create a token that's a copy of target creature. If this spell was kicked, create five of those tokens instead."""@en ;
    :oracleText """Kicker {5} (You may pay an additional {5} as you cast this spell.)
Create a token that's a copy of target creature. If this spell was kicked, create five of those tokens instead."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=680850"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/fdn/711/rite-of-replication"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If a spell's kicker cost was paid, the spell is "kicked.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """The kicker ability doesn't let you pay a kicker cost more than once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If a card or token enters as a copy of a permanent, the new permanent isn't kicked, even if the original was."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If you copy a kicked spell on the stack, the copy is also kicked. If the copied spell is a permanent spell, the token the copy of that spell becomes when it enters is also kicked."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """To determine a spell's total cost, start with the mana cost (or an alternative cost if another card's effect allows you to pay one instead), add any cost increases (such as kicker), then apply any cost reductions. The spell's mana value remains unchanged, no matter what the total cost to cast it was."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If you put a permanent with a kicker ability onto the battlefield without casting it, you can't kick it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-09-19"^^xsd:date ;
        :rulingText """If the copied creature is copying something else, then the tokens enter the battlefield as whatever that creature copied."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-09-19"^^xsd:date ;
        :rulingText """If the copied creature is a token, the tokens created copy the original characteristics of that token as stated by the effect that created that token."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-09-19"^^xsd:date ;
        :rulingText """The tokens copy exactly what was printed on the original creature and nothing else (unless that permanent is itself copying something else; see below). It doesn't copy whether that permanent is tapped or untapped, whether it has any counters on it or Auras attached to it, or any non-copy effects that have changed its power, toughness, types, color, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-09-19"^^xsd:date ;
        :rulingText """"Kicker [cost]" means "You may pay an additional [cost] as you cast this spell.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-09-19"^^xsd:date ;
        :rulingText """Any enters-the-battlefield abilities of the copied creature will trigger when the token enters the battlefield. Any "as [this creature] enters" or "[this creature] enters with" abilities of the creature will also work."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-09-19"^^xsd:date ;
