:MarchOfTheMachines rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "March of the Machines" ;
    :manaCost "{3}{U}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :Mirrodin ;
    :cardNumber "42"^^xsd:integer ;
    :artist "Ben Thompson" ;
    :hasLanguage :English ;
    :printedText """Each noncreature artifact is an artifact creature with power and toughness each equal to its mana value. (Equipment that's a creature can't equip a creature.)"""@en ;
    :oracleText """Each noncreature artifact is an artifact creature with power and toughness each equal to its mana value. (Equipment that's a creature can't equip a creature.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=46699"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/mrd/42/march-of-the-machines"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2004-12-01"^^xsd:date ;
        :rulingText """If an Equipment becomes a creature, it can no longer equip a creature. If it's currently attached to a creature, it becomes unattached (but remains on the battlefield). You can activate the Equipment's equip ability, but it won't do anything."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2004-12-01"^^xsd:date ;
        :rulingText """If a noncreature artifact is also another card type, such as enchantment or land, it will retain those types in addition to being an artifact creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2004-12-01"^^xsd:date ;
        :rulingText """Each artifact land has a mana value of 0. March of the Machines makes them 0/0 creatures, which are put into the graveyard as a state-based action."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2007-07-15"^^xsd:date ;
        :rulingText """If a noncreature artifact becomes an artifact creature this way and then another effect animates it, the new effect overrides March of the Machines's effect. For example, Chimeric Staff is a 4/4 creature while March of the Machines is on the battlefield. If you activate Chimeric Staff's ability and choose X = 5, Chimeric Staff will be a 5/5 artifact creature for the rest of the turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2009-10-01"^^xsd:date ;
        :rulingText """A noncreature permanent that turns into a creature is subject to the "summoning sickness" rule: It can only attack, and its {T} abilities can only be activated, if its controller has continuously controlled that permanent since the beginning of their most recent turn."""@en ] .

:Leveler rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Leveler" ;
    :manaCost "{5}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ,
                 :Creature ;
    :hasSubType :Juggernaut ;
    :hasRarity :Rare ;
    :isInSet :Mirrodin ;
    :cardNumber "195"^^xsd:integer ;
    :artist "Carl Critchlow" ;
    :hasLanguage :English ;
    :power "10" ;
    :powerValue "10"^^xsd:integer ;
    :toughness "10" ;
    :toughnessValue "10"^^xsd:integer ;
    :printedText """When this creature enters, exile all cards from your library."""@en ;
    :oracleText """When this creature enters, exile all cards from your library."""@en ;
    :flavorText """Once a century, the levelers rip through every corner of Mirrodin, obeying the commands of an unseen master."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=46708"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/mrd/195/leveler"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """You won't lose the game until you try to draw from the empty library."""@en ] .
