    :artist "Jason Rainville" ;
    :hasLanguage :English ;
    :printedText """Distribute four +1/+1 counters among up to four target creatures you control. Creatures you control gain vigilance and trample until end of turn."""@en ;
    :oracleText """Distribute four +1/+1 counters among up to four target creatures you control. Creatures you control gain vigilance and trample until end of turn."""@en ;
    :flavorText """In that moment, the fate of countless worlds rested with one dryad and a handful of the bravest Mirrodin had to offer."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=607263"^^xsd:anyURI ;
