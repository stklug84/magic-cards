    :scryfallUrl "https://scryfall.com/card/mom/165/shivan-branch-burner"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """When calculating a spell's total cost, include any alternative costs, additional costs, or anything else that increases or reduces the cost to cast the spell. Convoke applies after the total cost is calculated. Convoke doesn't change a spell's mana cost or mana value."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """If a creature you control has a mana ability with {T} in the cost, activating that ability while casting a spell with convoke will result in the creature being tapped before you pay the spell's costs. You won't be able to tap it again for convoke. Similarly, if you sacrifice a creature to activate a mana ability while casting a spell with convoke, that creature won't be on the battlefield when you pay the spell's costs, so you won't be able to tap it for convoke."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Because convoke isn't an alternative cost, it can be used in conjunction with alternative costs."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """You can tap any untapped creature you control to convoke a spell, even one you haven't controlled continuously since the beginning of your most recent turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Tapping a multicolored creature using convoke will pay for {1} or one mana of your choice of any of that creature's colors."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Tapping an untapped creature that's attacking or blocking to convoke a spell won't cause that creature to stop attacking or blocking."""@en ] .

