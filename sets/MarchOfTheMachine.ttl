    :flavorText """Old glitches in mage-ring function became critical tools in Vryn's defense."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=607108"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/mom/79/stasis-field"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """If the enchanted creature has an ability that grants abilities to other objects, Stasis Field’s effect will stop it from doing so. If the enchanted creature gains an ability after Stasis Field resolves, it will keep that ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """Stasis Field overwrites all previous effects that set the creature’s base power and toughness to specific values. Any power- or toughness-setting effects that start to apply after the ability resolves will overwrite this effect."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """Effects that modify a creature’s power and/or toughness, such as the effect of Titanic Growth, will apply to the creature no matter when they started to take effect. The same is true for any counters that change its power and/or toughness and effects that switch its power and toughness."""@en ] .

