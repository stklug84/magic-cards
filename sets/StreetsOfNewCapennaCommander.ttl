:DeterminedIteration rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Determined Iteration" ;
    :manaCost "{1}{R}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :Rare ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :StreetsOfNewCapennaCommander ;
    :cardNumber "45"^^xsd:integer ;
    :artist "Zoltan Boros" ;
    :hasLanguage :English ;
    :hasKeywordAction :Populate ;
    :printedText """At the beginning of combat on your turn, populate. The token created this way gains haste. Sacrifice it at the beginning of the next end step. (To populate, create a token that's a copy of a creature token you control.)"""@en ;
    :oracleText """At the beginning of combat on your turn, populate. The token created this way gains haste. Sacrifice it at the beginning of the next end step. (To populate, create a token that's a copy of a creature token you control.)"""@en ;
    :flavorText """"Only a fool believes they have nothing left to learn.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=598159"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/ncc/45/determined-iteration"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """The new creature token copies the characteristics of the original token as stated by the effect that created the original token."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Any enters-the-battlefield abilities of the copied token will trigger when the new token enters the battlefield. Any "as [this creature] enters the battlefield" or "[this creature] enters the battlefield with" abilities of the copied token will also work."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """If you control no creature tokens when you populate, nothing will happen."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """The new token doesn't copy whether the original token is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, or any noncopy effects that have changed its power, toughness, color, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """If you choose to copy a creature token that's a copy of another creature, the new creature token will copy the characteristics of whatever the original token is copying."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Populate doesn't target the creature token you're copying. You choose that creature token as you're taking the populate action. You can choose any creature token you control. If a spell or ability causes you to create a creature token and then instructs you to populate, you may choose to copy the token you just created, or you may choose to copy another creature token you control."""@en ] .

:BrokersConfluence rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Brokers Confluence" ;
    :manaCost "{2}{G}{W}{U}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Rare ;
    :hasColor :White ;
    :hasColor :Blue ;
    :hasColor :Green ;
    :hasColorIdentity :White ;
    :hasColorIdentity :Blue ;
    :hasColorIdentity :Green ;
    :isInSet :StreetsOfNewCapennaCommander ;
    :cardNumber "68"^^xsd:integer ;
    :artist "Brian Valeza" ;
    :hasLanguage :English ;
    :hasKeywordAction :Proliferate ;
    :printedText """Choose three. You may choose the same mode more than once.
• Proliferate. (Choose any number of permanents and/or players, then give each another counter of each kind already there.)
• Target creature phases out. (Treat it and anything attached to it as though they don't exist until its controller's next turn.)
• Counter target activated or triggered ability."""@en ;
    :oracleText """Choose three. You may choose the same mode more than once.
• Proliferate. (Choose any number of permanents and/or players, then give each another counter of each kind already there.)
• Target creature phases out. (Treat it and anything attached to it as though they don't exist until its controller's next turn.)
• Counter target activated or triggered ability."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=598182"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/ncc/68/brokers-confluence"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2022-04-29"^^xsd:date ;
        :rulingText """If you choose the first mode and also the second or third mode as you cast Brokers Confluence and all targets are illegal as it attempts to resolve, you won't get to proliferate."""@en ] .
