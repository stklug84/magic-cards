:PhyrexianSoulgorger rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Phyrexian Soulgorger" ;
    :manaCost "{3}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasSuperType :Snow ;
    :hasCardType :Artifact ,
                 :Creature ;
    :hasSubType :Phyrexian ,
                :Construct ;
    :hasRarity :Rare ;
    :isInSet :Coldsnap ;
    :cardNumber "141"^^xsd:integer ;
    :artist "Brian Snõddy" ;
    :hasLanguage :English ;
    :power "8" ;
    :powerValue "8"^^xsd:integer ;
    :toughness "8" ;
    :toughnessValue "8"^^xsd:integer ;
    :hasKeywordAbility :CumulativeUpkeep ;
    :printedText """Cumulative upkeep—Sacrifice a creature. (At the beginning of your upkeep, put an age counter on this permanent, then sacrifice it unless you pay its upkeep cost for each age counter on it.)"""@en ;
    :oracleText """Cumulative upkeep—Sacrifice a creature. (At the beginning of your upkeep, put an age counter on this permanent, then sacrifice it unless you pay its upkeep cost for each age counter on it.)"""@en ;
    :flavorText """The Phyrexian minds that constructed it did not live past its awakening."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=121160"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/csp/141/phyrexian-soulgorger"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
