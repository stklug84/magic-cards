    :arenaName "Dominion Saboteur" ;
    :arenaSetCode "TRK" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """If the copied permanent is copying something else, then Dominion Saboteur enters as a copy of whatever that permanent copied, with the listed exception."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """Dominion Saboteur copies exactly what was printed on the original permanent and nothing else, with the listed exception (unless that permanent is copying something else or is a token; see below). It doesn't copy whether that permanent is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """Any "When [this permanent] enters" abilities of the copied permanent will trigger when Dominion Saboteur enters. Any "As [this permanent] enters" or "[This permanent] enters with" abilities of the chosen permanent will also work."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """If the copied permanent has {X} in its mana cost, X is 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """If the copied permanent is a token, then Dominion Saboteur copies the original characteristics of that token as stated by the effect that created that token, with the listed exception."""@en ] .

