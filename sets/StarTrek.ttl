    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :StarTrek ;
    :cardNumber "43"^^xsd:integer ;
    :artist "Evan Shipard" ;
    :hasLanguage :English ;
    :power "5" ;
    :powerValue "5"^^xsd:integer ;
    :toughness "5" ;
