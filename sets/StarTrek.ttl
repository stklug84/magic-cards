                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "106608"^^xsd:positiveInteger ;
    :arenaName "Pure Energy" ;
    :arenaSetCode "TRK" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """You can cast a spell using beam me up even if it was somehow put into your graveyard without having been cast."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """If you choose two targets for Pure Energy, and only one of the creatures remains a legal target as the spell tries to resolve, the original distribution of counters applies and the counter that would have been put on the illegal target is lost. It won't be put on the remaining legal target."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """You choose the number of targets and how the counters will be distributed as you cast Pure Energy. Each target must receive at least one counter."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """If a card with beam me up is put into your graveyard during your turn, you can cast it if it's legal to do so before any other player can take any actions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """You must still follow any timing restrictions and permissions, including those based on the card's type. For instance, you can cast a sorcery using beam me up only when you could normally cast a sorcery."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """"Beam me up [cost]" means "You may cast this card from your graveyard by paying [cost] and returning a creature you control to its owner's hand rather than paying its mana cost" and "If the beam me up cost was paid, exile this card instead of putting it anywhere else any time it would leave the stack.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """A spell cast using beam me up will always be exiled afterward, whether it resolves, is countered, or leaves the stack in some other way."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """To determine the total cost of a spell, start with the mana cost or alternative cost (such as a beam me up cost) you're paying, add any cost increases, then apply any cost reductions. The mana value of the spell is determined only by its mana cost, no matter what the total cost to cast the spell was."""@en ] .

