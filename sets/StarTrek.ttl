:InfiniteDiversity rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Infinite Diversity" ;
    :manaCost "{7}{R}{R}" ;
    :manaValue "9"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :MythicRare ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :StarTrek ;
    :cardNumber "153"^^xsd:integer ;
    :artist "Julie Dillon" ;
    :hasLanguage :English ;
    :hasAbilityWord :Federation ;
    :printedText """Federation — Exile target instant or sorcery card from your graveyard. Copy that card X times, where X is the number of creature types among non-Borg creatures you control. You may cast the copies without paying their mana costs. Exile Infinite Diversity."""@en ;
    :oracleText """Federation — Exile target instant or sorcery card from your graveyard. Copy that card X times, where X is the number of creature types among non-Borg creatures you control. You may cast the copies without paying their mana costs. Exile Infinite Diversity."""@en ;
    :flavorText """Our differences make us stronger."""@en ;
    :scryfallUrl "https://scryfall.com/card/trk/153/infinite-diversity"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "106730"^^xsd:positiveInteger ;
    :arenaName "Infinite Diversity" ;
    :arenaSetCode "TRK" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """If you don't want to cast one or more of the copies, you can choose not to; the copies you don't cast cease to exist the next time state-based actions are performed."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """The value of X is calculated only once, as Infinite Diversity resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """Don't consider Borg creatures at all when counting creature types for federation abilities, even if they have additional creature types. However, a Borg having another creature type doesn't mean that type can't be counted, as long as a non-Borg also has it. For example, if you control a Borg Noble and a Human Noble, the number of creature types among non-Borg creatures you control is two (Human and Noble)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """You cast the copies while Infinite Diversity is resolving and still on the stack. You can't wait to cast them later in the turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """If you cast a spell "without paying its mana cost," you can't pay any alternative costs. You can, however, pay additional costs, such as kicker costs. If the spell has any mandatory additional costs, you must pay those."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """If the card has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost."""@en ] .

