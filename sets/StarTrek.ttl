    :hasCardType :Creature ;
    :hasSubType :Cardassian ,
                :Officer ,
                :Spy ;
    :hasRarity :Common ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :StarTrek ;
    :cardNumber "120"^^xsd:integer ;
    :artist "Wero Gallo" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "5" ;
    :toughnessValue "5"^^xsd:integer ;
    # Note: keyword "Face a dilemma" not defined in MagicCardsOntology
    :printedText """Whenever you face a dilemma, each opponent loses 1 life and you gain 1 life. (You face a dilemma as you choose one or more modes for a spell or ability.)"""@en ;
    :oracleText """Whenever you face a dilemma, each opponent loses 1 life and you gain 1 life. (You face a dilemma as you choose one or more modes for a spell or ability.)"""@en ;
    :flavorText """"Your resistance is wasted energy, and in time you'll wish you hadn't wasted it.\""""@en ;
    :scryfallUrl "https://scryfall.com/card/trk/120/obsidian-order-operative"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "106697"^^xsd:positiveInteger ;
    :arenaName "Obsidian Order Operative" ;
    :arenaSetCode "TRK" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """Modal spells and cards with modal abilities printed prior to the Khans of Tarkir release didn't use bulleted lists for the modes; these cards have received errata in the Oracle card reference."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """As long as you choose one or more modes for a spell or ability, you've faced a dilemma. It doesn't matter if that spell or ability goes on to resolve or not."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """An ability that triggers whenever a player faces a dilemma will resolve before the spell or ability that caused it to trigger. It resolves even if that spell or ability is countered or otherwise leaves the stack without resolving."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """A spell or ability is modal if it has two or more options in a bulleted list and instructions for a player to choose a number of those options, such as "Choose one" or "Choose one or more." Each of those options is a mode. Spells with spree or tiered are modal spells."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """If a player chooses no modes for a spell or ability, the player did not face a dilemma. This can happen because the instruction to choose modes for the spell or ability is optional ("You may choose one," or similar) or because there are no legal modes to choose for a modal triggered ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """If a player chooses more than one mode for a spell or ability, that player still faced only one dilemma."""@en ] .

