:DrBeverlyCrusher rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Dr. Beverly Crusher" ;
    :manaCost "{2}{W}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Human ,
                :Doctor ;
    :hasRarity :MythicRare ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :StarTrek ;
    :cardNumber "13"^^xsd:integer ;
    :artist "Mattia Rangoni" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "2" ;
    :toughnessValue "2"^^xsd:integer ;
    :printedText """If you gaining life causes a triggered ability of a permanent you control to trigger, that ability triggers an additional time.
Whenever you gain life, put a +1/+1 counter on Dr. Crusher."""@en ;
    :oracleText """If you gaining life causes a triggered ability of a permanent you control to trigger, that ability triggers an additional time.
Whenever you gain life, put a +1/+1 counter on Dr. Crusher."""@en ;
    :flavorText """"Damn. Where are the calluses we doctors are supposed to grow over our feelings?\""""@en ;
    :scryfallUrl "https://scryfall.com/card/trk/13/dr-beverly-crusher"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "106590"^^xsd:positiveInteger ;
    :arenaName "Dr. Beverly Crusher" ;
    :arenaSetCode "TRK" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """Each creature with lifelink dealing combat damage causes a separate life-gaining event. For example, if two creatures you control with lifelink deal combat damage at the same time, Dr. Crusher's second ability will naturally trigger twice (although her first ability will make that four times). However, if a single creature you control with lifelink deals combat damage to multiple creatures, players, planeswalkers, and/or battles at the same time (perhaps because it has trample or was blocked by more than one creature), the ability will naturally trigger only once (with her first ability making that twice)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """Dr. Crusher's second ability naturally triggers just once for each life-gaining event, whether it's 1 life from Jake Sisko, War Correspondent or 2 life from Elim Garak, Simple Tailor, although her first ability will cause her second ability to trigger an additional time."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """If you gain an amount of life "for each" of something or "equal to the number" of something, that life is gained as one event and Dr. Crusher's second ability naturally triggers only once (with her first ability making that twice)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """Triggered abilities use the word "when," "whenever," or "at." They're often written as "[Trigger condition], [effect]." Some keyword abilities are triggered abilities and will have "when," "whenever," or "at" in their reminder text."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """In a Two-Headed Giant game, life gained by your teammate won't cause Dr. Crusher's second ability to trigger, even though it caused your team's life total to increase."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """If Dr. Crusher is dealt lethal damage at the same time that you gain life, she will die before her second ability would resolve."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-10-07"^^xsd:date ;
        :rulingText """Dr. Crusher's first ability doesn't copy the triggered ability; it just causes the ability to trigger an additional time. Any choices made as you put the ability onto the stack, such as modes and targets, are made separately for each instance of the ability. Any choices made on resolution, such as whether to put counters on a permanent, are also made individually."""@en ] .

