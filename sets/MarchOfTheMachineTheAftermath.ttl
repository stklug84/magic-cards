:SarkhanSoulAflame rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Sarkhan, Soul Aflame" ;
    :manaCost "{1}{U}{R}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Human ,
                :Shaman ;
    :hasRarity :MythicRare ;
    :hasColor :Blue ,
              :Red ;
    :hasColorIdentity :Blue ,
                      :Red ;
    :isInSet :MarchOfTheMachineTheAftermath ;
    :cardNumber "46"^^xsd:integer ;
    :artist "Eric Wilkerson" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :printedText """Dragon spells you cast cost {1} less to cast.
Whenever a Dragon you control enters, you may have Sarkhan become a copy of it until end of turn, except its name is Sarkhan, Soul Aflame and it's legendary in addition to its other types."""@en ;
    :oracleText """Dragon spells you cast cost {1} less to cast.
Whenever a Dragon you control enters, you may have Sarkhan become a copy of it until end of turn, except its name is Sarkhan, Soul Aflame and it's legendary in addition to its other types."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=615439"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/mat/46/sarkhan-soul-aflame"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """If the copied Dragon has {X} in its mana cost, X is 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """If the Dragon that enters the battlefield is legendary and you have Sarkhan copy it, the two Dragons will have different names (unless the entering Dragon is somehow named Sarkhan, Soul Aflame). The "legend rule" won't apply."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """That ability can't reduce the amount of colored mana you pay for a Dragon spell. It reduces only the generic component of that cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """If the copied Dragon is a token, Sarkhan copies the original characteristics of that token as stated by the effect that created that token, with the noted exceptions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """Sarkhan's first ability doesn't change the mana cost or mana value of any Dragon spell. It changes only the total cost you pay."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """In some unusual cases, the Dragon that entered the battlefield will be copying something else by the time Sarkhan's ability resolves. In such a case, Sarkhan will copy whatever the Dragon is copying, with the noted exceptions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """Sarkhan copies exactly what was printed on the original Dragon and nothing else, with the noted exceptions (unless that creature is a token; see below). It doesn't copy whether that creature is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, and so on in response to Sarkhan's ability."""@en ] .
