    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """You choose how many targets Undercity Upheaval has and how the counters will be distributed as you cast the spell. Each target must receive at least one counter."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """If some of the creatures are illegal targets as Undercity Upheaval tries to resolve, the original distribution of counters still applies and the counters that would have been put on the illegal targets are lost. They won't be put instead on a legal target."""@en ] ,
