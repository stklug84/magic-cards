:MarkovBaron rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Markov Baron" ;
    :manaCost "{2}{B}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Vampire ,
                :Noble ;
    :hasRarity :Uncommon ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :MarchOfTheMachineTheAftermath ;
    :cardNumber "14"^^xsd:integer ;
    :artist "Ina Wong" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "2" ;
    :toughnessValue "2"^^xsd:integer ;
    :hasKeywordAbility :Lifelink ,
                       :Madness ,
                       :Convoke ;
    :printedText """Convoke (Your creatures can help cast this spell. Each creature you tap while casting this spell pays for {1} or one mana of that creature's color.)
Lifelink
Other Vampires you control get +1/+1.
Madness {2}{B} (If you discard this card, discard it into exile. When you do, cast it for its madness cost or put it into your graveyard.)"""@en ;
    :oracleText """Convoke (Your creatures can help cast this spell. Each creature you tap while casting this spell pays for {1} or one mana of that creature's color.)
Lifelink
Other Vampires you control get +1/+1.
Madness {2}{B} (If you discard this card, discard it into exile. When you do, cast it for its madness cost or put it into your graveyard.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=615407"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/mat/14/markov-baron"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "85070"^^xsd:positiveInteger ;
    :arenaName "Markov Baron" ;
    :arenaSetCode "MAT" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """Casting a spell with madness ignores the timing rules based on the card's card type. For example, you can cast a creature with madness if you discard it during an opponent's turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """A card with madness that's discarded counts as having been discarded even though it's put into exile rather than a graveyard. If it was discarded to pay a cost, that cost is still paid. Abilities that trigger when a card is discarded will still trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """Cards are discarded in a Magic game only from a player's hand. Effects that put cards into a player's graveyard from anywhere else do not cause those cards to be discarded."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """Madness works independently of why you're discarding the card. You could discard it to pay a cost, because a spell or ability tells you to, or because you have too many cards in your hand during your cleanup step. You can't discard a card with madness just because you want to, though."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """If you discard a card with madness to pay the cost of a spell or activated ability, that card's madness triggered ability (and the spell that card becomes, if you choose to cast it) will resolve before the spell or ability the discard paid for."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """A spell cast for its madness cost is put onto the stack like any other spell. It can be countered, copied, and so on. As it resolves, it's put onto the battlefield if it's a permanent card or into its owner's graveyard if it's an instant or sorcery card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """If you discard a card with madness while a spell or ability is resolving, it moves immediately to exile. Continue resolving that spell or ability, noting that the card you discarded is not in your graveyard at this time. Its madness triggered ability will be placed onto the stack once that spell or ability has completely resolved."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-05-12"^^xsd:date ;
        :rulingText """If you choose not to cast a card with madness when the madness triggered ability resolves, it's put into your graveyard. Madness doesn't give you another chance to cast it later."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """You can tap any untapped creature you control to convoke a spell, even one you haven't controlled continuously since the beginning of your most recent turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Because convoke isn't an alternative cost, it can be used in conjunction with alternative costs."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Tapping a multicolored creature using convoke will pay for {1} or one mana of your choice of any of that creature's colors."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """If a creature you control has a mana ability with {T} in the cost, activating that ability while casting a spell with convoke will result in the creature being tapped before you pay the spell's costs. You won't be able to tap it again for convoke. Similarly, if you sacrifice a creature to activate a mana ability while casting a spell with convoke, that creature won't be on the battlefield when you pay the spell's costs, so you won't be able to tap it for convoke."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """When calculating a spell's total cost, include any alternative costs, additional costs, or anything else that increases or reduces the cost to cast the spell. Convoke applies after the total cost is calculated. Convoke doesn't change a spell's mana cost or mana value."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-01-12"^^xsd:date ;
        :rulingText """Tapping an untapped creature that's attacking or blocking to convoke a spell won't cause that creature to stop attacking or blocking."""@en ] .

