:InTheTrenches rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "In the Trenches" ;
    :manaCost "{1}{W}{W}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :MythicRare ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :TheBrothersWar ;
    :cardNumber "8"^^xsd:integer ;
    :artist "Daarken" ;
    :hasLanguage :English ;
    :printedText """Creatures you control get +1/+1.
{5}{W}: Exile target nonland permanent you don't control until this enchantment leaves the battlefield. Activate only as a sorcery and only once."""@en ;
    :oracleText """Creatures you control get +1/+1.
{5}{W}: Exile target nonland permanent you don't control until this enchantment leaves the battlefield. Activate only as a sorcery and only once."""@en ;
    :flavorText """The battlefield became so pockmarked with craters and trenches that casualties were regularly attributed to "fell in a hole.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=583593"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/bro/8/in-the-trenches"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-14"^^xsd:date ;
        :rulingText """In a multiplayer game, if the owner of In the Trenches leaves the game, the exiled card will return to the battlefield. Because the one-shot effect that returns the card isn't an ability that goes on the stack, it won't cease to exist along with the leaving player's spells and abilities on the stack."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-14"^^xsd:date ;
        :rulingText """The activated ability can only be activated once per game. If the ability is countered or otherwise fails to resolve after being activated, it can't be activated again."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-14"^^xsd:date ;
        :rulingText """If a token is exiled, it ceases to exist. It won't be returned to the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-14"^^xsd:date ;
        :rulingText """If In the Trenches leaves the battlefield and later returns to the battlefield, it is a new object on the battlefield with no memory of the last time it was there. Its ability may be activated, even if it was activated a previous time it was on the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-14"^^xsd:date ;
        :rulingText """If In the Trenches leaves the battlefield before its activated ability resolves, the target permanent won't be exiled."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-14"^^xsd:date ;
        :rulingText """The activated ability is a single ability that creates two one-shot effects: one that exiles the permanent when the ability resolves, and another that returns the exiled card to the battlefield immediately after In the Trenches leaves the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-14"^^xsd:date ;
        :rulingText """Auras attached to the exiled permanent will be put into their owners' graveyards. Equipment attached to an exiled creature will become unattached and remain on the battlefield. Any counters on the exiled permanent will cease to exist."""@en ] .

