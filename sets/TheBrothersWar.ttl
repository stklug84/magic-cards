:SimianSimulacrum rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Simian Simulacrum" ;
    :manaCost "{3}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ,
                 :Creature ;
    :hasSubType :Ape ;
    :hasRarity :Rare ;
    :hasColorIdentity :Green ;
    :isInSet :TheBrothersWar ;
    :cardNumber "205"^^xsd:integer ;
    :artist "Randy Vargas" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "1" ;
    :toughnessValue "1"^^xsd:integer ;
    :hasKeywordAbility :Unearth ;
    :printedText """When this creature enters, put two +1/+1 counters on target creature you control.
Unearth {2}{G}{G} ({2}{G}{G}: Return this card from your graveyard to the battlefield. It gains haste. Exile it at the beginning of the next end step or if it would leave the battlefield. Unearth only as a sorcery.)"""@en ;
    :oracleText """When this creature enters, put two +1/+1 counters on target creature you control.
Unearth {2}{G}{G} ({2}{G}{G}: Return this card from your graveyard to the battlefield. It gains haste. Exile it at the beginning of the next end step or if it would leave the battlefield. Unearth only as a sorcery.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=583788"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/bro/205/simian-simulacrum"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-14"^^xsd:date ;
        :rulingText """If you activate a card's unearth ability but that card is removed from your graveyard before the ability resolves, that unearth ability will do nothing as it resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-14"^^xsd:date ;
        :rulingText """Unearth grants haste to the permanent that's returned to the battlefield (even if it's not a creature card). However, neither of the "exile" abilities is granted to that permanent. If that permanent loses all its abilities, it will still be exiled at the beginning of the next end step, and if it would leave the battlefield, it is still exiled instead."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-14"^^xsd:date ;
        :rulingText """At the beginning of the next end step, a permanent returned to the battlefield with unearth is exiled. This is a delayed triggered ability, and it can be countered by effects such as Defabricate that counter triggered abilities. If the ability is countered, the permanent will stay on the battlefield and the delayed triggered ability won't trigger again. However, the replacement effect will still exile the permanent if it eventually leaves the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-14"^^xsd:date ;
        :rulingText """Activating a card's unearth ability isn't the same as casting that card. The unearth ability is put on the stack, but the card is not. Spells and abilities that interact with activated abilities (such as Defabricate's second mode) will interact with unearth, but spells and abilities that interact with spells (such as Scatter Ray) will not."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-14"^^xsd:date ;
        :rulingText """If a permanent returned to the battlefield with unearth would leave the battlefield for any reason, it's exiled instead—unless the spell or ability that's causing the permanent to leave the battlefield is actually trying to exile it! In that case, it succeeds at exiling it. If that spell or ability later returns the card to the battlefield (as Static Net might, for example), the permanent card will return to the battlefield as a new object with no relation to its previous existence. The unearth effects will no longer apply to it."""@en ] .

:SaheeliFiligreeMaster rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Saheeli, Filigree Master" ;
    :manaCost "{2}{U}{R}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Planeswalker ;
    :hasSubType :Saheeli ;
    :hasRarity :MythicRare ;
    :hasColor :Blue ,
              :Red ;
    :hasColorIdentity :Blue ,
                      :Red ;
    :isInSet :TheBrothersWar ;
    :cardNumber "219"^^xsd:integer ;
    :artist "Aurore Folny" ;
    :hasLanguage :English ;
    :loyalty "3"^^xsd:integer ;
    :hasKeywordAction :Scry ;
    :printedText """+1: Scry 1. You may tap an untapped artifact you control. If you do, draw a card.
−2: Create two 1/1 colorless Thopter artifact creature tokens with flying. They gain haste until end of turn.
−4: You get an emblem with "Artifact creatures you control get +1/+1" and "Artifact spells you cast cost {1} less to cast.\""""@en ;
    :oracleText """+1: Scry 1. You may tap an untapped artifact you control. If you do, draw a card.
−2: Create two 1/1 colorless Thopter artifact creature tokens with flying. They gain haste until end of turn.
−4: You get an emblem with "Artifact creatures you control get +1/+1" and "Artifact spells you cast cost {1} less to cast.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=583801"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/bro/219/saheeli-filigree-master"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-14"^^xsd:date ;
        :rulingText """For the first ability, you don't choose which artifact to tap until the ability resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-14"^^xsd:date ;
        :rulingText """If you manage to activate Saheeli's last ability multiple times, each emblem you get is applied independently. For example, if you have two of those emblems, artifact creatures you control get +2/+2 and artifact spells you cast cost {2} less."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-14"^^xsd:date ;
        :rulingText """The cost reduction provided by Saheeli's emblem can never reduce the colored mana costs of an artifact spell."""@en ] .
