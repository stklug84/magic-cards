      [ rdf:type :Ruling ;
        :rulingDate "2025-10-02"^^xsd:date ;
        :rulingText """If you control no creatures other than Joo Dee and no artifacts as the ability resolves, you'll need to sacrifice either Joo Dee or the token copy."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-10-02"^^xsd:date ;
        :rulingText """The token copies exactly what was printed on the original creature and nothing else (unless that creature is copying something else or is a token; see below). It doesn't copy whether that creature is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, or so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-10-02"^^xsd:date ;
        :rulingText """The sacrifice part of Joo Dee's ability happens as part of the resolution of the ability. Players cannot do anything between creating the copy and sacrificing an artifact or creature."""@en ] .

