    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-10-02"^^xsd:date ;
        :rulingText """If a spell or ability targets multiple things, you can't target it with Redirect Lightning, even if all but one of those targets have become illegal."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-10-02"^^xsd:date ;
        :rulingText """You don't choose the new target for the spell or ability until Redirect Lightning resolves. You must change the target if possible. However, you can't change the target to an illegal target. If there are no legal targets to choose from, the target isn't changed. It doesn't matter if the original target has somehow become illegal itself."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-10-02"^^xsd:date ;
        :rulingText """If a spell or ability targets the same player or object multiple times, you can't target it with Redirect Lightning."""@en ] .

