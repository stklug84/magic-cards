    :cardName "Trelasarra, Moon Dancer" ;
    :manaCost "{G}{W}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Elf ,
                :Cleric ;
    :hasRarity :Uncommon ;
    :hasColor :White ,
              :Green ;
    :hasColorIdentity :White ,
                      :Green ;
    :isInSet :AdventuresInTheForgottenRealms ;
    :cardNumber "236"^^xsd:integer ;
    :artist "Kieran Yanner" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "2" ;
    :toughnessValue "2"^^xsd:integer ;
    :hasKeywordAction :Scry ;
    :printedText """Whenever you gain life, put a +1/+1 counter on Trelasarra and scry 1. (Look at the top card of your library. You may put that card on the bottom.)"""@en ;
    :oracleText """Whenever you gain life, put a +1/+1 counter on Trelasarra and scry 1. (Look at the top card of your library. You may put that card on the bottom.)"""@en ;
    :flavorText """"Eilistraee teaches us that we are not bound by the circumstances of our birth. We all may find beauty and light, if we have the courage to seek them.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=527523"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/afr/236/trelasarra-moon-dancer"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "77341"^^xsd:positiveInteger ;
    :arenaName "Trelasarra, Moon Dancer" ;
    :arenaSetCode "AFR" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-07-23"^^xsd:date ;
        :rulingText """Each creature with lifelink dealing combat damage causes a separate life gain event. For example, if two creatures you control with lifelink deal combat damage at the same time, a "whenever you gain life" ability will trigger twice. However, if a single creature you control with lifelink deals combat damage to multiple creatures, players, and/or planeswalkers at the same time (perhaps because it has trample or was blocked by more than one creature), the ability will trigger only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-07-23"^^xsd:date ;
        :rulingText """An ability that triggers "whenever you gain life" triggers just once for each life gain event, no matter how much life you gain."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-07-23"^^xsd:date ;
        :rulingText """If you gain life at the same time Trelasarra, Moon Dancer is dealt lethal damage, it dies before its triggered ability can put a +1/+1 counter on it, but you will still scry 1."""@en ] .
