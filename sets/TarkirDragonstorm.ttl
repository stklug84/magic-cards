:UnendingWhisper rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Unending Whisper" ;
    :manaCost "{U}" ;
    :manaValue "1"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Common ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :TarkirDragonstorm ;
    :cardNumber "62"^^xsd:integer ;
    :artist "Danny Schwartz" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Harmonize ;
    :printedText """Draw a card.
Harmonize {5}{U} (You may cast this card from your graveyard for its harmonize cost. You may tap a creature you control to reduce that cost by {X}, where X is its power. Then exile this spell.)"""@en ;
    :oracleText """Draw a card.
Harmonize {5}{U} (You may cast this card from your graveyard for its harmonize cost. You may tap a creature you control to reduce that cost by {X}, where X is its power. Then exile this spell.)"""@en ;
    :flavorText """In the Endless Song, Temur's whisperers hear spirits murmur of the past, present, and future."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=693542"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/tdm/62/unending-whisper"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "95580"^^xsd:positiveInteger ;
    :arenaName "Unending Whisper" ;
    :arenaSetCode "TDM" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """To determine the total cost of a spell, start with the mana cost or alternative cost (such as a harmonize cost) you’re paying, add any cost increases, then apply any cost reductions (such as the cost reduction from tapping a creature). The mana value of the spell is determined only by its mana cost, no matter what the total cost to cast the spell was."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """“Harmonize [cost]” means “You may cast this card from your graveyard by paying [cost] and tapping up to one untapped creature you control rather than paying the spell’s mana cost,” “If you cast this spell using its harmonize ability, its total cost is reduced by an amount of generic mana equal to the tapped creature’s power,” and “If the harmonize cost was paid, exile this card instead of putting it anywhere else any time it would leave the stack.”"""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """A spell cast using harmonize will always be exiled afterward, whether it resolves, is countered, or leaves the stack in some other way."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """If a card with harmonize is put into your graveyard during your turn, you can cast it if it’s legal to do so before any other player can take any actions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """Tapping a creature won’t reduce colored mana components of harmonize costs."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """You must still follow any timing restrictions and permissions, including those based on the card’s type. For instance, you can cast a sorcery using harmonize only when you could normally cast a sorcery."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """You can cast a spell using harmonize even if it was somehow put into your graveyard without having been cast."""@en ] .

