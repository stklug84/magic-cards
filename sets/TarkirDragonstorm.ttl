:BarrensteppeSiege rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Barrensteppe Siege" ;
    :manaCost "{2}{W}{B}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :Rare ;
    :hasColor :White ;
    :hasColor :Black ;
    :hasColorIdentity :White ;
    :hasColorIdentity :Black ;
    :isInSet :TarkirDragonstorm ;
    :cardNumber "171"^^xsd:integer ;
    :artist "Tuan Duong Chu" ;
    :hasLanguage :English ;
    :printedText """As this enchantment enters, choose Abzan or Mardu.
• Abzan — At the beginning of your end step, put a +1/+1 counter on each creature you control.
• Mardu — At the beginning of your end step, if a creature died under your control this turn, each opponent sacrifices a creature of their choice."""@en ;
    :oracleText """As this enchantment enters, choose Abzan or Mardu.
• Abzan — At the beginning of your end step, put a +1/+1 counter on each creature you control.
• Mardu — At the beginning of your end step, if a creature died under your control this turn, each opponent sacrifices a creature of their choice."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=693651"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/tdm/171/barrensteppe-siege"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """If you somehow control Barrensteppe Siege and no choice was made for it (perhaps because another permanent on the battlefield became a copy of it), it has neither of the two abilities."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """Barrensteppe Siege’s Mardu ability will check as the end step starts to see if a creature died under your control this turn. If none did, the ability won’t trigger at all."""@en ] .

