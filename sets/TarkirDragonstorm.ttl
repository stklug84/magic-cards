    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :TarkirDragonstorm ;
    :cardNumber "124"^^xsd:integer ;
    :artist "Joshua Raphael" ;
    :hasLanguage :English ;
    :power "3" ;
    :powerValue "3"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    :hasKeywordAbility :Flying ,
                       :Haste ;
    :printedText """Flying, haste
{1}{R}: This creature gets +1/+0 until end of turn.
//
Discard a card. If you do, draw two cards. (Then shuffle this card into its owner's library.)"""@en ;
    :oracleText """Flying, haste
{1}{R}: This creature gets +1/+0 until end of turn.
//
Discard a card. If you do, draw two cards. (Then shuffle this card into its owner's library.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=693604"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/tdm/124/stormshriek-feral-flush-out"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "95644"^^xsd:positiveInteger ;
    :arenaName "Stormshriek Feral" ;
    :arenaSetCode "TDM" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """If an Omen spell has one or more targets and all of those targets are illegal when the spell tries to resolve, it won’t resolve. None of its effects will happen, and it will be put into its owner’s graveyard. It won’t be shuffled into its owner’s library."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """If an Omen spell is countered or an effect causes it to otherwise leave the stack, it won’t be shuffled into its owner’s library."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """If an effect instructs you to choose a card name, you may choose the alternative Omen name. Consider only the alternative characteristics to determine whether that is an appropriate name to choose."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """If an Omen spell is copied, that copy is also an Omen and is shuffled into its owner’s library as it resolves. Its owner still shuffles their library, but the copy ceases to exist as a state-based action."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """As a player casts an omen card, the player chooses whether they cast the card normally or as an Omen."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """If you cast an omen card as an Omen, use only its alternative characteristics to determine whether it’s legal to cast that spell. For example, if you control Thundermane Dragon (“You may cast creature spells with power 4 or greater from the top of your library.”) and Twinmaw Stormbrood is on top of your library, you can cast Twinmaw Stormbrood, but not Charring Bite."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """When casting a spell as an Omen, use the alternative characteristics and ignore all of the card’s normal characteristics. The spell’s color, mana cost, mana value, and so on are determined by only those alternative characteristics. If the spell leaves the stack, it immediately resumes using its normal characteristics."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """Casting a card as an Omen isn’t casting it for an alternative cost. Effects that allow you to cast a spell for an alternative cost or without paying its mana cost may allow you to apply those to the Omen."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """An omen card is a creature card in every zone except the stack, as well as while on the stack if not cast as an Omen. Ignore its alternative characteristics in those cases. For example, while it’s in your graveyard, Twinmaw Stormbrood is a white creature card whose mana value is 6. It can’t be the target of the reflexive ability created by Kishla Trawlers’s triggered ability (“…When you do, return target instant or sorcery card from your graveyard to your hand.”)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """If a spell is cast as an Omen, its controller shuffles it into its owner’s library instead of putting it into its owner’s graveyard as it resolves."""@en ] .

