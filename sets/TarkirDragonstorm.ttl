                   :MagicOnline ;
    :arenaId "95734"^^xsd:positiveInteger ;
    :arenaName "Neriv, Heart of the Storm" ;
    :arenaSetCode "TDM" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """If damage dealt is being divided or assigned among multiple permanents or players, that damage is divided or assigned before any effects modify how much damage would be dealt. For example, say you control Neriv and you attack an opponent with a 5/5 creature with trample and haste that entered this turn. If it’s blocked by a 2/2 creature, you can assign 2 damage to the blocker and 3 damage to the defending player. Those amounts are then doubled to 4 and 6, respectively."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """The damage is dealt by the same source as the original source of damage. The doubled damage isn’t dealt by Neriv unless it was the original source of damage."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """If another effect (or effects) modifies how much damage a creature you control that entered this turn would deal (for example, by preventing some of that damage), the player being dealt damage or the controller of the permanent being dealt damage chooses the order in which any such effects, including the effect of Neriv’s last ability, apply. If all of the damage is prevented before the effect of Neriv’s last ability would apply, its effect no longer applies."""@en ] .

