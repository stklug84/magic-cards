    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :TarkirDragonstorm ;
    :cardNumber "51"^^xsd:integer ;
    :artist "John Tedrick" ;
    :hasLanguage :English ;
    :power "6" ;
    :powerValue "6"^^xsd:integer ;
    :toughness "7" ;
    :toughnessValue "7"^^xsd:integer ;
    :hasKeywordAbility :Flying ;
    :printedText """Flying
When this creature enters, return up to two other target nonland permanents to their owners' hands.
