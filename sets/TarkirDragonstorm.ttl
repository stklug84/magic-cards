        :rulingText """You must follow the normal timing permissions and restrictions of each spell you cast using the permission granted by Ugin’s last ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """If you cast a spell “without paying its mana cost,” you can’t choose to cast it for any alternative costs. You can, however, pay additional costs, such as kicker costs. If the spell has any mandatory additional costs those must be paid to cast the spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-04-04"^^xsd:date ;
        :rulingText """If a spell has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost."""@en ] .

:BarrensteppeSiege rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Barrensteppe Siege" ;
    :manaCost "{2}{W}{B}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
