      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """If a creature you control would enter the battlefield with a number of +1/+1 counters on it, it enters with that many plus one instead."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """If two or more effects attempt to modify how many counters would be put on a creature you control, you choose the order to apply those effects, no matter who controls the sources of those effects."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """Mutagen tokens are a kind of predefined token. Each one is a colorless artifact with the artifact subtype Mutagen and the ability "{1}, {T}, Sacrifice this token: Put a +1/+1 counter on target creature. Activate only as a sorcery.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """In the unusual case where you control more than one Michelangelo, Weirdness to 11, each one you control will increase the number of +1/+1 counters placed on a creature you control by one."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """Some spells and abilities that create Mutagen tokens require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. The Mutagen token won't be created."""@en ] .

