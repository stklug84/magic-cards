    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """There's no restriction on how many Class permanents you can control, whether they're the same or different classes. Each Class permanent tracks its own level separately."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """You can't activate an ability that advances a Class to a particular level if that Class is already that level or higher. For example, if a Class is already level 2, you can't activate the ability that advances it to level 2 again."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """Food is an artifact type. Even though it appears on some creatures, it's never a creature type."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """An ability that advances a Class to a higher level is a normal activated ability. It uses the stack and can be responded to."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """Some spells and abilities that create Food tokens may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. You won't create any Food tokens."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """Class cards have multiple text box sections. Other than the top section, each section contains a class level bar that includes a cost and a level number. Each represents an activated ability with the listed cost that advances the Class to the level listed in that bar."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """Gaining a level won't remove abilities that a Class had at a previous level."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """The value of X is calculated each time Party Dude's last ability resolves. Changing the number of cards in your hand after the ability resolves won't change the bonus granted to that creature that turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """If an effect refers to a Food, it means any Food artifact, not just a Food artifact token. For example, you can sacrifice Pizza Face (a Legendary Artifact Creature — Food Mutant) to activate Maraleaf Rider's ability (an ability with "Sacrifice a Food" in its cost). You can't sacrifice a Food to pay multiple costs. For example, you can't sacrifice a Food token to activate its own ability and also to activate Maraleaf Rider's ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """Each Class starts at level 1 and has the abilities in the top section of its text box. Once a Class advances to level 2 or level 3, it has all of the abilities listed in the associated section of its text box as well."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """Whatever you do, don't eat the cards. (Also, don't make the pizzas pictured on the cards. You don't have the digestive system of a Ninja Turtle.)"""@en ] .

