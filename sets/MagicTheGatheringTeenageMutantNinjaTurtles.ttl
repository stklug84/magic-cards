:TheLastRoninsTechnique rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "The Last Ronin's Technique" ;
    :manaCost "{3}{W}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Uncommon ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :MagicTheGatheringTeenageMutantNinjaTurtles ;
    :cardNumber "12"^^xsd:integer ;
    :artist "Adam Volker" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Sneak ;
    :printedText """Sneak {1}{W} (You may cast this spell for {1}{W} if you also return an unblocked attacker you control to hand during the declare blockers step.)
Create three 1/1 white Ninja Turtle Spirit creature tokens. If this spell's sneak cost was paid, they enter tapped and attacking."""@en ;
    :oracleText """Sneak {1}{W} (You may cast this spell for {1}{W} if you also return an unblocked attacker you control to hand during the declare blockers step.)
Create three 1/1 white Ninja Turtle Spirit creature tokens. If this spell's sneak cost was paid, they enter tapped and attacking."""@en ;
    :flavorText """They stood beside him. Whether they were figments or true spirits no longer mattered."""@en ;
    :scryfallUrl "https://scryfall.com/card/tmt/12/the-last-ronins-technique"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """Although a creature put onto the battlefield this way is attacking, it was never declared as an attacking creature. Abilities that trigger whenever a creature attacks won't trigger when that creature enters attacking."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """You choose the player, planeswalker, or battle each token is attacking. Each token can enter attacking a different player, planeswalker, or battle. They don't need to be the same player, planeswalker, or battle that the creature returned to pay The Last Ronin's Technique's sneak cost was attacking."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """If a creature spell's sneak cost was paid, the creature it becomes enters tapped and attacking the same player, planeswalker, or battle as the creature that was returned to its owner's hand to pay its sneak cost. This is a rule specific to sneak; in other cases, when a creature is put onto the battlefield attacking, that creature's controller chooses which player, planeswalker, or battle it's attacking."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """Spells can only be cast for their sneak costs any time you could play an instant during the declare blockers step on your turn (after your opponent has decided whether to block)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-01-27"^^xsd:date ;
        :rulingText """Although the tokens enter attacking if The Last Ronin's Technique's sneak cost was paid, those tokens were never declared as attacking creatures. Abilities that trigger whenever a creature attacks won't trigger when those tokens enter attacking."""@en ] .

