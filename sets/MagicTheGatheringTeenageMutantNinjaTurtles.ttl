    :scryfallUrl "https://scryfall.com/card/tmt/6/featherbrained-filcher"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
