:BreakerOfArmies rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Breaker of Armies" ;
    :manaCost "{8}" ;
    :manaValue "8"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Eldrazi ;
    :hasRarity :Uncommon ;
    :isInSet :BattleForZendikar ;
    :cardNumber "3"^^xsd:integer ;
    :artist "Richard Wright" ;
    :hasLanguage :English ;
    :power "10" ;
    :powerValue "10"^^xsd:integer ;
    :toughness "8" ;
    :toughnessValue "8"^^xsd:integer ;
    :printedText """All creatures able to block this creature do so."""@en ;
    :oracleText """All creatures able to block this creature do so."""@en ;
    :flavorText """"There are some who have lost everyone and everything. They actively seek out the Eldrazi, eager for the smallest measure of vengeance."
—Munda, ambush leader"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=401829"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/bfz/3/breaker-of-armies"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2015-08-25"^^xsd:date ;
        :rulingText """If more than one Breaker of Armies is attacking, the controller of each creature that could block them chooses which one that creature blocks. In this case, creatures that can block multiple creatures must block as many attacking Breaker of Armies as possible."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-08-25"^^xsd:date ;
        :rulingText """If, during its controller’s declare blockers step, a creature the defending player controls is tapped or is affected by a spell or ability that says it can’t block, then it doesn’t block. If there’s a cost associated with having it block, its controller isn’t forced to pay that cost. If they don’t, the creature doesn’t have to block."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-08-25"^^xsd:date ;
        :rulingText """If a creature can’t legally block Breaker of Armies but could block another attacking creature, it may do so. Likewise, if a creature the defending player controls can’t block Breaker of Armies unless its controller pays a cost, its controller may decline to pay that cost and block a different attacking creature."""@en ] .

:TitansPresence rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Titan's Presence" ;
    :manaCost "{3}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Uncommon ;
    :isInSet :BattleForZendikar ;
    :cardNumber "14"^^xsd:integer ;
    :artist "Slawomir Maniak" ;
    :hasLanguage :English ;
    :printedText """As an additional cost to cast this spell, reveal a colorless creature card from your hand.
Exile target creature if its power is less than or equal to the revealed card's power."""@en ;
    :oracleText """As an additional cost to cast this spell, reveal a colorless creature card from your hand.
Exile target creature if its power is less than or equal to the revealed card's power."""@en ;
    :flavorText """Dust and memory are all that remain in Ulamog's wake."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=402073"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/bfz/14/titans-presence"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2015-08-25"^^xsd:date ;
        :rulingText """Check the target creature’s power as Titan’s Presence resolves to see if it’s less than or equal to revealed creature card’s power. If it’s greater, Titan’s Presence will finish resolving with no effect."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-08-25"^^xsd:date ;
        :rulingText """The colorless creature card you reveal doesn’t have to still be in your hand as Titan’s Presence resolves. If it’s not, use its power as it last existed in your hand."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-08-25"^^xsd:date ;
        :rulingText """The colorless creature card stays revealed until Titan’s Presence leaves the stack."""@en ] .
