:PowerDepot rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Power Depot" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasCardType :Land ;
    :hasRarity :Uncommon ;
    :isInSet :ModernHorizons2 ;
    :cardNumber "251"^^xsd:integer ;
    :artist "James Paick" ;
    :hasLanguage :English ;
    :producesMana :White ;
    :producesMana :Blue ;
    :producesMana :Black ;
    :producesMana :Red ;
    :producesMana :Green ;
    :producesMana :Colorless ;
    :entersTapped "true"^^xsd:boolean ;
    :hasKeywordAbility :Modular ;
    :printedText """This land enters tapped.
{T}: Add {C}.
{T}: Add one mana of any color. Spend this mana only to cast artifact spells or activate abilities of artifacts.
Modular 1"""@en ;
    :oracleText """This land enters tapped.
{T}: Add {C}.
{T}: Add one mana of any color. Spend this mana only to cast artifact spells or activate abilities of artifacts.
Modular 1"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=522327"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/mh2/251/power-depot"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-06-18"^^xsd:date ;
        :rulingText """Yes, this land enters the battlefield with a +1/+1 counter, which does nothing while it's a land. When it's put into the graveyard from the battlefield, you may put its +1/+1 counters onto target artifact creature, no matter what Power Depot's card types are at the time."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-06-18"^^xsd:date ;
        :rulingText """If Power Depot is a creature and gets enough -1/-1 counters put on it to cause it to go to the graveyard, modular will put a number of +1/+1 counters on the target artifact creature equal to the number of +1/+1 counters on this creature before it left the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-06-18"^^xsd:date ;
        :rulingText """Power Depot is a land, so it can only be played as a land. It cannot be cast as a spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-06-18"^^xsd:date ;
        :rulingText """The mana produced by the last activated ability can't be spent to activate abilities of artifact cards in other zones, such as cycling or unearth costs."""@en ] .

