:OloroAgelessAscetic rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Oloro, Ageless Ascetic" ;
    :manaCost "{3}{W}{U}{B}" ;
    :manaValue "6"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Giant ,
                :Soldier ;
    :hasRarity :MythicRare ;
    :hasColor :White ,
              :Blue ,
              :Black ;
    :hasColorIdentity :White ,
                      :Blue ,
                      :Black ;
    :isInSet :SecretLairDrop ;
    :cardNumber "1962"^^xsd:integer ;
    :artist "Craig Drake" ;
    :hasLanguage :English ;
    :power "4" ;
    :powerValue "4"^^xsd:integer ;
    :toughness "5" ;
    :toughnessValue "5"^^xsd:integer ;
    :printedText """At the beginning of your upkeep, you gain 2 life.
Whenever you gain life, you may pay {1}. If you do, draw a card and each opponent loses 1 life.
At the beginning of your upkeep, if Oloro is in the command zone, you gain 2 life."""@en ;
    :oracleText """At the beginning of your upkeep, you gain 2 life.
Whenever you gain life, you may pay {1}. If you do, draw a card and each opponent loses 1 life.
At the beginning of your upkeep, if Oloro is in the command zone, you gain 2 life."""@en ;
    :flavorText """...defines cutting-edge fashion..."""@en ;
    :scryfallUrl "https://scryfall.com/card/sld/1962/oloro-ageless-ascetic"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2013-10-17"^^xsd:date ;
        :rulingText """In a Two-Headed Giant game, life gained by your teammate won't cause the ability to trigger, even though it causes your team's life total to increase."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-10-17"^^xsd:date ;
        :rulingText """In some unusual cases, you can gain life even though your life total actually decreases. For example, if you are being attacked by two 3/3 creatures and you block one with a 2/2 creature with lifelink, your life total will decrease by 1 even though you've gained 2 life. Oloro's second ability would trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-10-17"^^xsd:date ;
        :rulingText """If Oloro is your commander, its last ability will trigger at the beginning of the upkeep step on your first turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-10-17"^^xsd:date ;
        :rulingText """If two creatures you control with lifelink deal combat damage at the same time, Oloro's ability will trigger twice. However, if a single creature with lifelink deals combat damage to multiple creatures, players, and/or planeswalkers at the same time (perhaps because it has trample or was blocked by more than one creature), the ability will trigger only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-10-17"^^xsd:date ;
        :rulingText """You decide whether to pay {1} as the second ability resolves. If you do, you'll draw a card and each opponent will lose 1 life."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-10-17"^^xsd:date ;
        :rulingText """Oloro's first ability works only if Oloro is on the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2013-10-17"^^xsd:date ;
        :rulingText """Oloro's second ability triggers just once for each life-gaining event, no matter how much life is gained."""@en ] .

:BoseijuWhoSheltersAll rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Boseiju, Who Shelters All" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Land ;
    :hasRarity :Rare ;
    :isInSet :SecretLairDrop ;
    :cardNumber "2657"^^xsd:integer ;
    :artist "SimzArt" ;
    :hasLanguage :English ;
    :producesMana :Colorless ;
    :entersTapped "true"^^xsd:boolean ;
    :printedText """Boseiju enters tapped.
{T}, Pay 2 life: Add {C}. If that mana is spent on an instant or sorcery spell, that spell can't be countered."""@en ;
    :oracleText """Boseiju enters tapped.
{T}, Pay 2 life: Add {C}. If that mana is spent on an instant or sorcery spell, that spell can't be countered."""@en ;
    :flavorText """From its branches, they keep watch of the comings and goings of the courtyard."""@en ;
    :scryfallUrl "https://scryfall.com/card/sld/2657/boseiju-who-shelters-all"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2004-12-01"^^xsd:date ;
        :rulingText """The spell can't be countered if the mana produced by Boseiju is spent to cover any cost of the spell, even an additional cost such as a splice cost. This is true even if you pay an additional cost while casting a spell "without paying its mana cost.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2004-12-01"^^xsd:date ;
        :rulingText """Suppose mana produced by Boseiju is spent on a spell and an effect creates a copy of that spell. The copy can be countered, even though the original can't."""@en ] .
