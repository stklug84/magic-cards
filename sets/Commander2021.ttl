# Card Individuals
#
################################################################################

:EpicureOfBlood rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Epicure of Blood" ;
    :manaCost "{4}{B}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Vampire ;
    :hasRarity :Common ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :Commander2021 ;
    :cardNumber "143"^^xsd:integer ;
    :artist "Anna Steinbauer" ;
    :hasLanguage :English ;
    :power "4" ;
    :powerValue "4"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :printedText """Whenever you gain life, each opponent loses 1 life."""@en ;
    :oracleText """Whenever you gain life, each opponent loses 1 life."""@en ;
    :flavorText """"Fleshy, with just a hint of leather. A fine vintage.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=519178"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/c21/143/epicure-of-blood"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2019-07-12"^^xsd:date ;
        :rulingText """Each creature with lifelink dealing combat damage causes a separate life-gaining event. For example, if two creatures you control with lifelink deal combat damage at the same time, Epicure of Blood's ability will trigger twice. However, if a single creature you control with lifelink deals combat damage to multiple creatures, players, and/or planeswalkers at the same time (perhaps because it has trample or was blocked by more than one creature), the ability will trigger only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-07-12"^^xsd:date ;
        :rulingText """In a Two-Headed Giant game, life gained by your teammate won't cause the ability to trigger, even though it caused your team's life total to increase."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-07-12"^^xsd:date ;
        :rulingText """The ability of Epicure of Blood triggers just once for each life-gaining event, whether it's 1 life from Impassioned Orator or 4 life from Dawning Angel. If you gain an amount of life "for each" of something or "equal to the number" of something, that life is gained as one event and the ability of Epicure of Blood triggers only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-07-12"^^xsd:date ;
        :rulingText """In a Two-Headed Giant game, Epicure of Blood's ability causes the opposing team to lose 1 life twice."""@en ] .

