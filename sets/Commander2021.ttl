    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2014-07-18"^^xsd:date ;
        :rulingText """Although Darksteel Citadel is an artifact, it can't be cast as a spell. Playing it follows the normal rules for playing a land."""@en ] .
