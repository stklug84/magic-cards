    :artist "John Avon" ;
    :hasLanguage :English ;
    :producesMana :Colorless ;
    :hasKeywordAbility :Indestructible ;
    :printedText """Indestructible
{T}: Add {C}."""@en ;
    :oracleText """Indestructible
{T}: Add {C}."""@en ;
    :flavorText """Structures built from darksteel yield to neither assault nor age."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=519320"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/c21/285/darksteel-citadel"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
