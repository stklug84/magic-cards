#
# Card Individuals
#
################################################################################

:MirrorImage rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Mirror Image" ;
    :manaCost "{2}{U}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Shapeshifter ;
    :hasRarity :Uncommon ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :Jumpstart2022 ;
    :cardNumber "62"^^xsd:integer ;
    :artist "Yuchi Yuki" ;
    :hasLanguage :English ;
    :power "0" ;
    :powerValue "0"^^xsd:integer ;
    :toughness "0" ;
    :toughnessValue "0"^^xsd:integer ;
    :printedText """You may have this creature enter as a copy of a creature you control."""@en ;
    :oracleText """You may have this creature enter as a copy of a creature you control."""@en ;
    :flavorText """"Do I really look like that? I'm . . . beautiful!\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=597045"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/j22/62/mirror-image"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """If the chosen creature is copying something else (for example, if the chosen creature is another Mirror Image), then Mirror Image enters the battlefield as whatever the chosen creature copied."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Any enters-the-battlefield abilities of the copied creature will trigger when Mirror Image enters the battlefield. Any "as [this creature] enters the battlefield" or "[this creature] enters the battlefield with" abilities of the chosen creature will also work."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """If Mirror Image somehow enters the battlefield at the same time as another creature, it can't become a copy of that creature. You may choose only a creature that's already on the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Mirror Image copies exactly what was printed on the original creature (unless that creature is copying something else or is a token; see below). It doesn't copy whether that creature is tapped or untapped, whether it has any counters on it or any Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, or so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """If the copied creature has {X} in its mana cost, X is considered to be 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """If the chosen creature is a token, Mirror Image copies the original characteristics of that token as stated by the effect that put the token onto the battlefield. Mirror Image doesn't become a token in this case."""@en ] .

