:PrismariTheInspiration rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Prismari, the Inspiration" ;
    :manaCost "{5}{U}{R}" ;
    :manaValue "7"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Elder ,
                :Dragon ;
    :hasRarity :MythicRare ;
    :hasColor :Blue ,
              :Red ;
    :hasColorIdentity :Blue ,
                      :Red ;
    :isInSet :SecretsOfStrixhaven ;
    :cardNumber "285"^^xsd:integer ;
    :artist "Wayne Reynolds" ;
    :hasLanguage :English ;
    :power "7" ;
    :powerValue "7"^^xsd:integer ;
    :toughness "7" ;
    :toughnessValue "7"^^xsd:integer ;
    :hasKeywordAbility :Flying ,
                       :Ward ;
    :printedText """Flying
Ward—Pay 5 life.
Instant and sorcery spells you cast have storm. (Whenever you cast an instant or sorcery spell, copy it for each spell cast before it this turn. You may choose new targets for the copies.)"""@en ;
    :oracleText """Flying
Ward—Pay 5 life.
Instant and sorcery spells you cast have storm. (Whenever you cast an instant or sorcery spell, copy it for each spell cast before it this turn. You may choose new targets for the copies.)"""@en ;
    :scryfallUrl "https://scryfall.com/card/sos/285/prismari-the-inspiration"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-03-20"^^xsd:date ;
        :rulingText """If a spell has multiple instances of storm, each will trigger separately."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-03-20"^^xsd:date ;
        :rulingText """A copy of a spell can be countered like any other spell, but it must be countered individually. Countering a spell with storm won't affect the copies."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-03-20"^^xsd:date ;
        :rulingText """Spells cast from zones other than a player's hand and spells that were countered or otherwise failed to resolve are counted by the storm ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-03-20"^^xsd:date ;
        :rulingText """The copies of instant and sorcery spells you cast created by the storm ability are put directly onto the stack. They aren't cast and won't be counted by other spells with storm cast later in the turn."""@en ] .

:WisdomOfAges rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Wisdom of Ages" ;
    :manaCost "{4}{U}{U}{U}" ;
    :manaValue "7"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :SecretsOfStrixhaven ;
    :cardNumber "368"^^xsd:integer ;
    :artist "Nathaniel Himawan" ;
    :hasLanguage :English ;
    :printedText """Return all instant and sorcery cards from your graveyard to your hand. You have no maximum hand size for the rest of the game.
Exile Wisdom of Ages."""@en ;
    :oracleText """Return all instant and sorcery cards from your graveyard to your hand. You have no maximum hand size for the rest of the game.
Exile Wisdom of Ages."""@en ;
