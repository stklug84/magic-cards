:FieldsOfStrife rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Fields of Strife" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Land ;
    :hasRarity :Common ;
    :hasColorIdentity :White ;
    :hasColorIdentity :Red ;
    :isInSet :SecretsOfStrixhaven ;
    :cardNumber "255"^^xsd:integer ;
    :artist "Josu Solano" ;
    :hasLanguage :English ;
    :hasKeywordAction :Surveil ;
    :printedText """This land enters tapped.
{T}: Add {R} or {W}.
{2}{R}{W}, {T}: Surveil 1. (Look at the top card of your library. You may put it into your graveyard.)"""@en ;
    :oracleText """This land enters tapped.
{T}: Add {R} or {W}.
{2}{R}{W}, {T}: Surveil 1. (Look at the top card of your library. You may put it into your graveyard.)"""@en ;
    :flavorText """The terrible Blood Age lives on in the unending battle between thousands of spirits trapped in their final moments."""@en ;
    :scryfallUrl "https://scryfall.com/card/sos/255/fields-of-strife"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] .

