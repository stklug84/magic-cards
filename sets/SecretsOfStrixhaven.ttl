      [ rdf:type :Ruling ;
        :rulingDate "2026-03-20"^^xsd:date ;
        :rulingText """It doesn't matter if the creature or creatures targeted by the spell that caused the repartee ability to trigger leave the battlefield or stop being creatures before that spell resolves. As long as that spell targeted one or more creatures when it was cast, the repartee ability will trigger and later resolve."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-03-20"^^xsd:date ;
        :rulingText """A repartee ability resolves before the spell that caused it to trigger. It resolves even if that spell is countered or otherwise leaves the stack."""@en ] .

