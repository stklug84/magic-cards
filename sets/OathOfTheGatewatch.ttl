:CliffhavenVampire rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Cliffhaven Vampire" ;
    :manaCost "{2}{W}{B}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Vampire ,
                :Warrior ,
                :Ally ;
    :hasRarity :Uncommon ;
    :hasColor :White ,
              :Black ;
    :hasColorIdentity :White ,
                      :Black ;
    :isInSet :OathOfTheGatewatch ;
    :cardNumber "153"^^xsd:integer ;
    :artist "David Gaillet" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :hasKeywordAbility :Flying ;
    :printedText """Flying
Whenever you gain life, each opponent loses 1 life."""@en ;
    :oracleText """Flying
Whenever you gain life, each opponent loses 1 life."""@en ;
    :flavorText """"My people are no longer slaves to the Eldrazi, beholden to the past. We will determine our own future.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=407663"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/ogw/153/cliffhaven-vampire"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2016-01-22"^^xsd:date ;
        :rulingText """The ability triggers just once for each life-gaining event, no matter how much life is gained."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-01-22"^^xsd:date ;
        :rulingText """A creature with lifelink dealing combat damage causes a single life-gaining event. For example, if a single creature with lifelink deals combat damage to multiple creatures, players, and/or planeswalkers at the same time (perhaps because it has trample or was blocked by more than one creature), Cliffhaven Vampire’s triggered ability will trigger only once. However, if two creatures you control with lifelink deal combat damage at the same time, the ability will trigger twice."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-01-22"^^xsd:date ;
        :rulingText """In a Two-Headed Giant game, life gained by your teammate won’t cause the ability to trigger, even though it causes your team’s life total to increase."""@en ] .
