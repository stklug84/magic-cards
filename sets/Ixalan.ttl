@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@prefix :     <urn:stklug84:MagicCardsOntology:2026-02-27#> .
@base         <urn:stklug84:MagicCardIndividuals:XLN:2026-07-19#> .

################################################################################
#
# Ontology Definition
#
################################################################################

<urn:stklug84:MagicCardIndividuals:XLN:2026-07-19#>
    rdf:type owl:Ontology ;
    owl:imports <urn:stklug84:MagicCardsOntology:2026-02-27#> ;
    rdfs:label "Magic Card Collection Individuals – Ixalan"@en ;
    rdfs:comment """An instance graph describing the card individuals of a
personal Magic: The Gathering card collection that were printed in the set
Ixalan (XLN). One Card individual is defined per collected
printing, carrying its characteristics, format legalities and official
rulings. Card data was sourced from Gatherer and Scryfall. This file imports
MagicCardsOntology to reuse all existing class, property, set, keyword,
subtype, format and legality definitions."""@en .


################################################################################
#
# Card Individuals
#
################################################################################

:ArcaneAdaptation rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Arcane Adaptation" ;
    :manaCost "{2}{U}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :Ixalan ;
    :cardNumber "46"^^xsd:integer ;
    :artist "Mark Behm" ;
    :hasLanguage :English ;
    :printedText """As this enchantment enters, choose a creature type.
Creatures you control are the chosen type in addition to their other types. The same is true for creature spells you control and creature cards you own that aren't on the battlefield."""@en ;
    :oracleText """As this enchantment enters, choose a creature type.
Creatures you control are the chosen type in addition to their other types. The same is true for creature spells you control and creature cards you own that aren't on the battlefield."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=435198"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/xln/46/arcane-adaptation"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2017-09-29"^^xsd:date ;
        :rulingText """Replacement effects that modify creatures of a certain type as they enter the battlefield will apply after you apply Arcane Adaptation’s effect. This is a change from previous rules. If you control Arcane Adaptation and the Aether Revolt card Metallic Mimic, with the same creature type chosen for both, then any creature you control will enter the battlefield with an additional +1/+1 counter on it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-01-19"^^xsd:date ;
        :rulingText """To choose a creature type, you must choose an existing creature type, such as Vampire or Knight. You can’t choose multiple creature types, such as “Vampire Knight.” Card types such as artifact can’t be chosen, nor can subtypes that aren’t creature types, such as Jace, Vehicle, or Treasure."""@en ] .
