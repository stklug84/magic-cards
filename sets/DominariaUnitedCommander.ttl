:TraxosScourgeOfKroog rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Traxos, Scourge of Kroog" ;
    :manaCost "{4}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Artifact ,
                 :Creature ;
    :hasSubType :Dragon ,
                :Construct ;
    :hasRarity :Rare ;
    :isInSet :DominariaUnitedCommander ;
    :cardNumber "195"^^xsd:integer ;
    :artist "Lius Lasahido" ;
    :hasLanguage :English ;
    :power "7" ;
    :powerValue "7"^^xsd:integer ;
    :toughness "7" ;
    :toughnessValue "7"^^xsd:integer ;
    :hasKeywordAbility :Trample ;
    :printedText """Trample
Traxos enters tapped and doesn't untap during your untap step.
Whenever you cast a historic spell, untap Traxos. (Artifacts, legendaries, and Sagas are historic.)"""@en ;
    :oracleText """Trample
Traxos enters tapped and doesn't untap during your untap step.
Whenever you cast a historic spell, untap Traxos. (Artifacts, legendaries, and Sagas are historic.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=578811"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/dmc/195/traxos-scourge-of-kroog"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2018-04-27"^^xsd:date ;
        :rulingText """Some abilities trigger "whenever you cast a historic spell." Such an ability resolves before the spell that caused it to trigger. It resolves even if that spell is countered."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-04-27"^^xsd:date ;
        :rulingText """Lands are never cast, so abilities that trigger "whenever you cast a historic spell" won't trigger if you play a legendary land. They also won't trigger if a card on the battlefield transforms into a legendary land, as the Ixalan and Rivals of Ixalan double-faced cards do."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-04-27"^^xsd:date ;
        :rulingText """A card, spell, or permanent is historic if it has the legendary supertype, the artifact card type, or the Saga subtype. Having two of those qualities doesn't make an object more historic than another or provide an additional bonus—an object either is historic or it isn't."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-04-27"^^xsd:date ;
        :rulingText """An ability that triggers "whenever you cast a historic spell" doesn't trigger if a historic card is put onto the battlefield without being cast."""@en ] .
