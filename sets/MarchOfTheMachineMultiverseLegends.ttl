:ZadaHedronGrinder rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Zada, Hedron Grinder" ;
    :manaCost "{3}{R}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Goblin ,
                :Ally ;
    :hasRarity :Uncommon ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :MarchOfTheMachineMultiverseLegends ;
    :cardNumber "90"^^xsd:integer ;
    :artist "Chris Rallis" ;
    :hasLanguage :English ;
    :power "3" ;
    :powerValue "3"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    :printedText """Whenever you cast an instant or sorcery spell that targets only Zada, copy that spell for each other creature you control that the spell could target. Each copy targets a different one of those creatures."""@en ;
    :oracleText """Whenever you cast an instant or sorcery spell that targets only Zada, copy that spell for each other creature you control that the spell could target. Each copy targets a different one of those creatures."""@en ;
    :flavorText """"A hedron holds magic for a thousand years—or less, if need be.\""""@en ;
    :scryfallUrl "https://scryfall.com/card/mul/90/zada-hedron-grinder"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "85543"^^xsd:positiveInteger ;
    :arenaName "Zada, Hedron Grinder" ;
    :arenaSetCode "MUL" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2018-03-16"^^xsd:date ;
        :rulingText """Any creature you control that couldn't be targeted by the original spell (due to shroud, protection abilities, targeting restrictions, or any other reason) is just ignored by Zada's ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-03-16"^^xsd:date ;
        :rulingText """If the spell that's copied is modal (that is, it says "Choose one —" or the like), the copies will have the same mode. You can't choose a different one."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-03-16"^^xsd:date ;
        :rulingText """Zada's ability triggers whenever you cast an instant or sorcery spell that targets only Zada and no other object or player."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-03-16"^^xsd:date ;
        :rulingText """The copies that the ability creates are created on the stack, so they're not cast. Abilities that trigger when a player casts a spell (like Zada's ability itself) won't trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-03-16"^^xsd:date ;
        :rulingText """If you cast an instant or sorcery spell that has multiple targets, but it's targeting only Zada with all of them, Zada's ability will trigger. The copies will similarly each be targeting only one of your other creatures. You can't change any of the copy's targets to other creatures."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-03-16"^^xsd:date ;
        :rulingText """The controller of a copy can't choose to pay any alternative or additional costs for the copy. However, effects based on any alternative or additional costs that were paid for the original spell are copied as though those same costs were paid for the copy."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-03-16"^^xsd:date ;
        :rulingText """If the spell that's copied has an X whose value was determined as it was cast (like Rolling Thunder does), the copies have the same value of X."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-03-16"^^xsd:date ;
        :rulingText """You control all the copies. You choose the order the copies are put onto the stack. The original spell will be on the stack beneath those copies and will resolve last."""@en ] .

