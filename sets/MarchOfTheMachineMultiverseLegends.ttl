    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """Jegantha's companion ability compares the exact symbols in the mana costs of cards in your deck. If any one card has the same symbol twice, such as {X}{X}{R} or {(r/g)}{(r/g)}, the companion condition isn't satisfied."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """A generic mana cost is usually represented by numeric mana symbols ({1}, {2}, and so on) and also {X}. It is any cost requiring mana where that cost isn't {C}, {W}, {U}, {B}, {R}, or {G}."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-04-14"^^xsd:date ;
        :rulingText """You can spend mana from Jegantha's mana ability to pay for a hybrid symbol such as {2/W}, but only if you choose to pay the colored mana component, not the generic mana component."""@en ] .
