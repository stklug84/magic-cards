:CyclopsSuperconductor rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Cyclops Superconductor" ;
    :manaCost "{1}{U}{R}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
