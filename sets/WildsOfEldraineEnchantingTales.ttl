:GraspOfFate rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Grasp of Fate" ;
    :manaCost "{1}{W}{W}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :Uncommon ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :WildsOfEldraineEnchantingTales ;
    :cardNumber "3"^^xsd:integer ;
    :artist "WFlemming Illustration" ;
    :hasLanguage :English ;
    :printedText """When this enchantment enters, for each opponent, exile up to one target nonland permanent that player controls until this enchantment leaves the battlefield. (Those permanents return under their owners' control.)"""@en ;
    :oracleText """When this enchantment enters, for each opponent, exile up to one target nonland permanent that player controls until this enchantment leaves the battlefield. (Those permanents return under their owners' control.)"""@en ;
    :flavorText """"The witch wrapped her heart in briar vines, hid it away in the ancient keep in the depths of the forest. If none could find it, the prophecy could never come to pass."
—*Beyond the Great Henge*"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=632431"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/wot/3/grasp-of-fate"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "87041"^^xsd:positiveInteger ;
    :arenaName "Grasp of Fate" ;
    :arenaSetCode "WOT" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """The exiled cards return to the battlefield immediately after Grasp of Fate leaves the battlefield. Nothing happens between the two events, including state-based actions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """Auras attached to exiled nonland permanents will be put into their owners' graveyards. Equipment attached to exiled creatures will become unattached and remain on the battlefield. Any counters on exiled nonland permanents will cease to exist."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """In a multiplayer game, if Grasp of Fate's owner leaves the game, the exiled cards will return to the battlefield. Because the one-shot effect that returns the cards isn't an ability that goes on the stack, it won't cease to exist along with the leaving player's spells and abilities on the stack."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """If a token is exiled, it ceases to exist. It won't be returned to the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """If Grasp of Fate leaves the battlefield before its triggered ability resolves, no nonland permanents will be exiled."""@en ] .

