        :rulingText """If the revealed card has no mana symbols in its upper right corner (because it's a land card, for example), its mana value is 0."""@en ] .

:LeylineOfTheVoid rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Leyline of the Void" ;
    :manaCost "{2}{B}{B}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :Rare ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :WildsOfEldraineEnchantingTales ;
    :cardNumber "30"^^xsd:integer ;
    :artist "Matteo Marjoram" ;
    :hasLanguage :English ;
    :printedText """If this card is in your opening hand, you may begin the game with it on the battlefield.
If a card would be put into an opponent's graveyard from anywhere, exile it instead."""@en ;
    :oracleText """If this card is in your opening hand, you may begin the game with it on the battlefield.
If a card would be put into an opponent's graveyard from anywhere, exile it instead."""@en ;
    :flavorText """"Malevolent lights pulsed around her, whispering of riches in the dark. Still she walked on."
—*The Nameless Knight of Summer*"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=632458"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/wot/30/leyline-of-the-void"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "87068"^^xsd:positiveInteger ;
    :arenaName "Leyline of the Void" ;
    :arenaSetCode "WOT" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """Tokens can still die while Leyline of the Void is on the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """A player's "opening hand" is the hand of cards the player has after all players have taken mulligans. If players have any cards in hand that allow actions to be taken with them from a player's opening hand, the starting player takes all such actions first in any order, followed by each other player in turn order. Then the first turn begins."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """If your opponent discards a card while you control Leyline of the Void, abilities that check whether a card is discarded (such as Hollow One, or a madness ability of the discarded card) still work, even though that card never reaches that player's graveyard. In addition, spells or abilities that check the characteristics of the discarded card can find that card in exile."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-09-20"^^xsd:date ;
        :rulingText """While Leyline of the Void is on the battlefield, nontoken creatures your opponents control won't die. They'll be exiled instead. Abilities that would trigger when those creatures die won't trigger."""@en ] .

:SanguineBond rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Sanguine Bond" ;
    :manaCost "{3}{B}{B}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :Rare ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :WildsOfEldraineEnchantingTales ;
    :cardNumber "35"^^xsd:integer ;
    :artist "Harry Conway" ;
    :hasLanguage :English ;
    :printedText """Whenever you gain life, target opponent loses that much life."""@en ;
    :oracleText """Whenever you gain life, target opponent loses that much life."""@en ;
    :flavorText """"The witch smiled, savoring every stolen year. Every love the knight would never court, every meal he'd never taste, every honor he'd never win, was sweet as honey on her tongue."
—*Hexes of Dunbarrow*"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=632463"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/wot/35/sanguine-bond"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "87073"^^xsd:positiveInteger ;
    :arenaName "Sanguine Bond" ;
    :arenaSetCode "WOT" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2009-10-01"^^xsd:date ;
        :rulingText """Sanguine Bond's ability triggers just once for each life-gaining event, whether it's 1 life from Soul Warden or 8 life from Tendrils of Corruption."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """If you gain an amount of life "for each" of something, that life is gained as one event and Sanguine Bond's ability triggers only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """If an ability triggers whenever an opponent loses life and causes you to gain life, such as the ability of Exquisite Blood, this will loop until either you win the game or a player takes an action to break the loop. If neither of these happen, the game ends in a draw."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Each creature with lifelink dealing combat damage causes a separate life-gaining event. For example, if two creatures you control with lifelink deal combat damage at the same time, Sanguine Bond's ability will trigger twice and you may choose a different opponent for each trigger. However, if a single creature you control with lifelink deals combat damage to multiple creatures, players, planeswalkers, and/or battles at the same time (perhaps because it has trample or was blocked by more than one creature), the ability will trigger only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """In a Two-Headed Giant game, life gained by your teammate won't cause Sanguine Bond's ability to trigger, even though it caused your team's life total to increase."""@en ] .

