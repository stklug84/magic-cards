    :powerValue "3"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    :hasKeywordAbility :Flying ;
    # Note: keyword "Celebration" not defined in MagicCardsOntology
    :hasKeywordAbility :Haste ;
    :printedText """Haste
Celebration — As long as two or more nonland permanents entered the battlefield under your control this turn, Goddric is a Dragon with base power and toughness 4/4, flying, and "{R}: Dragons you control get +1/+0 until end of turn." (It loses all other creature types.)"""@en ;
    :oracleText """Haste
Celebration — As long as two or more nonland permanents entered the battlefield under your control this turn, Goddric is a Dragon with base power and toughness 4/4, flying, and "{R}: Dragons you control get +1/+0 until end of turn." (It loses all other creature types.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=629633"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/woe/132/goddric-cloaked-reveler"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Others are static abilities that give creatures abilities or power and toughness increases as long as two or more nonland permanents entered the battlefield under your control that turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """If an effect causes Goddric to lose all abilities during a turn in which it has already become a Dragon, he's still a Dragon creature with base power and toughness 4/4."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Each celebration ability has a different effect."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Celebration abilities only care if two or more nonland permanents entered the battlefield under your control in a turn. They won't get more powerful if more than two permanents entered the battlefield under your control in a turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """The permanents that entered the battlefield don't need to remain on the battlefield or under your control. Celebration abilities are checking for past events, not the current game state."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Some celebration abilities trigger at specific parts of the turn and check whether two or more nonland permanents entered the battlefield under your control already in that turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Goddric's activated ability affects only Dragons you control at the time it resolves. Any Dragons that come under your control later in the turn won't be affected."""@en ] .

