                   :MagicOnline ;
    :arenaId "86797"^^xsd:positiveInteger ;
    :arenaName "Not Dead After All" ;
    :arenaSetCode "WOE" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """If the creature doesn't return to the battlefield or returns as a noncreature permanent, the Wicked Role token won't be created."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Some spells and abilities that create Role tokens require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. The Role token won't be created."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Roles are colorless enchantment tokens. Each one has the Aura and Role subtypes and the enchant creature ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """A permanent can have multiple Roles attached to it if each one is controlled by a different player."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """If two or more Roles controlled by the same player become attached to a permanent at the same time (perhaps due to an effect such as that of Doubling Season), that player chooses which one to keep and which are put into their owners' graveyards."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Cards in the Wilds of Eldraine main set create six different Role tokens: Cursed, Monster, Royal, Sorcerer, Wicked, and Young Hero. A seventh Role token, Virtuous, is created by Ellivere of the Wild Court, the commander of the "Virtue and Valor" Commander Deck."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """If multiple creatures return to the battlefield (possibly because Not Dead After All targeted a melded permanent), a Wicked Role token will be created attached to each of them."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """If a permanent has more than one Role attached to it controlled by the same player, each of those Roles except the one with the most recent timestamp is put into its owner's graveyard. This is a state-based action."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """In rare cases, a spell or ability might attempt to create a Role token enchanting a permanent that it can't legally enchant (because of an ability like protection from enchantments). In such cases, the Role token isn't created."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Hexproof and shroud won't prevent a Role from becoming attached to a permanent if the ability creating that Role attached to that permanent doesn't target it."""@en ] .

:RowansGrimSearch rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Rowan's Grim Search" ;
    :manaCost "{2}{B}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Common ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :WildsOfEldraine ;
    :cardNumber "104"^^xsd:integer ;
    :artist "Aurore Folny" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Bargain ;
    :printedText """Bargain (You may sacrifice an artifact, enchantment, or token as you cast this spell.)
If this spell was bargained, look at the top four cards of your library, then put up to two of them back on top of your library in any order and the rest into your graveyard.
You draw two cards and you lose 2 life."""@en ;
    :oracleText """Bargain (You may sacrifice an artifact, enchantment, or token as you cast this spell.)
If this spell was bargained, look at the top four cards of your library, then put up to two of them back on top of your library in any order and the rest into your graveyard.
You draw two cards and you lose 2 life."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=629605"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/woe/104/rowans-grim-search"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "86800"^^xsd:positiveInteger ;
    :arenaName "Rowan's Grim Search" ;
    :arenaSetCode "WOE" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Some instant and sorcery spells require additional targets if they're bargained. You ignore those targeting requirements if those spells aren't bargained, and you can't bargain those spells unless you can choose the appropriate targets. On the other hand, you can bargain a permanent spell even if you won't be able to choose targets for an enters-the-battlefield ability of that permanent once the spell resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """You may sacrifice only one artifact, enchantment, or token to pay a spell's bargain cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Bargain means "As an additional cost to cast this spell, you may sacrifice an artifact, enchantment, or token.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """If you copy a bargained spell, the copy is also bargained. If a card or token enters the battlefield as a copy of a permanent that's already on the battlefield, the new permanent isn't bargained, even if the original was."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Bargain represents an optional additional cost. A spell cast with that additional cost paid is "bargained.\""""@en ] .

:ShatterTheOath rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Shatter the Oath" ;
    :manaCost "{3}{B}{B}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Common ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :WildsOfEldraine ;
    :cardNumber "106"^^xsd:integer ;
    :artist "Dominik Mayer" ;
    :hasLanguage :English ;
    # Note: keyword "Role token" not defined in MagicCardsOntology
    :printedText """Destroy target creature or enchantment. Create a Wicked Role token attached to up to one target creature you control. (If you control another Role on it, put that one into the graveyard. Enchanted creature gets +1/+1. When this token is put into a graveyard, each opponent loses 1 life.)"""@en ;
    :oracleText """Destroy target creature or enchantment. Create a Wicked Role token attached to up to one target creature you control. (If you control another Role on it, put that one into the graveyard. Enchanted creature gets +1/+1. When this token is put into a graveyard, each opponent loses 1 life.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=629607"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/woe/106/shatter-the-oath"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "86802"^^xsd:positiveInteger ;
    :arenaName "Shatter the Oath" ;
    :arenaSetCode "WOE" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """In rare cases, a spell or ability might attempt to create a Role token enchanting a permanent that it can't legally enchant (because of an ability like protection from enchantments). In such cases, the Role token isn't created."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Hexproof and shroud won't prevent a Role from becoming attached to a permanent if the ability creating that Role attached to that permanent doesn't target it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Some spells and abilities that create Role tokens require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. The Role token won't be created."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """A permanent can have multiple Roles attached to it if each one is controlled by a different player."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """If two or more Roles controlled by the same player become attached to a permanent at the same time (perhaps due to an effect such as that of Doubling Season), that player chooses which one to keep and which are put into their owners' graveyards."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """If you don't choose a second target for Shatter the Oath or that target is illegal as the spell resolves, the Wicked Role token won't be created."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Roles are colorless enchantment tokens. Each one has the Aura and Role subtypes and the enchant creature ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """If a permanent has more than one Role attached to it controlled by the same player, each of those Roles except the one with the most recent timestamp is put into its owner's graveyard. This is a state-based action."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Cards in the Wilds of Eldraine main set create six different Role tokens: Cursed, Monster, Royal, Sorcerer, Wicked, and Young Hero. A seventh Role token, Virtuous, is created by Ellivere of the Wild Court, the commander of the "Virtue and Valor" Commander Deck."""@en ] .

