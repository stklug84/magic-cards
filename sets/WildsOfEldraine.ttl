    :hasKeywordAbility :Flying ;
    :printedText """Flying
Whenever you cast an Adventure spell, you may copy it. You may choose new targets for the copy."""@en ;
    :oracleText """Flying
Whenever you cast an Adventure spell, you may copy it. You may choose new targets for the copy."""@en ;
    :flavorText """"...so the knight stabbed the troll, the troll threw the knight off the bridge, and they both forgot about the sword.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=629546"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/woe/45/chancellor-of-tales"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "86732"^^xsd:positiveInteger ;
    :arenaName "Chancellor of Tales" ;
    :arenaSetCode "WOE" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Chancellor of Tales's ability and the copy it creates both resolve before the Adventure spell. They resolve even if the Adventure spell is countered before the copy is created."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """If an effect copies an Adventure spell, that copy is exiled as it resolves. It ceases to exist as a state-based action; it's not possible to cast the copy as a permanent."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """An Adventure spell means an instant or sorcery spell with the Adventure spell type. Permanent spells that you cast which have an Adventure won't cause this ability to trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """The copy will have the same targets as the spell it's copying unless you choose new ones. You may change any number of the targets, including all of them or none of them. If, for one of the targets, you can't choose a new legal target, then it remains unchanged (even if the current target is illegal)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """Chancellor of Tales can copy any Adventure spell, not just one with targets."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-09-01"^^xsd:date ;
        :rulingText """The copy is created on the stack, so it's not "cast." Abilities that trigger when a player casts a spell won't trigger."""@en ] .

