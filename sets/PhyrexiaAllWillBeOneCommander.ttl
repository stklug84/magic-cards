    :hasColorIdentity :White ,
                      :Red ;
    :isInSet :PhyrexiaAllWillBeOneCommander ;
    :cardNumber "2"^^xsd:integer ;
    :artist "Bryan Sola" ;
    :hasLanguage :English ;
    :power "3" ;
    :powerValue "3"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    :printedText """Attacking tokens you control have double strike.
Whenever one or more tokens you control attack a player, exile the top card of your library. During any turn you attacked with a token, you may play that card."""@en ;
    :oracleText """Attacking tokens you control have double strike.
Whenever one or more tokens you control attack a player, exile the top card of your library. During any turn you attacked with a token, you may play that card."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=605656"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/onc/2/neyali-suns-vanguard"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """The card Neyali exiles is exiled face up."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """You can cast the exiled card if the token that attacked is still in combat, if it's left combat, if it's left the battlefield, or even if combat is over."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """Neyali's effect doesn't change when you can cast the exiled card. For example, if you exile a sorcery card, you can cast it only during your main phase when the stack is empty."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """Casting an exiled card causes it to leave exile. You can't cast it multiple times."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """The second ability of Neyali, Suns' Vanguard triggers for each player you are attacking with one or more tokens. It does not trigger if you are attacking a planeswalker a player controls, but not that player."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """The effect allowing you to cast the exiled card if you attacked with a token continues to apply even if Neyali leaves the battlefield or another player gains control of it. It also continues to apply during later turns—as long as you attacked with a token during those later turns."""@en ] .

:LuxArtilleryPhyrexiaAllWillBeOneCommander41 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Lux Artillery" ;
    :manaCost "{4}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasRarity :Rare ;
    :isInSet :PhyrexiaAllWillBeOneCommander ;
    :cardNumber "41"^^xsd:integer ;
    :artist "Jason Kang" ;
    :hasLanguage :English ;
    :printedText """Whenever you cast an artifact creature spell, it gains sunburst. (It enters with a +1/+1 counter on it for each color of mana spent to cast it.)
At the beginning of your end step, if there are thirty or more counters among artifacts and creatures you control, this artifact deals 10 damage to each opponent."""@en ;
    :oracleText """Whenever you cast an artifact creature spell, it gains sunburst. (It enters with a +1/+1 counter on it for each color of mana spent to cast it.)
At the beginning of your end step, if there are thirty or more counters among artifacts and creatures you control, this artifact deals 10 damage to each opponent."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=605525"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/onc/41/lux-artillery"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """Lux Artillery's last ability will check if there are thirty or more counters among artifacts and creatures you control as your end step begins. If there aren't, the ability won't trigger at all. If there are, the ability will check again as it tries to resolve. If the number of counters among artifacts and creatures you control has fallen below thirty, the ability won't do anything."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-02-04"^^xsd:date ;
        :rulingText """If the artifact creature already has sunburst (or if you control multiple copies of Lux Artillery), each instance of sunburst works separately."""@en ] .

