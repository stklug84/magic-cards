:NeyaliSunsVanguard rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Neyali, Suns' Vanguard" ;
    :manaCost "{2}{R}{W}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Human ,
                :Rebel ;
    :hasRarity :MythicRare ;
    :hasColor :White ,
