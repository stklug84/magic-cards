    :oracleText """This spell costs {2} less to cast if you control a creature with flying.
Return target nonland permanent you don't control to its owner's hand.
Draw a card."""@en ;
    :flavorText """Skysail's strength was also its vulnerability."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=479574"^^xsd:anyURI ;
