      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """To determine the total cost of a spell, start with the mana cost or alternative cost (such as a disturb cost) you're paying, add any cost increases, then apply any cost reductions. The mana value of a spell cast using disturb is determined by the mana cost on the front face of the card, no matter what the total cost to cast the spell was. (This is a special rule that applies only to nonmodal double faced-cards, including ones with disturb.)"""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """A spell cast this way enters the battlefield with its back face up."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """If you copy a permanent spell cast this way (perhaps with a card like Double Major), the copy becomes a token that's a copy of the card's back face, even though it isn't itself a double-faced card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """Disturb is found only on the front faces of some double-faced cards."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """"Disturb [cost]" means "You may cast this card transformed from your graveyard by paying [cost] rather than its mana cost.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """When you cast a spell using a card's disturb ability, the card is put onto the stack with its back face up. The resulting spell has all the characteristics of that face."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """The back face of each card with disturb has an ability that instructs its controller to exile if it would be put into a graveyard from anywhere. This includes going to the graveyard from the stack, so if the spell is countered after you cast it using the disturb ability, it will be put into exile."""@en ] .

:GisaGloriousResurrector rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Gisa, Glorious Resurrector" ;
    :manaCost "{2}{B}{B}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Human ,
                :Wizard ;
    :hasRarity :Rare ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :InnistradMidnightHunt ;
    :cardNumber "103"^^xsd:integer ;
    :artist "Yongjae Choi" ;
    :hasLanguage :English ;
    :power "4" ;
    :powerValue "4"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :printedText """If a creature an opponent controls would die, exile it instead.
At the beginning of your upkeep, put all creature cards exiled with Gisa onto the battlefield under your control. They gain decayed. (A creature with decayed can't block. When it attacks, sacrifice it at end of combat.)"""@en ;
    :oracleText """If a creature an opponent controls would die, exile it instead.
At the beginning of your upkeep, put all creature cards exiled with Gisa onto the battlefield under your control. They gain decayed. (A creature with decayed can't block. When it attacks, sacrifice it at end of combat.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=534874"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/mid/103/gisa-glorious-resurrector"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "78445"^^xsd:positiveInteger ;
    :arenaName "Gisa, Glorious Resurrector" ;
    :arenaSetCode "MID" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """Decayed represents a static ability and a triggered ability. "Decayed" means "This creature can't block" and "When this creature attacks, sacrifice it at end of combat.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """Because creatures controlled by opponents aren't dying due to Gisa's replacement effect, any "when [this creature] dies" triggered abilities those creatures have won't trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """Once a creature with decayed attacks, it will be sacrificed at end of combat, even if it no longer has decayed at that time."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """Decayed does not create any attacking requirements. You may choose not to attack with a creature that has decayed."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """If a creature your opponent controls would die and more than one effect would cause it to be exiled, that opponent chooses which one to apply. If the creature is exiled due to some other replacement effect, it will not be returned to the battlefield with Gisa."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """Gisa does not grant haste to the creatures that are returned to the battlefield, so you normally won't be able to attack with them the turn they are returned."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-09-24"^^xsd:date ;
        :rulingText """Decayed does not grant haste. Creatures with decayed that enter the battlefield during your turn may not attack until your next turn."""@en ] .
