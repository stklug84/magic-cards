      [ rdf:type :Ruling ;
        :rulingDate "2016-04-08"^^xsd:date ;
        :rulingText """If an effect causes Accursed Witch to transform on the battlefield, rather than leaving it and returning transformed, then Infectious Curse doesn't become attached to any player and is put into your graveyard. This won't cause abilities that trigger when a creature leaves the battlefield to trigger."""@en ] ,
