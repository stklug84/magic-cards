:HighwayRobbery rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Highway Robbery" ;
    :manaCost "{1}{R}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Common ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :OutlawsOfThunderJunction ;
    :cardNumber "129"^^xsd:integer ;
    :artist "Scott Murphy" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Plot ;
    :printedText """You may discard a card or sacrifice a land. If you do, draw two cards.
Plot {1}{R} (You may pay {1}{R} and exile this card from your hand. Cast it as a sorcery on a later turn without paying its mana cost. Plot only as a sorcery.)"""@en ;
    :oracleText """You may discard a card or sacrifice a land. If you do, draw two cards.
Plot {1}{R} (You may pay {1}{R} and exile this card from your hand. Cast it as a sorcery on a later turn without paying its mana cost. Plot only as a sorcery.)"""@en ;
    :flavorText """The fires weren't even out before the backstabbing began."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=655070"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/otj/129/highway-robbery"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "90475"^^xsd:positiveInteger ;
    :arenaName "Highway Robbery" ;
    :arenaSetCode "OTJ" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """Plot abilities are written “Plot [cost],” which means “Any time you have priority during your main phase while the stack is empty, you may pay [cost] and exile this card from your hand. It becomes plotted.”"""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If you’re casting a plotted card from exile without paying its mana cost, you can’t choose to cast it for any other alternative costs. You can, however, pay additional costs, such as kicker costs. If the plotted card has any mandatory additional costs, those must still be paid to cast the spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """You can’t cast a plotted card on the same turn it became plotted. On any future turn, you may cast that card from exile without paying its mana cost during your main phase while the stack is empty."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """You can’t choose to discard a card if you have no cards in hand. Similarly, you can’t choose to sacrifice a land if you control no lands."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """Exiling a card using its plot ability is a special action. Once you announce you’re taking that action, no other player can respond by trying to remove that card from your hand."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If a plotted card has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost."""@en ] .

