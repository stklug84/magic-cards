      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """Outlaw is not a creature type. If an effect asks you to choose a creature type, you can’t choose outlaw."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """A card, spell, or permanent is an outlaw if it has the Assassin, Mercenary, Pirate, Rogue, or Warlock creature type. It doesn’t matter if it has more than one of those creature types; as long as it has at least one, it’s an outlaw."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If an ability refers to an outlaw or whether a player controls an outlaw, it’s referring only to permanents with one or more of the creature types specified above. Notably, it’s not referring to any spell or card not on the battlefield. However, other abilities may refer to an “outlaw spell” or “outlaw card” in a zone other than the battlefield. Those abilities refer to spells and cards with one or more of the specified creature types."""@en ] .

:ThreeStepsAhead rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Three Steps Ahead" ;
    :manaCost "{U}" ;
    :manaValue "1"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :OutlawsOfThunderJunction ;
    :cardNumber "75"^^xsd:integer ;
    :artist "Francisco Miyara" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Spree ;
    :printedText """Spree (Choose one or more additional costs.)
+ {1}{U} — Counter target spell.
+ {3} — Create a token that's a copy of target artifact or creature you control.
+ {2} — Draw two cards, then discard a card."""@en ;
    :oracleText """Spree (Choose one or more additional costs.)
+ {1}{U} — Counter target spell.
+ {3} — Create a token that's a copy of target artifact or creature you control.
+ {2} — Draw two cards, then discard a card."""@en ;
    :flavorText """She'd planned for every eventuality, with the obvious exception of failure."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=655016"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/otj/75/three-steps-ahead"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "90421"^^xsd:positiveInteger ;
    :arenaName "Three Steps Ahead" ;
    :arenaSetCode "OTJ" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If an effect allows you to cast a spell with spree “without paying its mana cost,” you must still choose at least one mode and pay the associated additional costs."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """You can’t choose the same mode more than once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """Each additional cost and associated mode in the text box is also preceded with a + indicator. These symbols also have no rules meaning and serve only to remind players that the listed costs are additional costs."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """The token copies exactly what was printed on the original permanent and nothing else (unless that permanent is copying something else or is a token; see below). It doesn’t copy whether that permanent is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """No player can cast spells or activate abilities in between the modes of a resolving spell. Any abilities that trigger won’t be put onto the stack until the spell is done resolving."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If the copied permanent is a token, the token that’s created copies the original characteristics of that token as stated by the effect that created that token."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If a mode requires a target, you can select that mode only if there’s a legal target available. Ignore the targeting requirements for modes you don’t choose."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If the first and/or second modes are chosen, then Three Steps Ahead has one or more targets. If so, and all its targets are illegal as it tries to resolve, Three Steps Ahead won’t resolve and none of its effects will happen. If at least one target is still legal, the spell will resolve and modes with legal targets (and the third mode, if chosen) will have their effects."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If a spell with spree is copied, the effect that creates the copy may allow you to choose new targets. You cannot choose new modes."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If the copied permanent is copying something else, then the token enters the battlefield as whatever that permanent copied."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """No matter which modes you choose, you always follow the instructions in the order they are written."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """You must choose at least one of the listed modes and pay its associated additional cost in order to cast a spell with spree."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """Spells with spree have a + (plus sign) indicator in the upper right corner of the card frame. This has no rules meaning and serves only to remind players that at least one additional cost is required to cast the spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """The mana value of a spell with spree is determined only by its mana cost (in the upper right corner of the card). It doesn’t matter which modes you choose or which additional costs you pay, including any additional costs imposed by other effects."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """You choose the modes as you cast the spell with spree. Once modes are chosen, they can’t be changed."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If the copied permanent has {X} in its mana cost, X is 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """Any enters-the-battlefield abilities of the copied permanent will trigger when the token enters the battlefield. Any “as [this permanent] enters the battlefield” or “[this permanent] enters the battlefield with” abilities of the copied permanent will also work."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If all targets for the chosen modes become illegal before a spell with spree resolves, the spell won’t resolve and none of its effects will happen. If at least one target is still legal, the spell will resolve but will have no effect on any illegal targets."""@en ] .

