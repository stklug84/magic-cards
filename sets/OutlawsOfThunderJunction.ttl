:AnnieJoinsUp rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Annie Joins Up" ;
    :manaCost "{1}{R}{G}{W}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Enchantment ;
    :hasRarity :Rare ;
    :hasColor :White ;
    :hasColor :Red ;
    :hasColor :Green ;
    :hasColorIdentity :White ;
    :hasColorIdentity :Red ;
    :hasColorIdentity :Green ;
    :isInSet :OutlawsOfThunderJunction ;
    :cardNumber "191"^^xsd:integer ;
    :artist "Wylie Beckert" ;
    :hasLanguage :English ;
    :printedText """When Annie Joins Up enters, it deals 5 damage to target creature or planeswalker an opponent controls.
If a triggered ability of a legendary creature you control triggers, that ability triggers an additional time."""@en ;
    :oracleText """When Annie Joins Up enters, it deals 5 damage to target creature or planeswalker an opponent controls.
If a triggered ability of a legendary creature you control triggers, that ability triggers an additional time."""@en ;
    :flavorText """One last job, then she could retire in peace."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=655132"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/otj/191/annie-joins-up"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """In some cases involving linked abilities, an ability requires information about “the exiled card.” When this happens, the ability gets multiple answers. If these answers are being used to determine the value of a variable, the sum is used. For example, if Elite Arcanist’s enters-the-battlefield ability triggers twice, two cards are exiled. The value of X in the activation cost of Elite Arcanist’s other ability is the sum of the two cards’ mana values. As the ability resolves, you create copies of both cards and can cast none, one, or both of the copies in any order."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """Triggered abilities use the word “when,” “whenever,” or “at.” They’re often written as “[Trigger condition], [effect].” Some keyword abilities are triggered abilities and will have “when,” “whenever,” or “at the beginning of” in their reminder text."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """Annie Joins Up’s last ability doesn’t copy the triggered ability; it just causes the ability to trigger an additional time. Any choices made as you put the ability onto the stack, such as modes and targets, are made separately for each instance of the ability. Any choices made on resolution, such as whether to put counters on a permanent, are also made individually."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """Once an ability of a creature you control has triggered, making it legendary won’t cause that ability to trigger an additional time. Similarly, once an ability of a legendary creature you control has triggered an additional time due to Annie Joins Up’s last ability, turning it into a nonlegendary creature won’t remove that additional triggered ability from the stack."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If a triggered ability is linked to a second ability, additional instances of that triggered ability are also linked to that second ability. If the second ability refers to “the exiled card,” it refers to all cards exiled by instances of the triggered ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """Replacement effects are unaffected by Annie Joins Up’s last ability. For example, a 1/1 creature that enters the battlefield under your control with one +1/+1 counter on it won’t receive an additional +1/+1 counter."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """Abilities that apply “as [this creature] enters the battlefield” or “as [this creature] is turned face up” are also unaffected."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """Abilities that apply “when [this creature] is turned face up” will trigger an additional time only if that creature is legendary once it has been turned face up."""@en ] .

:KellanJoinsUp rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Kellan Joins Up" ;
    :manaCost "{G}{W}{U}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Enchantment ;
    :hasRarity :Rare ;
    :hasColor :White ;
    :hasColor :Blue ;
    :hasColor :Green ;
    :hasColorIdentity :White ;
    :hasColorIdentity :Blue ;
    :hasColorIdentity :Green ;
    :isInSet :OutlawsOfThunderJunction ;
    :cardNumber "212"^^xsd:integer ;
    :artist "Wylie Beckert" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Plot ;
    :printedText """When Kellan Joins Up enters, you may exile a nonland card with mana value 3 or less from your hand. If you do, it becomes plotted. (You may cast it as a sorcery on a later turn without paying its mana cost.)
Whenever a legendary creature you control enters, put a +1/+1 counter on each creature you control."""@en ;
    :oracleText """When Kellan Joins Up enters, you may exile a nonland card with mana value 3 or less from your hand. If you do, it becomes plotted. (You may cast it as a sorcery on a later turn without paying its mana cost.)
Whenever a legendary creature you control enters, put a +1/+1 counter on each creature you control."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=655153"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/otj/212/kellan-joins-up"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If a card doesn't have a mana cost, its mana value is 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If the mana cost of a card in your hand includes {X}, X is 0 for the purpose of determining its mana value."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """Exiling a card using its plot ability is a special action. Once you announce you're taking that action, no other player can respond by trying to remove that card from your hand."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """You can't cast a plotted card on the same turn it became plotted. On any future turn, you may cast that card from exile without paying its mana cost during your main phase while the stack is empty."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """The mana value of a split card in your hand is based on the combined mana cost of its two halves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """Plot abilities are written "Plot [cost]," which means "Any time you have priority during your main phase while the stack is empty, you may pay [cost] and exile this card from your hand. It becomes plotted.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If you're casting a plotted card from exile without paying its mana cost, you can't choose to cast it for any other alternative costs. You can, however, pay additional costs, such as kicker costs. If the plotted card has any mandatory additional costs, those must still be paid to cast the spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If a plotted card has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If multiple legendary creatures enter the battlefield under your control at the same time, Kellan Joins Up's last ability will trigger once for each of those creatures."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """If an instant or a card with flash is plotted this way, you can still cast it only when you have priority during your main phase while the stack is empty."""@en ] .

