    :artist "David Auden Nash" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    :printedText """Whenever a source you control deals noncombat damage to a creature equal to that creature's toughness, draw a card.
{X}, {T}: If a source you control would deal noncombat damage to a permanent or player this turn, it deals that much damage plus X instead."""@en ;
    :oracleText """Whenever a source you control deals noncombat damage to a creature equal to that creature's toughness, draw a card.
{X}, {T}: If a source you control would deal noncombat damage to a permanent or player this turn, it deals that much damage plus X instead."""@en ;
    :flavorText """"You'd best keep yourself out of my sights.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=655175"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/otj/234/taii-wakeen-perfect-shot"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """If another effect modifies how much damage a source would deal, including preventing some of it, the player being dealt damage or the controller of the permanent being dealt damage chooses an order in which to apply those effects. If all of the damage is prevented, Taii Wakeen’s effect no longer applies."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """The additional X damage is dealt by the same source as the original source of damage. The damage isn’t dealt by Taii Wakeen unless Taii Wakeen is the original source of damage."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-04-12"^^xsd:date ;
        :rulingText """Taii Wakeen’s first ability doesn’t care about any damage already marked on a creature. It just cares about whether the noncombat damage dealt to a creature by a source you control was equal to that creature’s toughness."""@en ] .

