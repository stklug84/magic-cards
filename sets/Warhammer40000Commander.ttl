:Zoanthrope rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Zoanthrope" ;
    :manaCost "{X}{U}{R}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Tyranid ;
    :hasRarity :Rare ;
    :hasColor :Blue ,
              :Red ;
    :hasColorIdentity :Blue ,
                      :Red ;
    :isInSet :Warhammer40000Commander ;
    :cardNumber "149"^^xsd:integer ;
    :artist "Billy Christian" ;
    :hasLanguage :English ;
    :power "0" ;
    :powerValue "0"^^xsd:integer ;
    :toughness "0" ;
    :toughnessValue "0"^^xsd:integer ;
    :hasKeywordAbility :Flying ,
                       :Ravenous ,
                       :Ward ;
    # Note: keyword "Warp Blast" not defined in MagicCardsOntology
    :printedText """Ravenous (This creature enters with X +1/+1 counters on it. If X is 5 or more, draw a card when it enters.)
Flying, ward {2}
Warp Blast — When this creature enters, it deals X damage to any target."""@en ;
    :oracleText """Ravenous (This creature enters with X +1/+1 counters on it. If X is 5 or more, draw a card when it enters.)
Flying, ward {2}
Warp Blast — When this creature enters, it deals X damage to any target."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=580971"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/40k/149/zoanthrope"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-07"^^xsd:date ;
        :rulingText """If a permanent spell with ravenous is copied, the copy will have the same value for X, and the token permanent that the spell becomes as it enters the battlefield will enter with X counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-07"^^xsd:date ;
        :rulingText """The triggered ability that checks to see if X is 5 or greater refers to the value of X that was chosen as the spell was cast, which may be different from the number of counters it entered with if there are replacement effects involved. This is also true for any other ability that it has which refers to X and triggers when it enters the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-07"^^xsd:date ;
        :rulingText """If another permanent enters the battlefield as a copy of a creature with Ravenous, it will not enter with any counters from the ravenous ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-10-07"^^xsd:date ;
        :rulingText """A creature with ravenous gets its counters as it enters the battlefield. It doesn't enter the battlefield first and then get its counters. Any triggered ability that looks for a creature with a certain power or toughness entering the battlefield will see the counters when it checks to see if it should trigger."""@en ] .
