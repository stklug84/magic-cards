When this enchantment enters, exile target tapped creature an opponent controls until this enchantment leaves the battlefield."""@en ;
    :flavorText """An ancient nemesis rendered harmless long ago."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=442919"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/dom/31/seal-away"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "67166"^^xsd:positiveInteger ;
    :arenaName "Seal Away" ;
    :arenaSetCode "DAR" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2018-04-27"^^xsd:date ;
        :rulingText """If Seal Away leaves the battlefield before its triggered ability resolves, the target creature won’t be exiled."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-04-27"^^xsd:date ;
        :rulingText """If a token is exiled this way, it will cease to exist and won’t return to the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-04-27"^^xsd:date ;
        :rulingText """Auras attached to the exiled creature will be put into their owners’ graveyards. Any Equipment will become unattached and remain on the battlefield. Any counters on the exiled creature will cease to exist. When the card returns to the battlefield, it will be a new object with no connection to the card that was exiled."""@en ] .

