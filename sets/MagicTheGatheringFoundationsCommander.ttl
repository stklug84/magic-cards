:RighteousValkyrie rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Righteous Valkyrie" ;
    :manaCost "{2}{W}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
