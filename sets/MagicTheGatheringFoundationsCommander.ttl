@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@prefix :     <urn:stklug84:MagicCardsOntology:2026-02-27#> .
@base         <urn:stklug84:MagicCardIndividuals:FDC:2026-07-19#> .

################################################################################
#
# Ontology Definition
#
################################################################################

<urn:stklug84:MagicCardIndividuals:FDC:2026-07-19#>
    rdf:type owl:Ontology ;
    owl:imports <urn:stklug84:MagicCardsOntology:2026-02-27#> ;
    rdfs:label "Magic Card Collection Individuals – Foundations Commander"@en ;
    rdfs:comment """An instance graph describing the card individuals of a
personal Magic: The Gathering card collection that were printed in the set
Foundations Commander (FDC). One Card individual is defined per collected
printing, carrying its characteristics, format legalities and official
rulings. Card data was sourced from Gatherer and Scryfall. This file imports
MagicCardsOntology to reuse all existing class, property, set, keyword,
subtype, format and legality definitions."""@en .


################################################################################
#
# Card Individuals
#
################################################################################

:ArcaneSignetMagicTheGatheringFoundationsCommander1 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Arcane Signet" ;
    :manaCost "{2}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasRarity :Uncommon ;
    :isInSet :MagicTheGatheringFoundationsCommander ;
    :cardNumber "1"^^xsd:integer ;
    :artist "Dan Murayama Scott" ;
    :hasLanguage :English ;
    :producesMana :White ,
                  :Blue ,
                  :Black ,
                  :Red ,
                  :Green ;
    :printedText """{T}: Add one mana of any color in your commander's color identity."""@en ;
    :oracleText """{T}: Add one mana of any color in your commander's color identity."""@en ;
    :flavorText """It started as a mere drop of water. The Magic Mirror crystallized it into much more."""@en ;
    :scryfallUrl "https://scryfall.com/card/fdc/1/arcane-signet"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """If you don't have a commander, Arcane Signet's ability produces no mana."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """If you have two commanders, the ability adds one mana of any color in their combined color identities."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """If your commander is a card that has no colors in its color identity, Arcane Signet's ability produces no mana. It doesn't produce {C}."""@en ] .

