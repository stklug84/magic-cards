:LilianaHereticalHealer rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Liliana, Heretical Healer // Liliana, Defiant Necromancer" ;
    :manaCost "{1}{B}{B}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ,
                 :Planeswalker ;
