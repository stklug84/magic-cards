    :power "*" ;
    :toughness "5" ;
    :toughnessValue "5"^^xsd:integer ;
    :printedText """Robobrain War Mind's power is equal to the number of cards in your hand.
When this creature enters, you get an amount of {E} (energy counters) equal to the number of artifact creatures you control.
Whenever this creature attacks, you may pay {E}{E}{E}. If you do, draw a card."""@en ;
    :oracleText """Robobrain War Mind's power is equal to the number of cards in your hand.
When this creature enters, you get an amount of {E} (energy counters) equal to the number of artifact creatures you control.
Whenever this creature attacks, you may pay {E}{E}{E}. If you do, draw a card."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=652125"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/pip/38/robobrain-war-mind"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """Use the number of artifact creatures you control when Robobrain War Mind's second ability resolves, including Robobrain War Mind itself if it's still on the battlefield, to determine the number of energy counters you get."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """{E} is the energy symbol. It represents one energy counter."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """Energy counters aren't mana. They don't go away as steps, phases, and turns end, and effects that add mana "of any type" can't give you energy counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """Some triggered abilities that state that you "may pay" a certain amount of {E} describe an effect that happens "If you do." In that case, no player may take actions to try to stop the ability's effect after you make your choice. If the payment is followed by the phrase "When you do," then you'll choose any targets for that reflexive triggered ability and put it on the stack before players can take actions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """If a spell or ability with one or more targets states that you "may pay" some amount of {E}, and each permanent that it targets has become an illegal target, the spell or ability won't resolve. You can't pay any {E} even if you want to."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """Some spells and abilities that give you {E} may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. You won't get any {E}."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """Keep track of how many energy counters each player has. Potential ways to track this include writing them down on paper or using dice, but any method that is clear and mutually agreeable is fine. (At higher levels of tournament play, dice may not be allowed for tracking counters that players have.)"""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """Some triggered abilities state that you "may pay" a certain amount of {E}. You can't pay that amount multiple times to multiply the effect. You simply choose whether or not to pay that amount of {E} as the ability resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """If an effect says you get one or more {E}, you get that many energy counters. To pay one or more {E}, you lose that many energy counters. You can't pay more energy counters than you have. Any effects that interact with counters a player gets, has, or loses can interact with energy counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """The ability that defines Robobrain War Mind's power functions in all zones, not just the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """Energy counters are a kind of counter that a player may have. They're not associated with any specific permanents."""@en ] .

:SynthInfiltrator rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Synth Infiltrator" ;
    :manaCost "{3}{U}{U}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasCardType :Creature ;
    :hasSubType :Synth ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :MagicTheGatheringFallout ;
    :cardNumber "40"^^xsd:integer ;
    :artist "Leonardo Borazio" ;
    :hasLanguage :English ;
    :power "0" ;
    :powerValue "0"^^xsd:integer ;
    :toughness "0" ;
    :toughnessValue "0"^^xsd:integer ;
    :hasKeywordAbility :Improvise ;
    :printedText """Improvise (Your artifacts can help cast this spell. Each artifact you tap after you're done activating mana abilities pays for {1}.)
You may have this creature enter as a copy of any creature on the battlefield, except it's a Synth artifact creature in addition to its other types."""@en ;
    :oracleText """Improvise (Your artifacts can help cast this spell. Each artifact you tap after you're done activating mana abilities pays for {1}.)
You may have this creature enter as a copy of any creature on the battlefield, except it's a Synth artifact creature in addition to its other types."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=652127"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/pip/40/synth-infiltrator"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """You can choose not to have Synth Infiltrator enter the battlefield as a copy of another creature. If you do, it will probably die due to having 0 toughness. (This is probably not the kind of innovation the Institute would approve of.)"""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """If the copied creature is a token, Synth Infiltrator copies the original characteristics of that token as stated by the effect that created that token, with the noted exceptions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """If the copied creature is copying something else, then Synth Infiltrator enters the battlefield as whatever that creature copied, with the noted exceptions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """Except for being a Synth artifact creature in addition to its other types, Synth Infiltrator copies exactly what was printed on the original creature and nothing else (unless that creature is copying something else or is a token; see below). It doesn’t copy whether that creature is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, or any non-copy effects that have changed its power, toughness, types, color, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """Any enters-the-battlefield abilities of the copied creature will trigger when Synth Infiltrator enters the battlefield. Any “as [this creature] enters the battlefield” or “[this creature] enters the battlefield with” abilities of the copied creature will also work."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """Improvise doesn’t change Synth Infiltrator’s mana cost or mana value, and it can’t reduce Synth Infiltrator’s cost below {U}{U}."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """If the copied creature has {X} in its mana cost, X is 0."""@en ] .

