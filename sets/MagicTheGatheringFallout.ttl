:OpenTheVaults rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Open the Vaults" ;
    :manaCost "{4}{W}{W}" ;
    :manaValue "6"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Rare ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :MagicTheGatheringFallout ;
    :cardNumber "168"^^xsd:integer ;
    :artist "Ilker Yildiz" ;
    :hasLanguage :English ;
    :printedText """Return all artifact and enchantment cards from all graveyards to the battlefield under their owners' control. (Auras with nothing to enchant remain in graveyards.)"""@en ;
    :oracleText """Return all artifact and enchantment cards from all graveyards to the battlefield under their owners' control. (Auras with nothing to enchant remain in graveyards.)"""@en ;
    :flavorText """"It may be time to leave, but I'll never forget the day you all entered Vault 76."
—Overseer"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=653131"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/pip/168/open-the-vaults"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """If an Aura can be returned to the battlefield with Open the Vaults, it must be, even if its owner doesn't like what it would enchant."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """If an Aura is put onto the battlefield without being cast, the Aura's controller-to-be chooses what it will enchant as it enters the battlefield. An Aura put onto the battlefield this way doesn't target anything (so it could be attached to an opponent's permanent with hexproof, for example), but the Aura's enchant ability restricts what it can be attached to. If the Aura can't legally be attached to anything, it remains in its current zone."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """An Aura put onto the battlefield this way can't enchant an artifact or enchantment that's also being put onto the battlefield with Open the Vaults."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """If multiple players have Auras in their graveyards, the player whose turn it is announces what their Auras will enchant, then each other player in turn order does the same, then all artifacts and enchantments (including both Auras and non-Auras) enter the battlefield at the same time."""@en ] .

