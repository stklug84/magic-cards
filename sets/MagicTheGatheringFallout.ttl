      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """If Vault 13 leaves the battlefield before its first chapter ability resolves, the target permanents won't be exiled at all."""@en ] ,
      [ rdf:type :Ruling ;
