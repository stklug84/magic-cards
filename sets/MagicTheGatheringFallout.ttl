:RobobrainWarMind rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Robobrain War Mind" ;
    :manaCost "{3}{U}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasCardType :Creature ;
    :hasSubType :Robot ;
    :hasRarity :Uncommon ;
    :hasColor :Blue ;
