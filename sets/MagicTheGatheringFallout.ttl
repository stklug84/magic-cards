:GlimmerOfGeniusMagicTheGatheringFallout176 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Glimmer of Genius" ;
    :manaCost "{3}{U}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Uncommon ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :MagicTheGatheringFallout ;
    :cardNumber "176"^^xsd:integer ;
    :artist "Josu Hernaiz" ;
    :hasLanguage :English ;
    :hasKeywordAction :Scry ;
    :printedText """Scry 2, then draw two cards. You get {E}{E} (two energy counters)."""@en ;
    :oracleText """Scry 2, then draw two cards. You get {E}{E} (two energy counters)."""@en ;
    :flavorText """Dr. Madison Li's genius was an asset for both Project Purity and, later, the Institute."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=653139"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/pip/176/glimmer-of-genius"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some spells and abilities that give you {E} may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. You won't get any {E}."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """{E} is the energy symbol. It represents one energy counter."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """If a spell or ability with one or more targets states that you "may pay" some amount of {E}, and each permanent that it targets has become an illegal target, the spell or ability won't resolve. You can't pay any {E} even if you want to."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """If an effect says you get one or more {E}, you get that many energy counters. To pay one or more {E}, you lose that many energy counters. You can't pay more energy counters than you have. Any effects that interact with counters a player gets, has, or loses can interact with energy counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some triggered abilities state that you "may pay" a certain amount of {E}. You can't pay that amount multiple times to multiply the effect. You simply choose whether or not to pay that amount of {E} as the ability resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some triggered abilities that state that you "may pay" a certain amount of {E} describe an effect that happens "If you do." In that case, no player may take actions to try to stop the ability's effect after you make your choice. If the payment is followed by the phrase "When you do," then you'll choose any targets for that reflexive triggered ability and put it on the stack before players can take actions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Energy counters aren't mana. They don't go away as steps, phases, and turns end, and effects that add mana "of any type" can't give you energy counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Energy counters are a kind of counter that a player may have. They're not associated with any specific permanents."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Keep track of how many energy counters each player has. Potential ways to track this include writing theme down on paper or using dice, but any method that is clear and mutually agreeable is fine. (At higher levels of tournament play, dice may not be allowed for tracking counters that players have.)"""@en ] .

:MechanizedProductionMagicTheGatheringFallout178 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Mechanized Production" ;
    :manaCost "{2}{U}{U}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasSubType :Aura ;
    :hasRarity :MythicRare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :MagicTheGatheringFallout ;
    :cardNumber "178"^^xsd:integer ;
    :artist "Brian Valeza" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Enchant ;
    :printedText """Enchant artifact you control
At the beginning of your upkeep, create a token that's a copy of enchanted artifact. Then if you control eight or more artifacts with the same name as one another, you win the game."""@en ;
    :oracleText """Enchant artifact you control
At the beginning of your upkeep, create a token that's a copy of enchanted artifact. Then if you control eight or more artifacts with the same name as one another, you win the game."""@en ;
    :flavorText """At the onset of the Great War, Nuka-Cola's best minds were reassigned to weapons development."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=653141"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/pip/178/mechanized-production"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """All eight of the permanents sharing a name must be artifacts. If you control only seven artifacts with the same name and a nonartifact permanent with that same name, you won't win the game."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """If the copied artifact is a token, the token that's created copies the original characteristics of that token as stated by the effect that created it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """If the copied artifact is copying something else (for example, if the copied artifact is a Sculpting Steel), then the token enters the battlefield as whatever that artifact copied."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """The eight artifacts with the same name don't have to have the same name as the enchanted artifact. For example, you win the game if you control eight Thopter artifact creature tokens as Mechanized Production's ability resolves, even if Mechanized Production isn't attached to a Thopter."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """If the enchanted artifact leaves the battlefield in response to Mechanized Production's triggered ability but Mechanized Production does not, Mechanized Production is put into its owner's graveyard as a state-based action with no enchanted artifact. The triggered ability creates no token, but you can still win the game if you control enough artifacts with the same name."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """If the copied artifact has {X} in its mana cost, X is considered to be zero."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """If you control eight or more artifacts that share a name while you control Mechanized Production, you won't win the game yet. You'll win the game while resolving its triggered ability during your upkeep."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """Any enters-the-battlefield abilities of the copied artifact trigger when the artifact token enters the battlefield. The artifact token also has any "this enters the battlefield with" or "as this enters the battlefield" abilities that the copied artifact has."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """The token copies exactly what was printed on the original artifact and nothing else (unless that artifact is copying something else or is a token; see below). It doesn't copy whether that artifact is tapped or untapped, whether it has any counters on it or Auras attached to it, or any non-copy effects that have changed its types, color, or so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """If Mechanized Production and the enchanted artifact leave the battlefield simultaneously in response to the triggered ability, then the effect creates a token that's a copy of the artifact as it last existed on the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """Any abilities that trigger on the token being created won't resolve until after Mechanized Production's triggered ability has finished resolving entirely and performed its check for eight artifacts with the same name."""@en ] .

