:ExpertLevelSafe rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Expert-Level Safe" ;
    :manaCost "{2}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasRarity :Uncommon ;
    :isInSet :MagicTheGatheringFallout ;
    :cardNumber "133"^^xsd:integer ;
    :artist "Victor Harmatiuk" ;
    :hasLanguage :English ;
    :printedText """When this artifact enters, exile the top two cards of your library face down.
{1}, {T}: You and target opponent each secretly choose 1, 2, or 3. Then those choices are revealed. If they match, sacrifice this artifact and put all cards exiled with it into their owners' hands. Otherwise, exile the top card of your library face down."""@en ;
    :oracleText """When this artifact enters, exile the top two cards of your library face down.
{1}, {T}: You and target opponent each secretly choose 1, 2, or 3. Then those choices are revealed. If they match, sacrifice this artifact and put all cards exiled with it into their owners' hands. Otherwise, exile the top card of your library face down."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=652220"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/pip/133/expert-level-safe"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """To secretly choose the numbers, you and the target opponent should each write down your choice of 1, 2, or 3 without showing them to anyone else. Keep those choices secret until they’re simultaneously revealed."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """You don’t get to look at the cards exiled by Expert-Level Safe’s abilities."""@en ] .

