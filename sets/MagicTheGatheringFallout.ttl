:CAMP rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "C.A.M.P." ;
    :manaCost "{3}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasSubType :Fortification ;
    :hasRarity :Uncommon ;
    :isInSet :MagicTheGatheringFallout ;
    :cardNumber "129"^^xsd:integer ;
    :artist "Tomas Duchek" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Fortify ;
    :printedText """Whenever fortified land is tapped for mana, put a +1/+1 counter on target creature you control. If that creature shares a color with the mana that land produced, create a Junk token. (It's an artifact with "{T}, Sacrifice this token: Exile the top card of your library. You may play that card this turn. Activate only as a sorcery.")
Fortify {3} ({3}: Attach to target land you control. Fortify only as a sorcery.)"""@en ;
    :oracleText """Whenever fortified land is tapped for mana, put a +1/+1 counter on target creature you control. If that creature shares a color with the mana that land produced, create a Junk token. (It's an artifact with "{T}, Sacrifice this token: Exile the top card of your library. You may play that card this turn. Activate only as a sorcery.")
Fortify {3} ({3}: Attach to target land you control. Fortify only as a sorcery.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=652216"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/pip/129/camp"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """Fortification is to lands what Equipment is to creatures. Except for the difference regarding what type of permanent they can be attached to, Fortifications and Equipment follow the same rules."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """If the fortified land produced more than one color of mana, you'll create a Junk token as long as the target creature is at least one of those colors."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """You can't sacrifice a Junk token to pay multiple costs. For example, you can't sacrifice a Junk token to activate its own ability and also to activate the second ability of Junk Jet."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """Some spells and abilities that create Junk tokens may require targets. If each target chosen is illegal as that spell or ability tries to resolve, it won't resolve and none of its effects happen. You won't create any Junk tokens."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-03-08"^^xsd:date ;
        :rulingText """You pay all costs and follow all normal timing rules for the card played from exile with a Junk token's ability. For example, if the exiled card is a land card, you may play it only during your main phase while the stack is empty."""@en ] .

