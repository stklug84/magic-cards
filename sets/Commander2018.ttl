:GeodeGolem rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Geode Golem" ;
    :manaCost "{5}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ,
                 :Creature ;
    :hasSubType :Golem ;
    :hasRarity :Uncommon ;
    :isInSet :Commander2018 ;
    :cardNumber "56"^^xsd:integer ;
    :artist "Yeong-Hao Han" ;
    :hasLanguage :English ;
    :power "5" ;
    :powerValue "5"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    :hasKeywordAbility :Trample ;
    :printedText """Trample
Whenever this creature deals combat damage to a player, you may cast your commander from the command zone without paying its mana cost. (You still pay any additional costs.)"""@en ;
    :oracleText """Trample
Whenever this creature deals combat damage to a player, you may cast your commander from the command zone without paying its mana cost. (You still pay any additional costs.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=450657"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/c18/56/geode-golem"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Geode Golem's triggered ability triggers even if it's dealt lethal damage at the same time it deals combat damage to a player."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """If a spell has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """If you cast a card “without paying its mana cost,” you can't choose to cast it for any alternative costs, such as bestow costs. You can, however, pay additional costs. If the card has any mandatory additional costs, such as the commander tax, those must be paid to cast the card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """If you wish to cast your commander without paying its mana cost, you must cast it while the triggered ability of Geode Golem is resolving. You can't cast for free it later in the turn. It may be cast at a time you normally wouldn't be able to cast a creature spell, but other restrictions (such as “Cast this card only from your graveyard”) are enforced."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-07-13"^^xsd:date ;
        :rulingText """Geode Golem's triggered ability triggers even if your commander isn't in the command zone at the time Geode Golem deals combat damage to a player. If your commander finds its way there before the trigger resolves, you can cast it."""@en ] .
