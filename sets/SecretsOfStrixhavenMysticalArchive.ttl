:Deduce rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Deduce" ;
    :manaCost "{1}{U}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Uncommon ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :SecretsOfStrixhavenMysticalArchive ;
    :cardNumber "16"^^xsd:integer ;
    :artist "Dominik Mayer" ;
    :hasLanguage :English ;
    :hasKeywordAction :Investigate ;
    :printedText """Draw a card. Investigate. (Create a Clue token. It's an artifact with "{2}, Sacrifice this token: Draw a card.")"""@en ;
    :oracleText """Draw a card. Investigate. (Create a Clue token. It's an artifact with "{2}, Sacrifice this token: Draw a card.")"""@en ;
    :flavorText """"Do not overlook the unusual, for therein often lie the keys to the unknown."
—Alquist Proft's case journal"""@en ;
    :scryfallUrl "https://scryfall.com/card/soa/16/deduce"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """Clue is an artifact type. Even though it appears on some cards with other permanent types, it's never a creature type, a land type, or anything but an artifact type."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """You can't sacrifice a Clue to pay multiple costs. For example, you can't sacrifice a Clue token to activate its own ability and also to activate Alquist Proft, Master Sleuth's ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """Some spells and abilities that investigate may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. You won't create any Clue tokens."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """Some abilities trigger "whenever you sacrifice a Clue". Those abilities trigger whenever you sacrifice a Clue for any reason, not just to activate a Clue's activated ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """If an effect refers to a Clue, it means any Clue artifact, not just a Clue artifact token. For example, you can sacrifice Wrench to pay for Alquist Proft, Master Sleuth's activated ability."""@en ] .

:FeedTheSwarmSecretsOfStrixhavenMysticalArchive29 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Feed the Swarm" ;
    :manaCost "{1}{B}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Uncommon ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :SecretsOfStrixhavenMysticalArchive ;
    :cardNumber "29"^^xsd:integer ;
    :artist "Paul Adam" ;
    :hasLanguage :English ;
    :printedText """Destroy target creature or enchantment an opponent controls. You lose life equal to that permanent's mana value."""@en ;
    :oracleText """Destroy target creature or enchantment an opponent controls. You lose life equal to that permanent's mana value."""@en ;
    :flavorText """"You cannot fight the Hunger Tide. You can only run, hide—and pray."
—Entry in a tattered journal"""@en ;
    :scryfallUrl "https://scryfall.com/card/soa/29/feed-the-swarm"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If a permanent on the battlefield has {X} in its mana cost, X is 0 for the purpose of determining its mana value."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """If the target permanent is an illegal target by the time Feed the Swarm tries to resolve, the spell doesn't resolve. You don't lose any life. If the target is legal but not destroyed (most likely because it has indestructible), you do lose life."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-11-08"^^xsd:date ;
        :rulingText """The amount of life you lose is determined by the permanent's mana value as it last existed on the battlefield."""@en ] .

