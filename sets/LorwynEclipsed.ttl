@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@prefix :     <urn:stklug84:MagicCardsOntology:2026-02-27#> .
@base         <urn:stklug84:MagicCardIndividuals:ECL:2026-07-19#> .

################################################################################
#
# Ontology Definition
#
################################################################################

<urn:stklug84:MagicCardIndividuals:ECL:2026-07-19#>
    rdf:type owl:Ontology ;
    owl:imports <urn:stklug84:MagicCardsOntology:2026-02-27#> ;
    rdfs:label "Magic Card Collection Individuals – Lorwyn Eclipsed"@en ;
    rdfs:comment """An instance graph describing the card individuals of a
personal Magic: The Gathering card collection that were printed in the set
Lorwyn Eclipsed (ECL). One Card individual is defined per collected
printing, carrying its characteristics, format legalities and official
rulings. Card data was sourced from Gatherer and Scryfall. This file imports
MagicCardsOntology to reuse all existing class, property, set, keyword,
subtype, format and legality definitions."""@en .


################################################################################
#
# Card Individuals
#
################################################################################

:RequitingHex rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Requiting Hex" ;
    :manaCost "{B}" ;
    :manaValue "1"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Uncommon ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :LorwynEclipsed ;
    :cardNumber "116"^^xsd:integer ;
    :artist "Randy Gallegos" ;
    :hasLanguage :English ;
    :hasKeywordAction :Blight ;
    :printedText """As an additional cost to cast this spell, you may blight 1. (You may put a -1/-1 counter on a creature you control.)
Destroy target creature with mana value 2 or less. If this spell's additional cost was paid, you gain 2 life."""@en ;
    :oracleText """As an additional cost to cast this spell, you may blight 1. (You may put a -1/-1 counter on a creature you control.)
Destroy target creature with mana value 2 or less. If this spell's additional cost was paid, you gain 2 life."""@en ;
    :scryfallUrl "https://scryfall.com/card/ecl/116/requiting-hex"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-11-17"^^xsd:date ;
        :rulingText """All of the -1/-1 counters must be put on a single creature. You can't choose to split them up between multiple creatures."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-11-17"^^xsd:date ;
        :rulingText """If a creature on the battlefield has {X} in its mana cost, X is 0 for the purpose of determining its mana value."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-11-17"^^xsd:date ;
        :rulingText """The creature you choose to put -1/-1 counters on doesn't have to have enough toughness to survive the process. For example, if you blight 2, you can choose to put the counters on a 1/1 creature you control."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-11-17"^^xsd:date ;
        :rulingText """If you can't place -1/-1 counters on any creatures you control (probably because you control no creatures), you can't choose to blight."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-11-17"^^xsd:date ;
        :rulingText """If the target creature is an illegal target as Requiting Hex tries to resolve, it won't resolve and none of its effects will happen. You won't gain life even if the additional cost was paid."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-11-17"^^xsd:date ;
        :rulingText """Once you've announced that you're casting a spell or activating an ability, players can't take actions until you've finished doing so. Notably, opponents can't try to destroy or otherwise remove your creatures to stop you from blighting as part of paying the cost of that spell or ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-11-17"^^xsd:date ;
        :rulingText """If a creature that has +1/+1 counters on it receives enough -1/-1 counters to cause it to be destroyed by lethal damage or put into its owner's graveyard for having 0 or less toughness, effects that refer to the counters on that creature when it died will see all of those +1/+1 and -1/-1 counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-11-17"^^xsd:date ;
        :rulingText """If a creature has +1/+1 counters and -1/-1 counters on it, state-based actions remove the same number of each so that it has only one kind of those counters on it. For example, if a creature has three +1/+1 counters on it and two -1/-1 counters are put on it, state-based actions will remove two of each of those kinds of counters, leaving the creature with just one +1/+1 counter."""@en ] .
