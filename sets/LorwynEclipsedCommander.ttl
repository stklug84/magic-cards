    :hasColorIdentity :Blue ;
    :hasColorIdentity :Black ;
    :hasColorIdentity :Green ;
    :isInSet :LorwynEclipsedCommander ;
    :cardNumber "128"^^xsd:integer ;
    :artist "Jason Rainville" ;
    :hasLanguage :English ;
    :power "6" ;
    :powerValue "6"^^xsd:integer ;
    :toughness "6" ;
    :toughnessValue "6"^^xsd:integer ;
    :printedText """During each of your turns, you may play a land and cast a permanent spell of each permanent type from your graveyard. (If a card has multiple permanent types, choose one as you play it.)"""@en ;
    :oracleText """During each of your turns, you may play a land and cast a permanent spell of each permanent type from your graveyard. (If a card has multiple permanent types, choose one as you play it.)"""@en ;
    :flavorText """"My child grew from rot and ruin, yet she bloomed."
—Multani"""@en ;
    :scryfallUrl "https://scryfall.com/card/ecc/128/muldrotha-the-gravetide"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """For example, you may cast an artifact creature spell as your artifact spell and cast another artifact creature spell as your creature spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """If multiple effects allow you to play a card from your graveyard, you must announce which permission you're using as you begin to play the card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """You must pay the costs to cast a spell this way. If it has an alternative cost, you may cast it for that cost instead."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """If a permanent card is put into your graveyard during your main phase and the stack is empty, you have a chance to cast it before any player may attempt to remove that card from your graveyard."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """Once you begin to cast a spell, losing control of Muldrotha won't affect the spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """You must follow the normal timing permissions and restrictions of the cards you play from your graveyard. For example, you can't use Muldrotha to play a land if you don't have an available land play or to cast a planeswalker spell during your end step."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """If you play a card from your graveyard and then have a new Muldrotha come under your control in the same turn, you may play another land or spell of that type from your graveyard that turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """Use the type of the card as it's played or cast to determine which permanent type to count it as. For example, if you cast a creature spell from your graveyard, you can cast a card with bestow as an enchantment spell."""@en ] .

