    :cardName "Gurmag Angler" ;
    :manaCost "{6}{B}" ;
    :manaValue "7"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Zombie ,
                :Fish ;
    :hasRarity :Common ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :PioneerMasters ;
    :cardNumber "94"^^xsd:integer ;
    :artist "YW Tang" ;
    :hasLanguage :English ;
    :power "5" ;
    :powerValue "5"^^xsd:integer ;
    :toughness "5" ;
    :toughnessValue "5"^^xsd:integer ;
    :hasKeywordAbility :Delve ;
    :printedText """Delve (Each card you exile from your graveyard while casting this spell pays for {1}.)"""@en ;
    :oracleText """Delve (Each card you exile from your graveyard while casting this spell pays for {1}.)"""@en ;
    :scryfallUrl "https://scryfall.com/card/pio/94/gurmag-angler"^^xsd:anyURI ;
    :isAvailableOn :MTGArena ;
    :arenaId "94325"^^xsd:positiveInteger ;
    :arenaName "Gurmag Angler" ;
    :arenaSetCode "PIO" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """Delve doesn't change a spell's mana cost or mana value. For example, Treasure Cruise's mana value is 8 even if you exiled three cards to cast it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """Because delve isn't an alternative cost, it can be used in conjunction with alternative costs, such as flashback. It can also be used to pay for additional costs that include generic mana."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """You can exile cards to pay only for generic mana, and you can't exile more cards than the generic mana requirement of a spell with delve. For example, you can't exile more than seven cards from your graveyard to cast Treasure Cruise unless an effect has increased its cost."""@en ] .

