    :isInSet :PioneerMasters ;
    :cardNumber "31"^^xsd:integer ;
    :artist "Darek Zabrocki" ;
    :hasLanguage :English ;
    :producesMana :White ;
    :entersTapped "true"^^xsd:boolean ;
    :printedText """Target creature you control gains protection from the color of your choice until end of turn.
//
This land enters tapped.
{T}: Add {W}."""@en ;
    :oracleText """Target creature you control gains protection from the color of your choice until end of turn.
//
This land enters tapped.
{T}: Add {W}."""@en ;
    :scryfallUrl "https://scryfall.com/card/pio/31/sejiri-shelter-sejiri-glacier"^^xsd:anyURI ;
    :isAvailableOn :MTGArena ;
    :arenaId "94257"^^xsd:positiveInteger ;
    :arenaName "Sejiri Shelter" ;
    :arenaSetCode "PIO" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-09-25"^^xsd:date ;
        :rulingText """In the Commander variant, a double-faced card's color identity is determined by the mana costs and mana symbols in the rules text of both faces combined. If either face has a color indicator or basic land type, those are also considered."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-09-25"^^xsd:date ;
        :rulingText """A modal double-faced card can't be transformed or be put onto the battlefield transformed. Ignore any instruction to transform a modal double-faced card or to put one onto the battlefield transformed."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-09-25"^^xsd:date ;
        :rulingText """There is a single triangle icon in the top left corner of the front face. There is a double triangle icon in the top left corner of the back face."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-09-25"^^xsd:date ;
        :rulingText """If an effect allows you to play a specific modal double-faced card, you may cast it as a spell or play it as a land, as determined by which face you choose to play. If an effect allows you to cast (rather than "play") a specific modal double-faced card, you can't play it as a land."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-09-25"^^xsd:date ;
        :rulingText """If an effect allows you to play a land or cast a spell from among a group of cards, you may play or cast a modal double-faced card with any face that fits the criteria of that effect."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-09-25"^^xsd:date ;
        :rulingText """If an effect instructs a player to choose a card name, the name of either face may be chosen. If that effect or a linked ability refers to a spell with the chosen name being cast and/or a land with the chosen name being played, it considers only the chosen name, not the other face's name."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-09-25"^^xsd:date ;
        :rulingText """If an effect puts a double-faced card onto the battlefield, it enters with its front face up. If that front face can't be put onto the battlefield, it doesn't enter the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-09-25"^^xsd:date ;
        :rulingText """The mana value of a modal double-faced card is based on the characteristics of the face that's being considered. On the stack and battlefield, consider whichever face is up. In all other zones, consider only the front face. This is different than how the mana value of a transforming double-faced card is determined."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-09-25"^^xsd:date ;
        :rulingText """To determine whether it is legal to play a modal double-faced card, consider only the characteristics of the face you're playing and ignore the other face's characteristics."""@en ] .

:GustOfWindPioneerMasters57 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Gust of Wind" ;
    :manaCost "{3}{U}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Common ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :PioneerMasters ;
    :cardNumber "57"^^xsd:integer ;
    :artist "Adam Paquette" ;
    :hasLanguage :English ;
    :printedText """This spell costs {2} less to cast if you control a creature with flying.
Return target nonland permanent you don't control to its owner's hand.
Draw a card."""@en ;
    :oracleText """This spell costs {2} less to cast if you control a creature with flying.
Return target nonland permanent you don't control to its owner's hand.
Draw a card."""@en ;
    :scryfallUrl "https://scryfall.com/card/pio/57/gust-of-wind"^^xsd:anyURI ;
    :isAvailableOn :MTGArena ;
    :arenaId "94284"^^xsd:positiveInteger ;
    :arenaName "Gust of Wind" ;
    :arenaSetCode "PIO" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """To determine the total cost of a spell, start with the mana cost or alternative cost you're paying, add any cost increases, then apply any cost reductions (such as that of Gust of Wind). The mana value of the spell remains unchanged, no matter what the total cost to cast it was."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """Once you announce that you're casting Gust of Wind, no player may take actions until the spell has been paid for. Notably, opponents can't try to change whether you control a creature with flying."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """If the target nonland permanent is an illegal target by the time Gust of Wind tries to resolve, the spell won't resolve. You won't draw a card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """Gust of Wind is unaffected if you no longer control a creature with flying after you've cast it."""@en ] .

