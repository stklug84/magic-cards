:HeartPiercerManticore rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Heart-Piercer Manticore" ;
    :manaCost "{2}{R}{R}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Manticore ;
    :hasRarity :Uncommon ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :PioneerMasters ;
    :cardNumber "140"^^xsd:integer ;
    :artist "Scott Murphy" ;
    :hasLanguage :English ;
    :power "4" ;
    :powerValue "4"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    :hasKeywordAbility :Embalm ;
    :printedText """When this creature enters, you may sacrifice another creature. When you do, this creature deals damage equal to that creature's power to any target.
Embalm {5}{R} ({5}{R}, Exile this card from your graveyard: Create a token that's a copy of it, except it's a white Zombie Manticore with no mana cost. Embalm only as a sorcery.)"""@en ;
    :oracleText """When this creature enters, you may sacrifice another creature. When you do, this creature deals damage equal to that creature's power to any target.
Embalm {5}{R} ({5}{R}, Exile this card from your graveyard: Create a token that's a copy of it, except it's a white Zombie Manticore with no mana cost. Embalm only as a sorcery.)"""@en ;
    :scryfallUrl "https://scryfall.com/card/pio/140/heart-piercer-manticore"^^xsd:anyURI ;
    :isAvailableOn :MTGArena ;
    :arenaId "94374"^^xsd:positiveInteger ;
    :arenaName "Heart-Piercer Manticore" ;
    :arenaSetCode "PIO" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """The sacrificed creature's last known existence on the battlefield is checked to determine its power."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """For each card with embalm, a corresponding game play supplement token can be found in some Amonkhet booster packs. These supplements are not required to play with cards with embalm; you can use the same items to represent an embalmed token as you would any other token."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """Heart-Piercer Manticore's damage-dealing ability triggers only when you sacrifice a creature as a result of the instruction of its triggered ability. It won't trigger if you sacrifice a creature for any other reason."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """The token copies exactly what was printed on the original card and nothing else. It doesn't copy any information about the object the card was before it was put into your graveyard."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """If the card copied by the token had any "when [this permanent] enters the battlefield" abilities, then the token also has those abilities and will trigger them when it's created. Similarly, any "as [this permanent] enters the battlefield" or "[this permanent] enters the battlefield with" abilities that the token has copied will also work."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """You can't sacrifice multiple creatures to deal damage multiple times."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """The token is a Zombie in addition to its other types and is white instead of its other colors. It has no mana cost, and thus its mana value is 0. These are copiable values of the token that other effects may copy."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """Heart-Piercer Manticore features a new style of triggered ability. When it enters the battlefield, its triggered ability goes on the stack without a target. While that ability is resolving, you may sacrifice a creature. If you do, a second ability triggers and you pick a target that will be dealt damage. This is different from other abilities that say "If you do . . ." in that players may cast spells and activate abilities before a creature is sacrificed and then again after the creature is sacrificed but before damage is dealt."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-07-14"^^xsd:date ;
        :rulingText """Once you've activated an embalm ability, the card is immediately exiled. Opponents can't try to stop the ability by exiling the card with an effect such as that of Crook of Condemnation."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-07-14"^^xsd:date ;
        :rulingText """If a spell or ability puts a creature card with embalm into your graveyard during your main phase, you'll have priority immediately after that spell or ability resolves. You can activate the creature card's embalm ability before any player can exile it with an effect, such as that of Crook of Condemnation, if it's legal for you to do so."""@en ] .

:OathOfChandra rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Oath of Chandra" ;
    :manaCost "{1}{R}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Enchantment ;
    :hasRarity :Rare ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :PioneerMasters ;
    :cardNumber "148"^^xsd:integer ;
    :artist "Wesley Burt" ;
    :hasLanguage :English ;
    :printedText """When Oath of Chandra enters, it deals 3 damage to target creature an opponent controls.
At the beginning of each end step, if a planeswalker entered the battlefield under your control this turn, Oath of Chandra deals 2 damage to each opponent."""@en ;
    :oracleText """When Oath of Chandra enters, it deals 3 damage to target creature an opponent controls.
At the beginning of each end step, if a planeswalker entered the battlefield under your control this turn, Oath of Chandra deals 2 damage to each opponent."""@en ;
    :scryfallUrl "https://scryfall.com/card/pio/148/oath-of-chandra"^^xsd:anyURI ;
    :isAvailableOn :MTGArena ;
    :arenaId "94382"^^xsd:positiveInteger ;
    :arenaName "Oath of Chandra" ;
    :arenaSetCode "PIO" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2016-01-22"^^xsd:date ;
        :rulingText """Each of the Oaths is legendary: if you control more than one of any particular Oath, you choose one to remain on the battlefield and the others are put into your graveyard."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-01-22"^^xsd:date ;
        :rulingText """Oath of Chandra’s last ability will trigger even if the planeswalker that entered the battlefield under your control is no longer on the battlefield, no longer under your control, or no longer a planeswalker. This is also true if Oath of Chandra wasn’t on the battlefield when the planeswalker entered."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-01-22"^^xsd:date ;
        :rulingText """The “legend rule” checks the full names of legendary permanents. You can control Oath of Gideon and Oath of Chandra at the same time, for example."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-01-22"^^xsd:date ;
        :rulingText """Even if you control a particular Oath, you can cast another of that Oath to take advantage of its enters-the-battlefield ability. It will enter the battlefield, causing its first ability to trigger. You will then choose one to keep, as detailed above, and then its enters-the-battlefield ability will resolve."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-01-22"^^xsd:date ;
        :rulingText """The last ability triggers only once per turn, even if more than one planeswalker entered the battlefield under your control."""@en ] .

