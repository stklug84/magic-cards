:MassPolymorph rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Mass Polymorph" ;
    :manaCost "{5}{U}" ;
    :manaValue "6"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :RealityFractureCommander ;
    :cardNumber "42"^^xsd:integer ;
    :artist "Christopher Moeller" ;
    :hasLanguage :English ;
    :printedText """Exile all creatures you control, then reveal cards from the top of your library until you reveal that many creature cards. Put all creature cards revealed this way onto the battlefield, then shuffle the rest of the revealed cards into your library."""@en ;
    :oracleText """Exile all creatures you control, then reveal cards from the top of your library until you reveal that many creature cards. Put all creature cards revealed this way onto the battlefield, then shuffle the rest of the revealed cards into your library."""@en ;
    :scryfallUrl "https://scryfall.com/card/frc/42/mass-polymorph"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2010-08-15"^^xsd:date ;
        :rulingText """All creatures you put onto the battlefield with Mass Polymorph enter at the same time."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2010-08-15"^^xsd:date ;
        :rulingText """If the number of creatures you exile is greater than the number of creature cards remaining in your library, you'll wind up revealing your entire library, putting all creature cards revealed that way onto the battlefield, then shuffling your library."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2010-08-15"^^xsd:date ;
        :rulingText """The creatures you exile with Mass Polymorph remain exiled for the rest of the game."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2010-08-15"^^xsd:date ;
        :rulingText """Any abilities that trigger during the resolution of Mass Polymorph (such as a creature's "enters" ability) will wait to be put onto the stack until Mass Polymorph finishes resolving. The player whose turn it is will put all of their triggered abilities on the stack in any order, then each other player in turn order will do the same. (The last ability put on the stack will be the first one that resolves.)"""@en ] .

