    :artist "Greg Staples" ;
    :hasLanguage :English ;
    :printedText """Create X 1/1 white Soldier creature tokens. If X is 5 or more, destroy all other creatures."""@en ;
    :oracleText """Create X 1/1 white Soldier creature tokens. If X is 5 or more, destroy all other creatures."""@en ;
    :flavorText """Their war forgotten, the nations of Bant stood united in the face of a common threat."""@en ;
    :scryfallUrl "https://scryfall.com/card/frc/28/martial-coup"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
