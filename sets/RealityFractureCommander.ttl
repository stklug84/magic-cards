      [ rdf:type :Ruling ;
        :rulingDate "2021-06-18"^^xsd:date ;
        :rulingText """You may choose any card type. The ones that may appear in a normal game of Magic are artifact, battle, creature, enchantment, instant, kindred, land, planeswalker, and sorcery. Supertypes such as snow and basic may not be chosen. Subtypes such as Angel, Aura, and Forest also may not be chosen."""@en ] ,
