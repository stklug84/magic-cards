:ReflectingPool rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Reflecting Pool" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Land ;
    :hasRarity :Rare ;
    :isInSet :RealityFractureCommander ;
    :cardNumber "23"^^xsd:integer ;
    :artist "Marco Gorlei" ;
    :hasLanguage :English ;
    :producesMana :White ,
                  :Blue ,
                  :Black ,
                  :Red ,
                  :Green ;
    :printedText """{T}: Add one mana of any type that a land you control could produce."""@en ;
    :oracleText """{T}: Add one mana of any type that a land you control could produce."""@en ;
    :flavorText """"Jace's world is like a warped mirror. Like some part of him strains against what the Theorist is creating."
—Vraska"""@en ;
    :scryfallUrl "https://scryfall.com/card/frc/23/reflecting-pool"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaName "Reflecting Pool" ;
    :arenaSetCode "FRC" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """Reflecting Pool’s ability doesn’t care about any restrictions or riders your lands put on the mana they produce, such as those of Plaza of Heroes or Power Depot. It just produces one mana of the appropriate type, with no restrictions or riders."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """Reflecting Pool’s ability checks the effects of all mana-producing abilities of lands you control, but it doesn’t check their costs or legality. For example, Spire of Industry says “{T}, Pay 1 life: Add one mana of any color. Activate only if you control an artifact.” If you control Spire of Industry and Reflecting Pool, you can tap Reflecting Pool for any color of mana. It doesn’t matter whether you control an artifact, whether you can pay 1 life, or whether Spire of Industry is untapped."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """The types of mana are white, blue, black, red, green, and colorless."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """Any change to a land’s type or abilities gained by a land can affect the types of mana a land can produce."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-07-25"^^xsd:date ;
        :rulingText """Multiple Reflecting Pools won’t help each other produce mana. If you control a Reflecting Pool, and all other lands you control either lack mana abilities or are other Reflecting Pools, you may still activate Reflecting Pool’s ability—it just won’t produce any mana."""@en ] .

