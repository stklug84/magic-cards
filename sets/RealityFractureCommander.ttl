:SharkTyphoon rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Shark Typhoon" ;
    :manaCost "{5}{U}" ;
    :manaValue "6"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :RealityFractureCommander ;
    :cardNumber "44"^^xsd:integer ;
    :artist "Caio Monteiro" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Cycling ;
    :printedText """Whenever you cast a noncreature spell, create an X/X blue Shark creature token with flying, where X is that spell's mana value.
Cycling {X}{1}{U} ({X}{1}{U}, Discard this card: Draw a card.)
When you cycle this card, create an X/X blue Shark creature token with flying."""@en ;
    :oracleText """Whenever you cast a noncreature spell, create an X/X blue Shark creature token with flying, where X is that spell's mana value.
Cycling {X}{1}{U} ({X}{1}{U}, Discard this card: Draw a card.)
When you cycle this card, create an X/X blue Shark creature token with flying."""@en ;
    :scryfallUrl "https://scryfall.com/card/frc/44/shark-typhoon"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """An ability that triggers when a player casts a spell resolves before the spell that caused it to trigger. It resolves even if that spell is countered."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """You can cycle a card even if it has a triggered ability from cycling that won't have a legal target. This is because the cycling ability and the triggered ability are separate. This also means that if either ability is countered (with Disallow, for example), the other ability will still resolve."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """Triggered abilities from cycling a card and the cycling ability itself aren't spells. Effects that interact with spells (such as that of Cancel) won't affect them."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """For spells with {X} in their mana costs, use the value chosen for X to determine the spell's mana value."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """Some cards with cycling have an ability that triggers when you cycle them, and some cards have an ability that triggers whenever you cycle any card. These triggered abilities resolve before you draw from the cycling ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-04-17"^^xsd:date ;
        :rulingText """You can choose 0 as the value of X in Shark Typhoon's cycling cost. The last ability will trigger, and you'll create a 0/0 blue Shark creature token with flying. Unless something else is raising its toughness, the Shark will then immediately die."""@en ] .

:SyntheticDestiny rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Synthetic Destiny" ;
    :manaCost "{4}{U}{U}" ;
    :manaValue "6"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :RealityFractureCommander ;
    :cardNumber "45"^^xsd:integer ;
    :artist "Dave Kendall" ;
    :hasLanguage :English ;
    :printedText """Exile all creatures you control. At the beginning of the next end step, reveal cards from the top of your library until you reveal that many creature cards, put all creature cards revealed this way onto the battlefield, then shuffle the rest of the revealed cards into your library."""@en ;
    :oracleText """Exile all creatures you control. At the beginning of the next end step, reveal cards from the top of your library until you reveal that many creature cards, put all creature cards revealed this way onto the battlefield, then shuffle the rest of the revealed cards into your library."""@en ;
    :flavorText """To Jin-Gitaxias, perfection is not a goal, but a process."""@en ;
    :scryfallUrl "https://scryfall.com/card/frc/45/synthetic-destiny"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """The cards you exile will stay in exile. They're not part of the group you shuffle into your library."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """If you don't reveal any noncreature cards this way (perhaps because all the creature cards you needed were on top of your library), you still shuffle your library."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """The creature cards will enter the battlefield simultaneously."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """Creature tokens you exile this way will count toward the number of creature cards you put onto the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """If you exile your commander as Synthetic Destiny resolves, you may not put it into the command zone until after Synthetic Destiny is finished resolving. It will still count toward the number of creature cards you put onto the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """If the number of creatures you exile is greater than the number of creature cards remaining in your library, you'll wind up revealing your entire library, putting all creature cards revealed that way onto the battlefield, then shuffling your library."""@en ] .

