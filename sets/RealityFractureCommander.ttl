      [ rdf:type :Ruling ;
        :rulingDate "2021-06-18"^^xsd:date ;
        :rulingText """You and the opponent you target take all the actions in the order listed. Notably, the creature or planeswalker they sacrifice won't be on the battlefield as they discard a card or lose life. If any abilities trigger, they will wait to be put on the stack until after the spell resolves. If any abilities controlled by that opponent trigger but losing 3 life causes them to lose the game, none of those abilities will be put on the stack."""@en ] .

:DreadhordeInvasion rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Dreadhorde Invasion" ;
    :manaCost "{1}{B}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :Rare ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :RealityFractureCommander ;
    :cardNumber "48"^^xsd:integer ;
    :artist "Stanton Feng" ;
    :hasLanguage :English ;
    :hasKeywordAction :Amass ;
    :printedText """At the beginning of your upkeep, you lose 1 life and amass Zombies 1. (Put a +1/+1 counter on an Army you control. It's also a Zombie. If you don't control an Army, create a 0/0 black Zombie Army creature token first.)
Whenever a Zombie token you control with power 6 or greater attacks, it gains lifelink until end of turn."""@en ;
    :oracleText """At the beginning of your upkeep, you lose 1 life and amass Zombies 1. (Put a +1/+1 counter on an Army you control. It's also a Zombie. If you don't control an Army, create a 0/0 black Zombie Army creature token first.)
Whenever a Zombie token you control with power 6 or greater attacks, it gains lifelink until end of turn."""@en ;
    :scryfallUrl "https://scryfall.com/card/frc/48/dreadhorde-invasion"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """The power of the Zombie token is checked only immediately after it attacks. Any other abilities that trigger when creatures you control attack won't have resolved yet."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """If the token's power changes later in the turn after it has attacked, including while Dreadhorde Invasion's second ability is on the stack, it won't cause the token to gain or lose lifelink."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Amass Orcs works the same way, except you create a 0/0 black Orc Army creature token if you don't control an Army. If the Army creature you chose isn't already an Orc, it becomes an Orc in addition to its other types. By combining cards with amass Orcs and amass Zombies, you can end up with an Orc Zombie Army."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Some cards that cause you to amass Zombies also provide bonuses to "Zombie tokens." These affect any token that happens to be a Zombie, not just a Zombie Army you've amassed."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """To amass Zombies N, if you don't control an Army creature, create a 0/0 black Zombie Army creature token. Then you choose an Army creature you control and put N +1/+1 counters on it. If that Army isn't already a Zombie, it becomes a Zombie in addition to its other types."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """If you don't control an Army, the Zombie Army token you create enters the battlefield as a 0/0 creature before receiving counters. Any abilities that trigger when a creature with a certain power enters the battlefield, such as that of Mentor of the Meek, will see the token enter as a 0/0 creature before it gets +1/+1 counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Amass abilities are now written as "amass [subtype] N." Previous cards with amass have received errata to say "amass Zombies N.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """Some cards refer to the "amassed Army." That means the Army creature you chose to receive counters, even if no counters were placed on it for some reason."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-06-16"^^xsd:date ;
        :rulingText """In the rare case that you control multiple Army creatures (perhaps because you played a creature with changeling) while you amass Zombies, you choose which of your Army creatures to put the +1/+1 counters on. If that creature isn't a Zombie, it becomes a Zombie in addition to its other types."""@en ] .

:CursedMirror rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Cursed Mirror" ;
    :manaCost "{2}{R}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasRarity :Rare ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :RealityFractureCommander ;
    :cardNumber "49"^^xsd:integer ;
    :artist "David Gaillet" ;
    :hasLanguage :English ;
    :producesMana :Red ;
    :printedText """{T}: Add {R}.
As this artifact enters, you may have it become a copy of any creature on the battlefield until end of turn, except it has haste."""@en ;
    :oracleText """{T}: Add {R}.
As this artifact enters, you may have it become a copy of any creature on the battlefield until end of turn, except it has haste."""@en ;
    :scryfallUrl "https://scryfall.com/card/frc/49/cursed-mirror"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-04-16"^^xsd:date ;
        :rulingText """Any enters-the-battlefield abilities of the copied creature will trigger when Cursed Mirror enters the battlefield. Any "As [this creature] enters the battlefield" or "[This creature] enters the battlefield with" abilities of the copied creature will also work."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-04-16"^^xsd:date ;
        :rulingText """If Cursed Mirror somehow enters the battlefield at the same time as a creature, it can't become a copy of that creature. You may choose only a creature that's already on the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-04-16"^^xsd:date ;
        :rulingText """If something else becomes a copy of Cursed Mirror while Cursed Mirror is a copy of a creature, the duration of the effect is not copied. The new copy will still be a creature (with haste) after Cursed Mirror stops being a copy at the end of the turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-04-16"^^xsd:date ;
        :rulingText """While it is copying a creature, Cursed Mirror does not have "{T}: Add {R}" (unless the creature it's copying also has that ability)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-04-16"^^xsd:date ;
        :rulingText """Cursed Mirror copies exactly what was printed on the original creature (unless that creature is copying something else or is a token; see below). It doesn't copy whether that creature is tapped or untapped, whether it has any counters on it or any Auras or Equipment attached to it, or any non-copy effects that have changed its types, color, power and toughness, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-04-16"^^xsd:date ;
        :rulingText """If the copied creature is copying something else, then Cursed Mirror enters the battlefield as a copy of whatever that creature is copying."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-04-16"^^xsd:date ;
        :rulingText """If the copied creature is a token, Cursed Mirror copies the original characteristics of that token as stated by the effect that created the token. Copying a token doesn't make Cursed Mirror a token. Similarly, if Cursed Mirror itself is a token, copying a nontoken permanent doesn't make it stop being a token."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-04-16"^^xsd:date ;
        :rulingText """If the copied creature has {X} in its mana cost, X is considered to be 0."""@en ] .

