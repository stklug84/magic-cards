    :toughness "2" ;
    :toughnessValue "2"^^xsd:integer ;
    # Note: keyword "Prepared" not defined in MagicCardsOntology
    :printedText """At the beginning of your upkeep, if this creature isn't prepared, it becomes prepared. (While it's prepared, you may cast a copy of its spell. Doing so unprepares it.)
//
