    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """If the resolution of a triggered ability involves casting a spell, that spell can't be cast if a spell with split second is on the stack."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Split second doesn't stop triggered abilities from triggering. If one does, its controller puts it on the stack and chooses targets for it, if any. Those abilities will resolve as normal."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """After a spell with split second resolves (or otherwise leaves the stack), players may again cast spells and activate abilities before the next object on the stack resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Players still get priority while a card with split second is on the stack; their options are just limited to mana abilities and certain special actions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Casting a spell with split second won't affect spells and abilities that are already on the stack."""@en ] .

