    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Bird ,
                :Wizard ;
    :hasRarity :Common ;
    :hasColor :White ,
              :Blue ;
    :hasColorIdentity :White ,
                      :Blue ;
    :isInSet :RealityFracture ;
    :cardNumber "133"^^xsd:integer ;
    :artist "Alexander Mokhov" ;
    :hasLanguage :English ;
    :power "1" ;
    :powerValue "1"^^xsd:integer ;
    :toughness "2" ;
    :toughnessValue "2"^^xsd:integer ;
    :hasKeywordAbility :Flying ;
    :hasKeywordAction :Surveil ;
    # Note: keyword "Prepared" not defined in MagicCardsOntology
    :printedText """Flying
This creature enters prepared. (While it's prepared, you may cast a copy of its spell. Doing so unprepares it.)
//
Create a 2/2 colorless Wizard Soldier creature token named Cadet. Surveil 1."""@en ;
    :oracleText """Flying
This creature enters prepared. (While it's prepared, you may cast a copy of its spell. Doing so unprepares it.)
