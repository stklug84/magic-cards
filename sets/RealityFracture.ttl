    :printedText """This spell costs {X} less to cast, where X is the greatest toughness among creatures you control.
Creatures you control can attack as though they didn't have defender.
Each creature you control with toughness greater than its power assigns combat damage equal to its toughness rather than its power."""@en ;
    :oracleText """This spell costs {X} less to cast, where X is the greatest toughness among creatures you control.
Creatures you control can attack as though they didn't have defender.
Each creature you control with toughness greater than its power assigns combat damage equal to its toughness rather than its power."""@en ;
    :scryfallUrl "https://scryfall.com/card/fra/197/ghalta-the-immovable"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaName "Ghalta the Immovable" ;
    :arenaSetCode "FRA" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Once you announce you're casting a spell, no player may take actions until the spell has been paid for. Notably, opponents can't try to reduce the toughness of creatures you control."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Once you determine the cost to cast Ghalta the Immovable, you may activate mana abilities to pay that cost. If the greatest toughness of creatures you control changes while activating mana abilities, the cost to cast Ghalta remains what you previously determined."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Ghalta the Immovable's last ability doesn't actually change any creature's power. It changes only the amount of combat damage the creature assigns. All other rules and effects that check power or toughness use the real values, even if they cause damage "equal to a creature's power" to be dealt."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """The first step of casting a spell is to move it to the stack. If this causes the greatest toughness of creatures you control to change (perhaps because you control a creature whose toughness is determined by the number of cards in your hand), that new toughness will be used to determine the cost reduction."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Ghalta the Immovable's cost reduction ability can't reduce the total cost to cast the spell below {W}."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Ghalta the Immovable's mana value doesn't change no matter what the greatest toughness of creatures you control is."""@en ] .

