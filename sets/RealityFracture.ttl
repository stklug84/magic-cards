:ChandraTorchOfDefiance rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Chandra, Torch of Defiance" ;
    :manaCost "{2}{R}{R}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Planeswalker ;
    :hasSubType :Chandra ;
    :hasRarity :MythicRare ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :RealityFracture ;
    :cardNumber "244"^^xsd:integer ;
    :artist "Kieran Yanner" ;
    :hasLanguage :English ;
    :producesMana :Red ;
    :loyalty "4"^^xsd:integer ;
    :printedText """+1: Exile the top card of your library. You may cast that card. If you don't, Chandra deals 2 damage to each opponent.
+1: Add {R}{R}.
−3: Chandra deals 4 damage to target creature.
−7: You get an emblem with "Whenever you cast a spell, this emblem deals 5 damage to any target.\""""@en ;
    :oracleText """+1: Exile the top card of your library. You may cast that card. If you don't, Chandra deals 2 damage to each opponent.
+1: Add {R}{R}.
−3: Chandra deals 4 damage to target creature.
−7: You get an emblem with "Whenever you cast a spell, this emblem deals 5 damage to any target.\""""@en ;
    :scryfallUrl "https://scryfall.com/card/fra/244/chandra-torch-of-defiance"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "106489"^^xsd:positiveInteger ;
    :arenaName "Chandra, Torch of Defiance" ;
    :arenaSetCode "FRA" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """If you cast the exiled card, you do so as part of the resolution of Chandra's ability. You can't wait to cast it later in the turn. Timing permissions based on the card's type are ignored, but other restrictions (such as "Cast [this card] only during combat") are not."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """An effect that instructs you to "cast" a card doesn't allow you to play lands. If the card exiled with Chandra's first ability is a land card, you can't play it and Chandra deals 2 damage to each opponent."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """You pay the costs for the exiled card if you cast it. You may pay alternative costs such as emerge rather than the card's mana cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Loyalty abilities can't be mana abilities. Chandra's second ability uses the stack and can be countered or otherwise responded to. Like all loyalty abilities, it can be activated only once per turn, during your main phase, when the stack is empty, and only if no other loyalty abilities of the planeswalker have been activated this turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Chandra's emblem's ability resolves before the spell that caused it to trigger. It resolves even if that spell is countered or otherwise leaves the stack."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """In a Two-Headed Giant game, Chandra's first ability causes 4 damage total to be dealt to the opposing team."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """The emblem created by Chandra's last ability is colorless. The damage it deals is from a colorless source."""@en ] .

