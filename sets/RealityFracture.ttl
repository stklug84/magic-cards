:RoilingCanopy rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Roiling Canopy" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Land ;
    :hasRarity :Rare ;
    :hasColorIdentity :Green ;
    :isInSet :RealityFracture ;
    :cardNumber "187"^^xsd:integer ;
    :artist "Titus Lunter" ;
    :hasLanguage :English ;
    :producesMana :Green ;
    :entersTapped "true"^^xsd:boolean ;
    :printedText """This land enters tapped.
Whenever a Forest you control enters, if you control at least five other Forests, target creature you control gets +3/+3 until end of turn.
{T}: Add {G}."""@en ;
    :oracleText """This land enters tapped.
Whenever a Forest you control enters, if you control at least five other Forests, target creature you control gets +3/+3 until end of turn.
{T}: Add {G}."""@en ;
    :flavorText """Jace left slices of his personality trapped in his strongest memories."""@en ;
    :scryfallUrl "https://scryfall.com/card/fra/187/roiling-canopy"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "106432"^^xsd:positiveInteger ;
    :arenaName "Roiling Canopy" ;
    :arenaSetCode "FRA" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Roiling Canopy's triggered ability has an "intervening 'if' clause." That means (1) the ability won't trigger at all unless, at the time a Forest enters under your control, you control five or more Forests other than that new one, and (2) the ability will do nothing if you control fewer than five Forests other than that new one by the time it resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """If multiple Forests enter under your control at the same time, Roiling Canopy's second ability could trigger that many times. Each ability takes into consideration the other Forests that entered at the same time as the one that caused it to trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """If a Forest you control leaves the battlefield between the time Roiling Canopy's second ability triggers and the time it resolves, be aware of whether that was the Forest that caused Roiling Canopy's ability to trigger or not. If it was, Roiling Canopy's count isn't affected; if it wasn't, Roiling Canopy's count goes down by one."""@en ] .

