    :oracleText """This creature enters with a +1/+1 counter on it.
When this creature dies, put its counters on up to one target creature you control."""@en ;
    :flavorText """When medical supplies are limited, her own cuttings will suffice."""@en ;
    :scryfallUrl "https://scryfall.com/card/fra/10/graft-surgeon"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaName "Graft Surgeon" ;
    :arenaSetCode "FRA" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """If enough -1/-1 counters are put on Graft Surgeon at the same time to make its toughness 0 or less, its second ability will see all of the +1/+1 counters it had when it died as well as the -1/-1 counters it had, and an equal number of each of those types of counters (plus any other applicable counters) will be put onto the target creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Graft Surgeon's second ability puts all counters that were on Graft Surgeon onto the target creature, not just its +1/+1 counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """If Graft Surgeon has -1/-1 counters on it when it dies, that ability will include those as well. This may result in the recipient of the counters dying."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Graft Surgeon's second ability doesn't cause you to move counters from Graft Surgeon onto the target creature. Rather, you put the same number of each kind of counter Graft Surgeon had when it died onto the target creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """In some unusual cases, you may end up putting the appropriate counters on more than one permanent. For example, if you control The Ozolith (a card from the Ikoria: Lair of Behemoths set) when Graft Surgeon dies, you'll put the appropriate number of each kind of counter onto both The Ozolith and the target creature."""@en ] .

