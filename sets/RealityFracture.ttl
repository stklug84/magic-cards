:CarnivorousCultivator rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Carnivorous Cultivator // Enroot" ;
    :manaCost "{1}{G}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Elf ,
                :Warlock ;
    :hasRarity :Rare ;
    :hasColor :Green ;
    :hasColorIdentity :Green ;
    :isInSet :RealityFracture ;
    :cardNumber "437"^^xsd:integer ;
    :artist "Filip Burburan" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    :hasKeywordAbility :Deathtouch ;
    # Note: keyword "Prepared" not defined in MagicCardsOntology
    :printedText """Deathtouch
This creature enters prepared.
Whenever this creature deals combat damage to a player, return target land card from your graveyard to your hand.
//
Search your library for a land card, put it into your graveyard, then shuffle."""@en ;
    :oracleText """Deathtouch
This creature enters prepared.
Whenever this creature deals combat damage to a player, return target land card from your graveyard to your hand.
//
Search your library for a land card, put it into your graveyard, then shuffle."""@en ;
    :scryfallUrl "https://scryfall.com/card/fra/437/carnivorous-cultivator-enroot"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """If a prepare spell with one or more targets has no legal targets when it tries to resolve, it won't resolve and none of its effects will happen. Since the spell was cast, the associated permanent will still not be prepared."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """If a prepared creature loses all abilities, it won't stop being prepared, and nothing will happen to its alternative characteristics or to the copy of its prepare spell in exile."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Creating a copy of a creature's prepare spell in exile ignores copy exceptions applied to that creature that would affect the copiable values of that spell. For example, say a player casts Croaking Counterpart (a sorcery that says "Create a token that's a copy of target non-Frog creature, except it's a 1/1 green Frog") targeting Diviner of Victory. The token copy of Diviner of Victory will enter prepared as a 1/1 green Frog creature, but the copy of Unwind History in exile will still be a blue sorcery. The copy of Unwind History won't be green, a creature, or a Frog, and it won't have power or toughness."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """If an effect causes a creature to become unprepared, a prepared creature stops being prepared and the associated copy of its prepare spell in exile ceases to exist. If it wasn't prepared at that time, nothing happens."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """As an effect causes a creature with a prepare spell to become prepared (including effects that state that a creature "enters prepared"), that creature's controller creates a copy of that creature's prepare spell in exile. That copy remains in exile for as long as that permanent is on the battlefield and is prepared. That creature's controller may cast that copy as long as it remains in exile. As they cast it, that creature stops being prepared."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """A creature without a prepare spell can't become prepared."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """If an effect instructs you to choose a card name, you may choose the alternative prepare spell's name. Consider only the alternative characteristics to determine whether that is an appropriate name to choose."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """A preparation card is a creature card in every zone. For example, while it's in your graveyard, Diviner of Victory is a blue creature card whose mana value is 1. It can't be the target of Stingcaster Mage's triggered ability ("When this creature enters, target instant or sorcery card in your graveyard gains flashback until end of turn. The flashback cost is equal to its mana cost.")."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """A creature with a prepare spell can't become prepared more than once at the same time. For example, say Bloodline Recollector is on the battlefield and is prepared. During the current turn, three creatures die. At the beginning of the end step, Bloodline Recollector's last ability triggers. When that ability resolves, since Bloodline Recollector is already prepared, the ability won't cause it to become prepared a second time or create a second copy of Ancestral Craving in exile."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """If a prepared creature stops being a creature, it will still be prepared, and the copy of its prepare spell will remain in exile. That permanent's controller will still be able to cast it. The same is true if a prepared creature becomes a copy of something else, even if it's then a permanent without a prepare spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Being prepared isn't a copiable value. If a permanent becomes a copy of a prepared creature, it won't be prepared. That permanent will have the alternative characteristics, though, and some other effect could cause it to become prepared later."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Preparation cards can be cast only with their base characteristics."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Only the current controller of a prepared creature can cast the copy of its prepare spell in exile. It doesn't matter who owns that creature or who controlled it when it became prepared."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """Casting a copy of a prepare spell from exile isn't casting it for an alternative cost. Effects that allow you to cast a spell for an alternative cost or without paying its mana cost may allow you to apply those to a copy of a prepare spell cast from exile."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """While copies of spells in zones other than the stack cease to exist when state-based actions are checked, this does not apply to copies of prepare spells in exile that were created as a creature became prepared."""@en ] .
