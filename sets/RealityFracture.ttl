    :hasLanguage :English ;
    :power "1" ;
    :powerValue "1"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :hasKeywordAction :Surveil ;
    # Note: keyword "Prepared" not defined in MagicCardsOntology
    :printedText """This creature enters prepared.
Whenever you scry or surveil, creatures you control get +1/+0 until end of turn. This ability triggers only once each turn.
//
