        :rulingText """You can cast a spell using flashback even if it was somehow put into your graveyard without having been cast."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2026-08-21"^^xsd:date ;
        :rulingText """If a card with flashback is put into your graveyard during your turn, you can cast it if it's legal to do so before any other player can take any actions."""@en ] ,
