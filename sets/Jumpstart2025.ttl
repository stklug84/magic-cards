:IslandJumpstart202584 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Island" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasSuperType :Basic ;
    :hasCardType :Land ;
    :hasSubType :Island ;
    :hasRarity :Common ;
    :hasColorIdentity :Blue ;
    :isInSet :Jumpstart2025 ;
    :cardNumber "84"^^xsd:integer ;
    :artist "Jonas De Ro" ;
    :hasLanguage :English ;
    :producesMana :Blue ;
    :printedText """({T}: Add {U}.)"""@en ;
    :oracleText """({T}: Add {U}.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=681239"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/j25/84/island"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
