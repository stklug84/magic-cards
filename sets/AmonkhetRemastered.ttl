:AnointedProcession rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Anointed Procession" ;
    :manaCost "{3}{W}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :Rare ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :AmonkhetRemastered ;
    :cardNumber "2"^^xsd:integer ;
    :artist "Victor Adame Minguez" ;
    :hasLanguage :English ;
    :printedText """If an effect would create one or more tokens under your control, it creates twice that many of those tokens instead."""@en ;
    :oracleText """If an effect would create one or more tokens under your control, it creates twice that many of those tokens instead."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=547469"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/akr/2/anointed-procession"^^xsd:anyURI ;
    :isAvailableOn :MTGArena ;
    :arenaId "73774"^^xsd:positiveInteger ;
    :arenaName "Anointed Procession" ;
    :arenaSetCode "AKR" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """If the token you create has any “as [this permanent] enters the battlefield” or “[this permanent] enters the battlefield with” abilities, first determine how many tokens are being created, then apply those abilities individually for each one. For example, if a token with “You may have [this permanent] enter the battlefield as a copy of any creature on the battlefield” would be created (such as an embalmed Vizier of Many Faces), the resulting two tokens can each copy a different creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """All of the tokens enter the battlefield simultaneously. They’ll be created with the same name, color, type and subtype, abilities, power, toughness, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """If you control two Anointed Processions, then the number of tokens created is four times the original number. If you control three, then the number of tokens created is eight times the original number, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """If an effect creates more than one kind of token, it’ll create twice as many of each kind. For example, if you cast Bestial Menace while controlling Anointed Procession, you’ll create two Snake tokens, two Wolf tokens, and two Elephant tokens."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """If the effect creating the tokens instructs you to do something with those tokens at a later time, like exiling them at the end of combat, you’ll do that for all the tokens."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-01-19"^^xsd:date ;
        :rulingText """There are many important moments in the story, but the most crucial—called “story spotlights”—are shown on cards. These cards have the Planeswalker symbol in their text box; this symbol has no effect on gameplay. You can read more about these events in the official Magic fiction at http://www.mtgstory.com."""@en ] .

:CollectedCompanyAmonkhetRemastered186 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Collected Company" ;
    :manaCost "{3}{G}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Rare ;
    :hasColor :Green ;
    :hasColorIdentity :Green ;
    :isInSet :AmonkhetRemastered ;
    :cardNumber "186"^^xsd:integer ;
    :artist "Lake Hurwitz" ;
    :hasLanguage :English ;
    :printedText """Look at the top six cards of your library. Put up to two creature cards with mana value 3 or less from among them onto the battlefield. Put the rest on the bottom of your library in any order."""@en ;
    :oracleText """Look at the top six cards of your library. Put up to two creature cards with mana value 3 or less from among them onto the battlefield. Put the rest on the bottom of your library in any order."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=547653"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/akr/186/collected-company"^^xsd:anyURI ;
    :isAvailableOn :MTGArena ;
    :arenaId "73966"^^xsd:positiveInteger ;
    :arenaName "Collected Company" ;
    :arenaSetCode "AKR" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2015-02-25"^^xsd:date ;
        :rulingText """Each of the creature cards can have mana value 3 or less. It's not the total mana value of the two cards."""@en ] .
