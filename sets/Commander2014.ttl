@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@prefix :     <urn:stklug84:MagicCardsOntology:2026-02-27#> .
@base         <urn:stklug84:MagicCardIndividuals:C14:2026-07-19#> .

################################################################################
#
# Ontology Definition
#
################################################################################

<urn:stklug84:MagicCardIndividuals:C14:2026-07-19#>
    rdf:type owl:Ontology ;
    owl:imports <urn:stklug84:MagicCardsOntology:2026-02-27#> ;
    rdfs:label "Magic Card Collection Individuals – Commander 2014"@en ;
    rdfs:comment """An instance graph describing the card individuals of a
personal Magic: The Gathering card collection that were printed in the set
Commander 2014 (C14). One Card individual is defined per collected
printing, carrying its characteristics, the platforms it is available on
(paper, MTG Arena, Magic Online) with its MTG Arena identity, its legality
in the paper and MTG Arena formats, and official rulings. Card data was
sourced from Gatherer and Scryfall. This file imports MagicCardsOntology to
reuse all existing class, property, set, keyword, subtype, format and
legality definitions."""@en .


################################################################################
#
# Card Individuals
#
################################################################################

:LiquimetalCoating rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Liquimetal Coating" ;
    :manaCost "{2}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasRarity :Uncommon ;
    :isInSet :Commander2014 ;
    :cardNumber "246"^^xsd:integer ;
    :artist "Johann Bodin" ;
    :hasLanguage :English ;
    :printedText """{T}: Target permanent becomes an artifact in addition to its other types until end of turn."""@en ;
    :oracleText """{T}: Target permanent becomes an artifact in addition to its other types until end of turn."""@en ;
    :flavorText """"They'll soon become accustomed to wearing skin that is not their own."
—Elesh Norn, Grand Cenobite"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=389578"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/c14/246/liquimetal-coating"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2011-01-01"^^xsd:date ;
        :rulingText """Becoming an artifact doesn't change what color(s) a permanent is."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2011-01-01"^^xsd:date ;
        :rulingText """You may target any permanent with the ability, including an artifact."""@en ] .
