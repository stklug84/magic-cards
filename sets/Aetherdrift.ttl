      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """If a permanent becomes a copy of a saddled Mount, the copy won’t be saddled."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """Creatures with saddle can attack or block as normal even if they aren’t saddled."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """You may activate a permanent’s saddle ability even if that permanent is already saddled."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """An ability that triggers when a creature “attacks while saddled” will trigger only if that creature was saddled when it was declared as an attacker."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """“Saddled” isn’t an ability that a creature has. It’s just something true about that creature. It won’t stop being saddled until the turn ends or it leaves the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """“Saddle N” means “Tap any number of other untapped creatures you control with total power N or greater: This permanent becomes saddled until end of turn. Activate only as a sorcery.”"""@en ] .

