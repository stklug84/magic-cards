      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """If an effect needs to know what a player’s speed is and that player doesn’t have a speed, their speed is considered 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """Your speed doesn’t change until a spell or ability says so, such as the inherent triggered ability that cares about opponents losing life during your turn. Notably, losing control of permanents with start your engines! doesn’t affect your speed."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """Start your engines! isn’t a triggered ability. Increasing your speed to 1 is something that happens as a state-based action as soon as you control a permanent with the ability. Notably, this includes gaining control of a permanent with the ability that another player controls."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """Each player tracks their speed (or lack thereof) separately. Increasing your speed has no effect on whether another player has speed."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """A player “has max speed” if their speed is 4."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
