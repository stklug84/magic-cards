    :artist "Julia Metzger" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "1" ;
    :toughnessValue "1"^^xsd:integer ;
    :hasKeywordAbility :MaxSpeed ,
                       :StartYourEngines ;
    :printedText """Start your engines! (If you have no speed, it starts at 1. It increases once on each of your turns when an opponent loses life. Max speed is 4.)
Max speed — This creature gets +1/+2."""@en ;
    :oracleText """Start your engines! (If you have no speed, it starts at 1. It increases once on each of your turns when an opponent loses life. Max speed is 4.)
Max speed — This creature gets +1/+2."""@en ;
    :flavorText """The warrior rose in a very different world from the one he'd left behind."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=690683"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/dft/246/walking-sarcophagus"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "95048"^^xsd:positiveInteger ;
    :arenaName "Walking Sarcophagus" ;
    :arenaSetCode "DFT" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """Start your engines! isn’t a triggered ability. Increasing your speed to 1 is something that happens as a state-based action as soon as you control a permanent with the ability. Notably, this includes gaining control of a permanent with the ability that another player controls."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """A player “has max speed” if their speed is 4."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """If an effect needs to know what a player’s speed is and that player doesn’t have a speed, their speed is considered 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """Each player tracks their speed (or lack thereof) separately. Increasing your speed has no effect on whether another player has speed."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """Your speed doesn’t change until a spell or ability says so, such as the inherent triggered ability that cares about opponents losing life during your turn. Notably, losing control of permanents with start your engines! doesn’t affect your speed."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """“Max speed — [ability]” means “As long as you have max speed, this object has [ability].” If the granted ability functions in a zone other than the battlefield, the max speed ability does too."""@en ] .

