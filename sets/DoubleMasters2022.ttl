:EzuriClawOfProgress rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Ezuri, Claw of Progress" ;
    :manaCost "{2}{G}{U}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Phyrexian ;
    :hasSubType :Elf ;
    :hasSubType :Warrior ;
    :hasRarity :MythicRare ;
    :hasColor :Blue ;
    :hasColor :Green ;
    :hasColorIdentity :Blue ;
    :hasColorIdentity :Green ;
    :isInSet :DoubleMasters2022 ;
    :cardNumber "494"^^xsd:integer ;
    :artist "James Ryman" ;
    :hasLanguage :English ;
    :power "3" ;
    :powerValue "3"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    :printedText """Whenever a creature you control with power 2 or less enters, you get an experience counter.
At the beginning of combat on your turn, put X +1/+1 counters on another target creature you control, where X is the number of experience counters you have."""@en ;
    :oracleText """Whenever a creature you control with power 2 or less enters, you get an experience counter.
At the beginning of combat on your turn, put X +1/+1 counters on another target creature you control, where X is the number of experience counters you have."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=573462"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/2x2/494/ezuri-claw-of-progress"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """All experience counters are identical, no matter how you got them. For example, the last ability will count experience counters that you got from the first ability, from another ability, from proliferating, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """Each game pack includes a card labeled "Experience" with the suggestion "Place your experience counters here." This card isn't required for play. It's simply a convenient spot to put your experience counters, which can be represented with dice, glass beads, or other small items."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-11-04"^^xsd:date ;
        :rulingText """Experience counters are the second kind of counters a player can have, joining poison."""@en ] .
