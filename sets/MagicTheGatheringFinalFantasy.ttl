      [ rdf:type :Ruling ;
        :rulingDate "2025-06-06"^^xsd:date ;
        :rulingText """If a mode requires a target, you can select that mode only if there's a legal target available. Ignore the targeting requirements for modes you don't choose."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-06-06"^^xsd:date ;
        :rulingText """If a spell with tiered is copied, the effect that creates the copy may allow you to choose new targets. You cannot choose a new mode."""@en ] ,
