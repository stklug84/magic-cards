        :rulingText """If an effect allows you to cast a spell with tiered "without paying its mana cost," you must still choose exactly one mode and pay the associated additional cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-06-06"^^xsd:date ;
        :rulingText """The mana value of a spell with tiered is determined only by its mana cost (in the upper right corner of the card). It doesn't matter which mode you choose or which additional costs you pay, including any additional costs imposed by other effects."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-06-06"^^xsd:date ;
        :rulingText """You must choose exactly one of the listed modes and pay its associated additional cost in order to cast a spell with tiered."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-06-06"^^xsd:date ;
        :rulingText """You choose the mode as you cast the spell with tiered. Once the mode is chosen, it can't be changed."""@en ] .

