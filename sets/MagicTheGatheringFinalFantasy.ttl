      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-06-06"^^xsd:date ;
        :rulingText """If Tellah is no longer on the battlefield when its ability resolves and eight or more mana was spent to cast the spell that caused its ability to trigger, the ability will still deal damage to each opponent."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-06-06"^^xsd:date ;
        :rulingText """Tellah's ability resolves before the spell that caused it to trigger. It resolves even if that spell is countered or otherwise leaves the stack."""@en ] .

