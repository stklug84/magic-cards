        :rulingText """If you and an opponent both lose life simultaneously, and this causes your life total to become 0 or less, you'll lose the game before Exquisite Blood's triggered ability can resolve."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2012-05-01"^^xsd:date ;
        :rulingText """Damage dealt to an opponent usually causes that opponent to lose life. An opponent paying life also causes loss of life."""@en ] .

