:MidnightClockAetherdriftCommander79 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Midnight Clock" ;
    :manaCost "{2}{U}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :AetherdriftCommander ;
    :cardNumber "79"^^xsd:integer ;
    :artist "Alexander Forssberg" ;
    :hasLanguage :English ;
    :printedText """{T}: Add {U}.
{2}{U}: Put an hour counter on this artifact.
At the beginning of each upkeep, put an hour counter on this artifact.
When the twelfth hour counter is put on this artifact, shuffle your hand and graveyard into your library, then draw seven cards. Exile this artifact."""@en ;
    :oracleText """{T}: Add {U}.
{2}{U}: Put an hour counter on this artifact.
At the beginning of each upkeep, put an hour counter on this artifact.
When the twelfth hour counter is put on this artifact, shuffle your hand and graveyard into your library, then draw seven cards. Exile this artifact."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=692429"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/drc/79/midnight-clock"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2019-10-04"^^xsd:date ;
        :rulingText """Midnight Clock's first triggered ability triggers at the beginning of each upkeep, not just your upkeep. In a Two-Headed Giant game, an ability that triggers at the beginning of each upkeep rather than each player's upkeep triggers only once during each team's upkeep."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-10-04"^^xsd:date ;
        :rulingText """You can activate Midnight Clock's mana ability to pay the cost of its second ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-10-04"^^xsd:date ;
        :rulingText """Midnight Clock's last ability triggers after one or more counters are put onto it if it had fewer than twelve counters on it before those counters were put on it and it has twelve or more counters on it after."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-10-04"^^xsd:date ;
        :rulingText """If Midnight Clock leaves the battlefield while its last ability is on the stack, it won't be exiled."""@en ] .

