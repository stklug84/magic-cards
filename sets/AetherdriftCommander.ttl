      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some triggered abilities state that you "may pay" a certain amount of {E}. You can't pay that amount multiple times to multiply the effect. You simply choose whether or not to pay that amount of {E} as the ability resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some triggered abilities that state that you "may pay" a certain amount of {E} describe an effect that happens "If you do." In that case, no player may take actions to try to stop the ability's effect after you make your choice. If the payment is followed by the phrase "When you do," then you'll choose any targets for that reflexive triggered ability and put it on the stack before players can take actions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """If a spell or ability with one or more targets states that you "may pay" some amount of {E}, and each permanent that it targets has become an illegal target, the spell or ability won't resolve. You can't pay any {E} even if you want to."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """{E} is the energy symbol. It represents one energy counter."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Energy counters are a kind of counter that a player may have. They're not associated with any specific permanents."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2018-01-19"^^xsd:date ;
        :rulingText """There are many important moments in the story, but the most crucial—called "story spotlights"—are shown on cards. These cards have the Planeswalker symbol in their text box; this symbol has no effect on gameplay. You can read more about these events in the official Magic fiction at http://www.mtgstory.com."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """If the target artifact or creature has a mana value of 0, you may choose to pay zero energy and gain control of it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """If a permanent has {X} in its mana cost, X is considered to be 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """The mana value of a token that isn't a copy of another object is 0. A token that is a copy of another object has the same mana cost as that object."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """In a multiplayer game, if a permanent's owner leaves the game after you've gained control of it, the permanent leaves with that player. If you leave the game before that player, the control-change effect ends."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """You choose the target artifact or creature as you cast Confiscation Coup. You don't choose whether or not to pay an amount of {E} until Confiscation Coup resolves. If the target becomes an illegal target, Confiscation Coup won't resolve and you won't get {E}{E}{E}{E}."""@en ] .

:Disallow rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Disallow" ;
    :manaCost "{1}{U}{U}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :AetherdriftCommander ;
    :cardNumber "74"^^xsd:integer ;
    :artist "Min Yum" ;
    :hasLanguage :English ;
    :printedText """Counter target spell, activated ability, or triggered ability. (Mana abilities can't be targeted.)"""@en ;
    :oracleText """Counter target spell, activated ability, or triggered ability. (Mana abilities can't be targeted.)"""@en ;
    :flavorText """"How easily your flames are quenched."
—Baral, Chief of Compliance"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=692424"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/drc/74/disallow"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2018-01-19"^^xsd:date ;
        :rulingText """There are many important moments in the story, but the most crucial—called "story spotlights"—are shown on cards. These cards have the Planeswalker symbol in their text box; this symbol has no effect on gameplay. You can read more about these events in the official Magic fiction at http://www.mtgstory.com."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """Activated abilities are written in the form "Cost: Effect." Some keyword abilities, such as equip and crew, are activated abilities and will have colons in their reminder texts."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """Triggered abilities use the word "when," "whenever," or "at." They're often written as "[Trigger condition], [effect]." Some keyword abilities, such as prowess and fabricate, are triggered abilities and will have "when," "whenever," or "at" in their reminder text."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """If you counter a delayed triggered ability that triggers at the beginning of the "next" occurrence of a specified step or phase, that ability won't trigger again the following time that phase or step occurs."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """An activated mana ability is one that could add mana as it resolves, doesn't have a target, and isn't a loyalty ability. A triggered mana ability is one that could add mana and triggers on an activated mana ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-02-09"^^xsd:date ;
        :rulingText """Abilities that create replacement effects, such as a permanent entering the battlefield tapped or with counters on it, can't be targeted. Abilities that apply "as [this creature] enters the battlefield" are also replacement effects and can't be targeted."""@en ] .

:EraOfInnovation rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Era of Innovation" ;
    :manaCost "{1}{U}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :Uncommon ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :AetherdriftCommander ;
    :cardNumber "75"^^xsd:integer ;
    :artist "Jason Rainville" ;
    :hasLanguage :English ;
    :printedText """Whenever an artifact or Artificer you control enters, you may pay {1}. If you do, you get {E}{E} (two energy counters).
Pay six {E}, Sacrifice this enchantment: Draw three cards."""@en ;
    :oracleText """Whenever an artifact or Artificer you control enters, you may pay {1}. If you do, you get {E}{E} (two energy counters).
Pay six {E}, Sacrifice this enchantment: Draw three cards."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=692425"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/drc/75/era-of-innovation"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some spells and abilities that give you {E} may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. You won't get any {E}."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some triggered abilities that state that you "may pay" a certain amount of {E} describe an effect that happens "If you do." In that case, no player may take actions to try to stop the ability's effect after you make your choice. If the payment is followed by the phrase "When you do," then you'll choose any targets for that reflexive triggered ability and put it on the stack before players can take actions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """If a spell or ability with one or more targets states that you "may pay" some amount of {E}, and each permanent that it targets has become an illegal target, the spell or ability won't resolve. You can't pay any {E} even if you want to."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """{E} is the energy symbol. It represents one energy counter."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Energy counters are a kind of counter that a player may have. They're not associated with any specific permanents."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Keep track of how many energy counters each player has. Potential ways to track this include writing theme down on paper or using dice, but any method that is clear and mutually agreeable is fine. (At higher levels of tournament play, dice may not be allowed for tracking counters that players have.)"""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """If an effect says you get one or more {E}, you get that many energy counters. To pay one or more {E}, you lose that many energy counters. You can't pay more energy counters than you have. Any effects that interact with counters a player gets, has, or loses can interact with energy counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Energy counters aren't mana. They don't go away as steps, phases, and turns end, and effects that add mana "of any type" can't give you energy counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some triggered abilities state that you "may pay" a certain amount of {E}. You can't pay that amount multiple times to multiply the effect. You simply choose whether or not to pay that amount of {E} as the ability resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """You can pay {1} only once each time Era of Innovation's first ability resolves. You can't pay more to get more than {E}{E}."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """If a creature that is both an artifact and an Artificer enters the battlefield under your control, Era of Innovation's triggered ability triggers only once."""@en ] .

