      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """Once the exiled creature returns, it's considered a new object with no relation to the object that it was. Auras attached to the exiled creature will be put into their owners' graveyards. Equipment attached to the exiled creature will become unattached and remain on the battlefield. Any counters on the exiled creature will cease to exist."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """If a token is exiled this way, it will cease to exist and won't return to the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """If you gain control of a creature “until end of turn,” you control it during that turn's end step."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """When an effect returns the exiled card “under your control,” you control it indefinitely after that. In a multiplayer game, if a player leaves the game, all cards that player owns leave as well. If you leave the game, any creatures you control from Conjurer's Closet effect are exiled."""@en ] .

:CultivatorsCaravan rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Cultivator's Caravan" ;
    :manaCost "{3}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasSubType :Vehicle ;
    :hasRarity :Rare ;
    :isInSet :AetherdriftCommander ;
    :cardNumber "127"^^xsd:integer ;
    :artist "Mark Zug" ;
    :hasLanguage :English ;
    :power "5" ;
    :powerValue "5"^^xsd:integer ;
    :toughness "5" ;
    :toughnessValue "5"^^xsd:integer ;
    :hasKeywordAbility :Crew ;
    :printedText """{T}: Add one mana of any color.
Crew 3 (Tap any number of creatures you control with total power 3 or more: This Vehicle becomes an artifact creature until end of turn.)"""@en ;
    :oracleText """{T}: Add one mana of any color.
Crew 3 (Tap any number of creatures you control with total power 3 or more: This Vehicle becomes an artifact creature until end of turn.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=692477"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/drc/127/cultivators-caravan"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """As long as Cultivator's Caravan isn't an artifact creature, its {T} ability can be activated if it came under your control this turn."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-09-29"^^xsd:date ;
        :rulingText """When a Vehicle becomes a creature, that doesn't count as having a creature enter the battlefield. The permanent was already on the battlefield; it only changed its types. Abilities that trigger whenever a creature enters the battlefield won't trigger."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-09-29"^^xsd:date ;
        :rulingText """If an effect causes a Vehicle to become an artifact creature with a specified power and toughness, that effect overwrites the Vehicle's printed power and toughness."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-09-29"^^xsd:date ;
        :rulingText """Any untapped creature you control can be tapped to pay a crew cost, even one that just came under your control."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-09-29"^^xsd:date ;
        :rulingText """If a permanent becomes a copy of a Vehicle, the copy won't be a creature, even if the Vehicle it's copying has become an artifact creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-09-29"^^xsd:date ;
        :rulingText """Vehicle is an artifact type, not a creature type. A Vehicle that's crewed won't normally have any creature type."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-09-29"^^xsd:date ;
        :rulingText """You may activate a crew ability of a Vehicle even if it's already an artifact creature. Doing so has no effect on the Vehicle. It doesn't change its power and toughness."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-09-29"^^xsd:date ;
        :rulingText """Once a Vehicle becomes a creature, it behaves exactly like any other artifact creature. It can't attack unless you've controlled it continuously since your turn began, it can block if it's untapped, it can be tapped to pay a Vehicle's crew cost, and so on."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-09-29"^^xsd:date ;
        :rulingText """For a Vehicle to be able to attack, it must be a creature as the declare attackers step begins, so the latest you can activate its crew ability to attack with it is during the beginning of combat step. For a Vehicle to be able to block, it must be a creature as the declare blockers step begins, so the latest you can activate its crew ability to block with it is during the declare attackers step. In either case, players may take actions after the crew ability resolves but before the Vehicle has been declared as an attacking or blocking creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-09-29"^^xsd:date ;
        :rulingText """Creatures that crew a Vehicle aren't attached to it or related in any other way. Effects that affect the Vehicle, such as by destroying it or giving it a +1/+1 counter, don't affect the creatures that crewed it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-09-29"^^xsd:date ;
        :rulingText """Once a player announces that they are activating a crew ability, no player may take other actions until the ability has been paid for. Notably, players can't try to stop the ability by changing a creature's power or by removing or tapping a creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-09-29"^^xsd:date ;
        :rulingText """Each Vehicle is printed with a power and toughness, but it's not a creature. If it becomes a creature (most likely through its crew ability), it will have that power and toughness."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-09-29"^^xsd:date ;
        :rulingText """You may tap more creatures than necessary to activate a crew ability."""@en ] .

:DecoctionModule rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Decoction Module" ;
    :manaCost "{2}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasRarity :Uncommon ;
    :isInSet :AetherdriftCommander ;
    :cardNumber "128"^^xsd:integer ;
    :artist "Aaron Miller" ;
    :hasLanguage :English ;
    :printedText """Whenever a creature you control enters, you get {E} (an energy counter).
{4}, {T}: Return target creature you control to its owner's hand."""@en ;
    :oracleText """Whenever a creature you control enters, you get {E} (an energy counter).
{4}, {T}: Return target creature you control to its owner's hand."""@en ;
    :flavorText """Progress leads to inspiration."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=692478"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/drc/128/decoction-module"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """{E} is the energy symbol. It represents one energy counter."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Energy counters are a kind of counter that a player may have. They're not associated with any specific permanents."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Keep track of how many energy counters each player has. Potential ways to track this include writing theme down on paper or using dice, but any method that is clear and mutually agreeable is fine. (At higher levels of tournament play, dice may not be allowed for tracking counters that players have.)"""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """If an effect says you get one or more {E}, you get that many energy counters. To pay one or more {E}, you lose that many energy counters. You can't pay more energy counters than you have. Any effects that interact with counters a player gets, has, or loses can interact with energy counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Energy counters aren't mana. They don't go away as steps, phases, and turns end, and effects that add mana "of any type" can't give you energy counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some triggered abilities state that you "may pay" a certain amount of {E}. You can't pay that amount multiple times to multiply the effect. You simply choose whether or not to pay that amount of {E} as the ability resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some triggered abilities that state that you "may pay" a certain amount of {E} describe an effect that happens "If you do." In that case, no player may take actions to try to stop the ability's effect after you make your choice. If the payment is followed by the phrase "When you do," then you'll choose any targets for that reflexive triggered ability and put it on the stack before players can take actions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """If a spell or ability with one or more targets states that you "may pay" some amount of {E}, and each permanent that it targets has become an illegal target, the spell or ability won't resolve. You can't pay any {E} even if you want to."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some spells and abilities that give you {E} may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. You won't get any {E}."""@en ] .

