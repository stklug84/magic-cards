        :rulingText """{E} is the energy symbol. It represents one energy counter."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Energy counters are a kind of counter that a player may have. They're not associated with any specific permanents."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Keep track of how many energy counters each player has. Potential ways to track this include writing theme down on paper or using dice, but any method that is clear and mutually agreeable is fine. (At higher levels of tournament play, dice may not be allowed for tracking counters that players have.)"""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """If an effect says you get one or more {E}, you get that many energy counters. To pay one or more {E}, you lose that many energy counters. You can't pay more energy counters than you have. Any effects that interact with counters a player gets, has, or loses can interact with energy counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Energy counters aren't mana. They don't go away as steps, phases, and turns end, and effects that add mana "of any type" can't give you energy counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some triggered abilities state that you "may pay" a certain amount of {E}. You can't pay that amount multiple times to multiply the effect. You simply choose whether or not to pay that amount of {E} as the ability resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some triggered abilities that state that you "may pay" a certain amount of {E} describe an effect that happens "If you do." In that case, no player may take actions to try to stop the ability's effect after you make your choice. If the payment is followed by the phrase "When you do," then you'll choose any targets for that reflexive triggered ability and put it on the stack before players can take actions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """If a spell or ability with one or more targets states that you "may pay" some amount of {E}, and each permanent that it targets has become an illegal target, the spell or ability won't resolve. You can't pay any {E} even if you want to."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some spells and abilities that give you {E} may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. You won't get any {E}."""@en ] .

:SaheeliSublimeArtificerAetherdriftCommander119 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Saheeli, Sublime Artificer" ;
    :manaCost "{1}{U/R}{U/R}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Planeswalker ;
    :hasSubType :Saheeli ;
    :hasRarity :Uncommon ;
    :hasColor :Blue ;
    :hasColor :Red ;
    :hasColorIdentity :Blue ;
    :hasColorIdentity :Red ;
    :isInSet :AetherdriftCommander ;
    :cardNumber "119"^^xsd:integer ;
    :artist "Wesley Burt" ;
    :hasLanguage :English ;
    :loyalty "5"^^xsd:integer ;
    :printedText """Whenever you cast a noncreature spell, create a 1/1 colorless Servo artifact creature token.
−2: Target artifact you control becomes a copy of another target artifact or creature you control until end of turn, except it's an artifact in addition to its other types."""@en ;
    :oracleText """Whenever you cast a noncreature spell, create a 1/1 colorless Servo artifact creature token.
−2: Target artifact you control becomes a copy of another target artifact or creature you control until end of turn, except it's an artifact in addition to its other types."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=692469"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/drc/119/saheeli-sublime-artificer"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """If an effect begins to apply to the target artifact before it becomes a copy of another permanent, that effect will continue to apply."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """Saheeli's first ability resolves before the spell that caused it to trigger. It resolves even if that spell is countered."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """If the target artifact is an Equipment attached to a creature and it becomes a copy of a non-Equipment permanent, it becomes unattached. If it becomes a copy of an Equipment, it remains attached."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """The target artifact is an artifact in addition to whatever types the second target has, and this exception is copiable. If something else copies the artifact later in the turn, that copy also will be an artifact."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """Saheeli's loyalty ability causes the target artifact to copy the printed values of the target permanent, plus any copy effects that have been applied to it. It won't copy counters on that permanent or effects that have changed its power, toughness, types, color, or so on. Notably, it won't copy effects that made the target permanent become a creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """If the target artifact copies a permanent that's copying something else, it will become whatever the target is copying."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """If the target artifact isn't an Equipment and becomes a copy of an Equipment, it'll become unattached when it becomes a non-Equipment artifact again."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-05-03"^^xsd:date ;
        :rulingText """If the target artifact becomes a creature the same turn it enters the battlefield, you can't attack with it or use any of its {T} abilities unless it has haste."""@en ] .

