:ThopterSpyNetworkAetherdriftCommander83 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Thopter Spy Network" ;
    :manaCost "{2}{U}{U}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :AetherdriftCommander ;
    :cardNumber "83"^^xsd:integer ;
    :artist "Jung Park" ;
    :hasLanguage :English ;
    :printedText """At the beginning of your upkeep, if you control an artifact, create a 1/1 colorless Thopter artifact creature token with flying.
Whenever one or more artifact creatures you control deal combat damage to a player, draw a card."""@en ;
    :oracleText """At the beginning of your upkeep, if you control an artifact, create a 1/1 colorless Thopter artifact creature token with flying.
Whenever one or more artifact creatures you control deal combat damage to a player, draw a card."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=692433"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/drc/83/thopter-spy-network"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2015-06-22"^^xsd:date ;
        :rulingText """The last ability will trigger, at most, once per combat damage step per player. However, if at least one artifact creature you control has first strike and others don't, or if an artifact creature you control has double strike, the ability could trigger twice per combat: once in each combat damage step."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2015-06-22"^^xsd:date ;
        :rulingText """Thopter Spy Network's first ability has an “intervening ‘if' clause.” That means (1) the ability won't trigger at all unless you control an artifact as your upkeep begins, and (2) the ability will do nothing if you don't control an artifact as it resolves."""@en ] .

