:PathOfAncestry rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Path of Ancestry" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Land ;
    :hasRarity :Common ;
    :isInSet :AetherdriftCommander ;
    :cardNumber "61"^^xsd:integer ;
    :artist "Wisnu Tan" ;
    :hasLanguage :English ;
    :printedText """This land enters tapped.
{T}: Add one mana of any color in your commander's color identity. When that mana is spent to cast a creature spell that shares a creature type with your commander, scry 1. (Look at the top card of your library. You may put that card on the bottom.)"""@en ;
    :oracleText """This land enters tapped.
{T}: Add one mana of any color in your commander's color identity. When that mana is spent to cast a creature spell that shares a creature type with your commander, scry 1. (Look at the top card of your library. You may put that card on the bottom.)"""@en ;
    # Note: keyword "Scry" not defined in MagicCardsOntology
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=692286"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/drc/61/path-of-ancestry"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-07-28"^^xsd:date ;
        :rulingText """Your commander's creature types are checked immediately after you cast a creature spell spending mana from Path of Ancestry's last ability. They aren't set before the game begins, and they may not be the same types your commander had when you activated that ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-07-28"^^xsd:date ;
        :rulingText """If you have two commanders, the last ability adds one mana of any color in their combined color identities. When you spend that mana on a creature spell that shares a creature type with either of your commanders, you'll scry 1."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """If Path of Ancestry's last ability produces two mana (most likely due to Mana Reflection), spending those two mana to cast creature spells that share a creature type with your commander will cause two abilities to trigger. Each of those abilities will cause you to scry 1. You won't scry 2. This is true whether you spend the mana on one creature spell or two."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """If your commander has no creature types, it can't share a creature type with any spell that you cast."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """If you cast your commander with mana from Path of Ancestry, and your commander hasn't somehow lost all of its creature types while on the stack, you'll scry 1."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """If you don't have a commander, Path of Ancestry's ability produces no mana."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """If your commander is a card that has no colors in its color identity, Path of Ancestry's ability produces no mana. It doesn't produce {C}."""@en ] .

:AethersquallAncient rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Aethersquall Ancient" ;
    :manaCost "{5}{U}{U}" ;
    :manaValue "7"^^xsd:nonNegativeInteger ;
    :hasCardType :Creature ;
    :hasSubType :Leviathan ;
    :hasRarity :Rare ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :AetherdriftCommander ;
    :cardNumber "68"^^xsd:integer ;
    :artist "Sam Burley" ;
    :hasLanguage :English ;
    :power "6" ;
    :powerValue "6"^^xsd:integer ;
    :toughness "6" ;
    :toughnessValue "6"^^xsd:integer ;
    :printedText """Flying
At the beginning of your upkeep, you get {E}{E}{E} (three energy counters).
Pay eight {E}: Return all other creatures to their owners' hands. Activate only as a sorcery."""@en ;
    :oracleText """Flying
At the beginning of your upkeep, you get {E}{E}{E} (three energy counters).
Pay eight {E}: Return all other creatures to their owners' hands. Activate only as a sorcery."""@en ;
    :hasKeywordAbility :Flying ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=692418"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/drc/68/aethersquall-ancient"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """{E} is the energy symbol. It represents one energy counter."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Energy counters are a kind of counter that a player may have. They're not associated with any specific permanents."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Keep track of how many energy counters each player has. Potential ways to track this include writing theme down on paper or using dice, but any method that is clear and mutually agreeable is fine. (At higher levels of tournament play, dice may not be allowed for tracking counters that players have.)"""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """If an effect says you get one or more {E}, you get that many energy counters. To pay one or more {E}, you lose that many energy counters. You can't pay more energy counters than you have. Any effects that interact with counters a player gets, has, or loses can interact with energy counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Energy counters aren't mana. They don't go away as steps, phases, and turns end, and effects that add mana "of any type" can't give you energy counters."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some triggered abilities state that you "may pay" a certain amount of {E}. You can't pay that amount multiple times to multiply the effect. You simply choose whether or not to pay that amount of {E} as the ability resolves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some triggered abilities that state that you "may pay" a certain amount of {E} describe an effect that happens "If you do." In that case, no player may take actions to try to stop the ability's effect after you make your choice. If the payment is followed by the phrase "When you do," then you'll choose any targets for that reflexive triggered ability and put it on the stack before players can take actions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """If a spell or ability with one or more targets states that you "may pay" some amount of {E}, and each permanent that it targets has become an illegal target, the spell or ability won't resolve. You can't pay any {E} even if you want to."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-06-07"^^xsd:date ;
        :rulingText """Some spells and abilities that give you {E} may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. You won't get any {E}."""@en ] .

