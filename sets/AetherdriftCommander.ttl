:BlasphemousActAetherdriftCommander101 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Blasphemous Act" ;
    :manaCost "{8}{R}" ;
    :manaValue "9"^^xsd:nonNegativeInteger ;
    :hasCardType :Sorcery ;
    :hasRarity :Rare ;
    :hasColor :Red ;
    :hasColorIdentity :Red ;
    :isInSet :AetherdriftCommander ;
    :cardNumber "101"^^xsd:integer ;
    :artist "Daarken" ;
    :hasLanguage :English ;
    :printedText """This spell costs {1} less to cast for each creature on the battlefield.
Blasphemous Act deals 13 damage to each creature."""@en ;
    :oracleText """This spell costs {1} less to cast for each creature on the battlefield.
Blasphemous Act deals 13 damage to each creature."""@en ;
    :flavorText """"Holy places are no longer sanctuary from death, and death is no longer sanctuary from anything."
—Thalia, Knight-Cathar"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=692451"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/drc/101/blasphemous-act"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """The total cost to cast Blasphemous Act is locked in before you pay that cost. For example, if there are three creatures on the battlefield, including one you can sacrifice to add {C}, the total cost of Blasphemous Act is {5}{R}. Then you can sacrifice the creature when you activate mana abilities just before paying the cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """Blasphemous Act's ability can't reduce the total cost to cast the spell below {R}."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """To determine the total cost of a spell, start with the mana cost or alternative cost you're paying, add any cost increases, then apply any cost reductions (such as that of Blasphemous Act). The mana value of the spell is determined only by its mana cost, no matter what the total cost to cast the spell was."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-11-10"^^xsd:date ;
        :rulingText """Although players may respond to Blasphemous Act once it's been cast, once it's announced, they can't respond before the cost is calculated and paid."""@en ] .

:CombustibleGearhulk rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Combustible Gearhulk" ;
