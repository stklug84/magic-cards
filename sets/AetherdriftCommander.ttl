:AethericAmplifier rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Aetheric Amplifier" ;
    :manaCost "{3}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasRarity :Rare ;
    :isInSet :AetherdriftCommander ;
    :cardNumber "18"^^xsd:integer ;
    :artist "Victor Sales" ;
    :hasLanguage :English ;
    :printedText """{T}: Add one mana of any color.
{4}, {T}: Choose one. Activate only as a sorcery.
• Double the number of each kind of counter on target permanent.
• Double the number of each kind of counter you have."""@en ;
    :oracleText """{T}: Add one mana of any color.
{4}, {T}: Choose one. Activate only as a sorcery.
• Double the number of each kind of counter on target permanent.
• Double the number of each kind of counter you have."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=692179"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/drc/18/aetheric-amplifier"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """To double the number of a kind of counters on a permanent, put a number of that kind of counters on it equal to the number it already has. Other cards that interact with putting counters on it will interact with this effect accordingly. The same is true for doubling the number of counters on a player."""@en ] .

:StridehangarAutomaton rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Stridehangar Automaton" ;
    :manaCost "{3}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasCardType :Creature ;
    :hasSubType :Construct ;
    :hasRarity :Rare ;
    :isInSet :AetherdriftCommander ;
    :cardNumber "19"^^xsd:integer ;
    :artist "Aaron J. Riley" ;
    :hasLanguage :English ;
    :power "1" ;
    :powerValue "1"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :printedText """Thopters you control get +1/+1.
If one or more artifact tokens would be created under your control, those tokens plus an additional 1/1 colorless Thopter artifact creature token with flying are created instead."""@en ;
    :oracleText """Thopters you control get +1/+1.
If one or more artifact tokens would be created under your control, those tokens plus an additional 1/1 colorless Thopter artifact creature token with flying are created instead."""@en ;
    :flavorText """"Avishkar greets the Multiverse with an open hand, but do not assume we are defenseless."
—Pia Nalaar"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=692180"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/drc/19/stridehangar-automaton"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """If an effect changes under whose control a token would be created, that effect applies before this creature’s effect applies. If an effect changes under whose control a token would enter the battlefield, that effect applies after this creature’s effect is able to be applied."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """The additional Thopter token won’t have any abilities the other tokens were created with. Anything else specified in the effect creating the token (such as tapped, attacking, or “Exile that token at end of combat”) applies to both the original tokens and the Thopter. Similarly, if the effect that creates the token has an additional effect that gives the token an ability, such as “That token gains haste,” that effect will also apply to the Thopter."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """If you copy a permanent spell, that copy becomes a token on the battlefield, but that’s not the same as creating a token. You won’t get an additional Thopter token that way."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """If another effect modifies which or how many tokens you create, you choose the order to apply those effects. For example, if you control this creature and Anointed Procession (“If an effect would create one or more tokens under your control, it creates twice that many of those tokens instead.”), each time you create tokens, you can choose to apply Anointed Procession’s effect to double those tokens first, then apply this creature’s effect to create an additional Thopter token. Or you can choose to apply this creature’s effect first followed by Anointed Procession’s effect, allowing you to create double the original tokens plus two additional Thopter tokens."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2025-02-07"^^xsd:date ;
        :rulingText """You don’t need to control the spell or ability that creates the tokens, but the tokens do need to be created under your control."""@en ] .

:RealityShiftAetherdriftCommander39 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Reality Shift" ;
    :manaCost "{1}{U}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Uncommon ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :isInSet :AetherdriftCommander ;
    :cardNumber "39"^^xsd:integer ;
    :artist "Villarrte" ;
    :hasLanguage :English ;
    :hasKeywordAction :Manifest ;
    :printedText """Exile target creature. Its controller manifests the top card of their library. (That player puts the top card of their library onto the battlefield face down as a 2/2 creature. If it's a creature card, it can be turned face up any time for its mana cost.)"""@en ;
    :oracleText """Exile target creature. Its controller manifests the top card of their library. (That player puts the top card of their library onto the battlefield face down as a 2/2 creature. If it's a creature card, it can be turned face up any time for its mana cost.)"""@en ;
    :flavorText """Forget the expected. Embrace the unpredictable."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=692264"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/drc/39/reality-shift"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """The face-down permanent is a 2/2 creature with no name, mana cost, creature types, or abilities. It's colorless and has a mana value of 0. Other effects that apply to the permanent can still grant or change any of these characteristics."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """If a double-faced card is manifested, it will be put onto the battlefield face down. While face down, it can't transform. If the front face of the card is a creature card, you can turn it face up by paying its mana cost. If you do, its front face will be up."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """Unlike a face-down creature that was cast using the morph ability, a manifested creature may still be turned face up after it loses its abilities if it's a creature card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """You must ensure that your face-down spells and permanents can easily be differentiated from each other. You're not allowed to mix up the cards that represent them on the battlefield in order to confuse other players. The order they entered the battlefield should remain clear. Common methods for indicating this include using markers or dice, or simply placing them in order on the battlefield. You must also track how each became face down (manifested, cast face down using the morph ability, and so on)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """Turning a permanent face up or face down doesn't change whether that permanent is tapped or untapped."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """Any time you have priority, you may turn a manifested creature face up by revealing that it's a creature card (ignoring any copy effects or type-changing effects that might be applying to it) and paying its mana cost. This is a special action. It doesn't use the stack and can't be responded to."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """A permanent that turns face up or face down changes characteristics but is otherwise the same permanent. Spells and abilities that were targeting that permanent, as well as Auras and Equipment that were attached to the permanent, aren't affected."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """Because face-down creatures don't have names, they can't have the same name as any other creature, even another face-down creature."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """If a manifested creature would have morph if it were face up, you may also turn it face up by paying its morph cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """There are no cards in the Fate Reforged set that would turn a face-down instant or sorcery card on the battlefield face up, but some older cards can try to do this. If something tries to turn a face-down instant or sorcery card on the battlefield face up, reveal that card to show all players it's an instant or sorcery card. The permanent remains on the battlefield face down. Abilities that trigger when a permanent turns face up won't trigger, because even though you revealed the card, it never turned face up."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """If a face-down permanent you control leaves the battlefield, you must reveal it. You must also reveal all face-down spells and permanents you control if you leave the game or if the game ends."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """At any time, you can look at a face-down permanent you control. You can't look at face-down permanents you don't control unless an effect allows you to or instructs you to."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2014-11-24"^^xsd:date ;
        :rulingText """Because the permanent is on the battlefield both before and after it's turned face up, turning a permanent face up doesn't cause any enters-the-battlefield abilities to trigger."""@en ] .

