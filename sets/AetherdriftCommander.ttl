:Duplicant rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Duplicant" ;
    :manaCost "{6}" ;
    :manaValue "6"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasCardType :Creature ;
    :hasSubType :Shapeshifter ;
    :hasRarity :Rare ;
    :isInSet :AetherdriftCommander ;
    :cardNumber "54"^^xsd:integer ;
    :artist "Hardy Fowler" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :printedText """Imprint — When this creature enters, you may exile target nontoken creature.
As long as a card exiled with this creature is a creature card, this creature has the power, toughness, and creature types of the last creature card exiled with it. It's still a Shapeshifter."""@en ;
    :oracleText """Imprint — When this creature enters, you may exile target nontoken creature.
As long as a card exiled with this creature is a creature card, this creature has the power, toughness, and creature types of the last creature card exiled with it. It's still a Shapeshifter."""@en ;
    # Note: keyword "Imprint" not defined in MagicCardsOntology
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=692279"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/drc/54/duplicant"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """Duplicant's base power and toughness change to the imprinted card's power and toughness. Counters and other effects that modify Duplicant's power and toughness still apply."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """Abilities that define a * in a creature's power and toughness apply while that card is in exile, but abilities that add or subtract power and toughness don't. For example, the ability of Crusader of Odric applies to determine Duplicant's power and toughness, but the ability of Death's Shadow doesn't."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """Duplicant's power and toughness are constantly updated if the exiled card's power and/or toughness change."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-08-07"^^xsd:date ;
        :rulingText """If a melded permanent or a merged permanent is exiled by Duplicant's triggered ability, that ability's controller chooses the relative timestamp of the exiled cards. Duplicant looks at the information of the one with the latest timestamp."""@en ] .

