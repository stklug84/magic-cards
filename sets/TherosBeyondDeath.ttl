    :oracleText """Flash (You may cast this spell any time you could cast an instant.)
Flying
Spells you cast with mana value 5 or greater cost {1} less to cast and can't be countered."""@en ;
    :flavorText """Even in their mountain fortresses, the Akroans have learned not to anger Thassa."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=476327"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/thb/76/thryx-the-sudden-storm"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "70587"^^xsd:positiveInteger ;
    :arenaName "Thryx, the Sudden Storm" ;
    :arenaSetCode "THB" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """For spells with {X} in their mana costs, use the value chosen for X to determine the spell's mana value."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """A spell or ability that counters spells can still target spells you control with mana value 5 or greater. When that spell or ability resolves, your spell won't be countered, but any additional effects of the countering spell or ability will still happen."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """To determine the total cost of a spell, start with the mana cost or alternative cost you're paying, add any cost increases, then apply any cost reductions (such as that of Thryx). The mana value of the spell remains unchanged, no matter what the total cost to cast it was."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """Players can't attempt to remove Thryx to raise the cost of a spell you wish to cast, but they can remove it to allow their spells and abilities to counter your spells."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """Thryx's last ability doesn't apply to itself while it's a spell."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """If Thryx enters the battlefield while a spell with mana value 5 or greater that you cast is on the stack, that spell can't be countered, even though you don't get the {1} discount."""@en ] .

