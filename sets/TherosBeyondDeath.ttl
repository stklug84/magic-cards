:HeliodSunCrowned rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Heliod, Sun-Crowned" ;
    :manaCost "{2}{W}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Enchantment ,
                 :Creature ;
    :hasSubType :God ;
    :hasRarity :MythicRare ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :TherosBeyondDeath ;
    :cardNumber "18"^^xsd:integer ;
    :artist "Lius Lasahido" ;
    :hasLanguage :English ;
    :power "5" ;
    :powerValue "5"^^xsd:integer ;
    :toughness "5" ;
    :toughnessValue "5"^^xsd:integer ;
    :hasKeywordAbility :Indestructible ;
    :printedText """Indestructible
As long as your devotion to white is less than five, Heliod isn't a creature.
Whenever you gain life, put a +1/+1 counter on target creature or enchantment you control.
{1}{W}: Another target creature gains lifelink until end of turn."""@en ;
    :oracleText """Indestructible
As long as your devotion to white is less than five, Heliod isn't a creature.
Whenever you gain life, put a +1/+1 counter on target creature or enchantment you control.
{1}{W}: Another target creature gains lifelink until end of turn."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=476269"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/thb/18/heliod-sun-crowned"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "70529"^^xsd:positiveInteger ;
    :arenaName "Heliod, Sun-Crowned" ;
    :arenaSetCode "THB" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """Heliod can be the target of its own triggered ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """A noncreature enchantment with a +1/+1 counter on it will be unaffected by that counter until it becomes a creature, at which time it will get +1/+1 for that counter."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """When a God enters the battlefield, your devotion to its color (including the mana symbols in the mana cost of the God itself) will determine if a creature entered the battlefield or not for abilities that trigger whenever a creature enters the battlefield."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """Counters put on a God remain on it while it's not a creature, even if they have no effect."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """Hybrid mana symbols, monocolored hybrid mana symbols, and Phyrexian mana symbols do count toward your devotion to their color(s)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """If an activated ability or triggered ability has an effect that depends on your devotion to a color, you count the number of mana symbols of that color among the mana costs of permanents you control as the ability resolves. The permanent with that ability will be counted if it's still on the battlefield at that time."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """In a Two-Headed Giant game, life gained by your teammate won't cause the ability to trigger, even though it caused your team's life total to increase."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """Multiple instances of lifelink on the same creature are redundant."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """If a God stops being a creature, it loses the type creature and the creature type God. It continues to be a legendary enchantment."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """Mana symbols in the text boxes of permanents you control don't count toward your devotion to any color."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """The abilities of Gods function as long as they're on the battlefield, regardless of whether they're creatures."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """The type-changing ability that can make a God not be a creature functions only on the battlefield. It's always a creature card in other zones, regardless of your devotion to its color. It's always a creature spell while it's on the stack."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """If you put an Aura on an opponent's permanent, you still control the Aura, and mana symbols in its mana cost count towards your devotion."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """Colorless and generic mana symbols ({C}, {0}, {1}, {2}, {X}, and so on) in mana costs of permanents you control don't count toward your devotion to any color."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """If a God is attacking or blocking and it stops being a creature, it will be removed from combat. It won't rejoin combat if it resumes being a creature later during that combat."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """If an effect causes a God to lose all abilities, its ability that causes it to stop being a creature still applies if appropriate."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """As a God enters the battlefield, your devotion to its color will determine whether any replacement effects that affect creatures entering the battlefield apply to that God. Because replacement effects are considered before the God is on the battlefield, the mana symbols in its mana cost won't be counted when determining this."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """Heliod's triggered ability triggers just once for each life-gaining event, whether it's 1 life from Daxos, Blessed by the Sun or 3 life from Cling to Dust. If you gain an amount of life "for each" of something or "equal to the number" of something, that life is gained as one event and Heliod's ability triggers only once."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-01-24"^^xsd:date ;
        :rulingText """If a creature is dealt lethal damage at the same time that you gain life, it can't receive a counter from Heliod's ability in time to save it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-07-28"^^xsd:date ;
        :rulingText """Each creature with lifelink dealing combat damage causes a separate life-gaining event. For example, if two creatures you control with lifelink deal combat damage at the same time, Heliod's ability will trigger twice. However, if a single creature you control with lifelink deals combat damage to multiple creatures, players, planeswalkers, and/or battles at the same time (perhaps because it has trample or was blocked by more than one creature), the ability will trigger only once."""@en ] .

