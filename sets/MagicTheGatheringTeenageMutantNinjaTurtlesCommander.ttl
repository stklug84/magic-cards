@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@prefix :     <urn:stklug84:MagicCardsOntology:2026-02-27#> .
@base         <urn:stklug84:MagicCardIndividuals:TMC:2026-07-19#> .

################################################################################
#
# Ontology Definition
#
################################################################################

<urn:stklug84:MagicCardIndividuals:TMC:2026-07-19#>
    rdf:type owl:Ontology ;
    owl:imports <urn:stklug84:MagicCardsOntology:2026-02-27#> ;
    rdfs:label "Magic Card Collection Individuals – Teenage Mutant Ninja Turtles Eternal"@en ;
    rdfs:comment """An instance graph describing the card individuals of a
personal Magic: The Gathering card collection that were printed in the set
Teenage Mutant Ninja Turtles Eternal (TMC). One Card individual is defined per collected
printing, carrying its characteristics, format legalities and official
rulings. Card data was sourced from Gatherer and Scryfall. This file imports
MagicCardsOntology to reuse all existing class, property, set, keyword,
subtype, format and legality definitions."""@en .


################################################################################
#
# Card Individuals
#
################################################################################

:ChromaticLanternMagicTheGatheringTeenageMutantNinjaTurtlesCommander58 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Chromatic Lantern" ;
    :manaCost "{3}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasRarity :Rare ;
    :isInSet :MagicTheGatheringTeenageMutantNinjaTurtlesCommander ;
    :cardNumber "58"^^xsd:integer ;
    :artist "Leanna Crossan" ;
    :hasLanguage :English ;
    :printedText """Lands you control have "{T}: Add one mana of any color."
{T}: Add one mana of any color."""@en ;
    :oracleText """Lands you control have "{T}: Add one mana of any color."
{T}: Add one mana of any color."""@en ;
    :flavorText """The Time Scepter can not only control time, but bend reality itself. Its master could rule all of reality, rewriting history to suit their whims."""@en ;
    :scryfallUrl "https://scryfall.com/card/tmc/58/chromatic-lantern"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2018-10-05"^^xsd:date ;
        :rulingText """Lands you control won't lose any other abilities they had. They also won't gain or lose any land types."""@en ] .
