:ForbiddenAlchemy rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Forbidden Alchemy" ;
    :manaCost "{2}{U}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Common ;
    :hasColor :Blue ;
    :hasColorIdentity :Blue ;
    :hasColorIdentity :Black ;
    :isInSet :TarkirDragonstormCommander ;
    :cardNumber "152"^^xsd:integer ;
    :artist "David Rapoza" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Flashback ;
    :printedText """Look at the top four cards of your library. Put one of them into your hand and the rest into your graveyard.
Flashback {6}{B} (You may cast this card from your graveyard for its flashback cost. Then exile it.)"""@en ;
    :oracleText """Look at the top four cards of your library. Put one of them into your hand and the rest into your graveyard.
Flashback {6}{B} (You may cast this card from your graveyard for its flashback cost. Then exile it.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=696308"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/tdc/152/forbidden-alchemy"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2011-09-22"^^xsd:date ;
        :rulingText """If you have fewer than four cards in your library, you'll look at all the cards there and put one into your hand and the rest into your graveyard."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """You can cast a spell using flashback even if it was somehow put into your graveyard without having been cast."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """"Flashback [cost]" means "You may cast this card from your graveyard by paying [cost] rather than paying its mana cost" and "If the flashback cost was paid, exile this card instead of putting it anywhere else any time it would leave the stack.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """You must still follow any timing restrictions and permissions, including those based on the card's type. For instance, you can cast a sorcery using flashback only when you could normally cast a sorcery."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """To determine the total cost of a spell, start with the mana cost or alternative cost (such as a flashback cost) you're paying, add any cost increases, then apply any cost reductions. The mana value of the spell is determined only by its mana cost, no matter what the total cost to cast the spell was."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """A spell cast using flashback will always be exiled afterward, whether it resolves, is countered, or leaves the stack in some other way."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2021-03-19"^^xsd:date ;
        :rulingText """If a card with flashback is put into your graveyard during your turn, you can cast it if it's legal to do so before any other player can take any actions."""@en ] .

