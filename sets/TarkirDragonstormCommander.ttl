    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2018-03-16"^^xsd:date ;
        :rulingText """If a creature enters the battlefield under your control and gains haste, but then loses it before attacking, it won't be able to attack that turn. This means that you can't use one Swiftfoot Boots to allow two new creatures to attack in the same turn."""@en ] .
