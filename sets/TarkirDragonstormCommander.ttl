    :isInSet :TarkirDragonstormCommander ;
    :cardNumber "294"^^xsd:integer ;
    :artist "Ryan Pancoast" ;
    :hasLanguage :English ;
    :loyalty "3"^^xsd:integer ;
    :printedText """+1: Creatures you control gain deathtouch until end of turn. Put a +1/+1 counter on up to one target creature token you control.
−2: Until end of turn, if one or more tokens would be created under your control, twice that many of those tokens are created instead.
−6: Exile all cards from all graveyards, then create a 1/1 white Spirit creature token with flying for each card exiled this way."""@en ;
    :oracleText """+1: Creatures you control gain deathtouch until end of turn. Put a +1/+1 counter on up to one target creature token you control.
−2: Until end of turn, if one or more tokens would be created under your control, twice that many of those tokens are created instead.
−6: Exile all cards from all graveyards, then create a 1/1 white Spirit creature token with flying for each card exiled this way."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=696450"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/tdc/294/kaya-geist-hunter"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2021-11-19"^^xsd:date ;
        :rulingText """The tokens that Kaya's second ability creates are exact copies of the tokens that were being created in the first place."""@en ] .

