:CaseOfTheShatteredPact rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Case of the Shattered Pact" ;
    :manaCost "{2}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Enchantment ;
    :hasSubType :Case ;
    :hasRarity :Uncommon ;
    :isInSet :MurdersAtKarlovManor ;
    :cardNumber "1"^^xsd:integer ;
    :artist "Peter Polach" ;
    :hasLanguage :English ;
    :hasKeywordAbility :Solved ;
    :printedText """When this Case enters, search your library for a basic land card, reveal it, put it into your hand, then shuffle.
To solve — There are five colors among permanents you control. (If unsolved, solve at the beginning of your end step.)
Solved — At the beginning of combat on your turn, target creature you control gains flying, double strike, and vigilance until end of turn."""@en ;
    :oracleText """When this Case enters, search your library for a basic land card, reveal it, put it into your hand, then shuffle.
To solve — There are five colors among permanents you control. (If unsolved, solve at the beginning of your end step.)
Solved — At the beginning of combat on your turn, target creature you control gains flying, double strike, and vigilance until end of turn."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=646565"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/mkm/1/case-of-the-shattered-pact"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "88922"^^xsd:positiveInteger ;
    :arenaName "Case of the Shattered Pact" ;
    :arenaSetCode "MKM" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """Cases don't lose their other abilities when they become solved."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """"To solve" abilities will check for their condition twice: once when the ability would trigger, and once when it resolves. If the condition isn't true at the beginning of your end step, the ability won't trigger at all. If the condition isn't true when the ability resolves, the Case won't become solved."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """"Solved — [static ability]" means "As long as this Case is solved, [static ability]." Static abilities are written as statements, such as "Creatures you control get +1/+1" or "Instant and sorcery spells you cast cost {1} less to cast.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """"Solved — [Triggered ability]" means "[Triggered ability]. This ability triggers only if this Case is solved." Triggered abilities use the word "when," "whenever," or "at." They're often written as "[Trigger condition], [effect].\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """The meaning of "solved" differs based on what type of ability follows it. "Solved — [activated ability]" means "[Activated ability]. Activate only if this Case is solved." Activated abilities contain a colon. They're generally written "[Cost]: [Effect]." """@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """Being solved is not part of a permanent's copiable values. A permanent that becomes a copy of a solved Case is not solved. A solved Case that somehow becomes a copy of a different Case stays solved."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """"To Solve — [condition]" means "At the beginning of your end step, if [condition] and this Case is not solved, it becomes solved.\""""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """Each Case has two special keyword abilities: to solve and solved."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """Once a Case becomes solved, it stays solved until it leaves the battlefield."""@en ] .

:AuspiciousArrival rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Auspicious Arrival" ;
    :manaCost "{1}{W}" ;
    :manaValue "2"^^xsd:nonNegativeInteger ;
    :hasCardType :Instant ;
    :hasRarity :Common ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :MurdersAtKarlovManor ;
    :cardNumber "5"^^xsd:integer ;
    :artist "Lie Setiawan" ;
    :hasLanguage :English ;
    :hasKeywordAction :Investigate ;
    :printedText """Target creature gets +2/+2 until end of turn. Investigate. (Create a Clue token. It's an artifact with "{2}, Sacrifice this token: Draw a card.")"""@en ;
    :oracleText """Target creature gets +2/+2 until end of turn. Investigate. (Create a Clue token. It's an artifact with "{2}, Sacrifice this token: Draw a card.")"""@en ;
    :flavorText """Proft brushed past the guards and introduced himself as "the great Detective Proft" without a hint of irony, then identified the culprit within minutes."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=646569"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/mkm/5/auspicious-arrival"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "88926"^^xsd:positiveInteger ;
    :arenaName "Auspicious Arrival" ;
    :arenaSetCode "MKM" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """You can't sacrifice a Clue to pay multiple costs. For example, you can't sacrifice a Clue token to activate its own ability and also to activate Alquist Proft, Master Sleuth's ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """Some abilities trigger "whenever you sacrifice a Clue". Those abilities trigger whenever you sacrifice a Clue for any reason, not just to activate a Clue's activated ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """Clue is an artifact type. Even though it appears on some cards with other permanent types, it's never a creature type, a land type, or anything but an artifact type."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """Some spells and abilities that investigate may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve. You won't create any Clue tokens."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """If an effect refers to a Clue, it means any Clue artifact, not just a Clue artifact token. For example, you can sacrifice Wrench to pay for Alquist Proft, Master Sleuth's activated ability."""@en ] .

