              :Green ;
    :hasColorIdentity :Black ,
                      :Green ;
    :isInSet :MurdersAtKarlovManor ;
    :cardNumber "240"^^xsd:integer ;
    :artist "Uriah Voth" ;
    :hasLanguage :English ;
    :printedText """As an additional cost to cast this spell, collect evidence X, where X is the total mana value of the permanents this spell targets.
Destroy up to one target artifact, up to one target creature, up to one target enchantment, and up to one target planeswalker."""@en ;
    :oracleText """As an additional cost to cast this spell, collect evidence X, where X is the total mana value of the permanents this spell targets.
Destroy up to one target artifact, up to one target creature, up to one target enchantment, and up to one target planeswalker."""@en ;
    :flavorText """"The Golgari can read the dead like a newspaper."
—Taboro of the Foundway Associates"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=646794"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/mkm/240/urgent-necropsy"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "89152"^^xsd:positiveInteger ;
    :arenaName "Urgent Necropsy" ;
    :arenaSetCode "MKM" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """Once you've announced that you're casting a spell, players can't take actions until you've finished doing so. Notably, opponents can't try to remove cards from your graveyard to stop you from collecting evidence."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """The value of X is locked in after you choose targets but before you pay costs for Urgent Necropsy. In the extremely unusual case where the mana value of one or more of the targets changes while you're paying costs, the cost to cast Urgent Necropsy, including the additional cost, remains what you previously determined."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2024-02-02"^^xsd:date ;
        :rulingText """If you can't exile enough cards to meet or exceed the required mana value, you can't choose to collect evidence at all."""@en ] .

