:MetalworkColossus rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Metalwork Colossus" ;
    :manaCost "{11}" ;
    :manaValue "11"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ,
                 :Creature ;
    :hasSubType :Construct ;
    :hasRarity :Rare ;
    :isInSet :MarvelSuperHeroesCommander ;
    :cardNumber "204"^^xsd:integer ;
    :artist "Josu Hernaiz" ;
    :hasLanguage :English ;
    :power "10" ;
    :powerValue "10"^^xsd:integer ;
    :toughness "10" ;
    :toughnessValue "10"^^xsd:integer ;
    :printedText """This spell costs {X} less to cast, where X is the total mana value of noncreature artifacts you control.
Sacrifice two artifacts: Return this card from your graveyard to your hand."""@en ;
    :oracleText """This spell costs {X} less to cast, where X is the total mana value of noncreature artifacts you control.
Sacrifice two artifacts: Return this card from your graveyard to your hand."""@en ;
    :flavorText """Wakandan defenses are centuries ahead of the rest of the world."""@en ;
    :scryfallUrl "https://scryfall.com/card/msc/204/metalwork-colossus"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """If a permanent has {X} in its mana cost, X is considered to be 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """Metalwork Colossus's last ability can be activated only if it is in your graveyard."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """Once a player has announced that they are casting Metalwork Colossus, no player may take actions to try to change the number of artifacts its controller controls before that spell's cost is locked in."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """The total cost to cast Metalwork Colossus is locked in before you pay that cost. For example, if you control three noncreature artifacts each with mana value 2, including one you can sacrifice to add {C} , the total cost of Metalwork Colossus is {5}. Then you can sacrifice the artifact when you activate mana abilities just before paying the cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2016-09-20"^^xsd:date ;
        :rulingText """If the total mana value of noncreature artifacts you control is 11 or greater, Metalwork Colossus costs {0} to cast."""@en ] .

:ScavengerGroundsMarvelSuperHeroesCommander263 rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Scavenger Grounds" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Land ;
    :hasSubType :Desert ;
    :hasRarity :Rare ;
    :isInSet :MarvelSuperHeroesCommander ;
    :cardNumber "263"^^xsd:integer ;
    :artist "Bastien Grivet" ;
    :hasLanguage :English ;
    :producesMana :Colorless ;
    :printedText """{T}: Add {C}.
{2}, {T}, Sacrifice a Desert: Exile all graveyards."""@en ;
    :oracleText """{T}: Add {C}.
{2}, {T}, Sacrifice a Desert: Exile all graveyards."""@en ;
    :flavorText """The remnants of titanic clashes, immortalized by the desert sands."""@en ;
    :scryfallUrl "https://scryfall.com/card/msc/263/scavenger-grounds"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MagicOnline ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2017-04-18"^^xsd:date ;
        :rulingText """Desert is a land subtype with no special meaning. It doesn't grant the land an intrinsic mana ability. Other cards may care about which lands are Deserts."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-07-14"^^xsd:date ;
        :rulingText """If a Desert has an ability with a cost of "Sacrifice a Desert," you can sacrifice that Desert to pay the cost for its own ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2017-07-14"^^xsd:date ;
        :rulingText """The sacrificed Desert will be in your graveyard to be exiled by the last ability of Scavenger Grounds."""@en ] .

