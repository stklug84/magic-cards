:LaezelVlaakithsChampion rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Lae'zel, Vlaakith's Champion" ;
    :manaCost "{2}{W}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Gith ;
    :hasSubType :Warrior ;
    :hasRarity :Rare ;
    :hasColor :White ;
    :hasColorIdentity :White ;
    :isInSet :CommanderLegendsBattleForBaldursGate ;
    :cardNumber "29"^^xsd:integer ;
    :artist "John Stanko" ;
    :hasLanguage :English ;
    :power "3" ;
    :powerValue "3"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    # Note: keyword "Choose a background" not defined in MagicCardsOntology
    :printedText """If you would put one or more counters on a creature or planeswalker you control or on yourself, put that many plus one of each of those kinds of counters on that permanent or player instead.
Choose a Background (You can have a Background as a second commander.)"""@en ;
    :oracleText """If you would put one or more counters on a creature or planeswalker you control or on yourself, put that many plus one of each of those kinds of counters on that permanent or player instead.
Choose a Background (You can have a Background as a second commander.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=562912"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/clb/29/laezel-vlaakiths-champion"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2022-06-10"^^xsd:date ;
        :rulingText """Choose a Background is a variant of the partner ability. You may have two commanders if one of them is a legendary creature with the choose a background ability and the other is a legendary Background enchantment. Backgrounds and cards with choose a Background do not interact with cards which have any other partner ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-06-10"^^xsd:date ;
        :rulingText """If you control a Background that grants an ability to commander creatures you own, and you own more than one commander creature, each of them will have that ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-06-10"^^xsd:date ;
        :rulingText """If a card refers to a commander creature you own, a Background won't usually be counted or included for that effect. If another spell or ability causes your Background to become a creature, however, it will be included. Any effect that refers to your commander or a commander you own or control without specifying creature will apply to a Background that is your commander, as appropriate."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-06-10"^^xsd:date ;
        :rulingText """If your Commander deck has two commanders, you can include only cards whose own color identities are also found in your commanders' combined color identities."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-06-10"^^xsd:date ;
        :rulingText """If your commander loses the choose a Background ability or stops being a Background during the game, as appropriate, it is still your commander."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-06-10"^^xsd:date ;
        :rulingText """ If something refers to your commander while you have two commanders, it refers to one of them of your choice. If you are instructed to perform an action on your commander (e.g. put it from the command zone into your hand due to Command Beacon), you choose one of your commanders at the time the effect happens."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-06-10"^^xsd:date ;
        :rulingText """You can choose two commanders that are the same color or colors."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-06-10"^^xsd:date ;
        :rulingText """Once the game begins, your two commanders are tracked separately. If you cast one, you won't have to pay an additional {2} the first time you cast the other. A player loses the game after having been dealt 21 combat damage from any one of them, not from both of them combined (although your Background won't usually be a creature anyway)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-06-10"^^xsd:date ;
        :rulingText """An effect that checks whether you control your commander is satisfied if you control one or both of your two commanders."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2022-06-10"^^xsd:date ;
        :rulingText """Both commanders start in the command zone, and the remaining 98 cards (or 58 cards in a Commander Draft game) of your deck are shuffled to become your library."""@en ] .

