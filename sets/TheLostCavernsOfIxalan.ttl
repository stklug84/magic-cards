    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :TheLostCavernsOfIxalan ;
    :cardNumber "120"^^xsd:integer ;
    :artist "Allen Douglas" ;
    :hasLanguage :English ;
    :power "2" ;
    :powerValue "2"^^xsd:integer ;
    :toughness "3" ;
    :toughnessValue "3"^^xsd:integer ;
    :printedText """{B}, {T}, Sacrifice this creature: Return target creature card from your graveyard to the battlefield with a finality counter on it. Activate only as a sorcery. (If a creature with a finality counter on it would die, exile it instead.)"""@en ;
    :oracleText """{B}, {T}, Sacrifice this creature: Return target creature card from your graveyard to the battlefield with a finality counter on it. Activate only as a sorcery. (If a creature with a finality counter on it would die, exile it instead.)"""@en ;
    :flavorText """"As the snake sheds its skin to be born anew, we cast off death to rise as servants of Aclazotz."
—Vito, Church of Dusk heretic"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=636825"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/lci/120/soulcoil-viper"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "87265"^^xsd:positiveInteger ;
    :arenaName "Soulcoil Viper" ;
    :arenaSetCode "LCI" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Because you choose the target of Soulcoil Viper's ability before you pay the cost of sacrificing it, Soulcoil Viper can't be the target of its own ability."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Finality counters work on any permanent, not only creatures. If a permanent with a finality counter on it would be put into a graveyard from the battlefield, exile it instead."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Multiple finality counters on a single permanent are redundant."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Finality counters don't stop permanents from going to zones other than the graveyard from the battlefield. For example, if a permanent with a finality counter on it would be put into its owner's hand from the battlefield, it does so normally."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Finality counters aren't keyword counters, and a finality counter doesn't give any abilities to the permanent it's on. If that permanent loses its abilities and then would go to a graveyard, it will still be exiled instead."""@en ] .

