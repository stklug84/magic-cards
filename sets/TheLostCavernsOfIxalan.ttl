    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Any enters-the-battlefield abilities of the copied permanent will trigger when the token enters the battlefield. Any "as [this permanent] enters the battlefield" or "[this permanent] enters the battlefield with" abilities of the target permanent will also work."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """If the copied permanent is a token, the new token that's created copies the original characteristics of that token as stated by the effect that created the token (with the listed exceptions)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """If the copied permanent has {X} in its mana cost, X is 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """If the copied permanent is copying something else, then the token enters the battlefield as whatever that permanent copied (with the listed exceptions)."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """The token copies exactly what was printed on the original permanent, with the listed exceptions (unless that permanent is copying something else or is a token; see below). It doesn't copy whether that permanent is tapped or untapped, whether it has any counters on it or any Auras or Equipment attached to it, or any non-copy effects that have changed its types, color, power and toughness, and so on."""@en ] .

:UchbenbakTheGreatMistake rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Uchbenbak, the Great Mistake" ;
    :manaCost "{3}{U}{B}" ;
    :manaValue "5"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Creature ;
    :hasSubType :Skeleton ,
                :Horror ;
    :hasRarity :Uncommon ;
    :hasColor :Blue ,
              :Black ;
    :hasColorIdentity :Blue ,
                      :Black ;
    :isInSet :TheLostCavernsOfIxalan ;
    :cardNumber "242"^^xsd:integer ;
    :artist "Steven Belledin" ;
    :hasLanguage :English ;
    :power "6" ;
    :powerValue "6"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :hasKeywordAbility :Vigilance ,
                       :Menace ;
    # Note: keyword "Descend" not defined in MagicCardsOntology
    :printedText """Vigilance, menace
Descend 8 — {4}{U}{B}: Return this card from your graveyard to the battlefield with a finality counter on it. Activate only if there are eight or more permanent cards in your graveyard and only as a sorcery. (If a creature with a finality counter on it would die, exile it instead.)"""@en ;
    :oracleText """Vigilance, menace
Descend 8 — {4}{U}{B}: Return this card from your graveyard to the battlefield with a finality counter on it. Activate only if there are eight or more permanent cards in your graveyard and only as a sorcery. (If a creature with a finality counter on it would die, exile it instead.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=636963"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/lci/242/uchbenbak-the-great-mistake"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "87404"^^xsd:positiveInteger ;
    :arenaName "Uchbenbak, the Great Mistake" ;
    :arenaSetCode "LCI" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Cards with the ability word "descend N" have abilities that care if you have at least N permanent cards in your graveyard."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Some descend triggered abilities include intervening "if" clauses (i.e. "if you have [four or eight] permanent cards in your graveyard" in the middle of the ability). Each of these abilities checks your graveyard at the moment it would trigger to see if it does. If you don't have the required number of permanent cards in your graveyard at that time, the ability doesn't trigger at all. If it does trigger, it will check again as it tries to resolve. If you don't have the required number of permanent cards in your graveyard at that time, the ability won't resolve and none of its effects will happen."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Multiple finality counters on a single permanent are redundant."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Finality counters work on any permanent, not only creatures. If a permanent with a finality counter on it would be put into a graveyard from the battlefield, exile it instead."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Finality counters don't stop permanents from going to zones other than the graveyard from the battlefield. For example, if a permanent with a finality counter on it would be put into its owner's hand from the battlefield, it does so normally."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Finality counters aren't keyword counters, and a finality counter doesn't give any abilities to the permanent it's on. If that permanent loses its abilities and then would go to a graveyard, it will still be exiled instead."""@en ] .

