    :hasKeywordAbility :Ward ;
    :printedText """Ward {2}
As this creature enters, choose a creature type.
This creature is the chosen type in addition to its other types.
If a triggered ability of another creature you control of the chosen type triggers, it triggers an additional time."""@en ;
    :oracleText """Ward {2}
As this creature enters, choose a creature type.
This creature is the chosen type in addition to its other types.
If a triggered ability of another creature you control of the chosen type triggers, it triggers an additional time."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=636980"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/lci/258/roaming-throne"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "87421"^^xsd:positiveInteger ;
    :arenaName "Roaming Throne" ;
    :arenaSetCode "LCI" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Roaming Throne's last ability doesn't copy the triggered ability; it just causes the ability to trigger an additional time. Any choices made as you put the ability onto the stack, such as modes and targets, are made separately for each instance of the ability. Any choices made on resolution, such as whether to put counters on a permanent, are also made individually."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """If you control two Roaming Thrones with the same chosen creature type, triggered abilities of other creatures you control of the chosen type trigger three times. Three such Roaming Thrones result in four triggered abilities, and so on."""@en ] .

:HiddenCataract rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Hidden Cataract" ;
    :manaValue "0"^^xsd:nonNegativeInteger ;
    :hasCardType :Land ;
    :hasSubType :Cave ;
    :hasRarity :Common ;
    :hasColorIdentity :Blue ;
    :isInSet :TheLostCavernsOfIxalan ;
    :cardNumber "273"^^xsd:integer ;
    :artist "Josu Solano" ;
    :hasLanguage :English ;
    :producesMana :Blue ;
    :entersTapped "true"^^xsd:boolean ;
    :hasKeywordAction :Discover ;
    :printedText """This land enters tapped.
{T}: Add {U}.
{4}{U}, {T}, Sacrifice this land: Discover 4. Activate only as a sorcery. (Exile cards from the top of your library until you exile a nonland card with mana value 4 or less. Cast it without paying its mana cost or put it into your hand. Put the rest on the bottom in a random order.)"""@en ;
    :oracleText """This land enters tapped.
{T}: Add {U}.
{4}{U}, {T}, Sacrifice this land: Discover 4. Activate only as a sorcery. (Exile cards from the top of your library until you exile a nonland card with mana value 4 or less. Cast it without paying its mana cost or put it into your hand. Put the rest on the bottom in a random order.)"""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=636998"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/lci/273/hidden-cataract"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "87439"^^xsd:positiveInteger ;
    :arenaName "Hidden Cataract" ;
    :arenaSetCode "LCI" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :Legal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """You exile the cards face up. All players will be able to see them."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """When you discover, you must exile cards. The only optional part of the ability is whether you cast the exiled card or put it into your hand."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """The mana value of a split card is determined by the combined mana cost of its two halves. If discover allows you to cast a split card, you may cast either half (as long as its mana value is less than or equal to the effect's discover value) but not both halves."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """If you cast a spell "without paying its mana cost", you can't choose to cast it for any alternative costs. You can, however, pay additional costs. If the spell has any mandatory additional costs, you must pay those to cast it."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Some spells and abilities that cause you to discover may require targets. If each target chosen is an illegal target as that spell or ability tries to resolve, it won't resolve and you won't discover."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """If you can't cast the discovered card (perhaps because there are no legal targets for the spell), you'll put it into your hand."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """If the discovered card has {X} in its mana cost, you must choose 0 as the value of X when casting it without paying its mana cost."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """A spell's mana value is determined only by its mana cost. Ignore any alternative costs, additional costs, cost increases, or cost reductions."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """If you discover an adventurer card, split card, or modal double-faced card, you might be able to cast that card with either set of characteristics depending on the effect's discover value. For example, if you discover 4 and reveal Galvanic Giant (an adventurer card from Wilds of Eldraine with a mana value of 4), you could cast Galvanic Giant, but not Storm Reading (its Adventure, which has a mana value of 7). If you discover 7 and reveal Galvanic Giant, you could cast either Galvanic Giant or Storm Reading."""@en ] .

