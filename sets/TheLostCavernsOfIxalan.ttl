:RoamingThrone rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Roaming Throne" ;
    :manaCost "{4}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasCardType :Artifact ;
    :hasCardType :Creature ;
    :hasSubType :Golem ;
    :hasRarity :Rare ;
    :isInSet :TheLostCavernsOfIxalan ;
    :cardNumber "258"^^xsd:integer ;
    :artist "Cristi Balanescu" ;
    :hasLanguage :English ;
    :power "4" ;
    :powerValue "4"^^xsd:integer ;
    :toughness "4" ;
    :toughnessValue "4"^^xsd:integer ;
    :hasKeywordAbility :Ward ;
    :printedText """Ward {2}
As this creature enters, choose a creature type.
This creature is the chosen type in addition to its other types.
If a triggered ability of another creature you control of the chosen type triggers, it triggers an additional time."""@en ;
    :oracleText """Ward {2}
As this creature enters, choose a creature type.
This creature is the chosen type in addition to its other types.
If a triggered ability of another creature you control of the chosen type triggers, it triggers an additional time."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=636980"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/lci/258/roaming-throne"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """Roaming Throne's last ability doesn't copy the triggered ability; it just causes the ability to trigger an additional time. Any choices made as you put the ability onto the stack, such as modes and targets, are made separately for each instance of the ability. Any choices made on resolution, such as whether to put counters on a permanent, are also made individually."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2023-11-10"^^xsd:date ;
        :rulingText """If you control two Roaming Thrones with the same chosen creature type, triggered abilities of other creatures you control of the chosen type trigger three times. Three such Roaming Thrones result in four triggered abilities, and so on."""@en ] .

:AnimPakalThousandthMoon rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Anim Pakal, Thousandth Moon" ;
    :manaCost "{1}{R}{W}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
