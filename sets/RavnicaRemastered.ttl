:KayaOrzhovUsurper rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Kaya, Orzhov Usurper" ;
    :manaCost "{1}{W}{B}" ;
    :manaValue "3"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Planeswalker ;
    :hasSubType :Kaya ;
    :hasRarity :Rare ;
    :hasColor :White ,
              :Black ;
    :hasColorIdentity :White ,
                      :Black ;
    :isInSet :RavnicaRemastered ;
    :cardNumber "194"^^xsd:integer ;
    :artist "Yongjae Choi" ;
    :hasLanguage :English ;
    :loyalty "3"^^xsd:integer ;
    :printedText """+1: Exile up to two target cards from a single graveyard. You gain 2 life if at least one creature card was exiled this way.
−1: Exile target nonland permanent with mana value 1 or less.
−5: Kaya deals damage to target player equal to the number of cards that player owns in exile and you gain that much life."""@en ;
    :oracleText """+1: Exile up to two target cards from a single graveyard. You gain 2 life if at least one creature card was exiled this way.
−1: Exile target nonland permanent with mana value 1 or less.
−5: Kaya deals damage to target player equal to the number of cards that player owns in exile and you gain that much life."""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=643201"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/rvr/194/kaya-orzhov-usurper"^^xsd:anyURI ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2019-01-25"^^xsd:date ;
        :rulingText """If a permanent has {X} in its mana cost, X is considered to be 0."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-01-25"^^xsd:date ;
        :rulingText """Kaya's last ability causes you to gain life equal to the number of cards the target player owns in exile, even if an effect causes her to deal more or less than that amount of damage to that player."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2019-01-25"^^xsd:date ;
        :rulingText """Tokens that aren't a copy of something else don't have a mana cost. Anything without a mana cost normally has a mana value of 0."""@en ] .
