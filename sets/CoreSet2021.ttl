:LilianaWakerOfTheDead rdf:type owl:NamedIndividual ,
                  :Card ;
    :cardName "Liliana, Waker of the Dead" ;
    :manaCost "{2}{B}{B}" ;
    :manaValue "4"^^xsd:nonNegativeInteger ;
    :hasSuperType :Legendary ;
    :hasCardType :Planeswalker ;
    :hasSubType :Liliana ;
    :hasRarity :MythicRare ;
    :hasColor :Black ;
    :hasColorIdentity :Black ;
    :isInSet :CoreSet2021 ;
    :cardNumber "297"^^xsd:integer ;
    :artist "Anna Steinbauer" ;
    :hasLanguage :English ;
    :loyalty "4"^^xsd:integer ;
    :printedText """+1: Each player discards a card. Each opponent who can't loses 3 life.
−3: Target creature gets -X/-X until end of turn, where X is the number of cards in your graveyard.
−7: You get an emblem with "At the beginning of combat on your turn, put target creature card from a graveyard onto the battlefield under your control. It gains haste.\""""@en ;
    :oracleText """+1: Each player discards a card. Each opponent who can't loses 3 life.
−3: Target creature gets -X/-X until end of turn, where X is the number of cards in your graveyard.
−7: You get an emblem with "At the beginning of combat on your turn, put target creature card from a graveyard onto the battlefield under your control. It gains haste.\""""@en ;
    :gathererUrl "https://gatherer.wizards.com/Pages/Card/Details.aspx?multiverseid=488913"^^xsd:anyURI ;
    :scryfallUrl "https://scryfall.com/card/m21/297/liliana-waker-of-the-dead"^^xsd:anyURI ;
    :isAvailableOn :PaperMagic ,
                   :MTGArena ,
                   :MagicOnline ;
    :arenaId "76872"^^xsd:positiveInteger ;
    :arenaName "Liliana, Waker of the Dead" ;
    :arenaSetCode "M21" ;
    :hasLegality
      [ rdf:type :LegalityMapping ; :inFormat :Commander ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Standard ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Modern ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Legacy ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Vintage ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pioneer ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Pauper ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Historic ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Timeless ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Alchemy ; :hasLegalityStatus :NotLegal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :Brawl ; :hasLegalityStatus :Legal ] ,
      [ rdf:type :LegalityMapping ; :inFormat :StandardBrawl ; :hasLegalityStatus :NotLegal ] ;
    :hasRuling
      [ rdf:type :Ruling ;
        :rulingDate "2020-06-23"^^xsd:date ;
        :rulingText """A player who has a card in hand can't choose to lose 3 life instead of discarding a card."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-06-23"^^xsd:date ;
        :rulingText """The value of X is determined only as Liliana's second ability resolves. Once that happens, the value of X won't change later in the turn even if the number of cards in your graveyard changes."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-06-23"^^xsd:date ;
        :rulingText """As Liliana's first ability resolves, first the player whose turn it is chooses a card in hand without revealing it, then each other player in turn order does the same. Then all the chosen cards are discarded at the same time. Finally, each opponent who couldn't discard a card loses 3 life."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-06-23"^^xsd:date ;
        :rulingText """If you have no cards in hand, you just don't discard anything. You don't lose 3 life. Other players still discard if able."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-06-23"^^xsd:date ;
        :rulingText """In a multiplayer game, if a player leaves the game, all cards that player owns leave as well. If you leave the game, any permanents you control from Liliana's emblem are exiled."""@en ] ,
      [ rdf:type :Ruling ;
        :rulingDate "2020-06-23"^^xsd:date ;
        :rulingText """Creatures put onto the battlefield with Liliana's emblem gain haste indefinitely."""@en ] .
