:Frog rdf:type :SubType ;
       rdfs:label "Frog" ;
       rdfs:comment "A leaping amphibian, sometimes growing to monstrous sizes."@en .
:Fungus rdf:type :SubType ;
       rdfs:label "Fungus" ;
       rdfs:comment "A sentient mushroom or fungal colony, often associated with saprolings."@en .
:Gamer rdf:type :SubType ;
