                :KeywordAbility ;
       rdfs:label "Storm" ;
       rdfs:comment "A keyword ability that creates copies of a spell."@en .
:Sunburst rdf:type owl:NamedIndividual ,
                   :KeywordAbility ;
          rdfs:label "Sunburst" ;
          rdfs:comment """A keyword ability that can have a permanent enter the
battlefield with +1/+1 counters or charge counters on it."""@en .
:Surge rdf:type owl:NamedIndividual ,
                :KeywordAbility ;
       rdfs:label "Surge" ;
       rdfs:comment """A keyword ability that provides an alternative cost to
cast a card if you or one of your teammates has cast another spell in the same
turn."""@en .
:Suspend rdf:type owl:NamedIndividual ,
                  :KeywordAbility ;
         rdfs:label "Suspend" ;
         rdfs:comment """A keyword ability that provides an alternative way to
play a card."""@en .
:Tiered rdf:type owl:NamedIndividual ,
                 :KeywordAbility ;
        rdfs:label "Tiered" ;
        rdfs:comment """A keyword ability found on some modal spells that
requires you to pay an additional cost for the mode you choose."""@en .
:Toxic rdf:type owl:NamedIndividual ,
                :KeywordAbility ;
       rdfs:label "Toxic" ;
       rdfs:comment """A keyword ability that causes a player to get poison
counters due to combat damage from creatures with the ability."""@en .
:Training rdf:type owl:NamedIndividual ,
                   :KeywordAbility ;
          rdfs:label "Training" ;
          rdfs:comment """A keyword ability that means “Whenever this creature
and at least one other creature with power greater than this creature’s power
attack, put a +1/+1 counter on this creature.”"""@en .
:Trample rdf:type owl:NamedIndividual ,
                  :KeywordAbility ;
         rdfs:label "Trample" ;
         rdfs:comment """A keyword ability that modifies how a creature assigns
combat damage."""@en .
:Transfigure rdf:type owl:NamedIndividual ,
                      :KeywordAbility ;
             rdfs:label "Transfigure" ;
             rdfs:comment """A keyword ability that lets a player search their
library for a replacement creature card."""@en .
:Transmute rdf:type owl:NamedIndividual ,
                    :KeywordAbility ;
           rdfs:label "Transmute" ;
           rdfs:comment """A keyword ability that lets a player search their
library for a replacement card."""@en .
:Tribute rdf:type owl:NamedIndividual ,
                  :KeywordAbility ;
         rdfs:label "Tribute" ;
         rdfs:comment """A keyword ability that allows an opponent to choose
between a creature entering the battlefield with +1/+1 counters or an additional
ability."""@en .
:UmbraArmor rdf:type owl:NamedIndividual ,
                     :KeywordAbility ;
            rdfs:label "Umbra Armor" ;
            rdfs:comment """A keyword ability that allows an Aura to protect the
permanent it’s enchanting."""@en .
:Undaunted rdf:type owl:NamedIndividual ,
                    :KeywordAbility ;
           rdfs:label "Undaunted" ;
           rdfs:comment """A keyword ability that reduces the cost of a spell
based on the number of opponents you have."""@en .
:Undying rdf:type owl:NamedIndividual ,
                  :KeywordAbility ;
         rdfs:label "Undying" ;
         rdfs:comment """A keyword ability that can return a creature from the
graveyard to the battlefield."""@en .
:Unearth rdf:type owl:NamedIndividual ,
                  :KeywordAbility ;
         rdfs:label "Unearth" ;
         rdfs:comment """A keyword ability that lets a player return a creature
card from their graveyard to the battlefield."""@en .
:Unleash rdf:type owl:NamedIndividual ,
                  :KeywordAbility ;
         rdfs:label "Unleash" ;
         rdfs:comment """A keyword ability that allows a creature to enter the
battlefield with a +1/+1 counter on it and stops it from blocking if it has a
+1/+1 counter on it."""@en .
:Vanishing rdf:type owl:NamedIndividual ,
                    :KeywordAbility ;
           rdfs:label "Vanishing" ;
           rdfs:comment """A keyword ability that limits how long a permanent
remains on the battlefield."""@en .
:Vigilance rdf:type owl:NamedIndividual ,
                    :KeywordAbility ;
           rdfs:label "Vigilance" ;
           rdfs:comment """A keyword ability that lets a creature attack without
tapping."""@en .
:Visit rdf:type owl:NamedIndividual ,
                :KeywordAbility ;
       rdfs:label "Visit" ;
