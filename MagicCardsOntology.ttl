# --- Legalities ---
:Legal rdf:type :Legality ;
       rdfs:label "Legal" ;
       rdfs:comment "The card is fully legal to play in the format."@en .
:NotLegal rdf:type :Legality ;
          rdfs:label "Not Legal" ;
          rdfs:comment "The card is not legal because it was never printed in a set legal for this format."@en .
:Banned rdf:type :Legality ;
        rdfs:label "Banned" ;
        rdfs:comment "The card is explicitly forbidden from being played in the format."@en .
:Restricted rdf:type :Legality ;
            rdfs:label "Restricted" ;
            rdfs:comment "The card is limited to a single copy per deck in the format (primarily Vintage)."@en .


#################################################
#
#  Constraints
#
#################################################

# --- Land Constraints ---
:LandCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Land
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Basic :Snow :Legendary )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "3"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Land Card" ;
    rdfs:comment "A class representing any card with the Land card type to enforce constraints."@en .

# --- Artifact Constraints ---
:ArtifactCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Artifact
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Legendary :Host :Snow )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "3"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :ArtifactTypes
    ] ;
    rdfs:label "Artifact Card" ;
    rdfs:comment "A class representing any card with the Artifact card type to enforce constraints."@en .

# --- Enchantment Constraints ---
:EnchantmentCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Enchantment
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Legendary :Snow :World )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "3"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :EnchantmentTypes
    ] ;
    rdfs:label "Enchantment Card" ;
    rdfs:comment "A class representing any card with the Enchantment card type to enforce constraints."@en .

# --- Planeswalker Constraints ---
:PlaneswalkerCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasCardType ;
                owl:hasValue :Planeswalker
            ]
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasSuperType ;
                owl:hasValue :Legendary
            ]
        )
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :PlaneswalkerTypes
    ] ;
    rdfs:label "Planeswalker Card" ;
    rdfs:comment "A class representing planeswalker cards, which must have the Legendary supertype."@en .

# --- Spell Constraints ---
:SpellCardConstraint rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Instant :Sorcery )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Legendary :Snow )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "2"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :SpellTypes
    ] ;
    rdfs:label "Spell Card Constraint" ;
    rdfs:comment "A class representing any card with the Instant or Sorcery card type to enforce constraints."@en .

# --- Basic Land Constraints ---
:BasicLandCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :LandCard
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasSuperType ;
                owl:hasValue :Basic
            ]
        )
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :BasicLandTypes
    ] ;
    rdfs:label "Basic Land Card" ;
    rdfs:comment "A class representing land cards with the Basic supertype."@en .


