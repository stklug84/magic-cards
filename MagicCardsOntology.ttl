@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

@prefix : <urn:stklug84:MagicCardsOntology:2024-02-13#> .
@base <urn:stklug84:MagicCardsOntology:2024-02-13#> .


<urn:stklug84:MagicCardsOntology:2026-02-14#> rdf:type owl:Ontology ;
                                              rdfs:label "Magic Cards Ontology" ;
                                              rdfs:comment "A detailed ontology for Magic: The Gathering cards, decks, and attributes."@en .

#################################################
#
#  Class Definitions
#
#################################################

:Card rdf:type owl:Class ;
      rdfs:label "Magic Card" ;
      rdfs:comment "A specific Magic: The Gathering card"@en .

:Deck rdf:type owl:Class ;
      rdfs:label "Deck" ;
      rdfs:comment "A generic constructed or limited deck"@en .

:CommanderDeck rdf:type owl:Class ;
               rdfs:subClassOf :Deck ;
               rdfs:label "Commander Deck" ;
               rdfs:comment "A constructed deck for the Commander format"@en .

:StandardDeck rdf:type owl:Class ;
              rdfs:subClassOf :Deck ;
              rdfs:label "Standard Deck" ;
              rdfs:comment "A constructed deck for the Standard format"@en .

:ModernDeck rdf:type owl:Class ;
            rdfs:subClassOf :Deck ;
            rdfs:label "Modern Deck" ;
            rdfs:comment "A constructed deck for the Modern format"@en .

:PioneerDeck rdf:type owl:Class ;
             rdfs:subClassOf :Deck ;
             rdfs:label "Pioneer Deck" ;
             rdfs:comment "A constructed deck for the Pioneer format"@en .

:LegacyDeck rdf:type owl:Class ;
            rdfs:subClassOf :Deck ;
            rdfs:label "Legacy Deck" ;
            rdfs:comment "A constructed deck for the Legacy format"@en .

:VintageDeck rdf:type owl:Class ;
             rdfs:subClassOf :Deck ;
             rdfs:label "Vintage Deck" ;
             rdfs:comment "A constructed deck for the Vintage format"@en .

:PauperDeck rdf:type owl:Class ;
            rdfs:subClassOf :Deck ;
            rdfs:label "Pauper Deck" ;
            rdfs:comment "A constructed deck for the Pauper format"@en .

:Color rdf:type owl:Class ;
       owl:equivalentClass [
           rdf:type owl:Class ;
           owl:oneOf (
               :White
               :Blue
               :Black
               :Red
               :Green
               :Colorless
           )
       ] ;
       rdfs:label "Color" ;
       rdfs:comment " The five colors of Magic plus Colorless"@en .

# Note: It is called supertype in the rules, but it is not a real supertype
#       but should be considered as a modifier of the card type.
:SuperType rdf:type owl:Class ;
           owl:equivalentClass [
               rdf:type owl:Class ;
               owl:oneOf (
                   :Basic
                   :Elite
                   :Host
                   :Legendary
                   :Ongoing
                   :Snow
                   :Token
                   :World
               )
           ] ;
           rdfs:label "Super Type" ;
           rdfs:comment "An additional classification that precedes the card type and provides additional rules or characteristics to a card."@en .

:CardType rdf:type owl:Class ;
          owl:equivalentClass [
              rdf:type owl:Class ;
              owl:oneOf (
                  :Artifact
                  :Battle
                  :Conspiracy
                  :Creature
                  :Dungeon
                  :Enchantment
                  :Instant
                  :Kindred
                  :Land
                  :Phenomenon
                  :Plane
                  :Planeswalker
                  :Scheme
                  :Sorcery
                  :Summon
                  :Vanguard
              )
          ] ;
          rdfs:label "Card Type" ;
          rdfs:comment "The primary classification of a card."@en .

:SubType rdf:type owl:Class ;
         rdfs:label "Sub Type" ;
         rdfs:comment "A sub-classification that provides more specific categorical information to the primary card type."@en .

:ArtifactTypes rdf:type owl:Class ;
               rdfs:subClassOf :SubType ;
               owl:equivalentClass [
                   rdf:type owl:Class ;
                   owl:oneOf (
                       :Attraction
                       :Blood
                       :Bobblehead
                       :Clue
                       :Contraption
                       :Equipment
                       :Food
                       :Fortification
                       :Gold
                       :Incubator
                       :Infinity
                       :Junk
                       :Lander
                       :Map
                       :Mutagen
                       :Powerstone
                       :Spacecraft
                       :Stone
                       :Treasure
                       :Vehicle
                   )
               ] ;
               rdfs:label "Artifact Types" ;
               rdfs:comment "A subtype that's correlated to the artifact card type."@en .

:EnchantmentTypes rdf:type owl:Class ;
                  rdfs:subClassOf :SubType ;
                  owl:equivalentClass [
                      rdf:type owl:Class ;
                      owl:oneOf (
                          :Aura
                          :Background
                          :Cartouche
                          :Case
                          :Class
                          :Curse
                          :Role
                          :Room
                          :Rune
                          :Saga
                          :Shard
                          :Shrine
                      )
                  ] ;
                  rdfs:label "Enchantment Types" ;
                  rdfs:comment "A subtype that's correlated to the enchantment card type."@en .

:PlaneswalkerTypes rdf:type owl:Class ;
                   rdfs:subClassOf :SubType ;
                   owl:equivalentClass [
                       rdf:type owl:Class ;
                       owl:oneOf (
                           :Ajani :Aminatou :Angrath :Arlinn :Ashiok :Bahamut
                           :Basri :Bolas :Calix :Chandra :Comet :Dack :Dakkon
                           :Daretti :Davriel :Dihada :Domri :Dovin :Ellywick
                           :Elminster :Elspeth :Estrid :Freyalise :Garruk
                           :Gideon :Grist :Guff :Huatli :Jace :Jared :Jaya
                           :Jeska :Kaito :Karn :Kasmina :Kaya :Kiora :Koth
                           :Liliana :Lolth :Lukka :Minsc :Mordenkainen :Nahiri
                           :Narset :Niko :Nissa :Nixilis :Oko :Quintorius :Ral
                           :Rowan :Saheeli :Samut :Sarkhan :Serra :Sivitri
                           :Sorin :Szat :Tamiyo :Tasha :Teferi :Teyo :Tezzeret
                           :Tibalt :Tyvar :Ugin :Urza :Venser :Vivien :Vraska
                           :Vronos :Will :Windgrace :Wrenn :Xenagos :Yanggu
                           :Yanling :Zariel
                       )
                   ] ;
                   rdfs:label "Planeswalker Types" ;
                   rdfs:comment "A subtype that's correlated to the planeswalker card type."@en .

:SpellTypes rdf:type owl:Class ;
            rdfs:subClassOf :SubType ;
            owl:equivalentClass [
                rdf:type owl:Class ;
                owl:oneOf (
                    :Adventure
                    :Arcane
                    :Lesson
                    :Omen
                    :Trap
                )
            ] ;
            rdfs:label "Spell Types" ;
            rdfs:comment "A subtype that's correlated to the instant or sorcery card type."@en .

:CreatureType rdf:type owl:Class ;
               rdfs:subClassOf :SubType ;
               owl:equivalentClass [
                   rdf:type owl:Class ;
                   owl:oneOf (
                       :Advisor :Aetherborn :Alien :Ally :Angel :Antelope
                       :Ape :Archer :Archon :Armadillo :Army :Artificer
                       :Assassin :AssemblyWorker :Astartes :Atog :Aurochs :Avatar
                       :Azra :Badger :Balloon :Barbarian :Bard :Basilisk
                       :Bat :Bear :Beast :Beaver :Beeble :Beholder
                       :Berserker :Bird :Bison :Blinkmoth :Boar :Bringer
                       :Brushwagg :Camarid :Camel :Capybara :Caribou :Carrier
                       :Cat :Centaur :Child :Chimera :Citizen :Cleric
                       :Clown :Cockatrice :Construct :Coward :Coyote :Crab
                       :Crocodile :Custodes :Cyberman :Cyclops :Ctan :Dalek
                       :Dauthi :Demigod :Demon :Deserter :Detective :Devil
                       :Dinosaur :Djinn :Doctor :Dog :Dragon :Drake
                       :Dreadnought :Drix :Drone :Druid :Dryad :Dwarf
                       :Echidna :Efreet :Egg :Elder :Eldrazi :Elemental
                       :Elephant :Elf :Elk :Employee :Eye :Faerie
                       :Ferret :Fish :Flagbearer :Fox :Fractal :Frog
                       :Fungus :Gamer :Gargoyle :Germ :Giant :Gith
                       :Glimmer :Gnoll :Gnome :Goat :Goblin :God
                       :Golem :Gorgon :Graveborn :Gremlin :Griffin :Guest
                       :Hag :Halfling :Hamster :Harpy :Hedgehog :Hellion
                       :Hero :Hippo :Hippogriff :Homarid :Homunculus :Horror
                       :Horse :Human :Hydra :Hyena :Illusion :Imp
                       :Incarnation :Inkling :Inquisitor :Insect :Jackal :Jellyfish
                       :Juggernaut :Kangaroo :Kavu :Kirin :Kithkin :Knight
                       :Kobold :Kor :Kraken :Lamia :Lammasu :Leech
                       :Lemur :Leviathan :Lhurgoyf :Licid :Lizard :Llama
                       :Lobster :Manticore :Masticore :Mercenary :Merfolk :Metathran
                       :Minion :Minotaur :Mite :Mole :Monger :Mongoose
                       :Monk :Monkey :Moogle :Moonfolk :Mount :Mouse
                       :Mutant :Myr :Mystic :Nautilus :Necron :Nephilim
                       :Nightmare :Nightstalker :Ninja :Noble :Noggle :Nomad
                       :Nymph :Octopus :Ogre :Ooze :Orb :Orc
                       :Orgg :Otter :Ouphe :Ox :Oyster :Pangolin
                       :Peasant :Pegasus :Pentavite :Performer :Pest :Phelddagrif
                       :Phoenix :Phyrexian :Pilot :Pincher :Pirate :Plant
                       :Platypus :Porcupine :Possum :Praetor :Primarch :Prism
                       :Processor :Qu :Rabbit :Raccoon :Ranger :Rat
                       :Rebel :Reflection :Rhino :Rigger :Robot :Rogue
                       :Sable :Salamander :Samurai :Sand :Saproling :Satyr
                       :Scarecrow :Scientist :Scion :Scorpion :Scout :Sculpture
                       :Seal :Serf :Serpent :Servo :Shade :Shaman
                       :Shapeshifter :Shark :Sheep :Siren :Skeleton :Skunk
                       :Slith :Sliver :Sloth :Slug :Snail :Snake
                       :Soldier :Soltari :Sorcerer :Spawn :Specter :Spellshaper
                       :Sphinx :Spider :Spike :Spirit :Splinter :Sponge
                       :Squid :Squirrel :Starfish :Surrakar :Survivor :Symbiote
                       :Synth :Tentacle :Tetravite :Thalakos :Thopter :Thrull
                       :Tiefling :TimeLord :Toy :Treefolk :Trilobite :Triskelavite
                       :Troll :Turtle :Tyranid :Unicorn :Utrom :Vampire
                       :Varmint :Vedalken :Villain :Volver :Wall :Walrus
                       :Warlock :Warrior :Weasel :Weird :Werewolf :Whale
                       :Wizard :Wolf :Wolverine :Wombat :Worm :Wraith
                       :Wurm :Yeti :Zombie :Zubera
                   )
               ] ;
               rdfs:label "Creature Type" ;
               rdfs:comment "A subtype that's correlated to the creature card type."@en .

:LandTypes rdf:type owl:Class ;
           rdfs:subClassOf :SubType ;
           owl:equivalentClass [
               rdf:type owl:Class ;
               owl:oneOf (
                :Cave
                :Desert
                :Gate
                :Lair
                :Locus
                :Mine
                :Planet
                :PowerPlant
                :Sphere
                :Tower
                :Town
                :Urzas
               )
           ] ;
           rdfs:label "Land Types" ;
           rdfs:comment "A subtype that's correlated to the land card type."@en .

:BasicLandTypes rdf:type owl:Class ;
                rdfs:subClassOf :LandTypes ;
                owl:equivalentClass [
                    rdf:type owl:Class ;
                    owl:oneOf (
                        :Plains
                        :Island
                        :Swamp
                        :Mountain
                        :Forest
                    )
                ] ;
                rdfs:label "Basic Land Types" ;
                rdfs:comment "Basic land types implicitly define the color of a land card"

:PlanarType rdf:type owl:Class ;
           rdfs:subClassOf :SubType ;
           owl:equivalentClass [
               rdf:type owl:Class ;
               owl:oneOf (
                   :Alara :AlfavaMetraxis :Amonkhet :AndrozaniMinor :Antausia :Apalapucia
                   :Arcavios :Arkhos :Avishkar :Azgol :Belenon :BolassMeditationRealm
                   :Capenna :Cridhe :Darillium :Dominaria :Earth :Echoir
                   :Eldraine :Equilor :Ergamon :Fabacin :Fiora :Gallifrey
                   :Gargantikar :Gobakhan :HorseheadNebula :Ikoria :Innistrad :Iquatana
                   :Ir :Ixalan :Kaldheim :Kamigawa :Kandoka :Karsus
                   :Kephalai :Kinshala :Kolbahan :Kylem :Kyneth :Lorwyn
                   :Luvion :Mars :Mercadia :Mirrodin :Moag :Mongseng
                   :Moon :Muraganda :Necros :NewEarth :NewPhyrexia :OutsideMuttersSpiral
                   :Phyrexia :Pyrulea :Rabiah :Rath :Ravnica :Regatha
                   :Segovia :SerrasRealm :Shadowmoor :Shandalar :Shenmeng :Skaro
                   :Spacecraft :Tarkir :TheAbyss :TheDalekAsylum :TheLibrary :Theros
                   :Time :Trenzalore :Ulgrotha :UnknownPlanet :Valla :Vryn
                   :Wildfire :Xerex :Zendikar :Zhalfir
               )
           ] ;
           rdfs:label "Planar Types" ;
           rdfs:comment "A subtype that's correlated to the plane card type."@en .

:DungeonType rdf:type owl:Class ;
               rdfs:subClassOf :SubType ;
               owl:equivalentClass [
                   rdf:type owl:Class ;
                   owl:oneOf (
                       :Undercity
                   )
               ] ;
               rdfs:label "Dungeon Types" ;
               rdfs:comment "A subtype that's correlated to the dungeon card type."@en .

:BattleType rdf:type owl:Class ;
               rdfs:subClassOf :SubType ;
               owl:equivalentClass [
                   rdf:type owl:Class ;
                   owl:oneOf (
                       :Siege
                   )
               ] ;
               rdfs:label "Battle Types" ;
               rdfs:comment "A subtype that's correlated to the battle card type."@en .

:Rarity rdf:type owl:Class ;
        owl:equivalentClass [
            rdf:type owl:Class ;
            owl:oneOf (
                :Common
                :Uncommon
                :Rare
                :MythicRare
                :Special
                :Bonus
                :Promo
                :Land
            )
        ] ;
        rdfs:label "Rarity" ;
        rdfs:comment "Rarity of a Magic card"@en .

:Set rdf:type owl:Class ;
     owl:hasKey ( :setName ) ;
     owl:hasKey ( :setCode ) ;
     rdfs:label "Set" ;
     rdfs:comment "A Magic: The Gathering expansion or set"@en .

:Language rdf:type owl:Class ;
          owl:equivalentClass [
              rdf:type owl:Class ;
              owl:oneOf (
                  :English
                  :German
                  :Japanese
                  :Spanish
              )
          ] ;
          rdfs:label "Language" ;
          rdfs:comment "Language of the card print"@en .

:Legality rdf:type owl:Class ;
          owl:equivalentClass [
              rdf:type owl:Class ;
              owl:oneOf (
                  :Legal
                  :NotLegal
                  :Banned
                  :Restricted
              )
          ] ;
          rdfs:label "Legality" ;
          rdfs:comment "The tournament legality status of a card."@en .

:Format rdf:type owl:Class ;
        owl:equivalentClass [
            rdf:type owl:Class ;
            owl:oneOf (
                :Alchemy
                :Archenemy
                :ArchenemyCommander
                :BoosterDraft
                :Brawl
                :Commander
                :Commander1v1
                :CommanderLimited
                :Conspiracy
                :Freeform
                :Historic
                :Legacy
                :Limited
                :Modern
                :MomirBasic
                :Oathbreaker
                :Pauper
                :PickTwoDraft
                :Pioneer
                :Planechase
                :SealedDeck
                :Standard
                :TeamBoosterDraft
                :TeamSealedDeck
                :Timeless
                :TwoHeadedGiant
                :Vintage
            )
        ] ;
        rdfs:label "Format" ;
        rdfs:comment "A game format like Commander, Standard, etc."@en .

:LegalityMapping rdf:type owl:Class ;
                 rdfs:label "Legality Mapping" ;
                 rdfs:comment "An intermediate class associating a Card, a Format, and a Legality Status"@en .

:Ruling rdf:type owl:Class ;
        rdfs:label "Ruling" ;
        rdfs:comment "Specific rules clarifications for a card"@en .


#################################################
#
#  Property Definitions
#
#################################################

# --- Data Properties ---

:cardName rdf:type owl:DatatypeProperty ;
      rdfs:domain :Card ;
      rdfs:range xsd:string ;
      rdfs:label "Card Name" ;
      rdfs:comment "The name of the card"@en .

:manaCost rdf:type owl:DatatypeProperty ;
          rdfs:domain :Card ;
          rdfs:range xsd:string ;
          rdfs:label "Mana Cost" ;
          rdfs:comment "The mana symbols required to cast the card, where each symbol is represented by a string like {W}, {U}, {B}, {R}, {G}, {C}, {X}, or {0}"@en .

:manaValue rdf:type owl:DatatypeProperty ;
           rdfs:domain :Card ;
           rdfs:range xsd:integer ;
           rdfs:label "Mana Value" ;
           rdfs:comment "Total amount of mana required to casts the spell. Formerly known as converted mana cost (CMC)"@en .

:printedText rdf:type owl:DatatypeProperty ;
            rdfs:domain :Card ;
            rdfs:range xsd:string ;
            rdfs:label "Printed Text" ;
            rdfs:comment " The text printed on the card"@en .

:oracleText rdf:type owl:DatatypeProperty ;
            rdfs:domain :Card ;
            rdfs:range xsd:string ;
            rdfs:label "Oracle Text" ;
            rdfs:comment " The official rules text of the card"@en .

:flavorText rdf:type owl:DatatypeProperty ;
            rdfs:domain :Card ;
            rdfs:range xsd:string ;
            rdfs:label "Flavor Text" ;
            rdfs:comment "The flavor text of the card"@en .

:artist rdf:type owl:DatatypeProperty ;
        rdfs:domain :Card ;
        rdfs:range xsd:string ;
        rdfs:label "Artist" ;
        rdfs:comment "The artist who illustrated the card"@en .

:power rdf:type owl:DatatypeProperty ;
       rdfs:domain :Card ;
       rdfs:range xsd:integer ;
       rdfs:comment "Power of a creature card (string to handle *, 1+*, etc.)"@en .

:toughness rdf:type owl:DatatypeProperty ;
           rdfs:domain :Card ;
           rdfs:range xsd:integer ;
           rdfs:comment "Toughness of a creature card"@en .

:loyalty rdf:type owl:DatatypeProperty ;
         rdfs:domain :Card ;
         rdfs:range xsd:integer ;
         rdfs:comment "Starting loyalty of a Planeswalker"@en .

:setName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
         rdfs:domain :Set ;
         rdfs:range xsd:string ;
         rdfs:label "Set Name" ;
         rdfs:comment "The full name of the Magic set"@en .

:setCode rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
         rdfs:domain :Set ;
         rdfs:range xsd:string ;
         rdfs:label "Set Code" ;
         rdfs:comment "The 3-letter code of the Magic set"@en .

:cardNumber rdf:type owl:DatatypeProperty ;
            rdfs:domain :Card ;
            rdfs:range xsd:integer ;
            rdfs:label "Card Number" ;
            rdfs:comment "The collector number of the card in a set when totals are not provided"@en .

:cardNumberString rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Card ;
                  rdfs:range xsd:string ;
                  rdfs:label "Card Number String" ;
                  rdfs:comment "The collector number of the card in a set as a string (e.g., '123a')"@en .

:cardCount rdf:type owl:DatatypeProperty ;
           rdfs:domain [
               rdf:type owl:Class ;
               owl:unionOf ( :Card :Set )
           ] ;
           rdfs:range xsd:integer ;
           rdfs:label "Card Count" ;
           rdfs:comment "The total number of cards in the set"@en .

:rulingText rdf:type owl:DatatypeProperty ;
            rdfs:domain :Ruling ;
            rdfs:range xsd:string ;
            rdfs:label "Ruling Text" ;
            rdfs:comment "The ruling text of the card"@en .

:rulingDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :Ruling ;
            rdfs:range xsd:date ;
            rdfs:label "Ruling Date" ;
            rdfs:comment "The date of the ruling"@en .

:gathererUrl rdf:type owl:DatatypeProperty ;
             rdfs:domain :Card ;
             rdfs:range xsd:anyURI ;
             rdfs:label "Gatherer URL" ;
             rdfs:comment "The URL to the card's entry on gatherer.wizards.com"@en .

:releaseDate rdf:type owl:DatatypeProperty ;
             rdfs:domain :Set ;
             rdfs:range xsd:date ;
             rdfs:label "Release Date" ;
             rdfs:comment "The release date of the set"@en .

# --- Object Properties ---

:hasColorIdentity rdf:type owl:ObjectProperty ;
                  rdfs:domain :Card ;
                  rdfs:range :Color ;
                  rdfs:label "Color Identity" ;
                  rdfs:comment "The color identity of the card for Commander deck building"@en .

:hasSuperType rdf:type owl:ObjectProperty ;
              rdfs:domain :Card ;
              rdfs:range :SuperType ;
              rdfs:label "Has Super Type" ;
              rdfs:comment "The super type of the card"@en .

:isPermanent rdf:type owl:DatatypeProperty ;
             rdfs:domain :CardType ;
             rdfs:range xsd:boolean ;
             rdfs:label "Is Permanent" ;
             rdfs:comment "Indicates whether the card type is a permanent (true) or non-permanent (false)."@en .

:hasCardType rdf:type owl:ObjectProperty ;
             rdfs:domain :Card ;
             rdfs:range :CardType ;
             rdfs:label "Has Card Type" ;
             rdfs:comment "The card type of the card"@en .

:hasSubType rdf:type owl:ObjectProperty ;
            rdfs:domain :Card ;
            rdfs:range :SubType ;
            rdfs:label "Has Sub Type" ;
            rdfs:comment "The sub type of the card"@en .

:hasRarity rdf:type owl:ObjectProperty ;
           rdfs:domain :Card ;
           rdfs:range :Rarity ;
           rdfs:label "Rarity" ;
           rdfs:comment "The rarity of the card"@en .

:hasSet rdf:type owl:ObjectProperty ;
        rdfs:domain :Card ;
        rdfs:range :Set ;
        rdfs:label "Set" ;
        rdfs:comment "The expansion set the card belongs to"@en .

:hasLanguage rdf:type owl:ObjectProperty ;
             rdfs:domain :Card ;
             rdfs:range :Language ;
             rdfs:label "Language" ;
             rdfs:comment "The language of the card print"@en .

:hasLegality rdf:type owl:ObjectProperty ;
             rdfs:domain :Card ;
             rdfs:range :LegalityMapping ;
             rdfs:label "Has Legality" ;
             rdfs:comment "Connects a card to its format legality statuses"@en .

:inFormat rdf:type owl:ObjectProperty ;
          rdfs:domain :LegalityMapping ;
          rdfs:range :Format ;
          rdfs:label "In Format" ;
          rdfs:comment "The format a legality mapping applies to"@en .

:hasLegalityStatus rdf:type owl:ObjectProperty ;
                   rdfs:domain :LegalityMapping ;
                   rdfs:range :Legality ;
                   rdfs:label "Has Legality Status" ;
                   rdfs:comment "The specific legality status applied"@en .

:hasRuling rdf:type owl:ObjectProperty ;
           rdfs:domain :Card ;
           rdfs:range :Ruling ;
           rdfs:label "Has Ruling" ;
           rdfs:comment "The ruling for the card"@en .

:isInDeck rdf:type owl:ObjectProperty ;
          rdfs:domain :Card ;
          rdfs:range :Deck ;
          rdfs:label "Is In Deck" ;
          rdfs:comment "Indicates a card is included in a deck"@en .

:isCommanderOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :isInDeck ;
               rdfs:domain :Card ;
               rdfs:range :CommanderDeck ;
               rdfs:label "Is Commander Of" ;
               rdfs:comment "Identifies the commander(s) of a deck"@en .

#################################################
#
#  Individuals
#
#################################################

# --- Colors ---
:White rdf:type :Color ;
       rdfs:label "White" ;
       rdfs:comment "The color of law, order, and structure, typically powered by Plains."@en .
:Blue rdf:type :Color ;
      rdfs:label "Blue" ;
      rdfs:comment "The color of logic, knowledge, and illusion, typically powered by Islands."@en .
:Black rdf:type :Color ;
       rdfs:label "Black" ;
       rdfs:comment "The color of death, ambition, and sacrifice, typically powered by Swamps."@en .
:Red rdf:type :Color ;
     rdfs:label "Red" ;
     rdfs:comment "The color of chaos, emotion, and impulse, typically powered by Mountains."@en .
:Green rdf:type :Color ;
       rdfs:label "Green" ;
       rdfs:comment "The color of nature, instinct, and interdependence, typically powered by Forests."@en .
:Colorless rdf:type :Color ;
           rdfs:label "Colorless" ;
           rdfs:comment "Cards and mana that have no color affiliation."@en .

# --- Rarities ---
:Common rdf:type :Rarity ;
        rdfs:label "Common" ;
        rdfs:comment "The most frequently found cards in a booster pack, denoted by a black expansion symbol."@en .
:Uncommon rdf:type :Rarity ;
          rdfs:label "Uncommon" ;
          rdfs:comment "Cards that appear less frequently than Commons, denoted by a silver expansion symbol."@en .
:Rare rdf:type :Rarity ;
      rdfs:label "Rare" ;
      rdfs:comment "Cards that typically appear once per regular booster pack, denoted by a gold expansion symbol."@en .
:MythicRare rdf:type :Rarity ;
            rdfs:label "Mythic Rare" ;
            rdfs:comment "The rarest standard cards, typically appearing once in every eight packs, denoted by an orange-red expansion symbol."@en .
:Special rdf:type :Rarity ;
         rdfs:label "Special" ;
         rdfs:comment "A rarity used for specialty subsets of cards such as Timeshifted cards, often denoted by a purple expansion symbol."@en .
:Bonus rdf:type :Rarity ;
       rdfs:label "Bonus" ;
       rdfs:comment "A rarity level used (e.g. by Scryfall) for special inserts or promotional materials not part of the standard set."@en .
:Promo rdf:type :Rarity ;
       rdfs:label "Promo" ;
       rdfs:comment "Cards distributed at promotional events like Prereleases or FNM, often featuring alternate art."@en .
:Land rdf:type :Rarity ;
      rdfs:label "Land" ;
      rdfs:comment "A rarity designation used explicitly for basic lands in booster packs."@en .

# --- Super Types ---
:Basic rdf:type :SuperType ;
       rdfs:label "Basic" ;
       rdfs:comment "A supertype that removes the four-of deck limit for a card."@en .
:Elite rdf:type :SuperType ;
       rdfs:label "Elite" ;
       rdfs:comment "A supertype denoting powerful versions of enemies, often used in supplementary sets."@en .
:Host rdf:type :SuperType ;
      rdfs:label "Host" ;
      rdfs:comment "A supertype used on silver-bordered and un-set creatures that can be augmented."@en .
:Legendary rdf:type :SuperType ;
           rdfs:label "Legendary" ;
           rdfs:comment "A supertype representing specific, unique entities. Can only exist as one on the battlefield at a time."@en .
:Ongoing rdf:type :SuperType ;
         rdfs:label "Ongoing" ;
         rdfs:comment "A supertype used exclusively on scheme cards in the Archenemy format."@en .
:Snow rdf:type :SuperType ;
      rdfs:label "Snow" ;
      rdfs:comment "A supertype representing cold or winter-themed permanents and spells."@en .
:Token rdf:type :SuperType ;
       rdfs:label "Token" ;
       rdfs:comment "A supertype representing permanents that are created during gameplay rather than cast from cards."@en .
:World rdf:type :SuperType ;
       rdfs:label "World" ;
       rdfs:comment "An obsolete supertype representing global enchantments where only one can exist on the battlefield at a time."@en .

# --- Card Types  ---
:Artifact rdf:type :CardType ;
          :isPermanent true ;
          rdfs:label "Artifact" ;
          rdfs:comment "A permanent type representing magical items, constructs, or relics."@en .
:Battle rdf:type :CardType ;
        :isPermanent true ;
        rdfs:label "Battle" ;
        rdfs:comment "A permanent type representing a conflict that can be attacked and defeated for a reward."@en .
:Creature rdf:type :CardType ;
          :isPermanent true ;
          rdfs:label "Creature" ;
          rdfs:comment "A permanent type that can attack and block."@en .
:Enchantment rdf:type :CardType ;
             :isPermanent true ;
             rdfs:label "Enchantment" ;
             rdfs:comment "A permanent type representing lasting magical effects."@en .
:Instant rdf:type :CardType ;
         :isPermanent false ;
         rdfs:label "Instant" ;
         rdfs:comment "A non-permanent spell that can be cast at almost any time."@en .
:Kindred rdf:type :CardType ;
         rdfs:label "Kindred" ;
         rdfs:comment "A card type denoting tribal synergies for non-creature cards. Specifically it allows creatures as subtypes."@en .
:Land rdf:type :CardType ;
      :isPermanent true ;
      rdfs:label "Land" ;
      rdfs:comment "A permanent type that is played rather than cast, used primarily to produce mana."@en .
:Phenomenon rdf:type :CardType ;
             :isPermanent false ;
             rdfs:label "Phenomenon" ;
             rdfs:comment "A multiplayer card type used specifically in the Planechase format."@en .
:Planeswalker rdf:type :CardType ;
              :isPermanent true ;
              rdfs:label "Planeswalker" ;
              rdfs:comment "A permanent type representing powerful conjurers with loyalty abilities."@en .
:Scheme rdf:type :CardType ;
        :isPermanent false ;
        rdfs:label "Scheme" ;
        rdfs:comment "A multiplayer card type used specifically in the Archenemy format."@en .
:Sorcery rdf:type :CardType ;
         :isPermanent false ;
         rdfs:label "Sorcery" ;
         rdfs:comment "A non-permanent spell that can only be cast during a player's main phase."@en .
:Summon rdf:type :CardType ;
        :isPermanent true ;
        rdfs:label "Summon" ;
        rdfs:comment "An obsolete card type formerly used for creature spells."@en .
:Vanguard rdf:type :CardType ;
          :isPermanent false ;
          rdfs:label "Vanguard" ;
          rdfs:comment "A casual card type representing a specific character that modifies starting life and hand size."@en .

# --- Creature Types ---
:Advisor rdf:type :SubType ;
       rdfs:label "Advisor" ;
       rdfs:comment "Individuals who offer counsel, wisdom, and administrative guidance."@en .
:Aetherborn rdf:type :SubType ;
       rdfs:label "Aetherborn" ;
       rdfs:comment "A short-lived being composed of aether, native to Kaladesh."@en .
:Alien rdf:type :SubType ;
       rdfs:label "Alien" ;
       rdfs:comment "An extraterrestrial being from another world or dimension."@en .
:Ally rdf:type :SubType ;
       rdfs:label "Ally" ;
       rdfs:comment "A creature working together with others, often sharing combat strategies."@en .
:Angel rdf:type :SubType ;
       rdfs:label "Angel" ;
       rdfs:comment "A manifestation of white mana, representing purity, law, and justice."@en .
:Antelope rdf:type :SubType ;
       rdfs:label "Antelope" ;
       rdfs:comment "A creature type representing a real-world antelope."@en .
:Ape rdf:type :SubType ;
       rdfs:label "Ape" ;
       rdfs:comment "A creature type representing a real-world ape or monkey."@en .
:Archer rdf:type :SubType ;
       rdfs:label "Archer" ;
       rdfs:comment "A warrior skilled in the use of bows and ranged weapons."@en .
:Archon rdf:type :SubType ;
       rdfs:label "Archon" ;
       rdfs:comment "A mysterious, armor-clad entity of law and justice that typically rides a winged beast."@en .
:Armadillo rdf:type :SubType ;
       rdfs:label "Armadillo" ;
       rdfs:comment "A creature type representing a real-world armadillo."@en .
:Army rdf:type :SubType ;
       rdfs:label "Army" ;
       rdfs:comment "A creature type representing a massive collective force or legion."@en .
:Artificer rdf:type :SubType ;
       rdfs:label "Artificer" ;
       rdfs:comment "A mage or inventor who crafts and manipulates magical artifacts."@en .
:Assassin rdf:type :SubType ;
       rdfs:label "Assassin" ;
       rdfs:comment "A trained killer who strikes with stealth and precision."@en .
:AssemblyWorker rdf:type :SubType ;
       rdfs:label "Assembly-Worker" ;
       rdfs:comment "A mechanical worker originally built in Urza's factories."@en .
:Astartes rdf:type :SubType ;
       rdfs:label "Astartes" ;
       rdfs:comment "Genetically enhanced, power-armored super-soldiers from the Warhammer 40,000 universe."@en .
:Atog rdf:type :SubType ;
       rdfs:label "Atog" ;
       rdfs:comment "A bizarre creature known for devouring unusual materials, such as artifacts or lands."@en .
:Aurochs rdf:type :SubType ;
       rdfs:label "Aurochs" ;
       rdfs:comment "A herd animal reminiscent of ancient, robust cattle."@en .
:Avatar rdf:type :SubType ;
       rdfs:label "Avatar" ;
       rdfs:comment "The physical manifestation of a god, plane, or abstract concept."@en .
:Azra rdf:type :SubType ;
       rdfs:label "Azra" ;
       rdfs:comment "A humanoid race with demonic ancestry, known for their agility and magic, native to Kylem."@en .
:Badger rdf:type :SubType ;
       rdfs:label "Badger" ;
       rdfs:comment "A creature type representing a real-world badger."@en .
:Balloon rdf:type :SubType ;
       rdfs:label "Balloon" ;
       rdfs:comment "A creature type representing an animate or piloted balloon."@en .
:Barbarian rdf:type :SubType ;
       rdfs:label "Barbarian" ;
       rdfs:comment "A fierce, primal warrior who relies on rage and physical might."@en .
:Bard rdf:type :SubType ;
       rdfs:label "Bard" ;
       rdfs:comment "A storyteller, musician, or entertainer who weaves magic into their art."@en .
:Basilisk rdf:type :SubType ;
       rdfs:label "Basilisk" ;
       rdfs:comment "A reptilian beast whose gaze or touch can turn living beings to stone."@en .
:Bat rdf:type :SubType ;
       rdfs:label "Bat" ;
       rdfs:comment "A creature type representing a real-world bat."@en .
:Bear rdf:type :SubType ;
       rdfs:label "Bear" ;
       rdfs:comment "A creature type representing a real-world bear, often a 2/2 creature."@en .
:Beast rdf:type :SubType ;
       rdfs:label "Beast" ;
       rdfs:comment "A feral, untamed creature, often large and associated with green mana."@en .
:Beaver rdf:type :SubType ;
       rdfs:label "Beaver" ;
       rdfs:comment "A creature type representing a real-world beaver."@en .
:Beeble rdf:type :SubType ;
       rdfs:label "Beeble" ;
       rdfs:comment "A small, annoying, pill-shaped creature that swarms and distracts."@en .
:Beholder rdf:type :SubType ;
       rdfs:label "Beholder" ;
       rdfs:comment "A floating aberration with a central eye and eyestalks, originating from Dungeons & Dragons."@en .
:Berserker rdf:type :SubType ;
       rdfs:label "Berserker" ;
       rdfs:comment "A warrior who fights in a state of frenzied, uncontrollable rage."@en .
:Bird rdf:type :SubType ;
       rdfs:label "Bird" ;
       rdfs:comment "A creature type representing a real-world or magical bird."@en .
:Bison rdf:type :SubType ;
       rdfs:label "Bison" ;
       rdfs:comment "A creature type representing a real-world bison."@en .
:Blinkmoth rdf:type :SubType ;
       rdfs:label "Blinkmoth" ;
       rdfs:comment "A small, glowing, artificial moth-like creature from Mirrodin."@en .
:Boar rdf:type :SubType ;
       rdfs:label "Boar" ;
       rdfs:comment "A creature type representing a real-world boar."@en .
:Bringer rdf:type :SubType ;
       rdfs:label "Bringer" ;
       rdfs:comment "A massive elemental manifestation of mana from Mirrodin's core."@en .
:Brushwagg rdf:type :SubType ;
       rdfs:label "Brushwagg" ;
       rdfs:comment "A bizarre creature that rolls into a ball of thorny vines for defense."@en .
:Camarid rdf:type :SubType ;
       rdfs:label "Camarid" ;
       rdfs:comment "A small crustacean-like creature, often a spawn of Homarids."@en .
:Camel rdf:type :SubType ;
       rdfs:label "Camel" ;
       rdfs:comment "A creature type representing a real-world camel."@en .
:Capybara rdf:type :SubType ;
       rdfs:label "Capybara" ;
       rdfs:comment "A creature type representing a real-world capybara."@en .
:Caribou rdf:type :SubType ;
       rdfs:label "Caribou" ;
       rdfs:comment "A creature type representing a real-world caribou."@en .
:Carrier rdf:type :SubType ;
       rdfs:label "Carrier" ;
       rdfs:comment "A creature afflicted with and carrying the Phyrexian plague."@en .
:Cat rdf:type :SubType ;
       rdfs:label "Cat" ;
       rdfs:comment "A feline creature, ranging from domestic cats to leonins and panthers."@en .
:Centaur rdf:type :SubType ;
       rdfs:label "Centaur" ;
       rdfs:comment "A creature with the upper body of a human and the lower body of a horse."@en .
:Child rdf:type :SubType ;
       rdfs:label "Child" ;
       rdfs:comment "A youth or infant entity."@en .
:Chimera rdf:type :SubType ;
       rdfs:label "Chimera" ;
       rdfs:comment "A hybrid monstrosity created by combining different creatures."@en .
:Citizen rdf:type :SubType ;
       rdfs:label "Citizen" ;
       rdfs:comment "An ordinary inhabitant of a city or society."@en .
:Cleric rdf:type :SubType ;
       rdfs:label "Cleric" ;
       rdfs:comment "A religious figure who channels divine magic for healing and protection."@en .
:Clown rdf:type :SubType ;
       rdfs:label "Clown" ;
       rdfs:comment "An entertainer known for comedic and sometimes unsettling performances."@en .
:Cockatrice rdf:type :SubType ;
       rdfs:label "Cockatrice" ;
       rdfs:comment "A mythical avian-reptilian hybrid with a petrifying touch."@en .
:Construct rdf:type :SubType ;
       rdfs:label "Construct" ;
       rdfs:comment "A type of animated artifact or automaton."@en .
:Coward rdf:type :SubType ;
       rdfs:label "Coward" ;
       rdfs:comment "A creature defined by its fear and reluctance to fight."@en .
:Coyote rdf:type :SubType ;
       rdfs:label "Coyote" ;
       rdfs:comment "A creature type representing a real-world coyote."@en .
:Crab rdf:type :SubType ;
       rdfs:label "Crab" ;
       rdfs:comment "A crustacean creature, often found in coastal and aquatic environments."@en .
:Crocodile rdf:type :SubType ;
       rdfs:label "Crocodile" ;
       rdfs:comment "A large aquatic reptile."@en .
:Custodes rdf:type :SubType ;
       rdfs:label "Custodes" ;
       rdfs:comment "An elite, genetically engineered bodyguard of the Emperor of Mankind."@en .
:Cyberman rdf:type :SubType ;
       rdfs:label "Cyberman" ;
       rdfs:comment "A cold, emotionless cyborg from the Doctor Who universe."@en .
:Cyclops rdf:type :SubType ;
       rdfs:label "Cyclops" ;
       rdfs:comment "A giant with a single eye in the middle of its forehead."@en .
:Ctan rdf:type :SubType ;
       rdfs:label "C’tan" ;
       rdfs:comment "An ancient, god-like star vampire from the Warhammer 40,000 universe."@en .
:Dalek rdf:type :SubType ;
       rdfs:label "Dalek" ;
