    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Legendary :Host :Snow )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "3"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :CreatureType
    ] ;
    rdfs:label "Creature Card" ;
    rdfs:comment "A class representing any card with the Creature card type to enforce constraints."@en .

