:Tap rdf:type :KeywordAction ;
     rdfs:label "Tap" ;
     rdfs:comment "To turn a permanent sideways from an upright position."@en .
:TheRingTemptsYou rdf:type :KeywordAction ;
                  rdfs:label "The Ring Tempts You" ;
                  rdfs:comment """A keyword action that causes a player to
