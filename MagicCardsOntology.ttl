@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

@prefix : <urn:stklug84:MagicCardsOntology:2024-02-13#> .
@base <urn:stklug84:MagicCardsOntology:2024-02-13#> .


<urn:stklug84:MagicCardsOntology:2026-02-14#> rdf:type owl:Ontology ;
                                              rdfs:label "Magic Cards Ontology" ;
                                              rdfs:comment "A detailed ontology for Magic: The Gathering cards, decks, and attributes."@en .

#################################################
#
#  Class Definitions
#
#################################################

:Card rdf:type owl:Class ;
      rdfs:label "Magic Card" ;
      rdfs:comment "A specific Magic: The Gathering card"@en .

:CommanderDeck rdf:type owl:Class ;
               rdfs:label "Commander Deck" ;
               rdfs:comment "A constructed deck for the Commander format"@en .

:Color rdf:type owl:Class ;
       owl:equivalentClass [
           rdf:type owl:Class ;
           owl:oneOf (
               :White
               :Blue
               :Black
               :Red
               :Green
               :Colorless
           )
       ] ;
       rdfs:label "Color" ;
       rdfs:comment " The five colors of Magic plus Colorless"@en .

:Rarity rdf:type owl:Class ;
        owl:equivalentClass [
            rdf:type owl:Class ;
            owl:oneOf (
                :Common
                :Uncommon
                :Rare
                :MythicRare
                :Special
                :Bonus
            )
        ] ;
        rdfs:label "Rarity" ;
        rdfs:comment "Rarity of a Magic card"@en .

:SuperType rdf:type owl:Class ;
           owl:equivalentClass [
               rdf:type owl:Class ;
               owl:oneOf (
                   :Legendary
                   :Snow
               )
           ] ;
           rdfs:label "Super Type" ;
           rdfs:comment "Super types like Legendary, Snow, World, etc."@en .

:CardType rdf:type owl:Class ;
          owl:equivalentClass [
              rdf:type owl:Class ;
              owl:oneOf (
                  :Creature
                  :Artifact
                  :Enchantment
                  :Instant
                  :Sorcery
                  :Land
                  :Planeswalker
              )
          ] ;
          rdfs:label "Card Type" ;
          rdfs:comment "Primary card types like Creature, Instant, Sorcery, etc."@en .

:SubType rdf:type owl:Class ;
         owl:equivalentClass [
             rdf:type owl:Class ;
             owl:oneOf (
                 :Human
                 :Soldier
                 :Wizard
                 :Dragon
                 :Equipment
             )
         ] ;
         rdfs:label "Sub Type" ;
         rdfs:comment "Sub types (Creature types, Artifact types, etc.)"@en .

:Set rdf:type owl:Class ;
     rdfs:label "Set" ;
     rdfs:comment "A Magic: The Gathering expansion or set"@en .

:Language rdf:type owl:Class ;
          rdfs:label "Language" ;
          rdfs:comment "Language of the card print"@en .

:Format rdf:type owl:Class ;
        owl:equivalentClass [
            rdf:type owl:Class ;
            owl:oneOf (
                :Alchemy
                :Archenemy
                :ArchenemyCommander
                :BoosterDraft
                :Brawl
                :Commander
                :Commander1v1
                :CommanderLimited
                :Conspiracy
                :Freeform
                :Historic
                :Legacy
                :Limited
                :Modern
                :MomirBasic
                :Oathbreaker
                :Pauper
                :PickTwoDraft
                :Pioneer
                :Planechase
                :SealedDeck
                :Standard
                :TeamBoosterDraft
                :TeamSealedDeck
                :Timeless
                :TwoHeadedGiant
                :Vintage
            )
        ] ;
        rdfs:label "Format" ;
        rdfs:comment "A game format like Commander, Standard, etc."@en .

:Ruling rdf:type owl:Class ;
        rdfs:label "Ruling" ;
        rdfs:comment "Specific rules clarifications for a card"@en .

#################################################
#
#  Property Definitions
#
#################################################

# --- Data Properties ---

:name rdf:type owl:DatatypeProperty ;
      rdfs:domain :Card ;
      rdfs:range xsd:string ;
      rdfs:label "Card Name" .

:manaCost rdf:type owl:DatatypeProperty ;
          rdfs:domain :Card ;
          rdfs:range xsd:string ;
          rdfs:label "Mana Cost" ;
          rdfs:comment "The mana symbols required to cast the card (e.g., {3}{U}{B})"@en .

:manaValue rdf:type owl:DatatypeProperty ;
           rdfs:domain :Card ;
           rdfs:range xsd:integer ;
           rdfs:label "Mana Value" ;
           rdfs:comment "Converted mana cost (CMC)"@en .

:oracleText rdf:type owl:DatatypeProperty ;
            rdfs:domain :Card ;
            rdfs:range xsd:string ;
            rdfs:label "Oracle Text" ;
            rdfs:comment " The official rules text of the card"@en .

:flavorText rdf:type owl:DatatypeProperty ;
            rdfs:domain :Card ;
            rdfs:range xsd:string ;
            rdfs:label "Flavor Text" .

:power rdf:type owl:DatatypeProperty ;
       rdfs:domain :Card ;
       rdfs:range xsd:string ;
       rdfs:comment "Power of a creature card (string to handle *, 1+*, etc.)"@en .

:toughness rdf:type owl:DatatypeProperty ;
           rdfs:domain :Card ;
           rdfs:range xsd:string ;
           rdfs:comment "Toughness of a creature card"@en .

:loyalty rdf:type owl:DatatypeProperty ;
         rdfs:domain :Card ;
         rdfs:range xsd:string ;
         rdfs:comment "Starting loyalty of a Planeswalker"@en .

:cardNumber rdf:type owl:DatatypeProperty ;
            rdfs:domain :Card ;
            rdfs:range xsd:string ;
            rdfs:label "Card Number" ;
            rdfs:comment "The collector number of the card in a set"@en .

:artist rdf:type owl:DatatypeProperty ;
        rdfs:domain :Card ;
        rdfs:range xsd:string ;
        rdfs:label "Artist" ;
        rdfs:comment "The artist who illustrated the card"@en .

:rulingText rdf:type owl:DatatypeProperty ;
            rdfs:domain :Ruling ;
            rdfs:range xsd:string ;
            rdfs:label "Ruling Text" .

:rulingDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :Ruling ;
            rdfs:range xsd:date ;
            rdfs:label "Ruling Date" .

# --- Object Properties ---

:hasColorIdentity rdf:type owl:ObjectProperty ;
                  rdfs:domain :Card ;
                  rdfs:range :Color ;
                  rdfs:label "Color Identity" ;
                  rdfs:comment "The color identity of the card for Commander deck building"@en .

:hasRarity rdf:type owl:ObjectProperty ;
           rdfs:domain :Card ;
           rdfs:range :Rarity ;
           rdfs:label "Rarity" .

:hasSuperType rdf:type owl:ObjectProperty ;
              rdfs:domain :Card ;
              rdfs:range :SuperType ;
              rdfs:label "Has Super Type" .

:hasCardType rdf:type owl:ObjectProperty ;
             rdfs:domain :Card ;
             rdfs:range :CardType ;
             rdfs:label "Has Card Type" .

:hasSubType rdf:type owl:ObjectProperty ;
            rdfs:domain :Card ;
            rdfs:range :SubType ;
            rdfs:label "Has Sub Type" .

:hasSet rdf:type owl:ObjectProperty ;
        rdfs:domain :Card ;
        rdfs:range :Set ;
        rdfs:label "Set" ;
        rdfs:comment "The expansion set the card belongs to"@en .

:hasLanguage rdf:type owl:ObjectProperty ;
             rdfs:domain :Card ;
             rdfs:range :Language ;
             rdfs:label "Language" .

:legalIn rdf:type owl:ObjectProperty ;
         rdfs:domain :Card ;
         rdfs:range :Format ;
         rdfs:label "Legal In" .

:notLegalIn rdf:type owl:ObjectProperty ;
            rdfs:domain :Card ;
            rdfs:range :Format ;
            rdfs:label "Not Legal In" .

:bannedIn rdf:type owl:ObjectProperty ;
          rdfs:domain :Card ;
          rdfs:range :Format ;
          rdfs:label "Banned In" .

:restrictedIn rdf:type owl:ObjectProperty ;
              rdfs:domain :Card ;
              rdfs:range :Format ;
              rdfs:label "Restricted In" .

:hasRuling rdf:type owl:ObjectProperty ;
           rdfs:domain :Card ;
           rdfs:range :Ruling ;
           rdfs:label "Has Ruling" .

:isInDeck rdf:type owl:ObjectProperty ;
          rdfs:domain :Card ;
          rdfs:range :CommanderDeck ;
          rdfs:label "Is In Deck" ;
          rdfs:comment "Indicates a card is part of the 99 in a Commander deck"@en .

:isCommanderOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :isInDeck ;
               rdfs:domain :Card ;
               rdfs:range :CommanderDeck ;
               rdfs:label "Is Commander Of" ;
               rdfs:comment "Identifies the commander(s) of a deck"@en .

#################################################
#
#  Individuals
#
#################################################

# --- Colors ---
:White rdf:type :Color ; rdfs:label "White" .
:Blue rdf:type :Color ; rdfs:label "Blue" .
:Black rdf:type :Color ; rdfs:label "Black" .
:Red rdf:type :Color ; rdfs:label "Red" .
:Green rdf:type :Color ; rdfs:label "Green" .
:Colorless rdf:type :Color ; rdfs:label "Colorless" .

# --- Rarities ---
:Common rdf:type :Rarity ; rdfs:label "Common" .
:Uncommon rdf:type :Rarity ; rdfs:label "Uncommon" .
:Rare rdf:type :Rarity ; rdfs:label "Rare" .
:MythicRare rdf:type :Rarity ; rdfs:label "Mythic Rare" .
:Special rdf:type :Rarity ; rdfs:label "Special" .
:Bonus rdf:type :Rarity ; rdfs:label "Bonus" .

# --- Languages ---
:English rdf:type :Language ; rdfs:label "English" .
:German rdf:type :Language ; rdfs:label "German" .
:Japanese rdf:type :Language ; rdfs:label "Japanese" .

# --- Formats ---
:Alchemy rdf:type :Format ; rdfs:label "Alchemy" ; rdfs:comment "Digital-only format played on MTG Arena" .
:Archenemy rdf:type :Format ; rdfs:label "Archenemy" ; rdfs:comment "One vs many multiplayer format" .
:ArchenemyCommander rdf:type :Format ; rdfs:label "Archenemy Commander" ; rdfs:comment "Archenemy played with Commander decks" .
:BoosterDraft rdf:type :Format ; rdfs:label "Booster Draft" ; rdfs:comment "Players draft cards from booster packs" .
:Brawl rdf:type :Format ; rdfs:label "Brawl" ; rdfs:comment "Commander variant played on MTG Arena" .
:Commander rdf:type :Format ; rdfs:label "Commander" ; rdfs:comment "100-card singleton multiplayer format" .
:Commander1v1 rdf:type :Format ; rdfs:label "Commander 1v1" ; rdfs:comment "Commander played as a duel" .
:CommanderLimited rdf:type :Format ; rdfs:label "Commander Limited" ; rdfs:comment "Draft or Sealed with Commander rules" .
:Conspiracy rdf:type :Format ; rdfs:label "Conspiracy" ; rdfs:comment "Draft format designed for multiplayer games" .
:Freeform rdf:type :Format ; rdfs:label "Freeform" ; rdfs:comment "Play with any cards in your collection" .
:Historic rdf:type :Format ; rdfs:label "Historic" ; rdfs:comment "Non-rotating digital format on MTG Arena" .
:Legacy rdf:type :Format ; rdfs:label "Legacy" ; rdfs:comment "Eternal format allowing cards from all Magic sets" .
:Limited rdf:type :Format ; rdfs:label "Limited" ; rdfs:comment "Formats where players build decks from opened packs" .
:Modern rdf:type :Format ; rdfs:label "Modern" ; rdfs:comment "Non-rotating format from 8th Edition onwards" .
:MomirBasic rdf:type :Format ; rdfs:label "Momir Basic" ; rdfs:comment "Digital format using Momir Vig avatar" .
:Oathbreaker rdf:type :Format ; rdfs:label "Oathbreaker" ; rdfs:comment "Singleton format with Planeswalker commander and signature spell" .
:Pauper rdf:type :Format ; rdfs:label "Pauper" ; rdfs:comment "Format using only common cards" .
:PickTwoDraft rdf:type :Format ; rdfs:label "Pick-Two Draft" ; rdfs:comment "Special 4-player draft format" .
:Pioneer rdf:type :Format ; rdfs:label "Pioneer" ; rdfs:comment "Non-rotating format from Return to Ravnica onwards" .
:Planechase rdf:type :Format ; rdfs:label "Planechase" ; rdfs:comment "Casual format using oversized planar cards" .
:SealedDeck rdf:type :Format ; rdfs:label "Sealed Deck" ; rdfs:comment "Build a deck from 6 booster packs" .
:Standard rdf:type :Format ; rdfs:label "Standard" ; rdfs:comment "Rotating format using recent sets" .
:TeamBoosterDraft rdf:type :Format ; rdfs:label "Team Booster Draft" ; rdfs:comment "Draft played in teams" .
:TeamSealedDeck rdf:type :Format ; rdfs:label "Team Sealed Deck" ; rdfs:comment "Sealed played in teams" .
:Timeless rdf:type :Format ; rdfs:label "Timeless" ; rdfs:comment "Digital format with no bans on MTG Arena" .
:TwoHeadedGiant rdf:type :Format ; rdfs:label "Two-Headed Giant" ; rdfs:comment "2v2 Team format" .
:Vintage rdf:type :Format ; rdfs:label "Vintage" ; rdfs:comment "Eternal format allowing almost all cards" .

# --- Sets ---
:Commander2017 rdf:type :Set ; rdfs:label "Commander 2017" ; rdfs:comment "C17" .
:Kaldheim rdf:type :Set ; rdfs:label "Kaldheim" ; rdfs:comment "KHM" .
:LimitedEditionAlpha rdf:type :Set ; rdfs:label "Limited Edition Alpha" ; rdfs:comment "LEA" .

# --- Rulings (Examples) ---
:UrDragonRuling1 rdf:type :Ruling ;
                 :rulingDate "2017-08-25"^^xsd:date ;
                 :rulingText "You can't reduce the cost to cast a Dragon spell to less than 0 mana." .

# --- Card Types (Examples) ---
:Creature rdf:type :CardType ; rdfs:label "Creature" .
:Artifact rdf:type :CardType ; rdfs:label "Artifact" .
:Enchantment rdf:type :CardType ; rdfs:label "Enchantment" .
:Instant rdf:type :CardType ; rdfs:label "Instant" .
:Sorcery rdf:type :CardType ; rdfs:label "Sorcery" .
:Land rdf:type :CardType ; rdfs:label "Land" .
:Planeswalker rdf:type :CardType ; rdfs:label "Planeswalker" .

# --- Super Types (Examples) ---
:Legendary rdf:type :SuperType ; rdfs:label "Legendary" .
:Snow rdf:type :SuperType ; rdfs:label "Snow" .

# --- Sub Types (Examples) ---
:Human rdf:type :SubType ; rdfs:label "Human" .
:Soldier rdf:type :SubType ; rdfs:label "Soldier" .
:Wizard rdf:type :SubType ; rdfs:label "Wizard" .
:Dragon rdf:type :SubType ; rdfs:label "Dragon" .
:Equipment rdf:type :SubType ; rdfs:label "Equipment" .

# --- Decks ---

:UrDragonDeck rdf:type :CommanderDeck ;
              rdfs:label "The Ur-Dragon Commander Deck" ;
              rdfs:comment "5-color Dragon Tribal deck"@en .

:LathrilDeck rdf:type :CommanderDeck ;
             rdfs:label "Lathril, Blade of the Elves Commander Deck" ;
             rdfs:comment "Golgari Elfball deck"@en .

# --- Cards ---

:TheUrDragon rdf:type :Card ;
             :name "The Ur-Dragon" ;
             :manaCost "{4}{W}{U}{B}{R}{G}" ;
             :manaValue 9 ;
             :hasSuperType :Legendary ;
             :hasCardType :Creature ;
             :hasSubType :Dragon , :Avatar ;
             :hasColorIdentity :White , :Blue , :Black , :Red , :Green ;
             :hasRarity :MythicRare ;
             :power "10" ;
             :toughness "10" ;
             :oracleText "Eminence — As long as The Ur-Dragon is in the command zone or on the battlefield, other Dragon spells you cast cost {1} less to cast.\nFlying\nWhenever one or more Dragons you control attack, draw that many cards, then you may put a permanent card from your hand onto the battlefield." ;
             :isCommanderOf :UrDragonDeck ;
             :cardNumber "048" ;
             :artist "Jaime Jones" ;
             :hasSet :Commander2017 ;
             :hasLanguage :English ;
             :legalIn :Commander , :Legacy , :Vintage ;
             :notLegalIn :Standard ;
             :hasRuling :UrDragonRuling1 .

:SolRing rdf:type :Card ;
         :name "Sol Ring" ;
         :manaCost "{1}" ;
         :manaValue 1 ;
         :hasCardType :Artifact ;
         :hasColorIdentity :Colorless ;
         :hasRarity :Uncommon ;
         :oracleText "{T}: Add {C}{C}." ;
         :isUsedInDeck :UrDragonDeck , :LathrilDeck ;
         :cardNumber "256" ;
         :artist "Mark Tedin" ;
         :hasSet :LimitedEditionAlpha ;
         :hasLanguage :English ;
         :legalIn :Commander , :Vintage ;
         :restrictedIn :Vintage ;
         :bannedIn :Legacy .

:LathrilBladeOfTheElves rdf:type :Card ;
                        :name "Lathril, Blade of the Elves" ;
                        :manaCost "{2}{B}{G}" ;
                        :manaValue 4 ;
                        :hasSuperType :Legendary ;
                        :hasCardType :Creature ;
                        :hasSubType :Elf , :Noble ;
                        :hasColorIdentity :Black , :Green ;
                        :hasRarity :MythicRare ;
                        :power "2" ;
                        :toughness "3" ;
                        :oracleText "Menace\nWhenever Lathril, Blade of the Elves deals combat damage to a player, create that many 1/1 green Elf Warrior creature tokens.\n{T}, Tap ten untapped Elves you control: Each opponent loses 10 life and you gain 10 life." ;
                        :isCommanderOf :LathrilDeck ;
                        :cardNumber "001" ;
                        :artist "Caroline Gariba" ;
                        :hasSet :Kaldheim ;
                        :hasLanguage :English ;
                        :legalIn :Commander , :Legacy .

:CommandTower rdf:type :Card ;
              :name "Command Tower" ;
              :manaValue 0 ;
              :hasCardType :Land ;
              :hasColorIdentity :Colorless ;
              :hasRarity :Common ;
              :oracleText "{T}: Add one mana of any color in your commander's color identity." ;
              :flavorText "When defeat is near and guidance is scarce, all eyes look in one direction." ;
              :isInDeck :UrDragonDeck , :LathrilDeck ;
              :artist "Ryan Yee" ;
              :hasSet :Commander2017 ;
              :legalIn :Commander .
