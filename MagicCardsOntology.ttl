:PowerPlant rdf:type :SubType ;
            rdfs:label "Power-Plant" ;
            rdfs:comment "A land type, one of the three Urza's land types."@en .
:Sphere rdf:type :SubType ;
        rdfs:label "Sphere" ;
        rdfs:comment
        """A land type representing distinct spherical or layered planar
environments."""@en .
:Swamp rdf:type :SubType ;
       rdfs:label "Swamp" ;
       rdfs:comment
       """A basic land type that inherently produces black mana."""@en .
:Tower rdf:type :SubType ;
       rdfs:label "Tower" ;
       rdfs:comment "A land type, one of the three Urza's land types."@en .
:Town rdf:type :SubType ;
      rdfs:label "Town" ;
      rdfs:comment "A land type representing a settlement or community."@en .
:Urzas rdf:type :SubType ;
       rdfs:label "Urza's" ;
       rdfs:comment
       """A land type representing an association with the legendary artificer
Urza."""@en .

# --- Formats ---
:Alchemy rdf:type :Format ;
         rdfs:label "Alchemy" ;
         rdfs:comment "Digital-only format played on MTG Arena" .
:Archenemy rdf:type :Format ;
           rdfs:label "Archenemy" ;
           rdfs:comment "One vs many multiplayer format" .
:ArchenemyCommander rdf:type :Format ;
                    rdfs:label "Archenemy Commander" ;
                    rdfs:comment "Archenemy played with Commander decks" .
:BoosterDraft rdf:type :Format ;
              rdfs:label "Booster Draft" ;
              rdfs:comment
              """Players draft cards from booster packs and build a 40 card
deck""" .
:Brawl rdf:type :Format ;
       rdfs:label "Brawl" ;
       rdfs:comment "Commander variant played on MTG Arena" .
:Commander rdf:type :Format ;
           rdfs:label "Commander" ;
           rdfs:comment "100-card singleton multiplayer format" .
:Commander1v1 rdf:type :Format ;
              rdfs:label "Commander 1v1" ;
              rdfs:comment "Commander played as a duel" .
:CommanderLimited rdf:type :Format ;
                  rdfs:label "Commander Limited" ;
                  rdfs:comment "Draft or Sealed with Commander rules" .
:Conspiracy rdf:type :Format ;
            rdfs:label "Conspiracy" ;
            rdfs:comment "Draft format designed for multiplayer games" .
:Freeform rdf:type :Format ;
          rdfs:label "Freeform" ;
          rdfs:comment "Play with any cards in your collection" .
:Historic rdf:type :Format ;
          rdfs:label "Historic" ;
          rdfs:comment "Non-rotating digital format on MTG Arena" .
:Legacy rdf:type :Format ;
        rdfs:label "Legacy" ;
        rdfs:comment "Eternal format allowing cards from all Magic sets" .
:Limited rdf:type :Format ;
         rdfs:label "Limited" ;
         rdfs:comment "Formats where players build decks from opened packs" .
:Modern rdf:type :Format ;
        rdfs:label "Modern" ;
        rdfs:comment "Non-rotating format from 8th Edition onwards" .
:MomirBasic rdf:type :Format ;
            rdfs:label "Momir Basic" ;
            rdfs:comment "Digital format using Momir Vig avatar" .
:Oathbreaker rdf:type :Format ;
             rdfs:label "Oathbreaker" ;
             rdfs:comment
             """Singleton format with Planeswalker commander and signature
spell""" .
:Pauper rdf:type :Format ;
        rdfs:label "Pauper" ;
        rdfs:comment "Format using only common cards" .
:PickTwoDraft rdf:type :Format ;
              rdfs:label "Pick-Two Draft" ;
              rdfs:comment "Special 4-player draft format" .
:Pioneer rdf:type :Format ;
         rdfs:label "Pioneer" ;
         rdfs:comment "Non-rotating format from Return to Ravnica onwards" .
:Planechase rdf:type :Format ;
            rdfs:label "Planechase" ;
            rdfs:comment "Casual format using oversized planar cards" .
:SealedDeck rdf:type :Format ;
            rdfs:label "Sealed Deck" ;
            rdfs:comment "Build a deck from 6 booster packs" .
:Standard rdf:type :Format ;
          rdfs:label "Standard" ;
          rdfs:comment
          """Rotating format using recent sets with 60 card decks and maximal
four copies of any card""" .
:TeamBoosterDraft rdf:type :Format ;
                  rdfs:label "Team Booster Draft" ;
                  rdfs:comment "Draft played in teams" .
:TeamSealedDeck rdf:type :Format ;
                rdfs:label "Team Sealed Deck" ;
                rdfs:comment "Sealed played in teams" .
:Timeless rdf:type :Format ;
          rdfs:label "Timeless" ;
          rdfs:comment "Digital format with no bans on MTG Arena" .
:TwoHeadedGiant rdf:type :Format ;
                rdfs:label "Two-Headed Giant" ;
                rdfs:comment "2v2 Team format" .
:Vintage rdf:type :Format ;
         rdfs:label "Vintage" ;
         rdfs:comment "Eternal format allowing almost all cards" .

# --- Languages ---
:English rdf:type :Language ;
         rdfs:label "English" ;
         rdfs:comment "The English language print of the card."@en .
:German rdf:type :Language ;
        rdfs:label "German" ;
        rdfs:comment "The German language print of the card."@en .
:Japanese rdf:type :Language ;
          rdfs:label "Japanese" ;
          rdfs:comment "The Japanese language print of the card."@en .
:Spanish rdf:type :Language ;
         rdfs:label "Spanish" ;
         rdfs:comment "The Spanish language print of the card."@en .

# --- Keywords ---
# --- Keyword Actions ---
:Abandon rdf:type :KeywordAction ;
                 rdfs:label "Abandon" ;
                 rdfs:comment
                 """To turn a face-up ongoing scheme card face down and put it
on the bottom of its owner’s scheme deck."""@en .
:Activate rdf:type :KeywordAction ;
                 rdfs:label "Activate" ;
                 rdfs:comment
                 """To put an activated ability onto the stack and pay its
costs, so that it will eventually resolve and have its effect."""@en .
:Adapt rdf:type :KeywordAction ;
                 rdfs:label "Adapt" ;
                 rdfs:comment
                 """A keyword action that puts +1/+1 counters on a creature that
doesn’t have any yet."""@en .
:Airbend rdf:type :KeywordAction ;
                 rdfs:label "Airbend" ;
                 rdfs:comment
                 """A keyword action that exiles one or more permanents and/or
spells. The owner of each card exiled with airbend may cast it from
exile by paying {2} rather than paying its mana cost."""@en .
:Amass rdf:type :KeywordAction ;
                 rdfs:label "Amass" ;
                 rdfs:comment
                 """A keyword action that gives you a Zombie Army creature token
or grows an Army you already have."""@en .
:Assemble rdf:type :KeywordAction ;
                 rdfs:label "Assemble" ;
                 rdfs:comment
                 """A keyword action that puts Contraptions onto the
battlefield."""@en .
:Attach rdf:type :KeywordAction ;
                 rdfs:label "Attach" ;
                 rdfs:comment
                 """To take an Aura, Equipment, or Fortification from where it
currently is and put it onto a specified object or player."""@en .
:Behold rdf:type :KeywordAction ;
                 rdfs:label "Behold" ;
                 rdfs:comment
                 """A keyword action that allows a player to choose a permanent
they control of a particular quality or reveal a card of that quality
from their hand, usually to pay a cost or get an additional effect."""@en .
:Blight rdf:type :KeywordAction ;
                 rdfs:label "Blight" ;
                 rdfs:comment
                 """A keyword action. To blight N means to put N -1/-1 counters
on a creature you control."""@en .
:Bolster rdf:type :KeywordAction ;
                 rdfs:label "Bolster" ;
                 rdfs:comment
                 """A keyword action that puts +1/+1 counters on the weakest
creature a player controls."""@en .
:Cast rdf:type :KeywordAction ;
                 rdfs:label "Cast" ;
                 rdfs:comment
                 """To take a card from where it is (usually the hand), put it
on the stack, and pay its costs, so that it will eventually resolve and
have its effect."""@en .
:Clash rdf:type :KeywordAction ;
                 rdfs:label "Clash" ;
                 rdfs:comment
                 """To have a mini-contest involving the top cards of players’
libraries."""@en .
:Cloak rdf:type :KeywordAction ;
                 rdfs:label "Cloak" ;
                 rdfs:comment
                 """A keyword action that puts a card onto the battlefield face
down as a 2/2 creature with ward {2}."""@en .
:CollectEvidence rdf:type :KeywordAction ;
                 rdfs:label "Collect Evidence" ;
                 rdfs:comment
                 """A keyword action. To “collect evidence N” means to exile any
number of cards from your graveyard with total mana value N or greater."""@en .
:Connive rdf:type :KeywordAction ;
                 rdfs:label "Connive" ;
                 rdfs:comment
                 """A keyword action that causes a player to draw a card,
discard a card, and then to put a +1/+1 counter on a creature if a
nonland card was discarded this way."""@en .
:Convert rdf:type :KeywordAction ;
                 rdfs:label "Convert" ;
                 rdfs:comment
                 """To turn a double-faced card so its other face is up."""@en .
:Counter rdf:type :KeywordAction ;
                 rdfs:label "Counter" ;
                 rdfs:comment
                 """A keyword action that cancels a spell or ability so it does
not resolve and none of its effects occur."""@en .
:Create rdf:type :KeywordAction ;
                 rdfs:label "Create" ;
                 rdfs:comment
                 """To create a token is to put a token onto the
battlefield."""@en .
:Destroy rdf:type :KeywordAction ;
                 rdfs:label "Destroy" ;
                 rdfs:comment
                 """To move a permanent from the battlefield to its owner’s
graveyard."""@en .
:Detain rdf:type :KeywordAction ;
                 rdfs:label "Detain" ;
                 rdfs:comment
                 """A keyword action that temporarily stops a permanent from
attacking, blocking, or having its activated abilities activated."""@en .
:Discard rdf:type :KeywordAction ;
                 rdfs:label "Discard" ;
                 rdfs:comment
                 """To move a card from its owner’s hand to that player’s
graveyard."""@en .
:Discover rdf:type :KeywordAction ;
                 rdfs:label "Discover" ;
                 rdfs:comment
                 """A keyword action that exiles cards from the top of your
library until you exile a nonland card with the required mana value,
then lets you cast it for free or put it into your hand."""@en .
:Double rdf:type :KeywordAction ;
                 rdfs:label "Double" ;
                 rdfs:comment
                 """A keyword action used in a variety of contexts."""@en .
:Earthbend rdf:type :KeywordAction ;
                 rdfs:label "Earthbend" ;
                 rdfs:comment
                 """A keyword action that makes a land you control into a hasty
0/0 land creature, puts N +1/+1 counters on it, and returns it tapped
under your control when it dies or is exiled."""@en .
:Endure rdf:type :KeywordAction ;
                 rdfs:label "Endure" ;
                 rdfs:comment
                 """A keyword action that lets a permanent’s controller either
create an N/N white Spirit creature token or put N +1/+1 counters on
that permanent."""@en .
:Exchange rdf:type :KeywordAction ;
                 rdfs:label "Exchange" ;
                 rdfs:comment
                 """To swap two things, such as objects, sets of objects, or
life totals."""@en .
:Exert rdf:type :KeywordAction ;
                 rdfs:label "Exert" ;
                 rdfs:comment
                 """A keyword action that stops a permanent from untapping
during the next untap step of the player who exerted it."""@en .
:Exile rdf:type :KeywordAction ;
                 rdfs:label "Exile" ;
                 rdfs:comment
                 """A keyword action that puts an object into the exile
zone."""@en .
:Explore rdf:type :KeywordAction ;
                 rdfs:label "Explore" ;
                 rdfs:comment
                 """A keyword action that causes a player to reveal the top card
of their library and then to take different actions depending on whether
a land card is revealed this way."""@en .
:FaceAVillainousChoice rdf:type :KeywordAction ;
                 rdfs:label "Face a Villainous Choice" ;
                 rdfs:comment
                 """A keyword action that causes a player to choose one of two
listed choices."""@en .
:Fateseal rdf:type :KeywordAction ;
                 rdfs:label "Fateseal" ;
                 rdfs:comment
                 """To manipulate some of the cards on top of an opponent’s
library."""@en .
:Fight rdf:type :KeywordAction ;
                 rdfs:label "Fight" ;
                 rdfs:comment
                 """A keyword action where each of two creatures deals damage
equal to its power to the other."""@en .
:Forage rdf:type :KeywordAction ;
                 rdfs:label "Forage" ;
                 rdfs:comment
                 """To pay a cost of exiling three cards from your graveyard or
sacrificing a Food."""@en .
:Goad rdf:type :KeywordAction ;
                 rdfs:label "Goad" ;
                 rdfs:comment
                 """A keyword action that causes a creature to be goaded until a
player’s next turn."""@en .
:Harness rdf:type :KeywordAction ;
                 rdfs:label "Harness" ;
                 rdfs:comment
                 """A keyword action that grants a permanent the harnessed
designation."""@en .
:Incubate rdf:type :KeywordAction ;
                 rdfs:label "Incubate" ;
                 rdfs:comment
                 """A keyword action that creates an Incubator token with a
specified number of +1/+1 counters on it."""@en .
:Investigate rdf:type :KeywordAction ;
                 rdfs:label "Investigate" ;
                 rdfs:comment
                 """A keyword action that creates a Clue artifact token."""@en .
:Learn rdf:type :KeywordAction ;
                 rdfs:label "Learn" ;
                 rdfs:comment
                 """A keyword action that lets a player add a Lesson card to
their hand from outside the game or discard a card to draw a card."""@en .
:Manifest rdf:type :KeywordAction ;
                 rdfs:label "Manifest" ;
                 rdfs:comment
                 """A keyword action that puts a card onto the battlefield face
down as a 2/2 creature."""@en .
:ManifestDread rdf:type :KeywordAction ;
                 rdfs:label "Manifest Dread" ;
                 rdfs:comment
                 """A keyword action that puts one of the top two cards of your
library onto the battlefield face down as a 2/2 creature."""@en .
:Meld rdf:type :KeywordAction ;
                 rdfs:label "Meld" ;
                 rdfs:comment
                 """To turn two members of a meld pair so their back faces are
up and combined into one oversized Magic card."""@en .
:Mill rdf:type :KeywordAction ;
                 rdfs:label "Mill" ;
                 rdfs:comment
                 """To mill a number of cards, a player puts that many cards
from the top of their library into their graveyard."""@en .
:Monstrosity rdf:type :KeywordAction ;
                 rdfs:label "Monstrosity" ;
                 rdfs:comment
                 """A keyword action that puts +1/+1 counters on a creature and
makes it become monstrous."""@en .
:OpenAnAttraction rdf:type :KeywordAction ;
                 rdfs:label "Open an Attraction" ;
                 rdfs:comment
                 """A keyword action that puts the top card of your Attraction
deck onto the battlefield face up under your control."""@en .
:Planeswalk rdf:type :KeywordAction ;
                 rdfs:label "Planeswalk" ;
                 rdfs:comment
                 """To put each face-up plane card or phenomenon card on the
bottom of its owner’s planar deck face down, then move the top card of
your planar deck off that planar deck and turn it face up in a
Planechase game."""@en .
:Play rdf:type :KeywordAction ;
                 rdfs:label "Play" ;
                 rdfs:comment
                 """A keyword action that lets a player play a land or cast a
card, whichever is appropriate."""@en .
:Populate rdf:type :KeywordAction ;
                 rdfs:label "Populate" ;
                 rdfs:comment
                 """A keyword action that creates a copy of a creature token you
control."""@en .
:Proliferate rdf:type :KeywordAction ;
                 rdfs:label "Proliferate" ;
                 rdfs:comment
                 """To give an additional counter to any number of players
and/or permanents of each kind they already have."""@en .
:Regenerate rdf:type :KeywordAction ;
                 rdfs:label "Regenerate" ;
                 rdfs:comment
                 """To replace a permanent’s destruction with an alternate
sequence of events."""@en .
:Reveal rdf:type :KeywordAction ;
                 rdfs:label "Reveal" ;
                 rdfs:comment
                 """To show a card to all players for a brief time."""@en .
:RollToVisitYourAttractions rdf:type :KeywordAction ;
                 rdfs:label "Roll to Visit Your Attractions" ;
                 rdfs:comment
                 """A keyword action that rolls a six-sided die and visits each
Attraction you control with that lit-up number, causing its visit
ability to trigger."""@en .
:Sacrifice rdf:type :KeywordAction ;
                 rdfs:label "Sacrifice" ;
                 rdfs:comment
                 """To move a permanent you control to its owner’s
graveyard."""@en .
:Scry rdf:type :KeywordAction ;
                 rdfs:label "Scry" ;
                 rdfs:comment
                 """To manipulate some of the cards on top of your
library."""@en .
:Search rdf:type :KeywordAction ;
                 rdfs:label "Search" ;
                 rdfs:comment
                 """To look at all cards in a stated zone and possibly find a
card that matches a given description."""@en .
:SetInMotion rdf:type :KeywordAction ;
                 rdfs:label "Set in Motion" ;
                 rdfs:comment
                 """To move a scheme card off the top of your scheme deck and
turn it face up."""@en .
:Shuffle rdf:type :KeywordAction ;
                 rdfs:label "Shuffle" ;
                 rdfs:comment
                 """To randomize the cards in a deck (before a game) or library
(during a game)."""@en .
:Support rdf:type :KeywordAction ;
                 rdfs:label "Support" ;
                 rdfs:comment
                 """A keyword action that lets you put +1/+1 counters on
creatures."""@en .
:Surveil rdf:type :KeywordAction ;
                 rdfs:label "Surveil" ;
                 rdfs:comment
                 """To manipulate some of the cards on top of your library,
sending some of them to your graveyard and rearranging the rest."""@en .
:Suspect rdf:type :KeywordAction ;
                 rdfs:label "Suspect" ;
                 rdfs:comment
                 """A keyword action that makes a creature suspected, giving it
menace and preventing it from blocking for as long as it remains
suspected."""@en .
:Tap rdf:type :KeywordAction ;
                 rdfs:label "Tap" ;
                 rdfs:comment
                 """To turn a permanent sideways from an upright
position."""@en .
:TheRingTemptsYou rdf:type :KeywordAction ;
                 rdfs:label "The Ring Tempts You" ;
                 rdfs:comment
                 """A keyword action that causes a player to choose a creature
they control to be their legendary Ring-bearer and may cause them to
create an emblem called The Ring."""@en .
:TimeTravel rdf:type :KeywordAction ;
                 rdfs:label "Time Travel" ;
                 rdfs:comment
                 """To add a time counter to or remove a time counter from any
number of permanents you control with a time counter on them or
suspended cards you own in exile with time counters on them."""@en .
:Transform rdf:type :KeywordAction ;
                 rdfs:label "Transform" ;
                 rdfs:comment
                 """To turn a double-faced card so its other face is up."""@en .
:Triple rdf:type :KeywordAction ;
                 rdfs:label "Triple" ;
                 rdfs:comment
                 """A keyword action that increases a creature’s power and/or
toughness."""@en .
:Untap rdf:type :KeywordAction ;
                 rdfs:label "Untap" ;
                 rdfs:comment
                 """To rotate a permanent back to the upright position from a
sideways position."""@en .
:VentureIntoTheDungeon rdf:type :KeywordAction ;
                 rdfs:label "Venture into the Dungeon" ;
                 rdfs:comment
                 """A keyword action that can bring dungeon cards into the game
from outside the game or move a player’s venture marker."""@en .
:Vote rdf:type :KeywordAction ;
                 rdfs:label "Vote" ;
                 rdfs:comment
                 """A keyword action that instructs players to vote from among
given options."""@en .
:Waterbend rdf:type :KeywordAction ;
                 rdfs:label "Waterbend" ;
                 rdfs:comment
                 """A keyword action. “Waterbend [cost]” means to pay that cost
and, for each {1} in that cost, you may tap an untapped artifact or
creature you control rather than pay mana."""@en .

# --- Keyword Abilities ---
:Absorb rdf:type :KeywordAbility ;
                 rdfs:label "Absorb" ;
                 rdfs:comment "A keyword ability that prevents damage."@en .
:Affinity rdf:type :KeywordAbility ;
                 rdfs:label "Affinity" ;
                 rdfs:comment
                 """A keyword ability that reduces how much mana you need to
spend to cast a spell."""@en .
:Afflict rdf:type :KeywordAbility ;
                 rdfs:label "Afflict" ;
                 rdfs:comment
                 """A keyword ability that makes the defending player lose life
for blocking."""@en .
:Afterlife rdf:type :KeywordAbility ;
                 rdfs:label "Afterlife" ;
                 rdfs:comment
                 """A keyword ability that leaves behind Spirit creature tokens
when certain creatures die."""@en .
:Aftermath rdf:type :KeywordAbility ;
                 rdfs:label "Aftermath" ;
                 rdfs:comment
                 """A keyword ability that lets a player cast one half of a
split card only from their graveyard."""@en .
:Amplify rdf:type :KeywordAbility ;
                 rdfs:label "Amplify" ;
                 rdfs:comment
                 """A keyword ability than can have a creature enter the
battlefield with +1/+1 counters on it."""@en .
:Annihilator rdf:type :KeywordAbility ;
                 rdfs:label "Annihilator" ;
                 rdfs:comment
                 """A keyword ability that can make a creature particularly
brutal when it attacks."""@en .
:Ascend rdf:type :KeywordAbility ;
                 rdfs:label "Ascend" ;
                 rdfs:comment
                 """A keyword causing a player to get the designation of the
city’s blessing once they control ten permanents."""@en .
:Assist rdf:type :KeywordAbility ;
                 rdfs:label "Assist" ;
                 rdfs:comment
                 """A keyword ability that lets another player help you pay for
a spell."""@en .
:AuraSwap rdf:type :KeywordAbility ;
                 rdfs:label "Aura Swap" ;
                 rdfs:comment
                 """A keyword ability that lets you exchange an Aura on the
battlefield with one in your hand."""@en .
:Awaken rdf:type :KeywordAbility ;
                 rdfs:label "Awaken" ;
                 rdfs:comment
                 """A keyword ability that lets you turn a land you control into
a creature."""@en .
:Backup rdf:type :KeywordAbility ;
                 rdfs:label "Backup" ;
                 rdfs:comment
                 """A keyword ability that lets a creature give +1/+1 counters
to itself or another when it enters the battlefield. If a different
creature is chosen, that creature also temporarily gains one or more
abilities."""@en .
:Banding rdf:type :KeywordAbility ;
                 rdfs:label "Banding" ;
                 rdfs:comment
                 """A keyword ability that modifies the rules for declaring
attackers and assigning combat damage."""@en .
:Bargain rdf:type :KeywordAbility ;
                 rdfs:label "Bargain" ;
                 rdfs:comment
                 """Bargain is a keyword ability that represents an optional
additional cost of sacrificing an artifact, enchantment, or token. A
spell has been bargained if its controller declared the intention to pay
that cost."""@en .
:BattleCry rdf:type :KeywordAbility ;
                 rdfs:label "Battle Cry" ;
                 rdfs:comment
                 """A keyword ability that makes other attacking creatures
better in combat."""@en .
:Bestow rdf:type :KeywordAbility ;
                 rdfs:label "Bestow" ;
                 rdfs:comment
                 """A keyword ability that lets a creature card be cast as an
Aura."""@en .
:Blitz rdf:type :KeywordAbility ;
                 rdfs:label "Blitz" ;
                 rdfs:comment
                 """A keyword ability found on creature cards that allows them
to be cast for an alternative cost."""@en .
:Bloodthirst rdf:type :KeywordAbility ;
                 rdfs:label "Bloodthirst" ;
                 rdfs:comment
                 """A keyword ability that can have a creature enter the
battlefield with +1/+1 counters on it."""@en .
:Boast rdf:type :KeywordAbility ;
                 rdfs:label "Boast" ;
                 rdfs:comment
                 """A special kind of activated ability that can be activated
only once each turn if the creature with the boast ability attacked that
turn."""@en .
:Bushido rdf:type :KeywordAbility ;
                 rdfs:label "Bushido" ;
                 rdfs:comment
                 """A keyword ability that can make a creature better in
combat."""@en .
:Buyback rdf:type :KeywordAbility ;
                 rdfs:label "Buyback" ;
                 rdfs:comment
                 """A keyword ability of instants and sorceries that can let the
spell return to its owner’s hand as it resolves."""@en .
:Cascade rdf:type :KeywordAbility ;
                 rdfs:label "Cascade" ;
                 rdfs:comment
                 """A keyword ability that may let a player cast a random extra
spell for no cost."""@en .
:Casualty rdf:type :KeywordAbility ;
                 rdfs:label "Casualty" ;
                 rdfs:comment
                 """A keyword ability that lets you sacrifice a creature with
enough power as an additional cost to copy the spell."""@en .
:Champion rdf:type :KeywordAbility ;
                 rdfs:label "Champion" ;
                 rdfs:comment
                 """A keyword ability that lets one creature temporarily replace
another."""@en .
:Changeling rdf:type :KeywordAbility ;
                 rdfs:label "Changeling" ;
                 rdfs:comment
                 """A characteristic-defining ability that grants the object
it’s on every creature type."""@en .
:Cipher rdf:type :KeywordAbility ;
                 rdfs:label "Cipher" ;
                 rdfs:comment
                 """A keyword ability that allows you to encode a card on a
creature and cast that card whenever that creature deals combat damage
to a player."""@en .
:Cleave rdf:type :KeywordAbility ;
                 rdfs:label "Cleave" ;
                 rdfs:comment
                 """A keyword ability that allows you to pay an alternative cost
to remove some of a spell’s text."""@en .
:Companion rdf:type :KeywordAbility ;
                 rdfs:label "Companion" ;
                 rdfs:comment
                 """A keyword ability that allows a player to choose one
creature card from outside the game as a companion if the restriction of
that card’s companion ability is met. Once a player has chosen a
companion, that player may pay {3} to put it into their hand once during
the game."""@en .
:Compleated rdf:type :KeywordAbility ;
                 rdfs:label "Compleated" ;
                 rdfs:comment
                 """A keyword ability that causes a planeswalker to enter the
battlefield with fewer loyalty counters if a player chose to pay life
for Phyrexian mana symbols in its cost."""@en .
:Conspire rdf:type :KeywordAbility ;
                 rdfs:label "Conspire" ;
                 rdfs:comment
                 """A keyword ability that creates a copy of a spell."""@en .
