################################################################################
#
#  Property Definitions
#
################################################################################

# --- Card-related Data Properties ---

:cardName rdf:type owl:DatatypeProperty ;
      	  rdfs:domain :Card ;
          rdfs:range xsd:string ;
          rdfs:label "Card Name" ;
          rdfs:comment
           """The name of the card. See rules 201.1 and 201.2."""@en .

:manaCost rdf:type owl:DatatypeProperty ;
          rdfs:domain :Card ;
          rdfs:range xsd:string ;
          rdfs:label "Mana Cost" ;
          rdfs:comment
          """The mana symbols required to cast the card, with
values represented using standard Magic mana notation enclosed in braces,
such as W, U, B, R, G, C, X, or 0. See rule 202.1."""@en .

:manaValue rdf:type owl:DatatypeProperty ;
           rdfs:domain :Card ;
           rdfs:range xsd:nonNegativeInteger ;
           rdfs:label "Mana Value" ;
           rdfs:comment
           """Total amount of mana required to cast the spell.
Formerly known as converted mana cost (CMC). See rule 202.3."""@en .

:printedText rdf:type owl:DatatypeProperty ;
             rdfs:domain :Card ;
             rdfs:range rdf:langString ;
             rdfs:label "Printed Text" ;
             rdfs:comment
             """The text printed on the card, including the card
name, mana cost, oracle text, flavor text, and card text.
See rule 207.1."""@en .

:oracleText rdf:type owl:DatatypeProperty ;
            rdfs:domain :Card ;
            rdfs:range rdf:langString ;
            rdfs:label "Oracle Text" ;
            rdfs:comment
            """The official rules text of the card. See rule 108.1."""@en .

:flavorText rdf:type owl:DatatypeProperty ;
            rdfs:domain :Card ;
            rdfs:range rdf:langString ;
            rdfs:label "Flavor Text" ;
            rdfs:comment
             """The flavor text of the card. See rule 207.2b."""@en .

:artist rdf:type owl:DatatypeProperty ;
        rdfs:domain :Card ;
        rdfs:range xsd:string ;
        rdfs:label "Artist" ;
        rdfs:comment
        """The artist who illustrated the card. See rule 213.1f."""@en .

:power rdf:type owl:DatatypeProperty ;
       rdfs:domain :Card ;
       rdfs:range xsd:string ;
       rdfs:label "Power" ;
       rdfs:comment
       """The printed power of a creature card, including
non-numeric expressions such as "*", "1+*", or "7-*".
See rules 208.1 and 208.2."""@en .

:toughness rdf:type owl:DatatypeProperty ;
           rdfs:domain :Card ;
           rdfs:range xsd:string ;
           rdfs:label "Toughness" ;
           rdfs:comment
           """The printed toughness of a creature card, including
non-numeric expressions such as "*", "1+*", or "7-*".
See rules 208.1 and 208.2."""@en .

:powerValue rdf:type owl:DatatypeProperty ;
            rdfs:domain :Card ;
            rdfs:range xsd:integer ;
            rdfs:label "Power Value" ;
            rdfs:comment
            """The numeric power of a creature card when its
printed power is a plain integer. See rule 208.1."""@en .

:toughnessValue rdf:type owl:DatatypeProperty ;
                rdfs:domain :Card ;
                rdfs:range xsd:integer ;
                rdfs:label "Toughness Value" ;
                rdfs:comment
                """The numeric toughness of a creature card when
its printed toughness is a plain integer. See rule 208.1."""@en .

:loyalty rdf:type owl:DatatypeProperty ;
         rdfs:domain :Card ;
         rdfs:range xsd:integer ;
         rdfs:label "Loyalty" ;
         rdfs:comment
         """Starting loyalty of a Planeswalker.
See rules 209.1 and 306.5."""@en .

:defenseValue rdf:type owl:DatatypeProperty ;
              rdfs:domain :Card ;
              rdfs:range xsd:nonNegativeInteger ;
              rdfs:label "Defense" ;
              rdfs:comment
              """The defense of a Battle card. A battle can be attacked
and its defense reduced; when it reaches 0, it is defeated.
See rules 210.1 and 310.4."""@en .

:setName rdf:type owl:DatatypeProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :Set ;
         rdfs:range rdf:langString ;
         rdfs:label "Set Name" ;
         rdfs:comment
         """The full name of the Magic set. See rule 206.1."""@en .

:setCode rdf:type owl:DatatypeProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :Set ;
         rdfs:range xsd:string ;
         rdfs:label "Set Code" ;
         rdfs:comment
         """The 3-letter code of the Magic set. See rule 206.1."""@en .

:cardNumber rdf:type owl:DatatypeProperty ;
            rdfs:domain :Card ;
            rdfs:range xsd:integer ;
            rdfs:label "Card Number" ;
            rdfs:comment
            """The collector number of the card in a set when
totals are not provided. See rule 213.1a."""@en .

:cardNumberString rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Card ;
                  rdfs:range xsd:string ;
                  rdfs:label "Card Number String" ;
                  rdfs:comment
                  """The collector number of the card in a set as a
string (e.g., '123a'). See rule 213.1a."""@en .

:cardCount rdf:type owl:DatatypeProperty ;
           rdfs:domain [
               rdf:type owl:Class ;
               owl:unionOf (
                   :Card
                   :Set
               )
           ] ;
           rdfs:range xsd:integer ;
           rdfs:label "Card Count" ;
           rdfs:comment
           """The total number of cards in the set. See rule 213.1a."""@en .

:rulingText rdf:type owl:DatatypeProperty ;
            rdfs:domain :Ruling ;
            rdfs:range rdf:langString ;
            rdfs:label "Ruling Text" ;
            rdfs:comment
            """The ruling text of the card, published alongside
Oracle text. See rule 108.1."""@en .

:rulingDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :Ruling ;
            rdfs:range xsd:date ;
            rdfs:label "Ruling Date" ;
            rdfs:comment
            """The date of the ruling, published alongside
Oracle text. See rule 108.1."""@en .

:gathererUrl rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Card ;
             rdfs:range xsd:anyURI ;
             rdfs:label "Gatherer URL" ;
             rdfs:comment
             """The URL to the card's entry on
gatherer.wizards.com. See rule 108.1."""@en .

:scryfallUrl rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Card ;
             rdfs:range xsd:anyURI ;
             rdfs:label "Scryfall URL" ;
             rdfs:comment
             """The URL to the card's entry on scryfall.com."""@en .

:releaseDate rdf:type owl:DatatypeProperty ;
             rdfs:domain :Set ;
             rdfs:range xsd:date ;
             rdfs:label "Release Date" ;
             rdfs:comment
             """The release date of the set. See rule 206.1."""@en .

:isPermanent rdf:type owl:DatatypeProperty ;
             rdfs:domain :CardType ;
             rdfs:range xsd:boolean ;
             rdfs:label "Is Permanent" ;
             rdfs:comment
             """Indicates whether the card type is a permanent
(true) or non-permanent (false). See rule 110.4."""@en .

# --- Object Properties ---

:hasColor rdf:type owl:ObjectProperty ;
          rdfs:domain :Card ;
          rdfs:range :Color ;
          rdfs:label "Has Color" ;
          rdfs:comment
          """The color(s) of the card, determined by the mana symbols in
its mana cost. A card with no colored mana symbols is colorless. Colorless is
not a color. See rules 105.1, 105.2, and 105.2c."""@en .

:hasColorIdentity rdf:type owl:ObjectProperty ;
                  rdfs:domain :Card ;
                  rdfs:range :Color ;
                  rdfs:label "Color Identity" ;
                  rdfs:comment
                  """The color identity of the card for Commander
deck building, determined by the colors of mana symbols anywhere on the card.
A card with no colored mana symbols has a colorless color identity, represented
by the absence of any :hasColorIdentity values. See rules 903.4 and
903.4a."""@en .

:hasSuperType rdf:type owl:ObjectProperty ;
              rdfs:domain :Card ;
              rdfs:range :SuperType ;
              rdfs:label "Has Super Type" ;
              rdfs:comment
              """The super type of the card. See rules 205.4 and 205.4a."""@en .

:hasCardType rdf:type owl:ObjectProperty ;
             rdfs:domain :Card ;
             rdfs:range :CardType ;
             rdfs:label "Has Card Type" ;
             rdfs:comment
             """The card type of the card. See rules 205.2a and 300.1."""@en .

:hasSubType rdf:type owl:ObjectProperty ;
            rdfs:domain :Card ;
            rdfs:range :SubType ;
            rdfs:label "Has Sub Type" ;
            rdfs:comment
            """The sub type of the card. See rule 205.3."""@en .

:hasRarity rdf:type owl:ObjectProperty ;
           rdfs:domain :Card ;
           rdfs:range :Rarity ;
           rdfs:label "Rarity" ;
           rdfs:comment
           """The rarity of the card. See rule 206.2."""@en .

:containsCard rdf:type owl:ObjectProperty ;
              rdfs:domain [
                  rdf:type owl:Class ;
                  owl:unionOf (
                      :Deck
                      :Set
                  )
              ] ;
              rdfs:range :Card ;
              rdfs:label "Contains Card" ;
              rdfs:comment
              """Relates a deck or set to a card it contains.
See rules 100.2 and 206.1."""@en .

:isInSet rdf:type owl:ObjectProperty ;
         owl:inverseOf :hasSetCard ;
         rdfs:domain :Card ;
         rdfs:range :Set ;
         rdfs:label "Set" ;
         rdfs:comment
         """The expansion set the card belongs to. See rule 206.1."""@en .

:hasLanguage rdf:type owl:ObjectProperty ;
             rdfs:domain :Card ;
             rdfs:range :Language ;
             rdfs:label "Language" ;
             rdfs:comment
             """The language of the card print. See rule 213.1e."""@en .

:hasLegality rdf:type owl:ObjectProperty ;
             rdfs:domain :Card ;
             rdfs:range :LegalityMapping ;
             rdfs:label "Has Legality" ;
             rdfs:comment
             """Connects a card to its format legality statuses.
See rules 100.6 and 206.4."""@en .

:inFormat rdf:type owl:ObjectProperty ;
          rdfs:domain :LegalityMapping ;
          rdfs:range :Format ;
          rdfs:label "In Format" ;
          rdfs:comment
          """The format a legality mapping applies to.
See rules 100.6 and 206.4."""@en .

:hasLegalityStatus rdf:type owl:ObjectProperty ;
                   rdfs:domain :LegalityMapping ;
                   rdfs:range :Legality ;
                   rdfs:label "Has Legality Status" ;
                   rdfs:comment
                   """The specific legality status applied.
See rules 100.6 and 206.4."""@en .

:hasRuling rdf:type owl:ObjectProperty ;
           rdfs:domain :Card ;
           rdfs:range :Ruling ;
           rdfs:label "Has Ruling" ;
           rdfs:comment
           """The ruling for the card, published alongside
Oracle text. See rule 108.1."""@en .

:isInDeck rdf:type owl:ObjectProperty ;
          owl:inverseOf :hasCard ;
          rdfs:domain :Card ;
          rdfs:range :Deck ;
          rdfs:label "Is In Deck" ;
          rdfs:comment
          """Indicates a card is included in a deck. See rule 100.2."""@en .

:hasSetCard rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :containsCard ;
            owl:inverseOf :isInSet ;
            rdfs:domain :Set ;
            rdfs:range :Card ;
            rdfs:label "Has Set Card" ;
            rdfs:comment
            """Indicates a set that has a specific card.
See rule 206.1."""@en .

:hasCard rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :containsCard ;
         owl:inverseOf :isInDeck ;
         rdfs:domain :Deck ;
         rdfs:range :Card ;
         rdfs:label "Has Card" ;
         rdfs:comment
         """Indicates a deck that has a specific card.
See rule 100.2."""@en .

:isCommanderOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :isInDeck ;
               rdfs:domain :Card ;
               rdfs:range :CommanderDeck ;
               rdfs:label "Is Commander Of" ;
               rdfs:comment
               """Identifies the commander(s) of a deck.
See rules 903.3 and 903.6."""@en .

# --- Deck Entry (Reified Deck-Card Quantity) ---
:DeckEntry rdf:type owl:Class ;
           rdfs:label "Deck Entry" ;
           rdfs:comment
           """A reified association between a deck and a specific card,
carrying the number of copies of that card in the deck. Used because OWL
cannot attach a literal (such as a quantity count) directly to an object
property edge between Deck and Card. See rule 100.2."""@en .

:hasDeckEntry rdf:type owl:ObjectProperty ;
              rdfs:domain :Deck ;
              rdfs:range :DeckEntry ;
              rdfs:label "Has Deck Entry" ;
              rdfs:comment
              """Relates a deck to one of its reified deck entries, which
in turn references a specific card and the number of copies in the deck.
See rule 100.2."""@en .

:entryCard rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :DeckEntry ;
           rdfs:range :Card ;
           rdfs:label "Entry Card" ;
           rdfs:comment
           """The card referenced by a deck entry. See rule 100.2."""@en .

:quantity rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :DeckEntry ;
          rdfs:range xsd:positiveInteger ;
          rdfs:label "Quantity" ;
          rdfs:comment
          """The number of copies of the entry's card in the deck.
Must be a positive integer. See rule 100.2."""@en .

# --- Card-to-Card Synergy ---
:hasSynergyWith rdf:type owl:ObjectProperty ,
                         owl:SymmetricProperty ;
                rdfs:domain :Card ;
                rdfs:range :Card ;
                rdfs:label "Has Synergy With" ;
                rdfs:comment
                """Relates two cards whose abilities, types, or effects
work together in a way that meaningfully enhances one or both cards'
contribution to a deck. This is an undirected, symmetric relation. For
finer-grained directional synergies, use the subproperties :amplifies
and :enables."""@en .

:amplifies rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasSynergyWith ;
           owl:inverseOf :isAmplifiedBy ;
           rdfs:domain :Card ;
           rdfs:range :Card ;
           rdfs:label "Amplifies" ;
           rdfs:comment
           """A directional synergy in which the subject card increases
the value, frequency, or magnitude of the object card's abilities or
effects (e.g., a card that causes another card's triggered ability to
trigger an additional time). Implies :hasSynergyWith."""@en .

:isAmplifiedBy rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasSynergyWith ;
               owl:inverseOf :amplifies ;
               rdfs:domain :Card ;
               rdfs:range :Card ;
               rdfs:label "Is Amplified By" ;
               rdfs:comment
               """Inverse of :amplifies. The subject card's abilities or
effects are enhanced by the object card."""@en .

:enables rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :hasSynergyWith ;
         owl:inverseOf :isEnabledBy ;
         rdfs:domain :Card ;
         rdfs:range :Card ;
         rdfs:label "Enables" ;
         rdfs:comment
         """A directional synergy in which the subject card creates the
preconditions under which the object card's abilities deliver value
(e.g., a token producer feeding an ETB-watching amplifier). Implies
:hasSynergyWith."""@en .

:isEnabledBy rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasSynergyWith ;
             owl:inverseOf :enables ;
             rdfs:domain :Card ;
             rdfs:range :Card ;
             rdfs:label "Is Enabled By" ;
             rdfs:comment
             """Inverse of :enables. The subject card's abilities deliver
their full value because the object card creates the preconditions."""@en .

:hasKeyword rdf:type owl:ObjectProperty ;
            rdfs:domain :Card ;
            rdfs:range :Keyword ;
            rdfs:label "Has Keyword" ;
            rdfs:comment
            """Relates a card to any keyword (ability or action) it has.
See rules 701.1 and 702.1."""@en .

:hasKeywordAbility rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasKeyword ;
                   rdfs:domain :Card ;
                   rdfs:range :KeywordAbility ;
                   rdfs:label "Has Keyword Ability" ;
                   rdfs:comment
                   """Relates a card to a keyword ability printed on it.
See rule 702.1."""@en .

:hasKeywordAction rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasKeyword ;
                  rdfs:domain :Card ;
                  rdfs:range :KeywordAction ;
                  rdfs:label "Has Keyword Action" ;
                  rdfs:comment
                  """Relates a card to a keyword action it references.
See rule 701.1."""@en .


#################################################
#
#  Constraints
#
#################################################

# --- Land Constraints ---
:LandCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Land
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Basic :Snow :Legendary )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "3"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Land Card" ;
    rdfs:comment
    """A class representing any card with the Land card type to enforce
constraints. See rule 305."""@en .

# --- Artifact Constraints ---
:ArtifactCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Artifact
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Legendary :Host :Snow )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "3"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Artifact Card" ;
    rdfs:comment
    """A class representing any card with the Artifact card type to enforce
constraints. Artifact cards may be multi-typed (e.g. Artifact Creature) and
carry subtypes from other categories. See rule 301."""@en .

# --- Creature Constraints ---
:CreatureCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Creature
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Legendary :Host :Snow )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "3"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:someValuesFrom :CreatureTypes
    ] ;
    rdfs:label "Creature Card" ;
    rdfs:comment
    """A class representing any card with the Creature card type to enforce
constraints. Every creature has at least one creature subtype, but multi-typed
cards (e.g. Artifact Creature) may also carry subtypes from other categories.
See rule 302."""@en .

# --- Kindred Constraints ---
:KindredCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Kindred
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:someValuesFrom :CreatureTypes
    ] ;
    rdfs:label "Kindred Card" ;
    rdfs:comment
    """A class representing any card with the Kindred card type to enforce
constraints. Kindred cards always have at least one creature subtype, but since
Kindred always co-occurs with another card type, the card may also carry
subtypes from other categories. See rule 308."""@en .


# --- Plane Constraints ---
:PlaneCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Plane
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :PlanarType
    ] ;
    rdfs:label "Plane Card" ;
    rdfs:comment
    """A class representing any card with the Plane card type to enforce
restrictions. See rule 311."""@en .


# --- Dungeon Constraints ---
:DungeonCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Dungeon
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :DungeonType
    ] ;
    rdfs:label "Dungeon Card" ;
    rdfs:comment
    """A class representing any card with the Dungeon card type to enforce
restrictions. See rule 309."""@en .

# --- Battle Constraints ---
:BattleCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Battle
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :BattleType
    ] ;
    rdfs:label "Battle Card" ;
    rdfs:comment
    """A class representing any card with the Battle card type to enforce
restrictions. See rule 310."""@en .

# --- Enchantment Constraints ---
:EnchantmentCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Enchantment
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Legendary :Snow :World )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "3"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Enchantment Card" ;
    rdfs:comment
    """A class representing any card with the Enchantment card type to enforce
constraints. Enchantment cards may be multi-typed (e.g. Enchantment Creature)
and carry subtypes from other categories. See rule 303."""@en .

# --- Planeswalker Constraints ---
:PlaneswalkerCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasCardType ;
                owl:hasValue :Planeswalker
            ]
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasSuperType ;
                owl:hasValue :Legendary
            ]
        )
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :PlaneswalkerTypes
    ] ;
    rdfs:label "Planeswalker Card" ;
    rdfs:comment
    """A class representing planeswalker cards, which must have the Legendary
supertype. See rules 306 and 205.4d."""@en .

# --- Spell Constraints ---
:SpellCardConstraint rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Instant :Sorcery )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Legendary :Snow )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "2"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :SpellTypes
    ] ;
    rdfs:label "Spell Card Constraint" ;
    rdfs:comment
    """A class representing any card with the Instant or Sorcery card type to
enforce constraints. See rules 304 and 307."""@en .

# --- Basic Land Constraints ---
:BasicLandCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :LandCard
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasSuperType ;
                owl:hasValue :Basic
            ]
        )
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :BasicLandTypes
    ] ;
    rdfs:label "Basic Land Card" ;
    rdfs:comment
    """A class representing land cards with the Basic supertype.
See rules 305.6 and 305.8."""@en .

# --- Phenomenon Constraints ---
:PhenomenonCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Phenomenon
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Phenomenon Card" ;
    rdfs:comment
    """A class representing any card with the Phenomenon card type to enforce
restrictions. See rule 312."""@en .

# --- Scheme Constraints ---
:SchemeCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Scheme
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Ongoing )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Scheme Card" ;
    rdfs:comment
    """A class representing any card with the Scheme card type to enforce
restrictions. See rule 314."""@en .

# --- Vanguard Constraints ---
:VanguardCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Vanguard
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Vanguard Card" ;
    rdfs:comment
    """A class representing any card with the Vanguard card type to enforce
restrictions. See rule 313."""@en .

# --- Conspiracy Constraints ---
:ConspiracyCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Conspiracy
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Conspiracy Card" ;
    rdfs:comment
    """A class representing any card with the Conspiracy card type to enforce
restrictions. See rule 315."""@en .

# --- Summon Constraints ---
:SummonCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Summon
    ] ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:oneOf ( :OldFogey )
    ] ;
    rdfs:label "Summon Card" ;
    rdfs:comment
    """A class representing the Summon card type, which only applies to the card
Old Fogey."""@en .


################################################################################
#
#  Individuals
#
################################################################################

# --- Colors ---
:White rdf:type owl:NamedIndividual ,
                :Color ;
       rdfs:label "White" ;
       rdfs:comment
       """The color of law, order, and structure, typically powered by
Plains."""@en .
:Blue rdf:type owl:NamedIndividual ,
               :Color ;
      rdfs:label "Blue" ;
      rdfs:comment
      """The color of logic, knowledge, and illusion, typically powered by
Islands."""@en .
:Black rdf:type owl:NamedIndividual ,
                :Color ;
       rdfs:label "Black" ;
       rdfs:comment
       """The color of death, ambition, and sacrifice, typically powered by
Swamps."""@en .
:Red rdf:type owl:NamedIndividual ,
              :Color ;
     rdfs:label "Red" ;
     rdfs:comment
     """The color of chaos, emotion, and impulse, typically powered by
Mountains."""@en .
:Green rdf:type owl:NamedIndividual ,
                :Color ;
       rdfs:label "Green" ;
       rdfs:comment
       """The color of nature, instinct, and interdependence, typically powered
by Forests."""@en .
:Colorless rdf:type owl:NamedIndividual ;
           rdfs:label "Colorless" ;
           rdfs:comment
           """An attribute representing the absence of color. Colorless is
not a color per rule 105.2c. Cards and mana with no color affiliation are
colorless. A card's colorless status is represented by the absence of any
:hasColor values."""@en .

# --- Rarities ---
:Common rdf:type owl:NamedIndividual ,
                 :Rarity ;
        rdfs:label "Common" ;
        rdfs:comment
        """The most frequently found cards in a booster pack, denoted by a black
expansion symbol."""@en .
:Uncommon rdf:type owl:NamedIndividual ,
                   :Rarity ;
          rdfs:label "Uncommon" ;
          rdfs:comment
          """Cards that appear less frequently than Commons, denoted by a silver
expansion symbol."""@en .
:Rare rdf:type owl:NamedIndividual ,
               :Rarity ;
      rdfs:label "Rare" ;
      rdfs:comment
      """Cards that typically appear once per regular booster pack, denoted by a
gold expansion symbol."""@en .
:MythicRare rdf:type owl:NamedIndividual ,
                     :Rarity ;
            rdfs:label "Mythic Rare" ;
            rdfs:comment
            """The rarest standard cards, typically appearing once in every
eight packs, denoted by an orange-red expansion symbol."""@en .
:Special rdf:type owl:NamedIndividual ,
                  :Rarity ;
         rdfs:label "Special" ;
         rdfs:comment
         """A rarity used for specialty subsets of cards such as Timeshifted
cards, often denoted by a purple expansion symbol."""@en .
:Bonus rdf:type owl:NamedIndividual ,
                :Rarity ;
       rdfs:label "Bonus" ;
       rdfs:comment
       """A rarity level used (e.g. by Scryfall) for special inserts or
promotional materials not part of the standard set."""@en .
:Promo rdf:type owl:NamedIndividual ,
                :Rarity ;
       rdfs:label "Promo" ;
       rdfs:comment
       """Cards distributed at promotional events like Prereleases or FNM, often
featuring alternate art."""@en .
:LandRarity rdf:type owl:NamedIndividual ,
                     :Rarity ;
            rdfs:label "Land Rarity" ;
            rdfs:comment
            """A rarity designation used explicitly for basic lands in booster
packs. See rule 206.2a."""@en .

# --- Super Types ---
:Basic rdf:type owl:NamedIndividual ,
                :SuperType ;
       rdfs:label "Basic" ;
       rdfs:comment
       """A supertype that removes the four-of deck limit for a card."""@en .
:Elite rdf:type owl:NamedIndividual ,
                :SuperType ;
       rdfs:label "Elite" ;
       rdfs:comment
       """A supertype denoting powerful versions of enemies, often used in
supplementary sets."""@en .
:Host rdf:type owl:NamedIndividual ,
               :SuperType ;
      rdfs:label "Host" ;
      rdfs:comment
      """A supertype used on silver-bordered and un-set creatures that can be
augmented."""@en .
:Legendary rdf:type owl:NamedIndividual ,
                    :SuperType ;
           rdfs:label "Legendary" ;
           rdfs:comment
           """A supertype representing specific, unique entities. Can only exist
as one on the battlefield at a time."""@en .
:Ongoing rdf:type owl:NamedIndividual ,
                  :SuperType ;
         rdfs:label "Ongoing" ;
         rdfs:comment
         """A supertype used exclusively on scheme cards in the Archenemy
format."""@en .
:Snow rdf:type owl:NamedIndividual ,
               :SuperType ;
      rdfs:label "Snow" ;
      rdfs:comment
      """A supertype representing cold or winter-themed permanents and
spells."""@en .
:Token rdf:type owl:NamedIndividual ,
                :SuperType ;
       rdfs:label "Token" ;
       rdfs:comment
       """A supertype representing permanents that are created during gameplay
rather than cast from cards."""@en .
:World rdf:type owl:NamedIndividual ,
                :SuperType ;
       rdfs:label "World" ;
       rdfs:comment
       """An obsolete supertype representing global enchantments where only one
can exist on the battlefield at a time."""@en .

# --- Card Types  ---
:Artifact rdf:type owl:NamedIndividual ,
                   :CardType ;
          :isPermanent true ;
          rdfs:label "Artifact" ;
          rdfs:comment
          """A permanent type representing magical items, constructs, or
relics."""@en .
:Battle rdf:type owl:NamedIndividual ,
                 :CardType ;
        :isPermanent true ;
        rdfs:label "Battle" ;
        rdfs:comment
        """A permanent type representing a conflict that can be attacked and
defeated for a reward."""@en .
:Conspiracy rdf:type owl:NamedIndividual ,
                     :CardType ;
            :isPermanent false ;
            rdfs:label "Conspiracy" ;
            rdfs:comment
            """A multiplayer card type used specifically in the Conspiracy
format."""@en .
:Creature rdf:type owl:NamedIndividual ,
                   :CardType ;
          :isPermanent true ;
          rdfs:label "Creature" ;
          rdfs:comment "A permanent type that can attack and block."@en .
:Dungeon rdf:type owl:NamedIndividual ,
                  :CardType ;
         :isPermanent false ;
         rdfs:label "Dungeon" ;
         rdfs:comment
         """A card type representing a dungeon that can be explored."""@en .
:Enchantment rdf:type owl:NamedIndividual ,
                      :CardType ;
             :isPermanent true ;
             rdfs:label "Enchantment" ;
             rdfs:comment
             """A permanent type representing lasting magical effects."""@en .
:Instant rdf:type owl:NamedIndividual ,
                  :CardType ;
         :isPermanent false ;
         rdfs:label "Instant" ;
         rdfs:comment
         """A non-permanent spell that can be cast at almost any time."""@en .
:Kindred rdf:type owl:NamedIndividual ,
                  :CardType ;
         :isPermanent true ;
         rdfs:label "Kindred" ;
         rdfs:comment
         """A card type denoting tribal synergies for non-creature cards.
Specifically it allows creatures as subtypes."""@en .
:Land rdf:type owl:NamedIndividual ,
               :CardType ;
      :isPermanent true ;
      rdfs:label "Land" ;
      rdfs:comment
      """A permanent type that is played rather than cast, used primarily to
produce mana."""@en .
:Phenomenon rdf:type owl:NamedIndividual ,
                     :CardType ;
             :isPermanent false ;
             rdfs:label "Phenomenon" ;
             rdfs:comment
             """A multiplayer card type used specifically in the Planechase
format."""@en .
:Plane rdf:type owl:NamedIndividual ,
                :CardType ;
       :isPermanent false ;
       rdfs:label "Plane" ;
       rdfs:comment
       """A card type representing a plane that can be planeswalked."""@en .
:Planeswalker rdf:type owl:NamedIndividual ,
                       :CardType ;
              :isPermanent true ;
              rdfs:label "Planeswalker" ;
              rdfs:comment
              """A permanent type representing powerful conjurers with loyalty
abilities."""@en .
:Scheme rdf:type owl:NamedIndividual ,
                 :CardType ;
        :isPermanent false ;
        rdfs:label "Scheme" ;
        rdfs:comment
        """A multiplayer card type used specifically in the Archenemy
format."""@en .
:Sorcery rdf:type owl:NamedIndividual ,
                  :CardType ;
         :isPermanent false ;
         rdfs:label "Sorcery" ;
         rdfs:comment
         """A non-permanent spell that can only be cast during a player's main
phase."""@en .
:Summon rdf:type owl:NamedIndividual ,
                 :CardType ;
        :isPermanent true ;
        rdfs:label "Summon" ;
        rdfs:comment
        """An obsolete card type formerly used for creature spells."""@en .
:Vanguard rdf:type owl:NamedIndividual ,
                   :CardType ;
          :isPermanent false ;
          rdfs:label "Vanguard" ;
          rdfs:comment
          """A casual card type representing a specific character that modifies
starting life and hand size."""@en .

# --- Creature Types ---
:Advisor rdf:type owl:NamedIndividual ,
                  :CreatureTypes ;
         rdfs:label "Advisor" ;
         rdfs:comment
         """Individuals who offer counsel, wisdom, and administrative
guidance."""@en .
:Aetherborn rdf:type owl:NamedIndividual ,
                     :CreatureTypes ;
            rdfs:label "Aetherborn" ;
            rdfs:comment
            """A short-lived being composed of aether, native to Kaladesh.
"""@en .
:Alien rdf:type owl:NamedIndividual ,
                :CreatureTypes ;
       rdfs:label "Alien" ;
       rdfs:comment
       """An extraterrestrial being from another world or dimension."""@en .
:Ally rdf:type owl:NamedIndividual ,
               :CreatureTypes ;
      rdfs:label "Ally" ;
      rdfs:comment
      """A creature working together with others, often sharing combat
strategies."""@en .
:Angel rdf:type owl:NamedIndividual ,
                :CreatureTypes ;
       rdfs:label "Angel" ;
       rdfs:comment
       """A manifestation of white mana, representing purity, law, and
justice."""@en .
:Antelope rdf:type owl:NamedIndividual ,
                   :CreatureTypes ;
          rdfs:label "Antelope" ;
          rdfs:comment
          """A creature type representing a real-world antelope."""@en .
:Ape rdf:type owl:NamedIndividual ,
              :CreatureTypes ;
     rdfs:label "Ape" ;
     rdfs:comment
     """A creature type representing a real-world ape or monkey."""@en .
:Archer rdf:type owl:NamedIndividual ,
                 :CreatureTypes ;
        rdfs:label "Archer" ;
        rdfs:comment
        """A warrior skilled in the use of bows and ranged weapons."""@en .
:Archon rdf:type owl:NamedIndividual ,
                 :CreatureTypes ;
        rdfs:label "Archon" ;
        rdfs:comment
        """A mysterious, armor-clad entity of law and justice that typically
rides a winged beast."""@en .
:Armadillo rdf:type owl:NamedIndividual ,
                    :CreatureTypes ;
           rdfs:label "Armadillo" ;
           rdfs:comment
           """A creature type representing a real-world armadillo."""@en .
:Army rdf:type owl:NamedIndividual ,
               :CreatureTypes ;
      rdfs:label "Army" ;
      rdfs:comment
      """A creature type representing a massive collective force or
legion."""@en .
:Artificer rdf:type owl:NamedIndividual ,
                    :CreatureTypes ;
           rdfs:label "Artificer" ;
           rdfs:comment
           """A mage or inventor who crafts and manipulates magical
artifacts."""@en .
:Assassin rdf:type owl:NamedIndividual ,
                   :CreatureTypes ;
          rdfs:label "Assassin" ;
          rdfs:comment
          """A trained killer who strikes with stealth and precision."""@en .
:AssemblyWorker rdf:type owl:NamedIndividual ,
                         :CreatureTypes ;
                rdfs:label "Assembly-Worker" ;
                rdfs:comment
                """A mechanical worker originally built in Urza's factories.
"""@en .
:Astartes rdf:type owl:NamedIndividual ,
                   :CreatureTypes ;
          rdfs:label "Astartes" ;
          rdfs:comment
          """Genetically enhanced, power-armored super-soldiers from the Warhammer
40,000 universe."""@en .
:Atog rdf:type owl:NamedIndividual ,
               :CreatureTypes ;
      rdfs:label "Atog" ;
      rdfs:comment
      """A bizarre creature known for devouring unusual materials, such as
artifacts or lands."""@en .
:Aurochs rdf:type owl:NamedIndividual ,
                  :CreatureTypes ;
         rdfs:label "Aurochs" ;
         rdfs:comment "A herd animal reminiscent of ancient, robust cattle."@en .
:Avatar rdf:type owl:NamedIndividual ,
                 :CreatureTypes ;
        rdfs:label "Avatar" ;
        rdfs:comment
        """The physical manifestation of a god, plane, or abstract
concept."""@en .
:Azra rdf:type owl:NamedIndividual ,
               :CreatureTypes ;
      rdfs:label "Azra" ;
      rdfs:comment
      """A humanoid race with demonic ancestry, known for their agility and
magic, native to Kylem."""@en .
:Badger rdf:type owl:NamedIndividual ,
                 :CreatureTypes ;
        rdfs:label "Badger" ;
        rdfs:comment "A creature type representing a real-world badger."@en .
:Balloon rdf:type owl:NamedIndividual ,
                  :CreatureTypes ;
         rdfs:label "Balloon" ;
         rdfs:comment
         """A creature type representing an animate or piloted balloon."""@en .
:Barbarian rdf:type owl:NamedIndividual ,
                    :CreatureTypes ;
           rdfs:label "Barbarian" ;
           rdfs:comment
           """A fierce, primal warrior who relies on rage and physical
might."""@en .
:Bard rdf:type owl:NamedIndividual ,
               :CreatureTypes ;
      rdfs:label "Bard" ;
      rdfs:comment
      """A storyteller, musician, or entertainer who weaves magic into their
art."""@en .
:Basilisk rdf:type owl:NamedIndividual ,
                   :CreatureTypes ;
          rdfs:label "Basilisk" ;
          rdfs:comment
          """A reptilian beast whose gaze or touch can turn living beings to
stone."""@en .
:Bat rdf:type owl:NamedIndividual ,
              :CreatureTypes ;
     rdfs:label "Bat" ;
     rdfs:comment
        """A creature type representing a real-world bat."""@en .
:Bear rdf:type owl:NamedIndividual ,
               :CreatureTypes ;
      rdfs:label "Bear" ;
      rdfs:comment
      """A creature type representing a real-world bear, often a 2/2
creature."""@en .
:Beast rdf:type owl:NamedIndividual ,
                :CreatureTypes ;
       rdfs:label "Beast" ;
       rdfs:comment
       """A feral, untamed creature, often large and associated with green
mana."""@en .
:Beaver rdf:type owl:NamedIndividual ,
                 :CreatureTypes ;
        rdfs:label "Beaver" ;
        rdfs:comment "A creature type representing a real-world beaver."@en .
:Beeble rdf:type owl:NamedIndividual ,
                 :CreatureTypes ;
        rdfs:label "Beeble" ;
        rdfs:comment
        """A small, annoying, pill-shaped creature that swarms and
distracts."""@en .
:Beholder rdf:type owl:NamedIndividual ,
                   :CreatureTypes ;
          rdfs:label "Beholder" ;
          rdfs:comment
          """A floating aberration with a central eye and eyestalks, originating
from Dungeons & Dragons."""@en .
:Berserker rdf:type owl:NamedIndividual ,
                    :CreatureTypes ;
           rdfs:label "Berserker" ;
           rdfs:comment
           """A warrior who fights in a state of frenzied, uncontrollable
rage."""@en .
:Bird rdf:type owl:NamedIndividual ,
               :CreatureTypes ;
      rdfs:label "Bird" ;
      rdfs:comment
      """A creature type representing a real-world or magical bird."""@en .
:Bison rdf:type owl:NamedIndividual ,
                :CreatureTypes ;
       rdfs:label "Bison" ;
       rdfs:comment "A creature type representing a real-world bison."@en .
:Blinkmoth rdf:type owl:NamedIndividual ,
                    :CreatureTypes ;
           rdfs:label "Blinkmoth" ;
           rdfs:comment
           """A small, glowing, artificial moth-like creature from Mirrodin."""@en .
:Boar rdf:type owl:NamedIndividual ,
               :CreatureTypes ;
      rdfs:label "Boar" ;
      rdfs:comment "A creature type representing a real-world boar."@en .
:Bringer rdf:type owl:NamedIndividual ,
                  :CreatureTypes ;
         rdfs:label "Bringer" ;
         rdfs:comment
         """A massive elemental manifestation of mana from Mirrodin's
core."""@en .
:Brushwagg rdf:type owl:NamedIndividual ,
                    :CreatureTypes ;
           rdfs:label "Brushwagg" ;
           rdfs:comment
           """A bizarre creature that rolls into a ball of thorny vines for
defense."""@en .
:Camarid rdf:type owl:NamedIndividual ,
                  :CreatureTypes ;
         rdfs:label "Camarid" ;
         rdfs:comment
         """A small crustacean-like creature, often a spawn of Homarids."""@en .
:Camel rdf:type owl:NamedIndividual ,
                :CreatureTypes ;
       rdfs:label "Camel" ;
       rdfs:comment "A creature type representing a real-world camel."@en .
:Capybara rdf:type owl:NamedIndividual ,
                   :CreatureTypes ;
          rdfs:label "Capybara" ;
          rdfs:comment
          """A creature type representing a real-world capybara."""@en .
:Caribou rdf:type owl:NamedIndividual ,
                  :CreatureTypes ;
         rdfs:label "Caribou" ;
         rdfs:comment "A creature type representing a real-world caribou."@en .
:Carrier rdf:type owl:NamedIndividual ,
                  :CreatureTypes ;
         rdfs:label "Carrier" ;
         rdfs:comment
         """A creature afflicted with and carrying the Phyrexian plague."""@en .
:Cat rdf:type owl:NamedIndividual ,
              :CreatureTypes ;
     rdfs:label "Cat" ;
     rdfs:comment
     """A feline creature, ranging from domestic cats to leonins and
panthers."""@en .
:Centaur rdf:type owl:NamedIndividual ,
                  :CreatureTypes ;
         rdfs:label "Centaur" ;
         rdfs:comment
         """A creature with the upper body of a human and the lower body of a
horse."""@en .
:Child rdf:type owl:NamedIndividual ,
