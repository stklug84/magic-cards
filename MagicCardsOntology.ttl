# --- Spell Types ---
:Adventure rdf:type owl:NamedIndividual ,
                    :SpellTypes ;
           rdfs:label "Adventure" ;
           rdfs:comment
           """A spell type that allows casting an alternate spell from a
permanent card."""@en .
:Arcane rdf:type owl:NamedIndividual ,
                 :SpellTypes ;
        rdfs:label "Arcane" ;
        rdfs:comment
        """A spell type originating from Kamigawa that can be spliced
onto."""@en .
:Lesson rdf:type owl:NamedIndividual ,
                 :SpellTypes ;
        rdfs:label "Lesson" ;
        rdfs:comment
        """A spell type that can be retrieved from outside the game by the Learn
mechanic."""@en .
:Omen rdf:type owl:NamedIndividual ,
               :SpellTypes ;
      rdfs:label "Omen" ;
      rdfs:comment "A spell type with path-based magic."@en .
:Trap rdf:type owl:NamedIndividual ,
               :SpellTypes ;
      rdfs:label "Trap" ;
      rdfs:comment
      """A spell type that can be cast for a reduced cost if a certain condition
is met."""@en .

# --- Artifact Types ---
:Attraction rdf:type owl:NamedIndividual ,
                     :ArtifactTypes ;
            rdfs:label "Attraction" ;
            rdfs:comment
            """An artifact type representing a theme park attraction visited
during gameplay."""@en .
:Blood rdf:type owl:NamedIndividual ,
                :ArtifactTypes ;
       rdfs:label "Blood" ;
       rdfs:comment
       """An artifact type representing blood tokens, typically sacrificed to
discard and draw a card."""@en .
:Bobblehead rdf:type owl:NamedIndividual ,
                     :ArtifactTypes ;
            rdfs:label "Bobblehead" ;
            rdfs:comment
            """An artifact type originally from the *Fallout* set representing
collectible figurines."""@en .
:Clue rdf:type owl:NamedIndividual ,
               :ArtifactTypes ;
      rdfs:label "Clue" ;
      rdfs:comment
      """An artifact type representing investigative evidence, typically
sacrificed to draw a card."""@en .
:Contraption rdf:type owl:NamedIndividual ,
                      :ArtifactTypes ;
             rdfs:label "Contraption" ;
             rdfs:comment
             """An artifact type representing a device assembled by
riggers."""@en .
:Equipment rdf:type owl:NamedIndividual ,
                    :ArtifactTypes ;
           rdfs:label "Equipment" ;
           rdfs:comment
           """An artifact type representing weapons, armor, or items that can be
attached to creatures."""@en .
:Food rdf:type owl:NamedIndividual ,
               :ArtifactTypes ;
      rdfs:label "Food" ;
      rdfs:comment
      """An artifact type representing sustenance, typically sacrificed to gain
life."""@en .
:Fortification rdf:type owl:NamedIndividual ,
                        :ArtifactTypes ;
               rdfs:label "Fortification" ;
               rdfs:comment
               """An artifact type representing defensive structures that can be
attached to lands."""@en .
:Gold rdf:type owl:NamedIndividual ,
               :ArtifactTypes ;
      rdfs:label "Gold" ;
      rdfs:comment
      """An artifact type representing currency, typically sacrificed for
mana."""@en .
:Incubator rdf:type owl:NamedIndividual ,
                    :ArtifactTypes ;
           rdfs:label "Incubator" ;
           rdfs:comment
           """An artifact type representing Phyrexian gestation pods that
transform into creatures."""@en .
:Infinity rdf:type owl:NamedIndividual ,
                   :ArtifactTypes ;
          rdfs:label "Infinity" ;
          rdfs:comment "An artifact type associated with un-set mechanics."@en .
:Junk rdf:type owl:NamedIndividual ,
               :ArtifactTypes ;
      rdfs:label "Junk" ;
      rdfs:comment
      """An artifact type representing scrap, typically sacrificed to impulse
draw."""@en .
:Lander rdf:type owl:NamedIndividual ,
                 :ArtifactTypes ;
        rdfs:label "Lander" ;
        rdfs:comment "An artifact type representing spacecraft landers."@en .
:Map rdf:type owl:NamedIndividual ,
              :ArtifactTypes ;
     rdfs:label "Map" ;
     rdfs:comment
     """An artifact type representing navigational aids, typically sacrificed to
explore."""@en .
:Mutagen rdf:type owl:NamedIndividual ,
                  :ArtifactTypes ;
         rdfs:label "Mutagen" ;
         rdfs:comment "An artifact type associated with mutation tokens."@en .
:Powerstone rdf:type owl:NamedIndividual ,
                     :ArtifactTypes ;
            rdfs:label "Powerstone" ;
            rdfs:comment "An artifact type representing a mana battery."@en .
:Spacecraft rdf:type owl:NamedIndividual ,
                     :ArtifactTypes ;
            rdfs:label "Spacecraft" ;
            rdfs:comment
            """An artifact type from the *Edge of Eternities* set representing
ships that often require \"Stationing\" to function."""@en .
:Stone rdf:type owl:NamedIndividual ,
                :ArtifactTypes ;
       rdfs:label "Stone" ;
       rdfs:comment
       """An artifact type representing a rock or specific mineral."""@en .
:Treasure rdf:type owl:NamedIndividual ,
                   :ArtifactTypes ;
          rdfs:label "Treasure" ;
          rdfs:comment
          """An artifact type representing wealth, typically sacrificed for mana
