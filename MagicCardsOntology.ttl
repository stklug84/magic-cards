:Dauthi rdf:type :SubType ;
       rdfs:label "Dauthi" ;
       rdfs:comment "A dark, shade-like humanoid race trapped in the shadow realm of Rath."@en .
:Demigod rdf:type :SubType ;
       rdfs:label "Demigod" ;
       rdfs:comment "A powerful being of partially divine origin."@en .
:Demon rdf:type :SubType ;
       rdfs:label "Demon" ;
       rdfs:comment "A malevolent entity formed of black mana, associated with ambition and contracts."@en .
:Deserter rdf:type :SubType ;
       rdfs:label "Deserter" ;
       rdfs:comment "A soldier who has abandoned their post or duty."@en .
:Detective rdf:type :SubType ;
       rdfs:label "Detective" ;
       rdfs:comment "An investigator skilled at solving mysteries and finding clues."@en .
:Devil rdf:type :SubType ;
       rdfs:label "Devil" ;
       rdfs:comment "A chaotic, destructive entity of red mana, prone to mischief and violence."@en .
:Dinosaur rdf:type :SubType ;
       rdfs:label "Dinosaur" ;
       rdfs:comment "A massive, prehistoric reptilian creature."@en .
:Djinn rdf:type :SubType ;
       rdfs:label "Djinn" ;
       rdfs:comment "A powerful, often mischievous elemental spirit of the air."@en .
:Doctor rdf:type :SubType ;
       rdfs:label "Doctor" ;
       rdfs:comment "A healer, scientist, or the iconic Time Lord from Doctor Who."@en .
:Dog rdf:type :SubType ;
       rdfs:label "Dog" ;
       rdfs:comment "A canine creature ranging from loyal hounds to wild feral dogs."@en .
:Dragon rdf:type :SubType ;
       rdfs:label "Dragon" ;
       rdfs:comment "A massive, flying, breath-weapon-wielding magical reptile."@en .
:Drake rdf:type :SubType ;
       rdfs:label "Drake" ;
       rdfs:comment "A smaller, two-legged draconic creature lacking the immense power of a true Dragon."@en .
:Dreadnought rdf:type :SubType ;
       rdfs:label "Dreadnought" ;
       rdfs:comment "An extraordinarily massive and destructive machine or vessel."@en .
:Drix rdf:type :SubType ;
       rdfs:label "Drix" ;
       rdfs:comment "A unique, unusual creature type occasionally found in supplementary material."@en .
:Drone rdf:type :SubType ;
       rdfs:label "Drone" ;
       rdfs:comment "A mindless worker or combatant part of a larger swarm, like Eldrazi."@en .
:Druid rdf:type :SubType ;
       rdfs:label "Druid" ;
       rdfs:comment "A nature mage who draws power from the land and its creatures."@en .
:Dryad rdf:type :SubType ;
       rdfs:label "Dryad" ;
       rdfs:comment "A mystical forest spirit bound to a tree or grove."@en .
:Dwarf rdf:type :SubType ;
       rdfs:label "Dwarf" ;
       rdfs:comment "A stout, subterranean humanoid known for mining and artifice."@en .
:Echidna rdf:type :SubType ;
       rdfs:label "Echidna" ;
       rdfs:comment "A creature type representing a real-world echidna."@en .
:Efreet rdf:type :SubType ;
       rdfs:label "Efreet" ;
       rdfs:comment "A fiery, volatile elemental spirit of flame."@en .
:Egg rdf:type :SubType ;
       rdfs:label "Egg" ;
       rdfs:comment "The unhatched stage of an oviparous creature."@en .
:Elder rdf:type :SubType ;
       rdfs:label "Elder" ;
       rdfs:comment "An ancient and incredibly powerful being of its kind, like Elder Dragons."@en .
:Eldrazi rdf:type :SubType ;
       rdfs:label "Eldrazi" ;
       rdfs:comment "A cosmic, world-devouring entity from the Blind Eternities."@en .
:Elemental rdf:type :SubType ;
       rdfs:label "Elemental" ;
       rdfs:comment "A physical manifestation of a fundamental force of nature or mana."@en .
:Elephant rdf:type :SubType ;
       rdfs:label "Elephant" ;
       rdfs:comment "A large pachyderm, including loxodons and mammoths."@en .
:Elf rdf:type :SubType ;
       rdfs:label "Elf" ;
       rdfs:comment "A forest-dwelling humanoid with a deep connection to nature magic."@en .
:Elk rdf:type :SubType ;
       rdfs:label "Elk" ;
       rdfs:comment "A majestic horned herbivore of the forest."@en .
:Employee rdf:type :SubType ;
       rdfs:label "Employee" ;
       rdfs:comment "A worker for a larger organization, often found in Un-sets."@en .
:Eye rdf:type :SubType ;
       rdfs:label "Eye" ;
       rdfs:comment "A floating, perceptive ocular entity."@en .
:Faerie rdf:type :SubType ;
       rdfs:label "Faerie" ;
       rdfs:comment "A small, mischievous winged sprite associated with illusions."@en .
:Ferret rdf:type :SubType ;
       rdfs:label "Ferret" ;
       rdfs:comment "A small, fast mustelid creature."@en .
:Fish rdf:type :SubType ;
       rdfs:label "Fish" ;
       rdfs:comment "An aquatic gill-bearing creature."@en .
:Flagbearer rdf:type :SubType ;
       rdfs:label "Flagbearer" ;
       rdfs:comment "A standard-bearer that magnetically draws enemy spells."@en .
:Fox rdf:type :SubType ;
       rdfs:label "Fox" ;
       rdfs:comment "A cunning vulpine creature, ranging from animals to kitsune."@en .
:Fractal rdf:type :SubType ;
