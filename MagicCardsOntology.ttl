       rdfs:comment "A land type representing a center of magical power."@en .
:Mine rdf:type :SubType ;
      rdfs:label "Mine" ;
      rdfs:comment "A land type, one of the three Urza's land types."@en .
:Mountain rdf:type :SubType ;
          rdfs:label "Mountain" ;
          rdfs:comment
          """A basic land type that inherently produces red mana."""@en .
:Plains rdf:type :SubType ;
        rdfs:label "Plains" ;
        rdfs:comment
        """A basic land type that inherently produces white mana."""@en .
:Planet rdf:type :SubType ;
        rdfs:label "Planet" ;
        rdfs:comment
        """A land type representing an entire world or celestial body."""@en .
:PowerPlant rdf:type :SubType ;
            rdfs:label "Power-Plant" ;
            rdfs:comment "A land type, one of the three Urza's land types."@en .
:Sphere rdf:type :SubType ;
        rdfs:label "Sphere" ;
        rdfs:comment
        """A land type representing distinct spherical or layered planar
