      rdfs:label "Clue" ;
      rdfs:comment
      """An artifact type representing investigative evidence, typically
sacrificed to draw a card."""@en .
:Contraption rdf:type :SubType ;
             rdfs:label "Contraption" ;
             rdfs:comment
             """An artifact type representing a device assembled by
riggers."""@en .
:Equipment rdf:type :SubType ;
           rdfs:label "Equipment" ;
           rdfs:comment
           """An artifact type representing weapons, armor, or items that can be
attached to creatures."""@en .
:Food rdf:type :SubType ;
      rdfs:label "Food" ;
      rdfs:comment
      """An artifact type representing sustenance, typically sacrificed to gain
