# --- Formats ---
:Alchemy rdf:type owl:NamedIndividual ,
                  :Format ;
         rdfs:label "Alchemy" ;
         rdfs:comment "Digital-only format played on MTG Arena" .
:Archenemy rdf:type owl:NamedIndividual ,
                    :Format ;
           rdfs:label "Archenemy" ;
           rdfs:comment "One vs many multiplayer format" .
:ArchenemyCommander rdf:type owl:NamedIndividual ,
                             :Format ;
                    rdfs:label "Archenemy Commander" ;
                    rdfs:comment "Archenemy played with Commander decks" .
:BoosterDraft rdf:type owl:NamedIndividual ,
                       :Format ;
              rdfs:label "Booster Draft" ;
              rdfs:comment
              """Players draft cards from booster packs and build a 40 card
deck""" .
:Brawl rdf:type owl:NamedIndividual ,
                :Format ;
       rdfs:label "Brawl" ;
       rdfs:comment "Commander variant played on MTG Arena" .
:Commander rdf:type owl:NamedIndividual ,
                    :Format ;
           rdfs:label "Commander" ;
           rdfs:comment "100-card singleton multiplayer format" .
:Commander1v1 rdf:type owl:NamedIndividual ,
                       :Format ;
              rdfs:label "Commander 1v1" ;
              rdfs:comment "Commander played as a duel" .
:CommanderLimited rdf:type owl:NamedIndividual ,
                           :Format ;
                  rdfs:label "Commander Limited" ;
                  rdfs:comment "Draft or Sealed with Commander rules" .
:ConspiracyFormat rdf:type owl:NamedIndividual ,
                           :Format ;
                  rdfs:label "Conspiracy" ;
                  rdfs:comment
                  """Draft format designed for multiplayer games.
See rule 905."""@en .
:Freeform rdf:type owl:NamedIndividual ,
                   :Format ;
          rdfs:label "Freeform" ;
          rdfs:comment "Play with any cards in your collection" .
:Historic rdf:type owl:NamedIndividual ,
                   :Format ;
          rdfs:label "Historic" ;
          rdfs:comment "Non-rotating digital format on MTG Arena" .
:Legacy rdf:type owl:NamedIndividual ,
                 :Format ;
        rdfs:label "Legacy" ;
        rdfs:comment "Eternal format allowing cards from all Magic sets" .
:Limited rdf:type owl:NamedIndividual ,
                  :Format ;
         rdfs:label "Limited" ;
         rdfs:comment "Formats where players build decks from opened packs" .
:Modern rdf:type owl:NamedIndividual ,
                 :Format ;
        rdfs:label "Modern" ;
        rdfs:comment "Non-rotating format from 8th Edition onwards" .
:MomirBasic rdf:type owl:NamedIndividual ,
                     :Format ;
            rdfs:label "Momir Basic" ;
            rdfs:comment "Digital format using Momir Vig avatar" .
:Oathbreaker rdf:type owl:NamedIndividual ,
                      :Format ;
             rdfs:label "Oathbreaker" ;
             rdfs:comment
             """Singleton format with Planeswalker commander and signature
spell""" .
:Pauper rdf:type owl:NamedIndividual ,
                 :Format ;
        rdfs:label "Pauper" ;
        rdfs:comment "Format using only common cards" .
:PickTwoDraft rdf:type owl:NamedIndividual ,
                       :Format ;
              rdfs:label "Pick-Two Draft" ;
              rdfs:comment "Special 4-player draft format" .
:Pioneer rdf:type owl:NamedIndividual ,
                  :Format ;
         rdfs:label "Pioneer" ;
         rdfs:comment "Non-rotating format from Return to Ravnica onwards" .
:Planechase rdf:type owl:NamedIndividual ,
                     :Format ;
            rdfs:label "Planechase" ;
            rdfs:comment "Casual format using oversized planar cards" .
:SealedDeck rdf:type owl:NamedIndividual ,
                     :Format ;
            rdfs:label "Sealed Deck" ;
            rdfs:comment "Build a deck from 6 booster packs" .
:Standard rdf:type owl:NamedIndividual ,
                   :Format ;
          rdfs:label "Standard" ;
          rdfs:comment
          """Rotating format using recent sets with 60 card decks and maximal
four copies of any card""" .
:TeamBoosterDraft rdf:type owl:NamedIndividual ,
                           :Format ;
                  rdfs:label "Team Booster Draft" ;
                  rdfs:comment "Draft played in teams" .
:TeamSealedDeck rdf:type owl:NamedIndividual ,
                         :Format ;
                rdfs:label "Team Sealed Deck" ;
                rdfs:comment "Sealed played in teams" .
:Timeless rdf:type owl:NamedIndividual ,
                   :Format ;
          rdfs:label "Timeless" ;
          rdfs:comment "Digital format with no bans on MTG Arena" .
:TwoHeadedGiant rdf:type owl:NamedIndividual ,
                         :Format ;
                rdfs:label "Two-Headed Giant" ;
                rdfs:comment "2v2 Team format" .
:Vintage rdf:type owl:NamedIndividual ,
                  :Format ;
         rdfs:label "Vintage" ;
         rdfs:comment "Eternal format allowing almost all cards" .

