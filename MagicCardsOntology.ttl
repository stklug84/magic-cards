# --- Legalities ---
:Legal rdf:type :Legality ;
       rdfs:label "Legal" ;
       rdfs:comment "The card is fully legal to play in the format."@en .
:NotLegal rdf:type :Legality ;
          rdfs:label "Not Legal" ;
          rdfs:comment "The card is not legal because it was never printed in a set legal for this format."@en .
:Banned rdf:type :Legality ;
        rdfs:label "Banned" ;
        rdfs:comment "The card is explicitly forbidden from being played in the format."@en .
:Restricted rdf:type :Legality ;
            rdfs:label "Restricted" ;
            rdfs:comment "The card is limited to a single copy per deck in the format (primarily Vintage)."@en .

# --- Summon Card ---
:OldFogey rdf:type :Card ;
          :name "Old Fogey" ;
          :manaCost "{G}{G}" ;
          :manaValue 2 ;
          :hasCardType :Summon ;
          :hasSubType :Dinosaur ;
          :hasRarity :Rare ;
          :hasColorIdentity :Green ;
          :hasSet :Unsanctioned ;
          :cardNumber 67 ;
          :artist "Douglas Shuler" ;
          :hasLanguage :English ;
          :power 7 ;
          :toughness 7 ;
          :printedText "Phasing, cumulative upkeep {1}, echo, fading 3, bands with other Dinosaurs, protection from Homarids, snow-covered plainswalk, flanking, rampage 2" ;
          :oracleText "Phasing, cumulative upkeep {1}, echo {G}{G}, fading 3, bands with other Dinosaurs, protection from Homarids, snow-covered plainswalk, flanking, rampage 2" ;
          :flavorText "These kids today with their collector numbers and their newfangled tap symbol. Twenty Black Lotuses and twenty Plague Rats. Now that's real Magic." ;
          :gathererUrl "https://gatherer.wizards.com/UND/en-us/67/old-fogey"^^xsd:anyURI ;
          # Not Legal Formats missing
          :hasLegality [ rdf:type :LegalityMapping ;
                         :inFormat :Commander ;
                         :hasLegalityStatus :NotLegal
                       ] ;
          :hasLegality [ rdf:type :LegalityMapping ;
                         :inFormat :Legacy ;
                         :hasLegalityStatus :NotLegal
                       ] ;
          :hasLegality [ rdf:type :LegalityMapping ;
                         :inFormat :Vintage ;
                         :hasLegalityStatus :NotLegal
                       ] ;
          :hasLegality [ rdf:type :LegalityMapping ;
                         :inFormat :Standard ;
                         :hasLegalityStatus :NotLegal
                       ] ;
          :hasLegality [ rdf:type :LegalityMapping ;
                         :inFormat :Modern ;
                         :hasLegalityStatus :NotLegal
                       ] ;
          :hasLegality [ rdf:type :LegalityMapping ;
                         :inFormat :Pioneer ;
                         :hasLegalityStatus :NotLegal
                       ] ;
          :hasLegality [ rdf:type :LegalityMapping ;
                         :inFormat :Pauper ;
                         :hasLegalityStatus :NotLegal
                       ]
          :hasRuling [rdf:type :Ruling ;
                      :rulingDate "2020-02-29"^^xsd:date ;
                      :rulingText "Due to changes in how echo and phasing work since Old Fogey was originally printed, echo mostly does nothing in this case. This is, as they say, a bit weird. Old Fogey is phased out when its echo ability would trigger, so that ability doesn't trigger at the beginning of the upkeep after Old Fogey enters the battlefield. Phasing in doesn't cause Old Fogey to enter the battlefield, so echo ends up not really doing much at all." ] .



#################################################
#
#  Constraints
#
#################################################

# --- Land Constraints ---
:LandCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Land
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Basic :Snow :Legendary )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "3"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Land Card" ;
    rdfs:comment "A class representing any card with the Land card type to enforce constraints."@en .

# --- Artifact Constraints ---
:ArtifactCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Artifact
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Legendary :Host :Snow )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "3"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :ArtifactTypes
    ] ;
    rdfs:label "Artifact Card" ;
    rdfs:comment "A class representing any card with the Artifact card type to enforce constraints."@en .

# --- Creature Constraints ---
:CreatureCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
