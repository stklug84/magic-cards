@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

@prefix : <urn:stklug84:MagicCardsOntology:2026-02-27#> .
@base <urn:stklug84:MagicCardsOntology:2026-02-27#> .

################################################################################
#
# Ontology Definition and Axiom Definitions
#
################################################################################

<urn:stklug84:MagicCardsOntology:2026-02-27#> rdf:type owl:Ontology ;
                                              rdfs:label
                                              """Magic Cards Ontology""" ;
                                              rdfs:comment
                                              """A detailed ontology for Magic:
The Gathering cards, decks, and attributes. This ontology is based on the
Comprehensive Rules of Magic: The Gathering, version 2026-02-27."""@en .

[] rdf:type owl:AllDisjointClasses ;
   owl:members ( :Color
                 :Rarity
                 :SuperType
                 :CardType
                 :SubType
                 :Format
                 :Language
                 :Legality ) .

[] rdf:type owl:AllDisjointClasses ;
   owl:members ( :ArtifactTypes
                 :EnchantmentTypes
                 :PlaneswalkerTypes
                 :SpellTypes
                 :CreatureTypes
                 :LandTypes
                 :PlanarTypes
                 :DungeonType
                 :BattleType ) .


################################################################################
#
#  Class Definitions
#
################################################################################

# --- Deck Classes ---

:Deck rdf:type owl:Class ;
      rdfs:label "Deck" ;
      rdfs:comment
      """A generic constructed or limited deck. See rules
100.2a, 100.2b, and 100.5."""@en .

:CommanderDeck rdf:type owl:Class ;
               rdfs:subClassOf :Deck ;
               rdfs:label "Commander Deck" ;
               rdfs:comment
               """A constructed deck for the Commander format.
See rule 903."""@en .

:StandardDeck rdf:type owl:Class ;
              rdfs:subClassOf :Deck ;
              rdfs:label "Standard Deck" ;
              rdfs:comment
              """A constructed deck for the Standard format.
See rules 100.2a and 100.6."""@en .

:ModernDeck rdf:type owl:Class ;
            rdfs:subClassOf :Deck ;
            rdfs:label "Modern Deck" ;
            rdfs:comment
            """A constructed deck for the Modern format.
See rules 100.2a and 100.6."""@en .

:PioneerDeck rdf:type owl:Class ;
             rdfs:subClassOf :Deck ;
             rdfs:label "Pioneer Deck" ;
             rdfs:comment
             """A constructed deck for the Pioneer format.
See rules 100.2a and 100.6."""@en .

:LegacyDeck rdf:type owl:Class ;
            rdfs:subClassOf :Deck ;
            rdfs:label "Legacy Deck" ;
            rdfs:comment
            """A constructed deck for the Legacy format.
See rules 100.2a and 100.6."""@en .

:VintageDeck rdf:type owl:Class ;
             rdfs:subClassOf :Deck ;
             rdfs:label "Vintage Deck" ;
             rdfs:comment
             """A constructed deck for the Vintage format.
See rules 100.2a and 100.6."""@en .

:PauperDeck rdf:type owl:Class ;
            rdfs:subClassOf :Deck ;
            rdfs:label "Pauper Deck" ;
            rdfs:comment
            """A constructed deck for the Pauper format.
See rules 100.2a and 100.6."""@en .

# ------------------------------------------------------------------------------
# Card Classes (including its attribute classes)
# - Color
# - Super Type
# - Card Type
# - Sub Type
# - Rarity
# - Set
# - Language
# - Legality
# - Format
# ------------------------------------------------------------------------------
:Card rdf:type owl:Class ;
      rdfs:label "Magic Card" ;
      rdfs:comment
      """A specific Magic: The Gathering card.
See rules 108.1 and 108.2."""@en .

# --- Color Attribute Class ---
:Color rdf:type owl:Class ;
       owl:equivalentClass [
           rdf:type owl:Class ;
           owl:oneOf (
               :White
               :Blue
               :Black
               :Red
               :Green
           )
       ] ;
       rdfs:label "Color" ;
       rdfs:comment
       """The five colors of Magic: White, Blue, Black, Red, and Green.
Colorless is not a color (rule 105.2c) and is modeled separately.
See rules 105.1 and 105.2."""@en .

# --- Super Type Attribute Class ---
:SuperType rdf:type owl:Class ;
           owl:equivalentClass [
               rdf:type owl:Class ;
               owl:oneOf (
                   :Basic
                   :Elite
                   :Host
                   :Legendary
                   :Ongoing
                   :Snow
                   :Token
                   :World
               )
           ] ;
           rdfs:label "Super Type" ;
           rdfs:comment
           """An additional classification that precedes the card
type and provides additional rules or characteristics to a card.
It is called supertype in the rules, but it is not a real supertype
but should be considered as a modifier of the card type.
See rules 205.4 and 205.4a."""@en .

# --- Card Type Attribute Class ---
:CardType rdf:type owl:Class ;
          owl:equivalentClass [
              rdf:type owl:Class ;
              owl:oneOf (
                  :Artifact
                  :Battle
                  :Conspiracy
                  :Creature
                  :Dungeon
                  :Enchantment
                  :Instant
                  :Kindred
                  :Land
                  :Phenomenon
                  :Plane
                  :Planeswalker
                  :Scheme
                  :Sorcery
                  :Summon
                  :Vanguard
              )
          ] ;
          rdfs:label "Card Type" ;
          rdfs:comment
          """The primary classification of a card.
A card can have one or more card types, separated by a space.
See rules 205.2a and 300.1."""@en .

# ------------------------------------------------------------------------------
# --- Sub Type Attribute Class ---
# - Artifact Types
# - Enchantment Types
# - Planeswalker Types
# - Spell Types
# - Creature Types
# - Land Types
# - Planar Types
# - Dungeon Types
# - Battle Types
# ------------------------------------------------------------------------------
:SubType rdf:type owl:Class ;
         owl:equivalentClass [
             rdf:type owl:Class ;
             owl:unionOf (
                 :ArtifactTypes
                 :EnchantmentTypes
                 :PlaneswalkerTypes
                 :SpellTypes
                 :CreatureTypes
                 :LandTypes
                 :PlanarTypes
                 :DungeonType
                 :BattleType
             )
         ] ;
         rdfs:label "Sub Type" ;
         rdfs:comment
         """A sub-classification that provides more specific
categorical information to the primary card type, separated by a long dash.
Each word after the dash is a separate subtype. See rule 205.3."""@en .

# --- Sub Type Classes ---
# NOTE: The rdfs:subClassOf :SubType on each class below is materially entailed
# by the owl:unionOf in the SubType equivalentClass above. It is kept explicitly
# for readability and to make the class hierarchy navigable without a reasoner.
:ArtifactTypes rdf:type owl:Class ;
               rdfs:subClassOf :SubType ;
               owl:equivalentClass [
                   rdf:type owl:Class ;
                   owl:oneOf (
                       :Attraction
                       :Blood
                       :Bobblehead
                       :Clue
                       :Contraption
                       :Equipment
                       :Food
                       :Fortification
                       :Gold
                       :Incubator
                       :Infinity
                       :Junk
                       :Lander
                       :Map
                       :Mutagen
                       :Powerstone
                       :Spacecraft
                       :Stone
                       :Treasure
                       :Vehicle
                   )
               ] ;
               rdfs:label "Artifact Types" ;
               rdfs:comment
               """Artifact subtypes are always a single word and
are listed after a long dash. Artifact subtypes are also called artifact types,
and artifacts may have multiple subtypes. See rules 301.3 and 205.3g."""@en .

:EnchantmentTypes rdf:type owl:Class ;
                  rdfs:subClassOf :SubType ;
                  owl:equivalentClass [
                      rdf:type owl:Class ;
                      owl:oneOf (
                          :Aura
                          :Background
                          :Cartouche
                          :Case
                          :Class
                          :Curse
                          :Role
                          :Room
                          :Rune
                          :Saga
                          :Shard
                          :Shrine
                      )
                  ] ;
                  rdfs:label "Enchantment Types" ;
                  rdfs:comment
                  """Enchantment subtypes are always a single word and are
listed after a long dash. Each word after the dash is a separate
subtype. Enchantment subtypes are also called enchantment types, and
enchantments may have multiple subtypes. See rules 303.3 and 205.3h."""@en .

:PlaneswalkerTypes rdf:type owl:Class ;
                   rdfs:subClassOf :SubType ;
                   owl:equivalentClass [
                       rdf:type owl:Class ;
                       owl:oneOf (
                           :Ajani :Aminatou :Angrath :Arlinn :Ashiok :Bahamut
                           :Basri :Bolas :Calix :Chandra :Comet :Dack :Dakkon
                           :Daretti :Davriel :Dihada :Domri :Dovin :Ellywick
                           :Elminster :Elspeth :Estrid :Freyalise :Garruk
                           :Gideon :Grist :Guff :Huatli :Jace :Jared :Jaya
                           :Jeska :Kaito :Karn :Kasmina :Kaya :Kiora :Koth
                           :Liliana :Lolth :Lukka :Minsc :Mordenkainen :Nahiri
                           :Narset :Niko :Nissa :Nixilis :Oko :Quintorius :Ral
                           :Rowan :Saheeli :Samut :Sarkhan :Serra :Sivitri
                           :Sorin :Szat :Tamiyo :Tasha :Teferi :Teyo :Tezzeret
                           :Tibalt :Tyvar :Ugin :Urza :Venser :Vivien :Vraska
                           :Vronos :Will :Windgrace :Wrenn :Xenagos :Yanggu
                           :Yanling :Zariel
                       )
                   ] ;
                   rdfs:label "Planeswalker Types" ;
                   rdfs:comment
                   """Planeswalker subtypes are always a single
word and are listed after a long dash. Each word after the dash is a separate
subtype. Planeswalker subtypes are also called planeswalker types, and
planeswalkers may have multiple subtypes. See rules 306.3 and 205.3j."""@en .

:SpellTypes rdf:type owl:Class ;
            rdfs:subClassOf :SubType ;
            owl:equivalentClass [
                rdf:type owl:Class ;
                owl:oneOf (
                    :Adventure
                    :Arcane
                    :Lesson
                    :Omen
                    :Trap
                )
            ] ;
            rdfs:label "Spell Types" ;
            rdfs:comment
            """Instant and sorcery subtypes are called spell types.
They are always a single word and are listed after a long dash, and instants
and sorceries may have multiple subtypes. See rules 304.3, 307.3, and 205.3k.
"""@en .

:CreatureTypes rdf:type owl:Class ;
               rdfs:subClassOf :SubType ;
               owl:equivalentClass [
                   rdf:type owl:Class ;
                   owl:oneOf (
                       :Advisor :Aetherborn :Alien :Ally :Angel :Antelope
                       :Ape :Archer :Archon :Armadillo :Army :Artificer
                       :Assassin :AssemblyWorker :Astartes :Atog :Aurochs
                       :Avatar :Azra :Badger :Balloon :Barbarian :Bard :Basilisk
                       :Bat :Bear :Beast :Beaver :Beeble :Beholder
                       :Berserker :Bird :Bison :Blinkmoth :Boar :Bringer
                       :Brushwagg :Camarid :Camel :Capybara :Caribou :Carrier
                       :Cat :Centaur :Child :Chimera :Citizen :Cleric
                       :Clown :Cockatrice :Construct :Coward :Coyote :Crab
                       :Crocodile :Custodes :Cyberman :Cyclops :Ctan :Dalek
                       :Dauthi :Demigod :Demon :Deserter :Detective :Devil
                       :Dinosaur :Djinn :Doctor :Dog :Dragon :Drake
                       :Dreadnought :Drix :Drone :Druid :Dryad :Dwarf
                       :Echidna :Efreet :Egg :Elder :Eldrazi :Elemental
                       :Elephant :Elf :Elk :Employee :Eye :Faerie
                       :Ferret :Fish :Flagbearer :Fox :Fractal :Frog
                       :Fungus :Gamer :Gargoyle :Germ :Giant :Gith
                       :Glimmer :Gnoll :Gnome :Goat :Goblin :God
                       :Golem :Gorgon :Graveborn :Gremlin :Griffin :Guest
                       :Hag :Halfling :Hamster :Harpy :Hedgehog :Hellion
                       :Hero :Hippo :Hippogriff :Homarid :Homunculus :Horror
                       :Horse :Human :Hydra :Hyena :Illusion :Imp
                       :Incarnation :Inkling :Inquisitor :Insect :Jackal
                       :Jellyfish :Juggernaut :Kangaroo :Kavu :Kirin :Kithkin
                       :Knight :Kobold :Kor :Kraken :Lamia :Lammasu :Leech
                       :Lemur :Leviathan :Lhurgoyf :Licid :Lizard :Llama
                       :Lobster :Manticore :Masticore :Mercenary :Merfolk
                       :Metathran :Minion :Minotaur :Mite :Mole :Monger
                       :Mongoose :Monk :Monkey :Moogle :Moonfolk :Mount :Mouse
                       :Mutant :Myr :Mystic :Nautilus :Necron :Nephilim
                       :Nightmare :Nightstalker :Ninja :Noble :Noggle :Nomad
                       :Nymph :Octopus :Ogre :Ooze :Orb :Orc
                       :Orgg :Otter :Ouphe :Ox :Oyster :Pangolin
                       :Peasant :Pegasus :Pentavite :Performer :Pest
                       :Phelddagrif :Phoenix :Phyrexian :Pilot :Pincher :Pirate
                       :Plant :Platypus :Porcupine :Possum :Praetor :Primarch
                       :Prism :Processor :Qu :Rabbit :Raccoon :Ranger :Rat
                       :Rebel :Reflection :Rhino :Rigger :Robot :Rogue
                       :Sable :Salamander :Samurai :Sand :Saproling :Satyr
                       :Scarecrow :Scientist :Scion :Scorpion :Scout :Sculpture
                       :Seal :Serf :Serpent :Servo :Shade :Shaman
                       :Shapeshifter :Shark :Sheep :Siren :Skeleton :Skunk
                       :Slith :Sliver :Sloth :Slug :Snail :Snake
                       :Soldier :Soltari :Sorcerer :Spawn :Specter :Spellshaper
                       :Sphinx :Spider :Spike :Spirit :Splinter :Sponge
                       :Squid :Squirrel :Starfish :Surrakar :Survivor :Symbiote
                       :Synth :Tentacle :Tetravite :Thalakos :Thopter :Thrull
                       :Tiefling :TimeLord :Toy :Treefolk :Trilobite
                       :Triskelavite :Troll :Turtle :Tyranid :Unicorn :Utrom
                       :Vampire :Varmint :Vedalken :Villain :Volver :Wall
                       :Walrus :Warlock :Warrior :Weasel :Weird :Werewolf :Whale
                       :Wizard :Wolf :Wolverine :Wombat :Worm :Wraith
                       :Wurm :Yeti :Zombie :Zubera
                   )
               ] ;
               rdfs:label "Creature Type" ;
               rdfs:comment
               """Creature and kindred subtypes are called creature
types. Creature subtypes are usually a single word long and are listed after a
long dash, and creatures and kindreds may have multiple subtypes.
See rules 302.3, 308.2, and 205.3m."""@en .

:LandTypes rdf:type owl:Class ;
           rdfs:subClassOf :SubType ;
           owl:equivalentClass [
               rdf:type owl:Class ;
               owl:unionOf (
                   [
                       rdf:type owl:Class ;
                       owl:oneOf (
                           :Cave
                           :Desert
                           :Gate
                           :Lair
                           :Locus
                           :Mine
                           :Planet
                           :PowerPlant
                           :Sphere
                           :Tower
                           :Town
                           :Urzas
                       )
                   ]
                   :BasicLandTypes
               )
           ] ;
           rdfs:label "Land Types" ;
           rdfs:comment
           """Land subtypes are always a single word and are listed
 after a long dash. Land subtypes are also called land types, and lands may have
 multiple subtypes. See rules 305.5 and 205.3i."""@en .

:BasicLandTypes rdf:type owl:Class ;
                rdfs:subClassOf :LandTypes ;
                owl:equivalentClass [
                    rdf:type owl:Class ;
                    owl:oneOf (
                        :Plains
                        :Island
                        :Swamp
                        :Mountain
                        :Forest
                    )
                ] ;
                rdfs:label "Basic Land Types" ;
                rdfs:comment
                """The basic land types are Plains, Island, Swamp,
Mountain, and Forest. An object with the land card type and a basic land type
has the intrinsic mana ability associated with that type. See rules 305.6 and
205.3i."""@en .

:PlanarTypes rdf:type owl:Class ;
             rdfs:subClassOf :SubType ;
             owl:equivalentClass [
                 rdf:type owl:Class ;
                 owl:oneOf (
                     :Alara :AlfavaMetraxis :Amonkhet :AndrozaniMinor :Antausia
                     :Apalapucia :Arcavios :Arkhos :Avishkar :Azgol :Belenon
                     :BolassMeditationRealm :Capenna :Cridhe :Darillium
                     :Dominaria :Earth :Echoir :Eldraine :Equilor :Ergamon
                     :Fabacin :Fiora :Gallifrey :Gargantikar :Gobakhan
                     :HorseheadNebula :Ikoria :Innistrad :Iquatana :Ir :Ixalan
                     :Kaldheim :Kamigawa :Kandoka :Karsus :Kephalai :Kinshala
                     :Kolbahan :Kylem :Kyneth :Lorwyn :Luvion :Mars :Mercadia
                     :Mirrodin :Moag :Mongseng :Moon :Muraganda :Necros
                     :NewEarth :NewPhyrexia :OutsideMuttersSpiral :Phyrexia
                     :Pyrulea :Rabiah :Rath :Ravnica :Regatha :Segovia
                     :SerrasRealm :Shadowmoor :Shandalar :Shenmeng :Skaro
                     :SpacecraftPlanar :Tarkir :TheAbyss :TheDalekAsylum
                     :TheLibrary :Theros :Time :Trenzalore :Ulgrotha
                     :UnknownPlanet :Valla :Vryn :Wildfire :Xerex :Zendikar
                     :Zhalfir
               )
             ] ;
             rdfs:label "Planar Types" ;
             rdfs:comment
             """Plane subtypes are called planar types. They are
listed after a long dash and may be multiple words; all words after the dash are
collectively a single subtype, and a plane can have only one subtype. See rules
311.3 and 205.3n."""@en .

:DungeonType rdf:type owl:Class ;
             rdfs:subClassOf :SubType ;
             owl:equivalentClass [
                rdf:type owl:Class ;
                   owl:oneOf (
                       :Undercity
                   )
               ] ;
               rdfs:label "Dungeon Types" ;
               rdfs:comment
               """One dungeon card, Undercity, has a subtype; this
subtype is called a dungeon type. See rule 205.3p."""@en .

:BattleType rdf:type owl:Class ;
               rdfs:subClassOf :SubType ;
               owl:equivalentClass [
                   rdf:type owl:Class ;
                   owl:oneOf (
                       :Siege
                   )
               ] ;
               rdfs:label "Battle Types" ;
               rdfs:comment
               """Battle subtypes are always a single word and are
listed after a long dash. Battle subtypes are also called battle types, and the
only battle type is Siege. See rules 310.3 and 205.3q."""@en .

# --- Rarity Attribute Class ---
:Rarity rdf:type owl:Class ;
        owl:equivalentClass [
            rdf:type owl:Class ;
            owl:oneOf (
                :Common
                :Uncommon
                :Rare
                :MythicRare
                :Special
                :Bonus
                :Promo
                :LandRarity
            )
        ] ;
        rdfs:label "Rarity" ;
        rdfs:comment
        """Rarity of a Magic card. See rules 206.2 and
213.1b."""@en .

# --- Set Attribute Class ---
:Set rdf:type owl:Class ;
     owl:hasKey ( :setName ) ;
     owl:hasKey ( :setCode ) ;
     rdfs:label "Set" ;
     rdfs:comment
     """A Magic: The Gathering expansion or set.
See rules 206.1 and 206.5."""@en .

# --- Language Attribute Class ---
:Language rdf:type owl:Class ;
          owl:equivalentClass [
              rdf:type owl:Class ;
              owl:oneOf (
                  :English
                  :German
                  :Japanese
                  :Spanish
              )
          ] ;
          rdfs:label "Language" ;
          rdfs:comment
          """Language of the card print. See rules 201.2 and
213.1e."""@en .

# --- Legality Attribute Classes ---
:Legality rdf:type owl:Class ;
          owl:equivalentClass [
              rdf:type owl:Class ;
              owl:oneOf (
                  :Legal
                  :NotLegal
                  :Banned
                  :Restricted
              )
          ] ;
          rdfs:label "Legality" ;
          rdfs:comment
          """The tournament legality status of a card.
See rules 100.6 and 206.4."""@en .

:LegalityMapping rdf:type owl:Class ;
                 rdfs:label "Legality Mapping" ;
                 rdfs:comment
                 """An intermediate class associating a Card,
a Format, and a Legality Status. See rules 100.6 and 206.4."""@en .

# --- Format Attribute Class ---
:Format rdf:type owl:Class ;
        owl:equivalentClass [
            rdf:type owl:Class ;
            owl:oneOf (
                :Alchemy
                :Archenemy
                :ArchenemyCommander
                :BoosterDraft
                :Brawl
                :Commander
                :Commander1v1
                :CommanderLimited
                :ConspiracyFormat
                :Freeform
                :Historic
                :Legacy
                :Limited
                :Modern
                :MomirBasic
                :Oathbreaker
                :Pauper
                :PickTwoDraft
                :Pioneer
                :Planechase
                :SealedDeck
                :Standard
                :TeamBoosterDraft
                :TeamSealedDeck
                :Timeless
                :TwoHeadedGiant
                :Vintage
            )
        ] ;
        rdfs:label "Format" ;
        rdfs:comment
        """A game format extracted from the Magic Webpage.
See rules 100.6 and 206.4."""@en .

:Ruling rdf:type owl:Class ;
        rdfs:label "Ruling" ;
        rdfs:comment
        """Specific rules clarifications for a card, published
alongside Oracle text. See rule 108.1."""@en .

# ------------------------------------------------------------------------------
# Card text related classes: Keyword Classes
# - Keyword Action
# - Keyword Ability
# ------------------------------------------------------------------------------

:Keyword rdf:type owl:Class ;
         owl:equivalentClass [
             rdf:type owl:Class ;
             owl:unionOf (
                 :KeywordAction
                 :KeywordAbility
             )
         ] ;
         rdfs:label "Keyword" ;
         rdfs:comment
         """A Magic game mechanic represented as a keyword action
 or keyword ability. A keyword is a word or phrase that is used to describe a
 game mechanic. See rules 701.1 and 702.1."""@en .

:KeywordAction rdf:type owl:Class ;
               rdfs:subClassOf :Keyword ;
               owl:disjointWith :KeywordAbility ;
               owl:equivalentClass [
                   rdf:type owl:Class ;
                   owl:oneOf (
                        :Abandon
                        :Activate
                        :Adapt
                        :Airbend
                        :Amass
                        :Assemble
                        :Attach
                        :Behold
                        :Blight
                        :Bolster
                        :Cast
                        :Clash
                        :Cloak
                        :CollectEvidence
                        :Connive
                        :Convert
                        :Counter
                        :Create
                        :Destroy
                        :Detain
                        :Discard
                        :Discover
                        :Double
                        :Earthbend
                        :Endure
                        :Exchange
                        :Exert
                        :Exile
                        :Explore
                        :FaceAVillainousChoice
                        :Fateseal
                        :Fight
                        :Forage
                        :Goad
                        :Harness
                        :Incubate
                        :Investigate
                        :Learn
                        :Manifest
                        :ManifestDread
                        :Meld
                        :Mill
                        :Monstrosity
                        :OpenAnAttraction
                        :Planeswalk
                        :Play
                        :Populate
                        :Proliferate
                        :Regenerate
                        :Reveal
                        :RollToVisitYourAttractions
                        :Sacrifice
                        :Scry
                        :Search
                        :SetInMotion
                        :Shuffle
                        :Support
                        :Surveil
                        :Suspect
                        :Tap
                        :TheRingTemptsYou
                        :TimeTravel
                        :Transform
                        :Triple
                        :Untap
                        :VentureIntoTheDungeon
                        :Vote
                        :Waterbend
                   )
               ] ;
               rdfs:label "Keyword Action" ;
               rdfs:comment
               """A keyword that represents a defined game action
in Magic. See rules 205.3a and 205.3b."""@en .

:KeywordAbility rdf:type owl:Class ;
                rdfs:subClassOf :Keyword ;
                owl:disjointWith :KeywordAction ;
                owl:equivalentClass [
                    rdf:type owl:Class ;
                    owl:oneOf (
                        :Absorb
                        :Affinity
                        :Afflict
                        :Afterlife
                        :Aftermath
                        :Amplify
                        :Annihilator
                        :Ascend
                        :Assist
                        :AuraSwap
                        :Awaken
                        :Backup
                        :Banding
                        :BandsWithOthers
                        :Bargain
                        :BattleCry
                        :Bestow
                        :Blitz
                        :Bloodthirst
                        :Boast
                        :Bushido
                        :Buyback
                        :Cascade
                        :Casualty
                        :Champion
                        :Changeling
                        :Cipher
                        :Cleave
                        :Companion
                        :Compleated
                        :Conspire
                        :Convoke
                        :Craft
                        :Crew
                        :CumulativeUpkeep
                        :Cycling
                        :Dash
                        :Daybound
                        :Deathtouch
                        :Decayed
                        :Defender
                        :Delve
                        :Demonstrate
                        :Dethrone
                        :Devoid
