# --- Legalities ---
:Legal rdf:type :Legality ;
       rdfs:label "Legal" ;
       rdfs:comment "The card is fully legal to play in the format."@en .
:NotLegal rdf:type :Legality ;
          rdfs:label "Not Legal" ;
          rdfs:comment
          """The card is not legal because it was never printed in a set legal
for this format."""@en .
:Banned rdf:type :Legality ;
        rdfs:label "Banned" ;
        rdfs:comment
        """The card is explicitly forbidden from being played in the
format."""@en .
:Restricted rdf:type :Legality ;
            rdfs:label "Restricted" ;
            rdfs:comment
            """The card is limited to a single copy per deck in the format
(primarily Vintage)."""@en .

# --- Summon Card  (only individual card that is of Summon type) ---
:OldFogey rdf:type :Card ;
          :cardName "Old Fogey" ;
          :manaCost "{G}{G}" ;
          :manaValue 2 ;
          # :hasSuperType <none> ;
          :hasCardType :Summon ;
          :hasSubType :Dinosaur ;
          :hasRarity :Rare ;
          :hasColorIdentity :Green ;
          :isInSet :Unsanctioned ;
          :cardNumber 67 ;
          # :cardNumberString <none> ;
          # :cardCount <none> ;
          :artist "Douglas Shuler" ;
          :hasLanguage :English ;
          # :power "7" ;
          :powerValue 7 ;
          # :toughness "7" ;
          :toughnessValue 7 ;
          # :loyalty <none> ;
          :printedText
          """Phasing, cumulative upkeep {1}, echo, fading 3, bands with
other Dinosaurs, protection from Homarids, snow-covered plainswalk,
flanking, rampage 2"""@en ;
          :oracleText
          """Phasing, cumulative upkeep {1}, echo {G}{G}, fading 3, bands
with other Dinosaurs, protection from Homarids, snow-covered
plainswalk, flanking, rampage 2"""@en ;
          :flavorText
          """These kids today with their collector numbers and their
newfangled tap symbol. Twenty Black Lotuses and twenty Plague Rats.
Now that's real Magic."""@en ;
          :hasKeywordAbility :BandsWithOthers ,
                             :CumulativeUpkeep ,
                             :Echo ,
                             :Fading ,
                             :Flanking ,
                             :Phasing ,
                             :Plainswalk ,
                             :Protection ,
                             :Rampage ;
          :gathererUrl
          "https://gatherer.wizards.com/UND/en-us/67/old-fogey"^^xsd:anyURI ;
          :hasLegality [ rdf:type :LegalityMapping ;
                         :inFormat :Commander ;
                         :hasLegalityStatus :NotLegal
                       ] ,
                       [ rdf:type :LegalityMapping ;
                         :inFormat :Legacy ;
                         :hasLegalityStatus :NotLegal
                       ] ,
                       [ rdf:type :LegalityMapping ;
                         :inFormat :Vintage ;
                         :hasLegalityStatus :NotLegal
                       ] ,
                       [ rdf:type :LegalityMapping ;
                         :inFormat :Standard ;
                         :hasLegalityStatus :NotLegal
                       ] ,
                       [ rdf:type :LegalityMapping ;
                         :inFormat :Modern ;
                         :hasLegalityStatus :NotLegal
                       ] ,
                       [ rdf:type :LegalityMapping ;
                         :inFormat :Pioneer ;
                         :hasLegalityStatus :NotLegal
                       ] ,
                       [ rdf:type :LegalityMapping ;
                         :inFormat :Pauper ;
                         :hasLegalityStatus :NotLegal
                       ] ;
          # :isInDeck <none> ;
          # :isCommanderOf <none> ;
          :hasRuling [rdf:type :Ruling ;
                      :rulingDate "2020-02-29"^^xsd:date ;
                      :rulingText
                      """Due to changes in how echo and phasing work since Old
Fogey was originally printed, echo mostly does nothing in this case.
This is, as they say, a bit weird. Old Fogey is phased out when
its echo ability would trigger, so that ability doesn't trigger
at the beginning of the upkeep after Old Fogey enters the
battlefield. Phasing in doesn't cause Old Fogey to enter the
battlefield, so echo ends up not really doing much at all."""@en
                    ] .