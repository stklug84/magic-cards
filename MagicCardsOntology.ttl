       rdfs:comment "A savage, hyena-like humanoid."@en .
:Gnome rdf:type :SubType ;
       rdfs:label "Gnome" ;
       rdfs:comment "A small, inventive humanoid known for artifice and tinkering."@en .
:Goat rdf:type :SubType ;
