:Reveal rdf:type :KeywordAction ;
        rdfs:label "Reveal" ;
        rdfs:comment "To show a card to all players for a brief time."@en .
:RollToVisitYourAttractions rdf:type :KeywordAction ;
                            rdfs:label "Roll to Visit Your Attractions" ;
                            rdfs:comment """A keyword action that rolls a
