# --- Keywords ---
# --- Keyword Actions ---
:Abandon rdf:type owl:NamedIndividual ,
                  :KeywordAction ;
         rdfs:label "Abandon" ;
         rdfs:comment """To turn a face-up ongoing scheme card face down and put
it on the bottom of its owner’s scheme deck."""@en .
:Activate rdf:type owl:NamedIndividual ,
                   :KeywordAction ;
          rdfs:label "Activate" ;
          rdfs:comment """To put an activated ability onto the stack and pay its
costs, so that it will eventually resolve and have its effect."""@en .
:Adapt rdf:type owl:NamedIndividual ,
                :KeywordAction ;
       rdfs:label "Adapt" ;
       rdfs:comment """A keyword action that puts +1/+1 counters on a creature
that doesn’t have any yet."""@en .
:Airbend rdf:type owl:NamedIndividual ,
                  :KeywordAction ;
         rdfs:label "Airbend" ;
         rdfs:comment """A keyword action that exiles one or more permanents
and/or spells. The owner of each card exiled with airbend may cast it from exile
by paying {2} rather than paying its mana cost."""@en .
:Amass rdf:type owl:NamedIndividual ,
                :KeywordAction ;
       rdfs:label "Amass" ;
       rdfs:comment """A keyword action that gives you a Zombie Army creature
token or grows an Army you already have."""@en .
:Assemble rdf:type owl:NamedIndividual ,
                   :KeywordAction ;
          rdfs:label "Assemble" ;
          rdfs:comment """A keyword action that puts Contraptions onto the
battlefield."""@en .
:Attach rdf:type owl:NamedIndividual ,
                 :KeywordAction ;
        rdfs:label "Attach" ;
        rdfs:comment """To take an Aura, Equipment, or Fortification from where
it currently is and put it onto a specified object or player."""@en .
:Behold rdf:type owl:NamedIndividual ,
                 :KeywordAction ;
        rdfs:label "Behold" ;
        rdfs:comment """A keyword action that allows a player to choose a
