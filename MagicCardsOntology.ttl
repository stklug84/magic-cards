:Swamp rdf:type :SubType ;
       rdfs:label "Swamp" ;
       rdfs:comment
       """A basic land type that inherently produces black mana."""@en .
:Tower rdf:type :SubType ;
       rdfs:label "Tower" ;
       rdfs:comment "A land type, one of the three Urza's land types."@en .
:Town rdf:type :SubType ;
      rdfs:label "Town" ;
      rdfs:comment "A land type representing a settlement or community."@en .
:Urzas rdf:type :SubType ;
       rdfs:label "Urza's" ;
       rdfs:comment
       """A land type representing an association with the legendary artificer
