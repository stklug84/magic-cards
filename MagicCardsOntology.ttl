    ] ;
    rdfs:label "Battle Card" ;
    rdfs:comment "A class representing any card with the Battle card type to enforce restrictions."@en .

# --- Enchantment Constraints ---
:EnchantmentCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Enchantment
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Legendary :Snow :World )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "3"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :EnchantmentTypes
    ] ;
    rdfs:label "Enchantment Card" ;
    rdfs:comment "A class representing any card with the Enchantment card type to enforce constraints."@en .

# --- Planeswalker Constraints ---
:PlaneswalkerCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasCardType ;
                owl:hasValue :Planeswalker
            ]
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasSuperType ;
                owl:hasValue :Legendary
            ]
        )
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :PlaneswalkerTypes
    ] ;
    rdfs:label "Planeswalker Card" ;
    rdfs:comment "A class representing planeswalker cards, which must have the Legendary supertype."@en .

# --- Spell Constraints ---
:SpellCardConstraint rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Instant :Sorcery )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Legendary :Snow )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "2"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :SpellTypes
    ] ;
    rdfs:label "Spell Card Constraint" ;
    rdfs:comment "A class representing any card with the Instant or Sorcery card type to enforce constraints."@en .

# --- Basic Land Constraints ---
:BasicLandCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :LandCard
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasSuperType ;
                owl:hasValue :Basic
            ]
        )
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:allValuesFrom :BasicLandTypes
    ] ;
    rdfs:label "Basic Land Card" ;
    rdfs:comment "A class representing land cards with the Basic supertype."@en .

# --- Phenomenon Constraints ---
:PhenomenonCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Phenomenon
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Phenomenon Card" ;
    rdfs:comment "A class representing any card with the Phenomenon card type to enforce restrictions."@en .

# --- Scheme Constraints ---
:SchemeCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Scheme
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:oneOf ( :Ongoing )
        ]
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Scheme Card" ;
    rdfs:comment "A class representing any card with the Scheme card type to enforce restrictions."@en .

# --- Vanguard Constraints ---
:VanguardCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Vanguard
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Vanguard Card" ;
    rdfs:comment "A class representing any card with the Vanguard card type to enforce restrictions."@en .

# --- Conspiracy Constraints ---
:ConspiracyCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Conspiracy
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSuperType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :hasSubType ;
        owl:maxCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Conspiracy Card" ;
    rdfs:comment "A class representing any card with the Conspiracy card type to enforce restrictions."@en .

# --- Summon Constraints ---
:SummonCard rdf:type owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasCardType ;
        owl:hasValue :Summon
    ] ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:oneOf ( :OldFogey )
    ] ;
    rdfs:label "Summon Card" ;
    rdfs:comment "A class representing the Summon card type, which only applies to the card Old Fogey."@en .


