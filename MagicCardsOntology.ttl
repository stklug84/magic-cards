# --- Enchantment Types ---
:Aura rdf:type :SubType ;
      rdfs:label "Aura" ;
      rdfs:comment
      """An enchantment type that attaches to another permanent or
player."""@en .
:Background rdf:type :SubType ;
            rdfs:label "Background" ;
            rdfs:comment
            """An enchantment type used in Commander drafting to act as a second
commander."""@en .
:Cartouche rdf:type :SubType ;
           rdfs:label "Cartouche" ;
           rdfs:comment
           """An Aura enchantment type representing a specific Amonkhet
trial."""@en .
:Case rdf:type :SubType ;
      rdfs:label "Case" ;
      rdfs:comment
      """An enchantment type representing an investigation that can be 'solved'
for an extra effect."""@en .
:Class rdf:type :SubType ;
       rdfs:label "Class" ;
       rdfs:comment
       """An enchantment type representing a character class that levels up over
time."""@en .
:Curse rdf:type :SubType ;
       rdfs:label "Curse" ;
       rdfs:comment
       """An Aura enchantment type that enchants and negatively impacts a
player."""@en .
:Role rdf:type :SubType ;
      rdfs:label "Role" ;
      rdfs:comment
      """An Aura enchantment type representing a specific role assigned to a
creature."""@en .
:Room rdf:type :SubType ;
      rdfs:label "Room" ;
      rdfs:comment
      """An enchantment type representing a location within a house or
dungeon."""@en .
:Rune rdf:type :SubType ;
      rdfs:label "Rune" ;
      rdfs:comment
      """An Aura enchantment type representing powerful Kaldheim magic."""@en .
:Shard rdf:type :SubType ;
       rdfs:label "Shard" ;
       rdfs:comment
       """An enchantment type representing a fragment of Niko Aris's
magic."""@en .
:Shrine rdf:type :SubType ;
        rdfs:label "Shrine" ;
        rdfs:comment
        """An enchantment type depicting a place of worship that scales based on
the number of Shrines."""@en .

