# --- Keywords ---
# --- Keyword Actions ---
:Abandon rdf:type :KeywordAction ;
         rdfs:label "Abandon" ;
         rdfs:comment """To turn a face-up ongoing scheme card face down and put
it on the bottom of its owner’s scheme deck."""@en .
:Activate rdf:type :KeywordAction ;
          rdfs:label "Activate" ;
          rdfs:comment """To put an activated ability onto the stack and pay its
costs, so that it will eventually resolve and have its effect."""@en .
:Adapt rdf:type :KeywordAction ;
       rdfs:label "Adapt" ;
       rdfs:comment """A keyword action that puts +1/+1 counters on a creature
that doesn’t have any yet."""@en .
:Airbend rdf:type :KeywordAction ;
         rdfs:label "Airbend" ;
         rdfs:comment """A keyword action that exiles one or more permanents
and/or spells. The owner of each card exiled with airbend may cast it from exile
by paying {2} rather than paying its mana cost."""@en .
:Amass rdf:type :KeywordAction ;
       rdfs:label "Amass" ;
       rdfs:comment """A keyword action that gives you a Zombie Army creature
token or grows an Army you already have."""@en .
:Assemble rdf:type :KeywordAction ;
          rdfs:label "Assemble" ;
          rdfs:comment """A keyword action that puts Contraptions onto the
battlefield."""@en .
:Attach rdf:type :KeywordAction ;
        rdfs:label "Attach" ;
        rdfs:comment """To take an Aura, Equipment, or Fortification from where
it currently is and put it onto a specified object or player."""@en .
:Behold rdf:type :KeywordAction ;
        rdfs:label "Behold" ;
        rdfs:comment """A keyword action that allows a player to choose a
permanent they control of a particular quality or reveal a card of that quality
from their hand, usually to pay a cost or get an additional effect."""@en .
:Blight rdf:type :KeywordAction ;
        rdfs:label "Blight" ;
        rdfs:comment """A keyword action. To blight N means to put N -1/-1
counters on a creature you control."""@en .
:Bolster rdf:type :KeywordAction ;
         rdfs:label "Bolster" ;
         rdfs:comment """A keyword action that puts +1/+1 counters on the
weakest creature a player controls."""@en .
:Cast rdf:type :KeywordAction ;
      rdfs:label "Cast" ;
      rdfs:comment """To take a card from where it is (usually the hand), put it
on the stack, and pay its costs, so that it will eventually resolve and have its
effect."""@en .
:Clash rdf:type :KeywordAction ;
       rdfs:label "Clash" ;
       rdfs:comment """To have a mini-contest involving the top cards of
players’ libraries."""@en .
:Cloak rdf:type :KeywordAction ;
       rdfs:label "Cloak" ;
       rdfs:comment """A keyword action that puts a card onto the battlefield
face down as a 2/2 creature with ward {2}."""@en .
:CollectEvidence rdf:type :KeywordAction ;
                 rdfs:label "Collect Evidence" ;
                 rdfs:comment """A keyword action. To “collect evidence N” means
to exile any number of cards from your graveyard with total mana value N or
greater."""@en .
:Connive rdf:type :KeywordAction ;
         rdfs:label "Connive" ;
         rdfs:comment """A keyword action that causes a player to draw a card,
discard a card, and then to put a +1/+1 counter on a creature if a nonland card
was discarded this way."""@en .
:Convert rdf:type :KeywordAction ;
         rdfs:label "Convert" ;
         rdfs:comment """To turn a double-faced card so its other face is
up."""@en .
:Counter rdf:type :KeywordAction ;
         rdfs:label "Counter" ;
         rdfs:comment """A keyword action that cancels a spell or ability so it
does not resolve and none of its effects occur."""@en .
:Create rdf:type :KeywordAction ;
        rdfs:label "Create" ;
        rdfs:comment """To create a token is to put a token onto the
battlefield."""@en .
:Destroy rdf:type :KeywordAction ;
         rdfs:label "Destroy" ;
         rdfs:comment """To move a permanent from the battlefield to its owner’s
graveyard."""@en .
:Detain rdf:type :KeywordAction ;
        rdfs:label "Detain" ;
        rdfs:comment """A keyword action that temporarily stops a permanent from
attacking, blocking, or having its activated abilities activated."""@en .
:Discard rdf:type :KeywordAction ;
         rdfs:label "Discard" ;
         rdfs:comment """To move a card from its owner’s hand to that player’s
graveyard."""@en .
:Discover rdf:type :KeywordAction ;
          rdfs:label "Discover" ;
          rdfs:comment """A keyword action that exiles cards from the top of
your library until you exile a nonland card with the required mana value, then
lets you cast it for free or put it into your hand."""@en .
:Double rdf:type :KeywordAction ;
        rdfs:label "Double" ;
        rdfs:comment "A keyword action used in a variety of contexts."@en .
:Earthbend rdf:type :KeywordAction ;
           rdfs:label "Earthbend" ;
           rdfs:comment """A keyword action that makes a land you control into a
hasty 0/0 land creature, puts N +1/+1 counters on it, and returns it tapped
under your control when it dies or is exiled."""@en .
:Endure rdf:type :KeywordAction ;
        rdfs:label "Endure" ;
        rdfs:comment """A keyword action that lets a permanent’s controller
either create an N/N white Spirit creature token or put N +1/+1 counters on that
permanent."""@en .
:Exchange rdf:type :KeywordAction ;
          rdfs:label "Exchange" ;
          rdfs:comment """To swap two things, such as objects, sets of objects,
or life totals."""@en .
:Exert rdf:type :KeywordAction ;
       rdfs:label "Exert" ;
       rdfs:comment """A keyword action that stops a permanent from untapping
during the next untap step of the player who exerted it."""@en .
:Exile rdf:type :KeywordAction ;
       rdfs:label "Exile" ;
       rdfs:comment """A keyword action that puts an object into the exile
zone."""@en .
:Explore rdf:type :KeywordAction ;
         rdfs:label "Explore" ;
         rdfs:comment """A keyword action that causes a player to reveal the top
