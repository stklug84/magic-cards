@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

@prefix : <urn:stklug84:ComputerGamesOntology:2024-09-22> .
@base <urn:stklug84:ComputerGamesOntology:2024-09-22> .


<urn:stklug84:ComputerGamesOntology:2024-09-22> rdf:type owl:Ontology ;
                                                rdfs:label "Computer Games Ontology" ;
                                                rdfs:comment "Describes all my computer games"@en .


#################################################
#
#  Class Definitions
#
#################################################

:Machine rdf:type owl:Class ;
         rdfs:label "Machine Class" ;
         rdfs:comment "A Machine that runs an installed computer game"@en .

:Computer rdf:type owl:Class ;
          rdfs:subClassOf :Machine ;
          owl:equivalentClass [
              rdf:type owl:Class ;
              owl:oneOf (
                     :m18
                     :G5587
              )
          ] ;
          rdfs:label "Computer/Notebook Class" ;
          rdfs:comment "A notebook or gaming machine that runs a computer game"@en .

:Storage rdf:type owl:Class ;
         rdfs:subClassOf :Machine ;
         owl:equivalentClass [
              rdf:type owl:Class ;
              owl:oneOf (
                     :icyBox
                     :icyBoxS
                     :inaTek
                     :m18DriveD
              )
          ] ;
         rdfs:label "Harddisk Class" ;
         rdfs:comment "A harddisk that can store games"@en .

:Smartphone rdf:type owl:Class ;
            rdfs:subClassOf :Machine ;
            rdfs:label "Smartphone Class" ;
            rdfs:comment "A smartphone that can run games inside an emulator"@en .

:OperatingSystem rdf:type owl:Class ;
                 owl:equivalentClass [
                     rdf:type owl:Class ;
                     owl:oneOf (
                            :linux
                            :windows
                     )
                 ] ;
                 rdfs:label "Operating System Class" ;
                 rdfs:comment "Operating system installed on a machine"@en .

:GamingPlatform rdf:type owl:Class ;
                owl:equivalentClass [
                     rdf:type owl:Class ;
                     owl:oneOf (
                            :battle.net
                            :gog
                            :steam
                     )
                ] ;
                rdfs:label "Gaming Platform Class" ;
                rdfs:comment "Platform to buy and stream computer games"@en .

:ComputerGame rdf:type owl:Class ;
              rdfs:label "Computer Games Class" ;
              rdfs:comment "Describes an individual computer game"@en .

:SCummVMGame rdf:type owl:Class ;
             rdfs:subClassOf :ComputerGame ;
             rdfs:label "ScummVM Games Class" ;
             rdfs:comment "Describes a ScummVM Game that can run on the ScummVM platform"@en .

:DownloadableContent rdf:type owl:Class ;
                     rdfs:subClassOf :ComputerGame ;
                     rdfs:label "Downloadable Content Class" ;
                     rdfs:comment "Downloadable content for computer games"@en .

:Tier rdf:type owl:Class ;
      owl:equivalentClass [
              rdf:type owl:Class ;
              owl:oneOf (
                     :tier1
                     :tier2
                     :tier3
                     :tier4
              )
      ] ;
      rdfs:label "Gaming Tier Class" ;
      rdfs:comment "Tier classification for computer games"@en .


#################################################
#
#  Property Definitions
#
#################################################

:isAvailableOn rdf:type owl:ObjectProperty ;
               rdfs:domain :ComputerGame ;
               rdfs:range :GamingPlatform ;
               rdfs:label "Availability on Platforms Property" ;
               rdfs:comment "Describes on which Gaming Platform a Computer Game is available"@en .

:isInstalledOn rdf:type owl:ObjectProperty ;
               rdfs:domain :ComputerGame ;
               rdfs:range :GamingPlatform ;
               rdfs:label "Installation on Gaming Platform Property" ;
               rdfs:comment "Describes which Gaming Platform a Computer Game is installed"@en .

:isProvidedOn rdf:type owl:ObjectProperty ;
               rdfs:domain :GamingPlatform ;
               rdfs:range :Machine ;
               rdfs:label "Installation on Machine Property" ;
               rdfs:comment "Describes on which system a Computer Game is installed"@en .

:runsOn rdf:type owl:ObjectProperty ;
        rdfs:domain :Machine ;
        rdfs:range :OperatingSystem ;
        rdfs:label "Runs on OS Property" ;
        rdfs:comment "The Operating System running on the Machine"@en .

:runsOnStorage rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:subPropertyOf :runsOn ;
               rdfs:domain :Tier ;
               rdfs:range :Storage ;
               rdfs:label "Runs on Storage Property" ;
               rdfs:comment "The Storage device that holds Computer Games belonging to a certain tier"@en .

:belongsToTier rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :ComputerGame ;
               rdfs:range :Tier ;
               rdfs:label "Tier Property" ;
               rdfs:comment "Describes the tier a Computer Game belongs to"@en .

:releasedOn rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :ComputerGame ;
            rdfs:range xsd:date ;
            rdfs:label "Release Date Property" ;
            rdfs:comment "The release date of a Computer Game or Downloadable Content"@en .

:hasDLCsOn rdf:type owl:ObjectProperty ;
           rdfs:domain :ComputerGame ;
           rdfs:range :GamingPlatform ;
           rdfs:label "DLCs Exist Property" ;
           rdfs:comment "DLCs are available on that Gaming PLatform"@en .

:availableDLCs rdf:type owl:ObjectProperty ;
               rdfs:domain :ComputerGame ;
               rdfs:range :DownloadableContent ;
               rdfs:label "DLCs Available Property" ;
               rdfs:comment "DLCs available and not yet bought on Gaming Platform"@en .

:isOnWishlist rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
                  rdfs:domain :DownloadableContent ;
                  rdfs:range xsd:boolean ;
                  rdfs:label "Wishlist Status Property" ;
                  rdfs:comment "Flags if a Computer Game is on the wishlist of a Gaming Platform"@en .

:ownsDLCs rdf:type owl:ObjectProperty ;
          rdfs:domain :ComputerGame ;
          rdfs:range :DownloadableContent ;
          rdfs:label "DLCs in Library Property" ;
          rdfs:comment "DLCs bought on Gaming Platform"@en .

:areAllDLCspurchased rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :ComputerGame ;
                  rdfs:range xsd:boolean ;
                  rdfs:label "DLC Purchase Status Propery" ;
                  rdfs:comment "Flags if all DLCs have been purchased for a Computer Game"@en .

:issueOnInstallation rdf:type owl:DatatypeProperty ;
                     rdfs:domain :ComputerGame ;
                     rdfs:range xsd:string ;
                     rdfs:label "Installation Issue Property" ;
                     rdfs:comment "Describes any issues encountered during installation of the Computer Game"@en .

:issueOnRun rdf:type owl:DatatypeProperty ;
            rdfs:domain :ComputerGame ;
            rdfs:range xsd:string ;
            rdfs:label "Run Issue Property" ;
            rdfs:comment "Describes any issues encountered during execution of the Computer Game"@en .

:alternativeTitle rdf:type owl:DatatypeProperty ;
                  rdfs:domain :ComputerGame ;
                  rdfs:range xsd:string ;
                  rdfs:label "Alternative Title Property" ;
                  rdfs:comment "An alternative title for the Computer Game"@en .


#################################################
#
#  Machine Individuals
#
#################################################

:m18 rdf:type :Computer ;
     :runsOn :windows ;
     rdfs:label "Alienware m18" ;
     rdfs:comment "Alienware m18 Windows Gaming Notebook"@en .

:G5587 rdf:type :Computer ;
       :runsOn :windows ,
               :linux ;
       rdfs:label "Dell G5587" ;
       rdfs:comment "Dell G5587 Notebook"@en .


#################################################
#
#  Storage Individuals
#
#################################################

:icyBox rdf:type :Storage ;
        rdfs:label "ICY BOX IB-3660-U3" ;
        rdfs:comment "ICY BOX"@en .

:icyBoxS rdf:type :Storage ;
         rdfs:label "ICY BOX IB-3660-U3-S" ;
         rdfs:comment "ICY BOX Silver"@en .

:inaTek rdf:type :Storage ;
        rdfs:label "Inatek FE2005" ;
        rdfs:comment "Inatek FE2005"@en .

:m18DriveD rdf:type :Storage ;
           rdfs:label "Alienware m18 Drive D" ;
           rdfs:comment "Internal Drive D of Alienware m18"@en .


#################################################
#
#  Operating System Individuals
#
#################################################

:windows rdf:type :OperatingSystem ;
         rdfs:label "Windows 11" ;
         rdfs:comment "Windows 11 Operating System installation"@en .

:linux rdf:type :OperatingSystem ;
       rdfs:label "Debian 12" ;
       rdfs:comment "Debian 12 Operating System installation"@en .


#################################################
#
#  Gaming Platform Individuals
#
#################################################

:battle.net rdf:type :GamingPlatform ;
            :isProvidedOn :m18 ;
            rdfs:label "Blizzard Battle.net" ;
            rdfs:comment "Blizzard Battle.net Gaming Platform Client"@en .

:steam rdf:type :GamingPlatform ;
       :isProvidedOn :m18 ,
                     :G5587 ;
       rdfs:label "Steam" ;
       rdfs:comment "Valve's Steam Gaming Platform Client"@en .

:gog rdf:type :GamingPlatform ;
     :isProvidedOn :m18 ;
     rdfs:label "Good Old Games" ;
     rdfs:comment "Good Old Games provide mainly DRM free game installers"@en .


#################################################
#
#  Tier Individuals
#
#################################################

:tier1 rdf:type :Tier ;
       :runsOnStorage :m18DriveD ;
       rdfs:label "Tier 1 Gaming Category" ;
       rdfs:comment "Games that we need to be able to play while not being home"@en .

:tier2 rdf:type :Tier ;
       :runsOnStorage :inaTek ;
       rdfs:label "Tier 2 Gaming Category" ;
       rdfs:comment "Games to be played at big living room screen with Elly"@en .

:tier3 rdf:type :Tier ;
       :runsOnStorage :icyBox ;
       rdfs:label "Tier 3 Gaming Category" ;
       rdfs:comment "Games played at home"@en .

#:tier4 rdf:type :Tier ;
#       :runsOnStorage :icyBoxS ;
#       rdfs:label "Tier 4 Gaming Category" ;
#       rdfs:comment "Games that are rarely played"@en .

:tier4 rdf:type :Tier ;
       rdfs:label "Tier 4 Gaming Category" ;
       rdfs:comment "Games that are not installed"@en .
       

