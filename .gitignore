# ignore global .gitignore
!*
.DS_Store

# ignore merge files
*.orig

# ignore html files
*.html

# ignore VSCode files
.vscode/
*.code-workspace

# ignore Python bytecode and tool caches
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/

# ignore local virtualenvs — CONTRIBUTING.md asks contributors to install
# rdflib to run the validators; `uv venv` self-ignores, `python -m venv`
# does not
.venv/
venv/

# ignore Python build artifacts (released via release.yml)
dist/
*.egg-info/

# ignore any structured list files — the collection inventory
# (collection.csv) is a local, untracked generator input and is
# deliberately not distributed
*.csv
*.dsv
*.tsv

# ignore plain text files — this rule is load-bearing: it is what keeps
# the WotC Comprehensive Rules text (MagicCompRules-*.txt, downloaded
# from Wizards, never redistributed) of the public repository.
# Do not narrow it without replacing those guards. It is also why the
# licence file is the extensionless LICENSE, never LICENSE.txt.
*.txt

# ignore the generated OASIS XML catalog — regenerate on demand with
# scripts/generate_catalog.py
catalog-v001.xml
