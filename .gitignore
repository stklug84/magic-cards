# ignore global .gitignore
!*
.DS_Store

# ignore merge files
*.orig

# ignore html files
*.html

# ignore VSCode files
.vscode/
*.code-workspace

# ignore Python bytecode and tool caches
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/

# ignore any structured list files — the collection inventory
# (collection.csv) is a local, untracked generator input and is
# deliberately not distributed
*.csv
*.dsv
*.tsv

# ignore plain text files
*.txt

# ignore the generated OASIS XML catalog — regenerate on demand with
# scripts/generate_catalog.py
catalog-v001.xml
