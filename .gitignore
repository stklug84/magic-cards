# ignore global .gitignore
!*
.DS_Store

# ignore merge files
*.orig

# ignore html files
*.html

# ignore VSCode files
.vscode/
*.code-workspace

# ignore Python bytecode and tool caches
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/

# ignore any structured list files
*.csv
*.dsv
*.tsv

# ignore plain text files (collection data, MagicCompRules - not
# distributed), but keep the strategy decklists
*.txt
!strategies/*.txt
