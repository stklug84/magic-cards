# ==============================================================================
# DISCLAIMER
#
# This file is an independent, fan-made instance graph carrying simulation
# annotations for Magic: The Gathering cards: machine-readable behavior hooks
# and threat weights consumed by the Monte-Carlo matchup simulator
# (scripts/mtgsim). These annotations are house-authored simulation opinion,
# not card facts. The file is not produced by, endorsed by, or affiliated
# with Wizards of the Coast LLC.
#
# Magic: The Gathering is a trademark of Wizards of the Coast LLC. All card
# names referenced herein are the intellectual property of Wizards of the
# Coast LLC and/or their respective owners. This work is made available under
# the Wizards of the Coast Fan Content Policy
# (https://company.wizards.com/en/legal/fancontentpolicy).
# ==============================================================================

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@prefix :     <urn:stklug84:MagicCardsOntology:2026-02-27#> .
@base         <urn:stklug84:MagicSimulationAnnotations:2026-07-20#> .

################################################################################
#
# Ontology Definition
#
################################################################################

<urn:stklug84:MagicSimulationAnnotations:2026-07-20#>
    rdf:type owl:Ontology ;
    owl:imports <urn:stklug84:MagicCardsOntology:2026-02-27#> ;
    rdfs:label "Magic Simulation Annotations"@en ;
    rdfs:comment """An instance graph attaching simulation behavior hooks
(:hasBehaviorHook, whitelisted keys with JSON literal values) and AI threat
weights (:threatWeight) to card individuals. Consumed by the Monte-Carlo
matchup simulator in scripts/mtgsim, which cannot reliably derive these
semantics from oracle text. Hooks apply to the card by name (any printing);
by convention they are asserted on the printing referenced by the deck
graphs. Keys are whitelisted in scripts/mtgsim/behaviors.py
(BEHAVIOR_KEYS) and validated by scripts/check_consistency.py."""@en .


################################################################################
#
# Behavior Hooks and Threat Weights
#
################################################################################

