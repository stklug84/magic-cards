@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@prefix :     <urn:stklug84:MagicCardsOntology:2026-02-27#> .
@base         <urn:stklug84:MagicSimulationAnnotations:2026-07-20#> .

################################################################################
#
# Ontology Definition
#
################################################################################

<urn:stklug84:MagicSimulationAnnotations:2026-07-20#>
    rdf:type owl:Ontology ;
    <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by-sa/4.0/> ;
    owl:imports <urn:stklug84:MagicCardsOntology:2026-02-27#> ;
    rdfs:label "Magic Simulation Annotations"@en ;
    rdfs:comment """An instance graph attaching simulation behavior hooks
(:hasBehaviorHook, whitelisted keys with JSON literal values) and AI threat
weights (:threatWeight) to card individuals. Consumed by the Monte-Carlo
matchup simulator in scripts/mtgsim, which cannot reliably derive these
semantics from oracle text. Hooks apply to the card by name (any printing);
by convention they are asserted on the printing referenced by the deck
graphs. Keys are whitelisted in scripts/mtgsim/behaviors.py
(BEHAVIOR_KEYS) and validated by scripts/check_consistency.py."""@en .

################################################################################
#
# Behavior Hooks and Threat Weights
#
################################################################################

:AcademyManufactor
    :threatWeight "4"^^xsd:nonNegativeInteger ;
    :hasBehaviorHook
      [ rdf:type :BehaviorHook ; :behaviorKey "manufactor" ; :behaviorValue "true" ] .

:AdrixAndNevTwincasters
    :threatWeight "8"^^xsd:nonNegativeInteger ;
    :hasBehaviorHook
      [ rdf:type :BehaviorHook ; :behaviorKey "doubler" ; :behaviorValue "2" ] .

