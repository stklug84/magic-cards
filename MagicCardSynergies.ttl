@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

@prefix :     <urn:stklug84:MagicCardsOntology:2026-02-27#> .
@base         <urn:stklug84:MagicCardSynergies:2026-07-19#> .

################################################################################
#
# Ontology Definition
#
################################################################################

<urn:stklug84:MagicCardSynergies:2026-07-19#>
    rdf:type owl:Ontology ;
    owl:imports <urn:stklug84:MagicCardsOntology:2026-02-27#> ;
    owl:imports <urn:stklug84:MagicCardIndividuals:2026-07-19#> ;
    rdfs:label "Magic Card Synergies"@en ;
    rdfs:comment """An instance graph capturing directional synergy relations
(:amplifies, :enables and their OWL inverses) and mutual synergies
(:hasSynergyWith) between the card individuals of the collection. Each
logical synergy is asserted exactly once: directional relations use the
forward properties, the inverse directions follow from the owl:inverseOf
axioms in MagicCardsOntology, and the symmetric :hasSynergyWith is asserted
once per pair. Relations are deck-independent: they hold for any deck built
from the collection. Where a card exists in several printings, the relations
are asserted on one canonical individual per card name. This file imports
MagicCardsOntology for the property definitions and MagicCardIndividuals for
the card individuals it relates."""@en .

################################################################################
#
# Collection-Wide Card Synergies
#
# Directional and mutual synergies across the named card individuals of the
# collection aggregated by MagicCardIndividuals.ttl (primarily creatures,
# artifacts and enchantments, with instants and sorceries where they feed a
# permanent's engine).
#
# Modelling conventions:
#   :amplifies      - subject increases the value, frequency or magnitude of
#                     the object's abilities (trigger doublers, token/counter/
#                     energy multipliers, blink/copy engines re-firing ETBs).
#   :enables        - subject creates the preconditions for the object's
#                     payoff (resource producers feeding sinks, token
#                     producers feeding copy/populate payoffs, extra combats
#                     feeding attack triggers).
#   :hasSynergyWith - mutual synergy with no clear direction (stacking
#                     doublers, closed engine loops). Symmetric; asserted once
#                     per pair.
#
# Only the forward properties are asserted; :isAmplifiedBy and :isEnabledBy
# follow from the owl:inverseOf axioms in MagicCardsOntology, keeping each
# logical synergy asserted exactly once.
#
################################################################################

# --- Aberrant Researcher // Perfected Form ---
:AberrantResearcher :enables :ArcadeGannon .  # upkeep mill stocks artifact/Human targets

# --- Abundant Growth ---
:AbundantGrowth :enables :GrimGuardian .  # Aura ETB triggers constellation drain

# --- Abundant Maw ---
:AbundantMaw :enables :StormkeldProwler .  # Emerge cast is still MV8, cheap way to trigger counters

# --- Academy Manufactor ---
:AcademyManufactor :amplifies :Blink ,  # Investigate Clue becomes Clue+Food+Treasure
                              :BootleggersStash ,  # each Treasure becomes Clue+Food+Treasure
                              :CityOfDeath ,  # Chapter I Treasure becomes three tokens
                              :CutthroatNegotiator ,  # Parley Treasures become three tokens each
                              :GildedGoose ,  # Each Food becomes Clue+Food+Treasure
                              :MagdaTheHoardmaster ,  # crime Treasure becomes three tokens
                              :NukaColaVendingMachine ,  # Food activation makes all three tokens
                              :SurvivorsMedKit ,  # Food mode instead yields Clue+Food+Treasure
                              :TheRani ,  # Each investigate Clue becomes three tokens
                              :TheSeventhDoctor ,  # Investigate makes Clue+Food+Treasure
                              :TheThirdDoctor ,  # His ETB token becomes Clue+Food+Treasure
                              :TirelessProvisioner ,  # landfall Food/Treasure becomes all three
                              :TirelessTracker ,  # Each investigate Clue becomes Clue+Food+Treasure
                              :TreasureVaultAetherdriftCommander180 ,  # Each Treasure made becomes Clue+Food+Treasure
                              :WeirdingWood .  # Investigate Clue becomes Clue+Food+Treasure
:AcademyManufactor :enables :AceFearlessRebel ,  # extra artifact tokens to sacrifice
                            :AdaptiveOmnitool ,  # artifact tokens grow +1/+1 per artifact
                            :AetherworksMarvelAetherdriftCommander123 ,  # sacrificed tokens hit gy for energy
                            :AidFromTheCowl ,  # sacrificing tokens turns on revolt
                            :AlpharaelStonechosen ,  # token sac turns on Void attack
                            :BanishToAnotherUniverse ,  # artifact tokens cut affinity cost
                            :FiveHundredYearDiary ,  # Extra Clues from replacement grow Diary mana
                            :GhirapurAetherGrid ,  # Triple token output floods artifacts to tap
                            :GimbalGremlinProdigyMarchOfTheMachineCommander3 ,  # Three token names grow Gremlin counters
                            :GontisAetherHeart ,  # Triple artifact tokens yield energy per ETB
                            :HedronDetonator ,  # Triple artifact tokens mean triple pings
                            :HellkiteIgniter ,  # Triple tokens grow artifact count for pump
                            :HellkiteTyrant ,  # Triple tokens race to twenty-artifact win
                            :MechanizedProductionMurdersAtKarlovManorCommander109 ,  # Treasures speed 8 same-name artifacts win
                            :VedalkenHumiliator ,  # Extra artifact tokens fill metalcraft
                            :WarmakerGunship ,  # Extra artifact tokens boost ETB damage
                            :WeftstalkerArdent .  # Bonus artifact tokens entering add pings

